axWidth={180} />\n\n      <div\n        aria-hidden\n        style={{\n          width: 1,\n          height: 22,\n          background: 'var(--border)',\n          margin: '0 var(--space-2)',\n        }}\n      />\n\n      <Breadcrumb\n        course={course}\n        lesson={lesson}\n        moduleTitle={moduleTitle}\n        slug={slug}\n      />\n\n      <div style={{ flex: 1 }} />\n\n      <SectionProgress totals={sectionTotals} />\n\n      <div\n        aria-hidden\n        style={{\n          width: 1,\n          height: 22,\n          background: 'var(--border)',\n          margin: '0 var(--space-2)',\n        }}\n      />\n\n      <ThemeToggle />\n\n      <ToolbarIconBtn\n        testId=\"reset-session-btn\"\n        ariaLabel=\"Reset Python session\"\n        onClick={onResetSession}\n      >\n        <RefreshCw size={16} strokeWidth={2} />\n      </ToolbarIconBtn>\n\n      <ToolbarIconBtn\n        testId=\"shortcuts-btn\"\n        ariaLabel=\"Keyboard shortcuts\"\n        onClick={openShortcutsModal}\n      >\n        <HelpCircle size={16} strokeWidth={2} />\n      </ToolbarIconBtn>\n\n      <ToolbarIconBtn\n        testId=\"tutor-btn\"\n        ariaLabel={chatOpen ? 'Close AI tutor' : 'Open AI tutor'}\n        onClick={onToggleChat}\n        active={chatOpen}\n      >\n        <span\n          style={{\n            fontFamily: 'var(--font-mono)',\n            fontSize: 11,\n            letterSpacing: '0.02em',\n          }}\n        >\n          ⌘.\n        </span>\n      </ToolbarIconBtn>\n\n      <AvatarMenu />","numLines":130,"startLine":990,"totalLines":2454}}}
