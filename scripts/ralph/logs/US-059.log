ns once on mount to swap the SSR-safe","+    // default (false) to the real value derived from navigator.userAgent.","+    // eslint-disable-next-line react-hooks/set-state-in-effect","     setIsMac(isMacPlatform());","   }, []);","   return isMac;"]}],"userModified":false,"replaceAll":false}}
