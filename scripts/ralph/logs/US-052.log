{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DZsDGNtcoAzhkuME4TMSED","type":"tool_result","content":"700\t          minWidth: 0,\n701\t          overflow: 'auto',\n702\t          padding: 'var(--space-6) var(--space-6) var(--space-7)',\n703\t          background: 'var(--bg)',\n704\t        }}\n705\t      >\n706\t        {!loaded ? (\n707\t          <ContentSkeleton />\n708\t        ) : error ? (\n709\t          <LessonNotFound slug={slug} message={error} />\n710\t        ) : lesson ? (\n711\t          <LessonStream\n712\t            course={course}\n713\t            lesson={lesson}\n714\t            slug={slug}\n715\t            lessonSlug={lessonSlug}\n716\t            progress={progress}\n717\t            editingSections={editingSections}\n718\t            onToggleEdit={handleToggleEdit}\n719\t            onSaveTheory={handleSaveTheory}\n720\t            panelSectionId={panelSectionId}\n721\t            onOpenPanel={handleOpenPanel}\n722\t            onOpenLessonSources={() => setLessonSourcesPanelOpen(true)}\n723\t          />\n724\t        ) : null}\n725\t      </main>\n726\t\n727\t      <ChatColumn open={chatOpen} />\n728\t\n729\t      <BottomBar\n730\t        prevLesson={prevLesson}\n731\t        nextLesson={nextLesson}\n732\t        status={lessonStatus}\n733\t        onMarkComplete={handleMarkComplete}\n734\t        onNavigate={handleNavigate}\n735\t      />\n736\t\n737\t      <WidgetEditPanel\n738\t        section={panelSection}\n739\t        courseSlug={slug}\n740\t        open={panelSectionId !== null && panelSection !== null}\n741\t        onClose={handleClosePanel}\n742\t        onSave={handleSavePanelSection}\n743\t      />\n744\t\n745\t      <LessonSourcesEditPanel\n746\t        open={lessonSourcesPanelOpen}\n747\t        sources={lesson?.sources}\n748\t        onClose={() => setLessonSourcesPanelOpen(false)}\n749\t        onSave={handleSaveLessonSources}\n750\t      />\n751\t\n752\t      {sessionToast && <SessionToast me