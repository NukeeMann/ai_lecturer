ks for the session.\n    }\n  }, []);"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":412,"cache_read_input_tokens":77409,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":412},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b74a772c-12b8-46f0-a2a8-706cfe2f6baf","uuid":"cc7caec9-8851-4e69-a14e-637b9b2cb188"}
