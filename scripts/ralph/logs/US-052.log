{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XqVQhwQkE9Ux6wwBnR4mzV","type":"tool_result","content":"The file /home/nukeemann/projects/ai_lecturer/.worktrees/US-052/src/components/LessonChat.tsx has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"b74a772c-12b8-46f0-a2a8-706cfe2f6baf","uuid":"34bff05b-be37-423c-871a-7c7895b5fe94","timestamp":"2026-05-04T05:51:45.952Z","tool_use_result":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-052/src/components/LessonChat.tsx","oldString":"  useEffect(() => {\n    // eslint-disable-next-line react-hooks/set-state-in-effect\n    setDraft(readDraft(courseSlug, lessonSlug));\n    // eslint-disable-next-line react-hooks/set-state-in-effect\n    setMessages([]);\n  }, [courseSlug, lessonSlug]);","newString":"  useEffect(() => {\n    // eslint-disable-next-line react-hooks/set-state-in-effect\n    setDraft(readDraft(courseSlug, lessonSlug));\n    setMessages([]);\n  }, [courseSlug, lessonSlug]);","originalFile":"'use client';\n\nimport {\n  useCallback,\n  useEffect,\n  useLayoutEffect,\n  useRef,\n  useState,\n  type CSSProperties,\n  type KeyboardEvent as ReactKeyboardEvent,\n} from 'react';\nimport { X } from 'lucide-react';\n\nexport interface LessonChatProps {\n  open: boolean;\n  onClose: () => void;\n  courseSlug: string;\n  lessonSlug: string;\n}\n\ninterface ChatMessage {\n  id: string;\n  role: 'user' | 'assistant';\n  content: string;\n}\n\nconst PANEL_WIDTH = 320;\nconst MAX_TEXTAREA_LINES = 6;\nconst DRAFT_DEBOUNCE_MS = 200;\nconst ASSISTANT_PLACEHOLDER =\n  'Backend not connected — try again after US-053 ships';\n\nfunction draftKey(courseSlug: string, lessonSlug: string): string {\n  return `lessonChatDraft:${courseSlug}:${lessonSlug}`;\n}\n\nfunction isMod(e: ReactKeyboardEvent | KeyboardEvent): boolean {\n  return e.metaKey || e.ctrlKey;\n}\n\nfunction readDraft(courseSlug: string, lessonSlug: string): string {\n  if (typeof window === 'undefined') return '';\n  try {\n    return window.localStorage.getItem(draftKey(courseSlug, lessonSlug)) ?? '';\n  } catch {\n    return '';\n  }\n}\n\nexport function LessonChat({\n  open,\n  onClose,\n  courseSlug,\n  lessonSlug,\n}: LessonChatProps) {\n  const [messages, setMessages] = useState<ChatMessage[]>([]);\n  const [draft, setDraft] = useState<string>('');\n  const textareaRef = useRef<HTMLTextAreaElement | null>(null);\n  const messagesEndRef = useRef<HTMLDivElement | null>(null);\n\n  // Restore draft from localStorage on mount and whenever the lesson changes.\n  // (Each lesson has its own draft key.)\n  useEffect(() => {\n    // eslint-disable-next-line react-hooks/set-state-in-effect\n    setDraft(readDraft(courseSlug, lessonSlug));\n    // eslint-disable-next-line react-hooks/set-state-in-effect\n    setMessages([]);\n  }, [courseSlug, lessonSlug]);\n\n  // Debounced mirror of draft → localStorage.\n  useEffect(() => {\n    const handle = window.setTimeout(() => {\n      try {\n        const key = draftKey(courseSlug, lessonSlug);\n        if (draft.length === 0) {\n          window.localStorage.removeItem(key);\n        } else {\n          window.localStorage.setItem(key, draft);\n        }\n      } catch {\n        // localStorage unavailable — draft still works for the session.\n      }\n    }, DRAFT_DEBOUNCE_MS);\n    return () => window.clearTimeout(handle);\n  }, [draft, courseSlug, lessonSlug]);\n\n  // Autoresize the textarea up to MAX_TEXTAREA_LINES.\n  useLayoutEffect(() => {\n    const el = textareaRef.current;\n    if (!el) return;\n    el.style.height = 'auto';\n    const cs = window.getComputedStyle(el);\n    const lineHeight = parseFloat(cs.lineHeight) || 20;\n    const paddingTop = parseFloat(cs.paddingTop) || 0;\n    const paddingBottom = parseFloat(cs.paddingBottom) || 0;\n    const maxHeight = lineHeight * MAX_TEXTAREA_LINES + paddingTop + paddingBottom;\n    const next = Math.min(el.scrollHeight, maxHeight);\n    el.style.height = `${next}px`;\n    el.style.overflowY = el.scrollHeight > maxHeight ? 'auto' : 'hidden';\n  }, [draft, open]);\n\n  // Scroll message list to bottom whenever a new message lands.\n  useEffect(() => {\n    messagesEndRef.current?.scrollIntoView({ block: 'end' });\n  }, [messages.length]);\n\n  // Focus composer when panel opens.\n  useEffect(() => {\n    if (!open) return;\n    textareaRef.current?.focus();\n  }, [open]);\n\n  const trimmed = draft.trim();\n  const sendDisabled = trimmed.length === 0;\n\n  const handleSend = useCallback(() => {\n    const value = draft.trim();\n    if (value.length === 0) return;\n    const now = Date.now();\n    const userMsg: ChatMessage = {\n      id: `u-${now}`,\n      role: 'user',\n      content: value,\n    };\n    const assistantMsg: ChatMessage = {\n      id: `a-${now}`,\n      role: 'assistant',\n      content: ASSISTANT_PLACEHOLDER,\n    };\n    setMessages((prev) => [...prev, userMsg, assistantMsg]);\n    setDraft('');\n    try {\n      window.localStorage.removeItem(draftKey(courseSlug, lessonSlug));\n    } catch {\n      // localStorage unavailable; nothing more to clear.\n    }\n  }, [draft, courseSlug, lessonSlug]);\n\n  const handleTextareaKeyDown = useCallback(\n    (e: ReactKeyboardEvent<HTMLTextAreaElement>) => {\n      if (e.key === 'Enter' && isMod(e)) {\n        e.preventDefault();\n        handleSend();\n      }\n      // Plain Enter inserts newline (default browser behavior).\n    },\n    [handleSend],\n  );\n\n  return (\n    <aside\n      data-testid=\"lesson-chat\"\n      data-open={open ? 'true' : 'false'}\n      aria-hidden={!open}\n      style={{\n        gridColumn: '3 / 4',\n        gridRow: '2 / 3',\n        borderLeft: open ? '1px solid var(--border)' : 'none',\n        background: 'var(--bg-elevated)',\n        overflow: 'hidden',\n        minWidth: 0,\n      }}\n    >\n      <div\n        style={{\n          width: PANEL_WIDTH,\n          height: '100%',\n          display: 'flex',\n          flexDirection: 'column',\n          opacity: open ? 1 : 0,\n        }}\n      >\n        <ChatHeader onClose={onClose} />\n        <ChatBody messages={messages} endRef={messagesEndRef} />\n        <ChatComposer\n          textareaRef={textareaRef}\n          value={draft}\n          onChange={setDraft}\n          onKeyDown={handleTextareaKeyDown}\n          onSend={handleSend}\n          sendDisabled={sendDisabled}\n        />\n      </div>\n    </aside>\n  );\n}\n\nfunction ChatHeader({ onClose }: { onClose: () => void }) {\n  return (\n    <header\n      data-testid=\"lesson-chat-header\"\n      style={{\n        display: 'flex',\n        alignItems: 'center',\n        justifyContent: 'space-between',\n        gap: 'var(--space-3)',\n        padding: 'var(--space-3) var(--space-4)',\n        borderBottom: '1px solid var(--border)',\n        flexShrink: 0,\n      }}\n    >\n      <h2\n        style={{\n          margin: 0,\n          fontSize: 'var(--fs-md)',\n          fontWeight: 600,\n          color: 'var(--text)',\n          lineHeight: 1.2,\n        }}\n      >\n        AI Tutor\n      </h2>\n      <button\n        type=\"button\"\n        onClick={onClose}\n        aria-label=\"Close AI tutor\"\n        data-testid=\"lesson-chat-close\"\n        style={{\n          width: 28,\n          height: 28,\n          display: 'inline-flex',\n          alignItems: 'center',\n          justifyContent: 'center',\n          background: 'transparent',\n          border: '1px solid transparent',\n          borderRadius: 'var(--radius-sm)',\n          color: 'var(--text-tertiary)',\n          cursor: 'pointer',\n          flexShrink: 0,\n        }}\n      >\n        <X size={14} aria-hidden />\n      </button>\n    </header>\n  );\n}\n\nfunction ChatBody({\n  messages,\n  endRef,\n}: {\n  messages: ChatMessage[];\n  endRef: React.RefObject<HTMLDivElement | null>;\n}) {\n  const empty = messages.length === 0;\n  return (\n    <div\n      data-testid=\"lesson-chat-body\"\n      style={{\n        flex: 1,\n        minHeight: 0,\n        overflow: 'auto',\n        padding: 'var(--space-4)',\n        display: 'flex',\n        flexDirection: 'column',\n        gap: 'var(--space-3)',\n      }}\n    >\n      {empty ? (\n        <div\n          data-testid=\"lesson-chat-empty\"\n          style={{\n            margin: 'auto',\n            textAlign: 'center',\n            color: 'var(--text-tertiary)',\n            fontSize: 'var(--fs-sm)',\n            maxWidth: 240,\n            padding: 'var(--space-3)',\n          }}\n        >\n          Ask anything about this lesson — I have its content as context.\n        </div>\n      ) : (\n        <>\n          {messages.map((msg) => (\n            <ChatBubble key={msg.id} message={msg} />\n          ))}\n          <div ref={endRef} aria-hidden />\n        </>\n      )}\n    </div>\n  );\n}\n\nfunction ChatBubble({ message }: { message: ChatMessage }) {\n  const isUser = message.role === 'user';\n  const baseStyle: CSSProperties = {\n    maxWidth: '85%',\n    borderRadius: 'var(--radius-md)',\n    padding: '8px 12px',\n    fontSize: 'var(--fs-sm)',\n    lineHeight: 1.45,\n    whiteSpace: 'pre-wrap',\n    wordBreak: 'break-word',\n  };\n  const userStyle: CSSProperties = {\n    ...baseStyle,\n    alignSelf: 'flex-end',\n    background: 'var(--accent)',\n    color: 'var(--accent-fg, white)',\n  };\n  const assistantStyle: CSSProperties = {\n    ...baseStyle,\n    alignSelf: 'flex-start',\n    background: 'var(--bg-subtle)',\n    color: 'var(--text)',\n    border: '1px solid var(--border)',\n  };\n  return (\n    <div\n      data-testid={isUser ? 'lesson-chat-msg-user' : 'lesson-chat-msg-assistant'}\n      data-role={message.role}\n      style={isUser ? userStyle : assistantStyle}\n    >\n      {message.content}\n    </div>\n  );\n}\n\ninterface ChatComposerProps {\n  textareaRef: React.RefObject<HTMLTextAreaElement | null>;\n  value: string;\n  onChange: (next: string) => void;\n  onKeyDown: (e: ReactKeyboardEvent<HTMLTextAreaElement>) => void;\n  onSend: () => void;\n  sendDisabled: boolean;\n}\n\nfunction ChatComposer({\n  textareaRef,\n  value,\n  onChange,\n  onKeyDown,\n  onSend,\n  sendDisabled,\n}: ChatComposerProps) {\n  return (\n    <footer\n      data-testid=\"lesson-chat-composer\"\n      style={{\n        position: 'sticky',\n        bottom: 0,\n        flexShrink: 0,\n        borderTop: '1px solid var(--border)',\n        padding: 'var(--space-3) var(--space-4)',\n        background: 'var(--bg-elevated)',\n        display: 'flex',\n        flexDirection: 'column',\n        gap: 'var(--space-2)',\n      }}\n    >\n      <textarea\n        ref={textareaRef}\n        data-testid=\"lesson-chat-textarea\"\n        rows={1}\n        placeholder=\"Ask anything…\"\n        value={value}\n        onChange={(e) => onChange(e.target.value)}\n        onKeyDown={onKeyDown}\n        style={{\n          width: '100%',\n          resize: 'none',\n          border: '1px solid var(--border)',\n          borderRadius: 'var(--radius-md)',\n          padding: '8px 10px',\n          background: 'var(--bg)',\n          color: 'var(--text)',\n          fontSize: 'var(--fs-sm)',\n          fontFamily: 'inherit',\n          lineHeight: 1.45,\n          outline: 'none',\n        }}\n      />\n      <div\n        style={{\n          display: 'flex',\n          alignItems: 'center',\n          justifyContent: 'space-between',\n          gap: 'var(--space-2)',\n        }}\n      >\n        <span\n          aria-hidden\n          style={{\n            fontSize: 'var(--fs-xs)',\n            color: 'var(--text-tertiary)',\n            fontFamily: 'var(--font-mono)',\n          }}\n        >\n          ⌘+Enter to send\n        </span>\n        <div style={{ display: 'flex', gap: 'var(--space-2)' }}>\n          <button\n            type=\"button\"\n            data-testid=\"lesson-chat-stop\"\n            disabled\n            aria-label=\"Stop response (coming in US-055)\"\n            style={{\n              padding: '6px 12px',\n              fontSize: 'var(--fs-sm)',\n              borderRadius: 'var(--radius-md)',\n              border: '1px solid var(--border)',\n              background: 'transparent',\n              color: 'var(--text-quaternary)',\n              cursor: 'not-allowed',\n              opacity: 0.6,\n            }}\n          >\n            Stop\n          </button>\n          <button\n            type=\"button\"\n            data-testid=\"lesson-chat-send\"\n            onClick={onSend}\n            disabled={sendDisabled}\n            style={{\n              padding: '6px 14px',\n              fontSize: 'var(--fs-sm)',\n              fontWeight: 500,\n              borderRadius: 'var(--radius-md)',\n              border: '1px solid var(--accent)',\n              background: sendDisabled ? 'var(--bg-subtle)' : 'var(--accent)',\n              color: sendDisabled ? 'var(--text-quaternary)' : 'var(--accent-fg, white)',\n              cursor: sendDisabled ? 'not-allowed' : 'pointer',\n              opacity: sendDisabled ? 0.6 : 1,\n            }}\n          >\n            Send\n          </button>\n        </div>\n      </div>\n    </footer>\n  );\n}\n","structuredPatch":[{"oldStart":63,"oldLines":7,"newStart":63,"newLines":6,"lines":["   useEffect(() => {","     // eslint-disable-next-line react-hooks/set-state-in-effect","     setDraft(readDraft(courseSlug, lessonSlug));","-    // eslint-disable-next-line react-hooks/set-state-in-effect","     setMessages([]);","   }, [courseSlug, lessonSlug]);"," "]}],"userModified":false,"replaceAll":false}}
