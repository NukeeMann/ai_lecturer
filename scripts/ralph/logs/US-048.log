{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013mg33krFZhXXbHJY6A1oNc","type":"tool_result","content":"1\timport { z } from 'zod';\n2\t\n3\texport const DragMatchItemSchema = z.object({\n4\t  id: z.string().min(1),\n5\t  label: z.string().min(1),\n6\t});\n7\t\n8\texport const DragMatchZoneSchema = z.object({\n9\t  id: z.string().min(1),\n10\t  label: z.string().min(1),\n11\t  accepts: z.array(z.string().min(1)),\n12\t});\n13\t\n14\texport const DragMatchDataSchema = z.object({\n15\t  prompt: z.string(),\n16\t  items: z.array(DragMatchItemSchema).min(1),\n17\t  zones: z.array(DragMatchZoneSchema).min(1),\n18\t  multipleItemsPerZone: z.boolean().default(false),\n19\t  explanation: z.string().optional(),\n20\t});\n21\t\n22\texport type DragMatchItem = z.infer<typeof DragMatchItemSchema>;\n23\texport type DragMatchZone = z.infer<typeof DragMatchZoneSchema>;\n24\texport type DragMatchData = z.infer<typeof DragMatchDataSchema>;\n25\t\n26\texport type DragMatchPlacement = Record<string, string[]>;\n27\t\n28\texport interface DragMatchValidationResult {\n29\t  allCorrect: boolean;\n30\t  zoneCorrect: Record<string, boolean>;\n31\t  misplacedItemIds: Set<string>;\n32\t}\n33\t\n34\tfunction arraysEqual(a: readonly string[], b: readonly string[]): boolean {\n35\t  if (a.length !== b.length) return false;\n36\t  for (let i = 0; i < a.length; i++) {\n37\t    if (a[i] !== b[i]) return false;\n38\t  }\n39\t  return true;\n40\t}\n41\t\n42\tfunction setsEqual(a: readonly string[], b: readonly string[]): boolean {\n43\t  if (a.length !== b.length) return false;\n44\t  const sb = new Set(b);\n45\t  return a.every((x) => sb.has(x));\n46\t}\n47\t\n48\texport function validateDragMatch(\n49\t  data: DragMatchData,\n50\t  placement: DragMatchPlacement,\n51\t): DragMatchValidationResult {\n52\t  const zoneCorrect: Record<string, boolean> = {};\n53\t  const expectedZoneByItem = new Map<string, string>();\n54\t  for (const zone of data.zones) {\n55\t    for (const itemId of zone.accepts) {\n56\t      expectedZoneByItem.set(itemId, zone.id);\n57\t    }\n58\t  }\n59\t\n60\t  for (const zone of data.zones) {\n61\t    const placed = placement[zone.id] ?? [];\n62\t    zoneCorrect[zone.id] = data.multipleItemsPerZone\n63\t      ? arraysEqual(placed, zone.accepts)\n64\t      : setsEqual(placed, zone.accepts);\n65\t  }\n66\t\n67\t  const misplacedItemIds = new Set<string>();\n68\t  for (const item of data.items) {\n69\t    let actualZone: string | null = null;\n70\t    for (const zone of data.zones) {\n71\t      if ((placement[zone.id] ?? []).includes(item.id)) {\n72\t        actualZone = zone.id;\n73\t        break;\n74\t      }\n75\t    }\n76\t    const expected = expectedZoneByItem.get(item.id) ?? null;\n77\t    if (actualZone !== expected) misplacedItemIds.add(item.id);\n78\t  }\n79\t\n80\t  const allCorrect = data.zones.every((z) => zoneCorrect[z.id]);\n81\t  return { allCorrect, zoneCorrect, misplacedItemIds };\n82\t}\n83\t"}]},"parent_tool_use_id":null,"session_id":"46b898f2-0f25-403b-8a34-d68b7e60e547","uuid":"acb2b161-caf8-4d74-a0b6-c095ed84aab7","timestamp":"2026-05-03T22:17:59.410Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-048/src/widgets/DragMatch/schema.ts","content":"import { z } from 'zod';\n\nexport const DragMatchItemSchema = z.object({\n  id: z.string().min(1),\n  label: z.string().min(1),\n});\n\nexport const DragMatchZoneSchema = z.object({\n  id: z.string().min(1),\n  label: z.string().min(1),\n  accepts: z.array(z.string().min(1)),\n});\n\nexport const DragMatchDataSchema = z.object({\n  prompt: z.string(),\n  items: z.array(DragMatchItemSchema).min(1),\n  zones: z.array(DragMatchZoneSchema).min(1),\n  multipleItemsPerZone: z.boolean().default(false),\n  explanation: z.string().optional(),\n});\n\nexport type DragMatchItem = z.infer<typeof DragMatchItemSchema>;\nexport type DragMatchZone = z.infer<typeof DragMatchZoneSchema>;\nexport type DragMatchData = z.infer<typeof DragMatchDataSchema>;\n\nexport type DragMatchPlacement = Record<string, string[]>;\n\nexport interface DragMatchValidationResult {\n  allCorrect: boolean;\n  zoneCorrect: Record<string, boolean>;\n  misplacedItemIds: Set<string>;\n}\n\nfunction arraysEqual(a: readonly string[], b: readonly string[]): boolean {\n  if (a.length !== b.length) return false;\n  for (let i = 0; i < a.length; i++) {\n    if (a[i] !== b[i]) return false;\n  }\n  return true;\n}\n\nfunction setsEqual(a: readonly string[], b: readonly string[]): boolean {\n  if (a.length !== b.length) return false;\n  const sb = new Set(b);\n  return a.every((x) => sb.has(x));\n}\n\nexport function validateDragMatch(\n  data: DragMatchData,\n  placement: DragMatchPlacement,\n): DragMatchValidationResult {\n  const zoneCorrect: Record<string, boolean> = {};\n  const expectedZoneByItem = new Map<string, string>();\n  for (const zone of data.zones) {\n    for (const itemId of zone.accepts) {\n      expectedZoneByItem.set(itemId, zone.id);\n    }\n  }\n\n  for (const zone of data.zones) {\n    const placed = placement[zone.id] ?? [];\n    zoneCorrect[zone.id] = data.multipleItemsPerZone\n      ? arraysEqual(placed, zone.accepts)\n      : setsEqual(placed, zone.accepts);\n  }\n\n  const misplacedItemIds = new Set<string>();\n  for (const item of data.items) {\n    let actualZone: string | null = null;\n    for (const zone of data.zones) {\n      if ((placement[zone.id] ?? []).includes(item.id)) {\n        actualZone = zone.id;\n        break;\n      }\n    }\n    const expected = expectedZoneByItem.get(item.id) ?? null;\n    if (actualZone !== expected) misplacedItemIds.add(item.id);\n  }\n\n  const allCorrect = data.zones.every((z) => zoneCorrect[z.id]);\n  return { allCorrect, zoneCorrect, misplacedItemIds };\n}\n","numLines":83,"startLine":1,"totalLines":83}}}
