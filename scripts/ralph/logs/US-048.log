,\n78\t  borderRadius: 'var(--radius-md)',\n79\t  background: 'var(--bg-elevated)',\n80\t  border: '1px solid var(--border-strong)',\n81\t  fontSize: 'var(--fs-sm)',\n82\t  color: 'var(--text)',\n83\t  cursor: 'grab',\n84\t  userSelect: 'none',\n85\t  touchAction: 'none',\n86\t  lineHeight: 1.3,\n87\t};\n88\t\n89\tconst zonesGridStyle: CSSProperties = {\n90\t  display: 'grid',\n91\t  gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))',\n92\t  gap: 'var(--space-3)',\n93\t};\n94\t\n95\tconst submitButtonBase: CSSProperties = {\n96\t  display: 'inline-flex',\n97\t  alignItems: 'center',\n98\t  justifyContent: 'center',\n99\t  gap: 6,\n100\t  height: 36,\n101\t  padding: '0 var(--space-5)',\n102\t  borderRadius: 'var(--radius-md)',\n103\t  fontSize: 'var(--fs-sm)',\n104\t  fontWeight: 500,\n105\t  cursor: 'pointer',\n106\t  border: '1px solid transparent',\n107\t};\n108\t\n109\tinterface DraggableItemProps {\n110\t  item: DragMatchItem;\n111\t  misplaced: boolean;\n112\t  expectedZoneLabel: string | null;\n113\t  submitted: boolean;\n114\t  disabled: boolean;\n115\t}\n116\t\n117\tfunction DraggableItem({\n118\t  item,\n119\t  misplaced,\n120\t  expectedZoneLabel,\n121\t  submitted,\n122\t  disabled,\n123\t}: DraggableItemProps) {\n124\t  const { attributes, listeners, setNodeRef, transform, isDragging } =\n125\t    useDraggable({\n126\t      id: item.id,\n127\t      disabled,\n128\t      attributes: { roleDescription: 'Draggable item' },\n129\t    });\n130\t\n131\t  const style: CSSProperties = {\n132\t    ...itemBaseStyle,\n133\t    transform: CSS.Translate.toString(transform),\n134\t    opacity: isDragging ? 0 : 1,\n135\t    cursor: disabled ? 'default' : 'grab',\n136\t  };\n137\t\n138\t  if (submitted && misplaced) {\n139\t    style.outline = '2px dashed var(--danger-border)';\n140\t    style.outlineOffset = 2;\n141\t  } else if (submitted) {\n142\t    style.outline = '2px solid var(--success-border)';\n143\t    style.outlineOffset = 2;\n144\t  }\n145\t\n146\t  return (\n147\t    <span\n148\t      ref={setNodeRef}\n149\t      data-testid={`dragmatch-item-${item.id}`}\n150\t      data-item-id={item.id}\n151\t      data-misplaced={submitted && misplaced ? 'true' : 'false'}\n152\t      style={style}\n153\t      {...listeners}\n154\t      {...attributes}\n155\t    >\n156\t      {item.label}\n157\t      {submitted && misplaced && expectedZoneLabel && (\n158\t        <span\n159\t          data-testid={`dragmatch-item-expected-${item.id}`}\n160\t          style={{\n161\t            marginLeft: 6,\n162\t            fontSize: 'var(--fs-xs)',\n163\t            color: 'var(--danger)',\n164\t            fontStyle: 'italic',\n165\t          }}\n166\t        >\n167\t          → {expectedZoneLabel}\n168\t        </span>\n169\t      )}\n170\t    </span>\n171\t  );\n172\t}\n173\t\n174\tinterface DroppableContainerProps {\n175\t  id: string;\n176\t  children: React.ReactNode;\n177\t  testId?: string;\n178\t  baseStyle: CSSProperties;\n179\t  hoverStyle?: CSSProperties;\n180\t  feedbackStyle?: CSSProperties;\n181\t  ariaLabel?: string;\n182\t}\n183\t\n184\tfunction DroppableContainer({\n185\t  id,\n186\t  children,\n187\t  testId,\n188\t  baseStyle,\n189\t  hoverStyle,\n190\t  feedbackStyle,\n191\t  ariaLabel,\n192\t}: DroppableContainerProps) {\n193\t  const { setNodeRef, isOver, active } = useDroppable({ id });\n194\t  const showHover = isOver && active !== null;\n195\t\n196\t  const style: CSSProperties = {\n197\t    ...baseStyle,\n198\t    ...(showHover && hoverStyle ? hoverStyle : {}),\n199\t    ...(feedbackStyle ?? {}),\n200\t  };\n201\t\n202\t  return (\n203\t    <div\n204\t      ref={setNodeRef}\n205\t      data-testid={testId}\n206\t      data-drop-id={id}\n207\t      data-drop-over={showHover ? 'true' : 'false'}\n208\t      aria-label={ariaLabel}\n209\t      style={style}\n210\t    >\n211\t      {children}\n212\t    </div>\n213\t  );\n214\t}\n215\t\n216\tconst bankBaseStyle: CSSProperties = {\n217\t  display: 'flex',\n218\t  flexWrap: 'wrap',\n219\t  gap: 'var(--space-2)',\n220\t  minHeight: 56,\n221\t  padding: 'var(--space-3)',\n222\t  borderRadius: 'var(--radius-md)',\n223\t  borderWidth: 1,\n224\t  borderStyle: 'dashed',\n225\t  borderColor: 'var(--border-strong)',\n226\t  background: 'var(--bg-subtle)',\n227\t};\n228\t\n229\tconst zoneBaseStyle: CSSProperties = {\n230\t  display: 'flex',\n231\t  flexDirection: 'column',\n232\t  gap: 'var(--space-2)',\n233\t  minHeight: 96,\n234\t  padding: 'var(--space-3)',\n235\t  borderRadius: 'var(--radius-md)',\n236\t  borderWidth: 1,\n237\t  borderStyle: 'solid',\n238\t  borderColor: 'var(--border-strong)',\n239\t  background: 'var(--bg-elevated)',\n240\t};\n241\t\n242\tconst zoneLabelStyle: CSSProperties = {\n243\t  fontSize: 'var(--fs-sm)',\n244\t  color: 'var(--text-secondary)',\n245\t  fontWeight: 500,\n246\t  marginBottom: 4,\n247\t};\n248\t\n249\tconst zoneItemsStyle: CSSProperties = {\n250\t  display: 'flex',\n251\t  flexWrap: 'wrap',\n252\t  gap: 'var(--space-2)',\n253\t  flex: 1,\n254\t};\n255\t\n256\tconst zoneEmptyHintStyle: CSSProperties = {\n257\t  fontSize: 'var(--fs-xs)',\n258\t  color: 'var(--text-quaternary)',\n259\t  fontStyle: 'italic',\n260\t};\n261\t\n262\tconst hoverStyle: CSSProperties = {\n263\t  background: 'var(--accent-subtle)',\n264\t  borderColor: 'var(--accent-border)',\n265\t};\n266\t\n267\tfunction zoneFeedbackStyle(state: 'correct' | 'incorrect' | 'idle'): CSSProperties {\n268\t  if (state === 'correct') {\n269\t    return {\n270\t      background: 'var(--success-subtle)',\n271\t      borderColor: 'var(--success-border)',\n272\t    };\n273\t  }\n274\t  if (state === 'incorrect') {\n275\t    return {\n276\t      background: 'var(--danger-subtle)',\n277\t      borderColor: 'var(--danger-border)',\n278\t    };\n279\t  }\n280\t  return {};\n281\t}\n282\t\n283\tfunction buildInitialPlacement(data: DragMatchData): DragMatchPlacement {\n284\t  const out: DragMatchPlacement = {};\n285\t  out[DRAG_MATCH_BANK_ID] = data.items.map((i) => i.id);\n286\t  for (const z of data.zones) out[z.id] = [];\n287\t  return out;\n288\t}\n289\t\n290\texport function DragMatchWidget({\n291\t  data: rawData,\n292\t  progressKey,\n293\t  onComplete,\n294\t}: DragMatchWidgetProps) {\n295\t  const data = useMemo(() => DragMatchDataSchema.parse(rawData), [rawData]);\n296\t\n297\t  const [placement, setPlacement] = useState<DragMatchPlacement>(() =>\n298\t    buildInitialPlacement(data),\n299\t  );\n300\t  const [submitted, setSubmitted] = useState(false);\n301\t  const [activeId, setActiveId] = useState<string | null>(null);\n302\t  const completedOnceRef = useRef(false);\n303\t\n304\t  const onCompleteRef = useRef(onComplete);\n305\t  useEffect(() => {\n306\t    onCompleteRef.current = onComplete;\n307\t  }, [onComplete]);\n308\t\n309\t  const itemById = useMemo(() => {\n310\t    const m = new Map<string, DragMatchItem>();\n311\t    for (const it of data.items) m.set(it.id, it);\n312\t    return m;\n313\t  }, [data.items]);\n314\t\n315\t  const expectedZoneLabelByItem = useMemo(() => {\n316\t    const m = new Map<string, string>();\n317\t    for (const z of data.zones) {\n318\t      for (const itemId of z.accepts) m.set(itemId, z.label);\n319\t    }\n320\t    return m;\n321\t  }, [data.zones]);\n322\t\n323\t  const sensors = useSensors(\n324\t    useSensor(PointerSensor, {\n325\t      activationConstraint: { distance: 4 },\n326\t    }),\n327\t    useSensor(KeyboardSensor),\n328\t  );\n329\t\n330\t  const validation = useMemo(\n331\t    () => (submitted ? validateDragMatch(data, placement) : null),\n332\t    [submitted, data, placement],\n333\t  );\n334\t\n335\t  const allCorrect = validation?.allCorrect ?? false;\n336\t\n337\t  const handleDragStart = useCallback((event: DragStartEvent) => {\n338\t    setActiveId(String(event.active.id));\n339\t  }, []);\n340\t\n341\t  const handleDragEnd = useCallback(\n342\t    (event: DragEndEvent) => {\n343\t      setActiveId(null);\n344\t      const { active, over } = event;\n345\t      if (!over) return;\n346\t      const itemId = String(active.id);\n347\t      const targetId = String(over.id);\n348\t\n349\t      setPlacement((prev) => {\n350\t        const next: DragMatchPlacement = {};\n351\t        for (const k of Object.keys(prev)) next[k] = prev[k].slice();\n352\t\n353\t        let sourceContainer: string | null = null;\n354\t        for (const k of Object.keys(next)) {\n355\t          if (next[k].includes(itemId)) {\n356\t            sourceContainer = k;\n357\t            break;\n358\t          }\n359\t        }\n360\t        if (!sourceContainer) return prev;\n361\t        if (sourceContainer === targetId) return prev;\n362\t\n363\t        next[sourceContainer] = next[sourceContainer].filter((id) => id !== itemId);\n364\t\n365\t        if (!next[targetId]) next[targetId] = [];\n366\t\n367\t        const targetIsZone = data.zones.some((z) => z.id === targetId);\n368\t        if (targetIsZone && !data.multipleItemsPerZone) {\n369\t          // single-item-per-zone: move existing occupants back to bank\n370\t          const displaced = next[targetId];\n371\t          if (displaced.length > 0) {\n372\t            next[DRAG_MATCH_BANK_ID] = [\n373\t              ...(next[DRAG_MATCH_BANK_ID] ?? []),\n374\t              ...displaced,\n375\t            ];\n376\t          }\n377\t          next[targetId] = [itemId];\n378\t        } else {\n379\t          next[targetId] = [...next[targetId], itemId];\n380\t        }\n381\t        return next;\n382\t      });\n383\t\n384\t      if (submitted) setSubmitted(false);\n385\t    },\n386\t    [data, submitted],\n387\t  );\n388\t\n389\t  const handleDragCancel = useCallback(() => {\n390\t    setActiveId(null);\n391\t  }, []);\n392\t\n393\t  const handleSubmit = useCallback(() => {\n394\t    setSubmitted(true);\n395\t    const result = validateDragMatch(data, placement);\n396\t    if (result.allCorrect && !completedOnceRef.current) {\n397\t      completedOnceRef.current = true;\n398\t      if (progressKey) void patchSectionDone(progressKey);\n399\t      onCompleteRef.current?.();\n400\t    }\n401\t  }, [data, placement, progressKey]);\n402\t\n403\t  const handleReset = useCallback(() => {\n404\t    setPlacement(buildInitialPlacement(data));\n405\t    setSubmitted(false);\n406\t  }, [data]);\n407\t\n408\t  const bankItems = placement[DRAG_MATCH_BANK_ID] ?? [];\n409\t  const allPlaced = bankItems.length === 0;\n410\t\n411\t  const submitDisabled = submitted ? false : !allPlaced;\n412\t  const submitButtonStyle: CSSProperties = useMemo(() => {\n413\t    if (submitted && allCorrect) {\n414\t      return {\n415\t        ...submitButtonBase,\n416\t        background: 'transparent',\n417\t        border: '1px solid var(--success-border)',\n418\t        color: 'var(--success)',\n419\t        cursor: 'default',\n420\t      };\n421\t    }\n422\t    if (submitted) {\n423\t      return {\n424\t        ...submitButtonBase,\n425\t        background: 'transparent',\n426\t        color: 'var(--text-secondary)',\n427\t        border: '1px solid var(--border-strong)',\n428\t      };\n429\t    }\n430\t    return {\n431\t      ...submitButtonBase,\n432\t      background: submitDisabled ? 'var(--bg-active)' : 'var(--accent)',\n433\t      color: submitDisabled ? 'var(--text-tertiary)' : 'var(--text-on-accent)',\n434\t      cursor: submitDisabled ? 'not-allowed' : 'pointer',\n435\t      opacity: submitDisabled ? 0.7 : 1,\n436\t    };\n437\t  }, [submitted, allCorrect, submitDisabled]);\n438\t\n439\t  function renderItem(itemId: string, opts: { inOverlay?: boolean } = {}) {\n440\t    const item = itemById.get(itemId);\n441\t    if (!item) return null;\n442\t    const misplaced = validation?.misplacedItemIds.has(item.id) ?? false;\n443\t    const expectedZoneLabel = expectedZoneLabelByItem.get(item.id) ?? null;\n444\t    if (opts.inOverlay) {\n445\t      return (\n446\t        <span\n447\t          style={{\n448\t            ...itemBaseStyle,\n449\t            cursor: 'grabbing',\n450\t            boxShadow: 'var(--shadow-md)',\n451\t          }}\n452\t        >\n453\t          {item.label}\n454\t        </span>\n455\t      );\n456\t    }\n457\t    return (\n458\t      <DraggableItem\n459\t        key={item.id}\n460\t        item={item}\n461\t        misplaced={misplaced}\n462\t        expectedZoneLabel={expectedZoneLabel}\n463\t        submitted={submitted}\n464\t        disabled={submitted && allCorrect}\n465\t      />\n466\t    );\n467\t  }\n468\t\n469\t  return (\n470\t    <div data-dragmatch-body style={wrapStyle}>\n471\t      <div data-dragmatch-prompt style={promptStyle}>\n472\t        {data.prompt}\n473\t      </div>\n474\t\n475\t      <DndContext\n476\t        sensors={sensors}\n477\t        onDragStart={handleDragStart}\n478\t        onDragEnd={handleDragEnd}\n479\t        onDragCancel={handleDragCancel}\n480\t      >\n481\t        <div>\n482\t          <div style={sectionLabelStyle}>Items</div>\n483\t          <DroppableContainer\n484\t            id={DRAG_MATCH_BANK_ID}\n485\t            testId=\"dragmatch-bank\"\n486\t            ariaLabel=\"Item bank\"\n487\t            baseStyle={bankBaseStyle}\n488\t            hoverStyle={hoverStyle}\n489\t          >\n490\t            {bankItems.length === 0 ? (\n491\t              <span style={zoneEmptyHintStyle}>All items placed</span>\n492\t            ) : (\n493\t              bankItems.map((id) => renderItem(id))\n494\t            )}\n495\t          </DroppableContainer>\n496\t        </div>\n497\t\n498\t        <div>\n499\t          <div style={sectionLabelStyle}>Zones</div>\n500\t          <div style={zonesGridStyle}>\n501\t            {data.zones.map((zone) => {\n502\t              const placed = placement[zone.id] ?? [];\n503\t              const correctness = submitted\n504\t                ? validation?.zoneCorrect[zone.id]\n505\t                  ? 'correct'\n506\t                  : 'incorrect'\n507\t                : 'idle';\n508\t              return (\n509\t                <DroppableContainer\n510\t                  key={zone.id}\n511\t                  id={zone.id}\n512\t                  testId={`dragmatch-zone-${zone.id}`}\n513\t                  ariaLabel={`Zone: ${zone.label}`}\n514\t                  baseStyle={zoneBaseStyle}\n515\t                  hoverStyle={hoverStyle}\n516\t                  feedbackStyle={zoneFeedbackStyle(correctness)}\n517\t                >\n518\t                  <div style={zoneLabelStyle}>{zone.label}</div>\n519\t                  <div style={zoneItemsStyle}>\n520\t                    {placed.length === 0 ? (\n521\t                      <span style={zoneEmptyHintStyle}>Drop here</span>\n522\t                    ) : (\n523\t                      placed.map((id) => renderItem(id))\n524\t                    )}\n525\t                  </div>\n526\t                </DroppableContainer>\n527\t              );\n528\t            })}\n529\t          </div>\n530\t        </div>\n531\t\n532\t        <DragOverlay>\n533\t          {activeId ? renderItem(activeId, { inOverlay: true }) : null}\n534\t        </DragOverlay>\n535\t      </DndContext>\n536\t\n537\t      <div\n538\t        style={{\n539\t          display: 'flex',\n540\t          alignItems: 'center',\n541\t          gap: 'var(--space-3)',\n542\t        }}\n543\t      >\n544\t        {submitted && !allCorrect ? (\n545\t          <button\n546\t            type=\"button\"\n547\t            data-testid=\"dragmatch-reset\"\n548\t            onClick={handleReset}\n549\t            style={{\n550\t              ...submitButtonBase,\n551\t              background: 'transparent',\n552\t              color: 'var(--text-secondary)',\n553\t              border: '1px solid var(--border-strong)',\n554\t              cursor: 'pointer',\n555\t            }}\n556\t          >\n557\t            Try again\n558\t          </button>\n559\t        ) : null}\n560\t        <button\n561\t          type=\"button\"\n562\t          data-testid=\"dragmatch-submit\"\n563\t          onClick={handleSubmit}\n564\t          disabled={submitDisabled}\n565\t          aria-label={submitted && allCorrect ? 'Solved' : 'Check answers'}\n566\t          style={submitButtonStyle}\n567\t        >\n568\t          {submitted && allCorrect ? (\n569\t            <>\n570\t              <Check size={14} aria-hidden /> Solved\n571\t            </>\n572\t          ) : submitted ? (\n573\t            <>\n574\t              <X size={14} aria-hidden /> Submit again\n575\t            </>\n576\t          ) : (\n577\t            'Submit'\n578\t          )}\n579\t        </button>\n580\t      </div>\n581\t\n582\t      {submitted && data.explanation && (\n583\t        <Callout tone=\"info\" title=\"Explanation\">\n584\t          {data.explanation}\n585\t        </Callout>\n586\t      )}\n587\t    </div>\n588\t  );\n589\t}\n590\t\n591\tasync function patchSectionDone(key: DragMatchProgressKey): Promise<void> {\n592\t  try {\n593\t    await fetch('/api/progress', {\n594\t      method: 'PATCH',\n595\t      headers: { 'Content-Type': 'application/json' },\n596\t      body: JSON.stringify({\n597\t        courseSlug: key.courseSlug,\n598\t        lessonSlug: key.lessonSlug,\n599\t        sectionState: { [key.sectionId]: { done: true } },\n600\t      }),\n601\t    });\n602\t  } catch {\n603\t    // Persistence is non-fatal.\n604\t  }\n605\t}\n606\t"}]},"parent_tool_use_id":null,"session_id":"46b898f2-0f25-403b-8a34-d68b7e60e547","uuid":"19cd8d0b-00e3-4492-a632-a291c2a7c855","timestamp":"2026-05-03T22:18:11.017Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-048/src/widgets/DragMatch/DragMatchWidget.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useEffect,\n  useMemo,\n  useRef,\n  useState,\n  type CSSProperties,\n} from 'react';\nimport {\n  DndContext,\n  DragOverlay,\n  KeyboardSensor,\n  PointerSensor,\n  useDraggable,\n  useDroppable,\n  useSensor,\n  useSensors,\n  type DragEndEvent,\n  type DragStartEvent,\n} from '@dnd-kit/core';\nimport { CSS } from '@dnd-kit/utilities';\nimport { Check, X } from 'lucide-react';\n\nimport { Callout } from '@/components/Callout';\n\nimport {\n  DragMatchDataSchema,\n  validateDragMatch,\n  type DragMatchData,\n  type DragMatchItem,\n  type DragMatchPlacement,\n} from './schema';\n\nexport const DRAG_MATCH_BANK_ID = '__bank__';\n\nexport interface DragMatchProgressKey {\n  courseSlug: string;\n  lessonSlug: string;\n  sectionId: string;\n}\n\nexport interface DragMatchWidgetProps {\n  data: DragMatchData;\n  progressKey?: DragMatchProgressKey;\n  onComplete?: () => void;\n}\n\nconst wrapStyle: CSSProperties = {\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-4)',\n  padding: 'var(--space-5)',\n};\n\nconst promptStyle: CSSProperties = {\n  fontSize: 'var(--fs-md)',\n  fontWeight: 500,\n  color: 'var(--text)',\n  lineHeight: 1.4,\n};\n\nconst sectionLabelStyle: CSSProperties = {\n  fontSize: 'var(--fs-xs)',\n  fontWeight: 600,\n  letterSpacing: '0.06em',\n  textTransform: 'uppercase',\n  color: 'var(--text-tertiary)',\n  marginBottom: 'var(--space-2)',\n};\n\nconst itemBaseStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 6,\n  padding: '6px 10px',\n  borderRadius: 'var(--radius-md)',\n  background: 'var(--bg-elevated)',\n  border: '1px solid var(--border-strong)',\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text)',\n  cursor: 'grab',\n  userSelect: 'none',\n  touchAction: 'none',\n  lineHeight: 1.3,\n};\n\nconst zonesGridStyle: CSSProperties = {\n  display: 'grid',\n  gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))',\n  gap: 'var(--space-3)',\n};\n\nconst submitButtonBase: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  gap: 6,\n  height: 36,\n  padding: '0 var(--space-5)',\n  borderRadius: 'var(--radius-md)',\n  fontSize: 'var(--fs-sm)',\n  fontWeight: 500,\n  cursor: 'pointer',\n  border: '1px solid transparent',\n};\n\ninterface DraggableItemProps {\n  item: DragMatchItem;\n  misplaced: boolean;\n  expectedZoneLabel: string | null;\n  submitted: boolean;\n  disabled: boolean;\n}\n\nfunction DraggableItem({\n  item,\n  misplaced,\n  expectedZoneLabel,\n  submitted,\n  disabled,\n}: DraggableItemProps) {\n  const { attributes, listeners, setNodeRef, transform, isDragging } =\n    useDraggable({\n      id: item.id,\n      disabled,\n      attributes: { roleDescription: 'Draggable item' },\n    });\n\n  const style: CSSProperties = {\n    ...itemBaseStyle,\n    transform: CSS.Translate.toString(transform),\n    opacity: isDragging ? 0 : 1,\n    cursor: disabled ? 'default' : 'grab',\n  };\n\n  if (submitted && misplaced) {\n    style.outline = '2px dashed var(--danger-border)';\n    style.outlineOffset = 2;\n  } else if (submitted) {\n    style.outline = '2px solid var(--success-border)';\n    style.outlineOffset = 2;\n  }\n\n  return (\n    <span\n      ref={setNodeRef}\n      data-testid={`dragmatch-item-${item.id}`}\n      data-item-id={item.id}\n      data-misplaced={submitted && misplaced ? 'true' : 'false'}\n      style={style}\n      {...listeners}\n      {...attributes}\n    >\n      {item.label}\n      {submitted && misplaced && expectedZoneLabel && (\n        <span\n          data-testid={`dragmatch-item-expected-${item.id}`}\n          style={{\n            marginLeft: 6,\n            fontSize: 'var(--fs-xs)',\n            color: 'var(--danger)',\n            fontStyle: 'italic',\n          }}\n        >\n          → {expectedZoneLabel}\n        </span>\n      )}\n    </span>\n  );\n}\n\ninterface DroppableContainerProps {\n  id: string;\n  children: React.ReactNode;\n  testId?: string;\n  baseStyle: CSSProperties;\n  hoverStyle?: CSSProperties;\n  feedbackStyle?: CSSProperties;\n  ariaLabel?: string;\n}\n\nfunction DroppableContainer({\n  id,\n  children,\n  testId,\n  baseStyle,\n  hoverStyle,\n  feedbackStyle,\n  ariaLabel,\n}: DroppableContainerProps) {\n  const { setNodeRef, isOver, active } = useDroppable({ id });\n  const showHover = isOver && active !== null;\n\n  const style: CSSProperties = {\n    ...baseStyle,\n    ...(showHover && hoverStyle ? hoverStyle : {}),\n    ...(feedbackStyle ?? {}),\n  };\n\n  return (\n    <div\n      ref={setNodeRef}\n      data-testid={testId}\n      data-drop-id={id}\n      data-drop-over={showHover ? 'true' : 'false'}\n      aria-label={ariaLabel}\n      style={style}\n    >\n      {children}\n    </div>\n  );\n}\n\nconst bankBaseStyle: CSSProperties = {\n  display: 'flex',\n  flexWrap: 'wrap',\n  gap: 'var(--space-2)',\n  minHeight: 56,\n  padding: 'var(--space-3)',\n  borderRadius: 'var(--radius-md)',\n  borderWidth: 1,\n  borderStyle: 'dashed',\n  borderColor: 'var(--border-strong)',\n  background: 'var(--bg-subtle)',\n};\n\nconst zoneBaseStyle: CSSProperties = {\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-2)',\n  minHeight: 96,\n  padding: 'var(--space-3)',\n  borderRadius: 'var(--radius-md)',\n  borderWidth: 1,\n  borderStyle: 'solid',\n  borderColor: 'var(--border-strong)',\n  background: 'var(--bg-elevated)',\n};\n\nconst zoneLabelStyle: CSSProperties = {\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text-secondary)',\n  fontWeight: 500,\n  marginBottom: 4,\n};\n\nconst zoneItemsStyle: CSSProperties = {\n  display: 'flex',\n  flexWrap: 'wrap',\n  gap: 'var(--space-2)',\n  flex: 1,\n};\n\nconst zoneEmptyHintStyle: CSSProperties = {\n  fontSize: 'var(--fs-xs)',\n  color: 'var(--text-quaternary)',\n  fontStyle: 'italic',\n};\n\nconst hoverStyle: CSSProperties = {\n  background: 'var(--accent-subtle)',\n  borderColor: 'var(--accent-border)',\n};\n\nfunction zoneFeedbackStyle(state: 'correct' | 'incorrect' | 'idle'): CSSProperties {\n  if (state === 'correct') {\n    return {\n      background: 'var(--success-subtle)',\n      borderColor: 'var(--success-border)',\n    };\n  }\n  if (state === 'incorrect') {\n    return {\n      background: 'var(--danger-subtle)',\n      borderColor: 'var(--danger-border)',\n    };\n  }\n  return {};\n}\n\nfunction buildInitialPlacement(data: DragMatchData): DragMatchPlacement {\n  const out: DragMatchPlacement = {};\n  out[DRAG_MATCH_BANK_ID] = data.items.map((i) => i.id);\n  for (const z of data.zones) out[z.id] = [];\n  return out;\n}\n\nexport function DragMatchWidget({\n  data: rawData,\n  progressKey,\n  onComplete,\n}: DragMatchWidgetProps) {\n  const data = useMemo(() => DragMatchDataSchema.parse(rawData), [rawData]);\n\n  const [placement, setPlacement] = useState<DragMatchPlacement>(() =>\n    buildInitialPlacement(data),\n  );\n  const [submitted, setSubmitted] = useState(false);\n  const [activeId, setActiveId] = useState<string | null>(null);\n  const completedOnceRef = useRef(false);\n\n  const onCompleteRef = useRef(onComplete);\n  useEffect(() => {\n    onCompleteRef.current = onComplete;\n  }, [onComplete]);\n\n  const itemById = useMemo(() => {\n    const m = new Map<string, DragMatchItem>();\n    for (const it of data.items) m.set(it.id, it);\n    return m;\n  }, [data.items]);\n\n  const expectedZoneLabelByItem = useMemo(() => {\n    const m = new Map<string, string>();\n    for (const z of data.zones) {\n      for (const itemId of z.accepts) m.set(itemId, z.label);\n    }\n    return m;\n  }, [data.zones]);\n\n  const sensors = useSensors(\n    useSensor(PointerSensor, {\n      activationConstraint: { distance: 4 },\n    }),\n    useSensor(KeyboardSensor),\n  );\n\n  const validation = useMemo(\n    () => (submitted ? validateDragMatch(data, placement) : null),\n    [submitted, data, placement],\n  );\n\n  const allCorrect = validation?.allCorrect ?? false;\n\n  const handleDragStart = useCallback((event: DragStartEvent) => {\n    setActiveId(String(event.active.id));\n  }, []);\n\n  const handleDragEnd = useCallback(\n    (event: DragEndEvent) => {\n      setActiveId(null);\n      const { active, over } = event;\n      if (!over) return;\n      const itemId = String(active.id);\n      const targetId = String(over.id);\n\n      setPlacement((prev) => {\n        const next: DragMatchPlacement = {};\n        for (const k of Object.keys(prev)) next[k] = prev[k].slice();\n\n        let sourceContainer: string | null = null;\n        for (const k of Object.keys(next)) {\n          if (next[k].includes(itemId)) {\n            sourceContainer = k;\n            break;\n          }\n        }\n        if (!sourceContainer) return prev;\n        if (sourceContainer === targetId) return prev;\n\n        next[sourceContainer] = next[sourceContainer].filter((id) => id !== itemId);\n\n        if (!next[targetId]) next[targetId] = [];\n\n        const targetIsZone = data.zones.some((z) => z.id === targetId);\n        if (targetIsZone && !data.multipleItemsPerZone) {\n          // single-item-per-zone: move existing occupants back to bank\n          const displaced = next[targetId];\n          if (displaced.length > 0) {\n            next[DRAG_MATCH_BANK_ID] = [\n              ...(next[DRAG_MATCH_BANK_ID] ?? []),\n              ...displaced,\n            ];\n          }\n          next[targetId] = [itemId];\n        } else {\n          next[targetId] = [...next[targetId], itemId];\n        }\n        return next;\n      });\n\n      if (submitted) setSubmitted(false);\n    },\n    [data, submitted],\n  );\n\n  const handleDragCancel = useCallback(() => {\n    setActiveId(null);\n  }, []);\n\n  const handleSubmit = useCallback(() => {\n    setSubmitted(true);\n    const result = validateDragMatch(data, placement);\n    if (result.allCorrect && !completedOnceRef.current) {\n      completedOnceRef.current = true;\n      if (progressKey) void patchSectionDone(progressKey);\n      onCompleteRef.current?.();\n    }\n  }, [data, placement, progressKey]);\n\n  const handleReset = useCallback(() => {\n    setPlacement(buildInitialPlacement(data));\n    setSubmitted(false);\n  }, [data]);\n\n  const bankItems = placement[DRAG_MATCH_BANK_ID] ?? [];\n  const allPlaced = bankItems.length === 0;\n\n  const submitDisabled = submitted ? false : !allPlaced;\n  const submitButtonStyle: CSSProperties = useMemo(() => {\n    if (submitted && allCorrect) {\n      return {\n        ...submitButtonBase,\n        background: 'transparent',\n        border: '1px solid var(--success-border)',\n        color: 'var(--success)',\n        cursor: 'default',\n      };\n    }\n    if (submitted) {\n      return {\n        ...submitButtonBase,\n        background: 'transparent',\n        color: 'var(--text-secondary)',\n        border: '1px solid var(--border-strong)',\n      };\n    }\n    return {\n      ...submitButtonBase,\n      background: submitDisabled ? 'var(--bg-active)' : 'var(--accent)',\n      color: submitDisabled ? 'var(--text-tertiary)' : 'var(--text-on-accent)',\n      cursor: submitDisabled ? 'not-allowed' : 'pointer',\n      opacity: submitDisabled ? 0.7 : 1,\n    };\n  }, [submitted, allCorrect, submitDisabled]);\n\n  function renderItem(itemId: string, opts: { inOverlay?: boolean } = {}) {\n    const item = itemById.get(itemId);\n    if (!item) return null;\n    const misplaced = validation?.misplacedItemIds.has(item.id) ?? false;\n    const expectedZoneLabel = expectedZoneLabelByItem.get(item.id) ?? null;\n    if (opts.inOverlay) {\n      return (\n        <span\n          style={{\n            ...itemBaseStyle,\n            cursor: 'grabbing',\n            boxShadow: 'var(--shadow-md)',\n          }}\n        >\n          {item.label}\n        </span>\n      );\n    }\n    return (\n      <DraggableItem\n        key={item.id}\n        item={item}\n        misplaced={misplaced}\n        expectedZoneLabel={expectedZoneLabel}\n        submitted={submitted}\n        disabled={submitted && allCorrect}\n      />\n    );\n  }\n\n  return (\n    <div data-dragmatch-body style={wrapStyle}>\n      <div data-dragmatch-prompt style={promptStyle}>\n        {data.prompt}\n      </div>\n\n      <DndContext\n        sensors={sensors}\n        onDragStart={handleDragStart}\n        onDragEnd={handleDragEnd}\n        onDragCancel={handleDragCancel}\n      >\n        <div>\n          <div style={sectionLabelStyle}>Items</div>\n          <DroppableContainer\n            id={DRAG_MATCH_BANK_ID}\n            testId=\"dragmatch-bank\"\n            ariaLabel=\"Item bank\"\n            baseStyle={bankBaseStyle}\n            hoverStyle={hoverStyle}\n          >\n            {bankItems.length === 0 ? (\n              <span style={zoneEmptyHintStyle}>All items placed</span>\n            ) : (\n              bankItems.map((id) => renderItem(id))\n            )}\n          </DroppableContainer>\n        </div>\n\n        <div>\n          <div style={sectionLabelStyle}>Zones</div>\n          <div style={zonesGridStyle}>\n            {data.zones.map((zone) => {\n              const placed = placement[zone.id] ?? [];\n              const correctness = submitted\n                ? validation?.zoneCorrect[zone.id]\n                  ? 'correct'\n                  : 'incorrect'\n                : 'idle';\n              return (\n                <DroppableContainer\n                  key={zone.id}\n                  id={zone.id}\n                  testId={`dragmatch-zone-${zone.id}`}\n                  ariaLabel={`Zone: ${zone.label}`}\n                  baseStyle={zoneBaseStyle}\n                  hoverStyle={hoverStyle}\n                  feedbackStyle={zoneFeedbackStyle(correctness)}\n                >\n                  <div style={zoneLabelStyle}>{zone.label}</div>\n                  <div style={zoneItemsStyle}>\n                    {placed.length === 0 ? (\n                      <span style={zoneEmptyHintStyle}>Drop here</span>\n                    ) : (\n                      placed.map((id) => renderItem(id))\n                    )}\n                  </div>\n                </DroppableContainer>\n              );\n            })}\n          </div>\n        </div>\n\n        <DragOverlay>\n          {activeId ? renderItem(activeId, { inOverlay: true }) : null}\n        </DragOverlay>\n      </DndContext>\n\n      <div\n        style={{\n          display: 'flex',\n          alignItems: 'center',\n          gap: 'var(--space-3)',\n        }}\n      >\n        {submitted && !allCorrect ? (\n          <button\n            type=\"button\"\n            data-testid=\"dragmatch-reset\"\n            onClick={handleReset}\n            style={{\n              ...submitButtonBase,\n              background: 'transparent',\n              color: 'var(--text-secondary)',\n              border: '1px solid var(--border-strong)',\n              cursor: 'pointer',\n            }}\n          >\n            Try again\n          </button>\n        ) : null}\n        <button\n          type=\"button\"\n          data-testid=\"dragmatch-submit\"\n          onClick={handleSubmit}\n          disabled={submitDisabled}\n          aria-label={submitted && allCorrect ? 'Solved' : 'Check answers'}\n          style={submitButtonStyle}\n        >\n          {submitted && allCorrect ? (\n            <>\n              <Check size={14} aria-hidden /> Solved\n            </>\n          ) : submitted ? (\n            <>\n              <X size={14} aria-hidden /> Submit again\n            </>\n          ) : (\n            'Submit'\n          )}\n        </button>\n      </div>\n\n      {submitted && data.explanation && (\n        <Callout tone=\"info\" title=\"Explanation\">\n          {data.explanation}\n        </Callout>\n      )}\n    </div>\n  );\n}\n\nasync function patchSectionDone(key: DragMatchProgressKey): Promise<void> {\n  try {\n    await fetch('/api/progress', {\n      method: 'PATCH',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        courseSlug: key.courseSlug,\n        lessonSlug: key.lessonSlug,\n        sectionState: { [key.sectionId]: { done: true } },\n      }),\n    });\n  } catch {\n    // Persistence is non-fatal.\n  }\n}\n","numLines":606,"startLine":1,"totalLines":606}}}
