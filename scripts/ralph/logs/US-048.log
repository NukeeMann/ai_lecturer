{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VRxDFgcVEFo1FbWu4uW89Q","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport {\n4\t  useCallback,\n5\t  useMemo,\n6\t  useState,\n7\t  type CSSProperties,\n8\t} from 'react';\n9\timport { Plus, Trash2 } from 'lucide-react';\n10\timport type { z } from 'zod';\n11\t\n12\timport {\n13\t  EditorFormFooter,\n14\t  EditorFormSaveError,\n15\t  errorTextStyle,\n16\t  fieldStyle,\n17\t  formBodyStyle,\n18\t  inputStyle,\n19\t  labelStyle,\n20\t  textareaStyle,\n21\t  type FieldErrors,\n22\t} from '@/components/EditorForm';\n23\timport { SourcesField } from '@/components/Sources';\n24\timport type { Source } from '@/lib/schemas/lesson';\n25\t\n26\timport {\n27\t  DragMatchDataSchema,\n28\t  type DragMatchData,\n29\t  type DragMatchItem,\n30\t  type DragMatchZone,\n31\t} from './schema';\n32\t\n33\texport interface DragMatchEditorProps {\n34\t  initial: DragMatchData;\n35\t  initialSources?: Source[];\n36\t  onCancel: () => void;\n37\t  onSave: (next: DragMatchData, sources?: Source[]) => Promise<void>;\n38\t}\n39\t\n40\tinterface ItemRow extends DragMatchItem {\n41\t  rowId: string;\n42\t}\n43\t\n44\tinterface ZoneRow extends DragMatchZone {\n45\t  rowId: string;\n46\t}\n47\t\n48\tfunction makeRowId(): string {\n49\t  return `r-${Math.random().toString(36).slice(2, 9)}`;\n50\t}\n51\t\n52\tfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n53\t  const out: FieldErrors = {};\n54\t  for (const issue of error.issues) {\n55\t    const path = issue.path.join('.') || '_root';\n56\t    if (!out[path]) out[path] = issue.message;\n57\t  }\n58\t  return out;\n59\t}\n60\t\n61\tconst cardStyle: CSSProperties = {\n62\t  border: '1px solid var(--border)',\n63\t  borderRadius: 'var(--radius-md)',\n64\t  padding: 'var(--space-3)',\n65\t  display: 'flex',\n66\t  flexDirection: 'column',\n67\t  gap: 'var(--space-2)',\n68\t  background: 'var(--bg-elevated)',\n69\t  marginBottom: 6,\n70\t};\n71\t\n72\tconst cardHeaderStyle: CSSProperties = {\n73\t  display: 'flex',\n74\t  alignItems: 'center',\n75\t  gap: 'var(--space-2)',\n76\t};\n77\t\n78\tconst removeButtonStyle: CSSProperties = {\n79\t  width: 24,\n80\t  height: 24,\n81\t  display: 'inline-flex',\n82\t  alignItems: 'center',\n83\t  justifyContent: 'center',\n84\t  background: 'transparent',\n85\t  border: '1px solid transparent',\n86\t  borderRadius: 'var(--radius-sm)',\n87\t  color: 'var(--text-tertiary)',\n88\t  cursor: 'pointer',\n89\t  flexShrink: 0,\n90\t};\n91\t\n92\tconst addButtonStyle: CSSProperties = {\n93\t  display: 'inline-flex',\n94\t  alignItems: 'center',\n95\t  gap: 4,\n96\t  background: 'transparent',\n97\t  border: '1px dashed var(--border-strong)',\n98\t  borderRadius: 'var(--radius-md)',\n99\t  color: 'var(--text-secondary)',\n100\t  fontSize: 'var(--fs-xs)',\n101\t  fontWeight: 500,\n102\t  padding: '6px 10px',\n103\t  cursor: 'pointer',\n104\t  marginTop: 4,\n105\t};\n106\t\n107\tconst subLabelStyle: CSSProperties = {\n108\t  display: 'block',\n109\t  fontSize: '11px',\n110\t  color: 'var(--text-tertiary)',\n111\t  marginBottom: 4,\n112\t};\n113\t\n114\tconst acceptsListStyle: CSSProperties = {\n115\t  display: 'flex',\n116\t  flexWrap: 'wrap',\n117\t  gap: 4,\n118\t};\n119\t\n120\tconst chipStyle = (active: boolean): CSSProperties => ({\n121\t  display: 'inline-flex',\n122\t  alignItems: 'center',\n123\t  gap: 4,\n124\t  padding: '3px 8px',\n125\t  borderRadius: 'var(--radius-sm)',\n126\t  fontSize: 'var(--fs-xs)',\n127\t  border: '1px solid',\n128\t  borderColor: active ? 'var(--accent)' : 'var(--border-strong)',\n129\t  background: active ? 'var(--accent-subtle)' : 'var(--bg-elevated)',\n130\t  color: active ? 'var(--accent-text)' : 'var(--text-secondary)',\n131\t  cursor: 'pointer',\n132\t});\n133\t\n134\tconst toggleRowStyle: CSSProperties = {\n135\t  display: 'flex',\n136\t  alignItems: 'center',\n137\t  gap: 8,\n138\t  fontSize: 'var(--fs-sm)',\n139\t  color: 'var(--text)',\n140\t};\n141\t\n142\texport function DragMatchEditor({\n143\t  initial,\n144\t  initialSources,\n145\t  onCancel,\n146\t  onSave,\n147\t}: DragMatchEditorProps) {\n148\t  const [prompt, setPrompt] = useState<string>(initial.prompt);\n149\t  const [items, setItems] = useState<ItemRow[]>(() =>\n150\t    initial.items.map((i) => ({ ...i, rowId: makeRowId() })),\n151\t  );\n152\t  const [zones, setZones] = useState<ZoneRow[]>(() =>\n153\t    initial.zones.map((z) => ({ ...z, rowId: makeRowId() })),\n154\t  );\n155\t  const [multipleItemsPerZone, setMultipleItemsPerZone] = useState<boolean>(\n156\t    initial.multipleItemsPerZone ?? false,\n157\t  );\n158\t  const [explanation, setExplanation] = useState<string>(initial.explanation ?? '');\n159\t  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n160\t  const [errors, setErrors] = useState<FieldErrors>({});\n161\t  const [saving, setSaving] = useState(false);\n162\t  const [saveError, setSaveError] = useState<string | null>(null);\n163\t\n164\t  const current: DragMatchData = useMemo(() => {\n165\t    const obj: DragMatchData = {\n166\t      prompt,\n167\t      items: items.map((i) => ({ id: i.id, label: i.label })),\n168\t      zones: zones.map((z) => ({ id: z.id, label: z.label, accepts: z.accepts })),\n169\t      multipleItemsPerZone,\n170\t    };\n171\t    if (explanation.trim()) obj.explanation = explanation;\n172\t    return obj;\n173\t  }, [prompt, items, zones, multipleItemsPerZone, explanation]);\n174\t\n175\t  const dirty = useMemo(() => {\n176\t    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n177\t    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n178\t  }, [current, initial, sources, initialSources]);\n179\t\n180\t  const handleSave = useCallback(async () => {\n181\t    if (!dirty || saving) return;\n182\t    const result = DragMatchDataSchema.safeParse(current);\n183\t    if (!result.success) {\n184\t      setErrors(flattenIssues(result.error));\n185\t      return;\n186\t    }\n187\t    setErrors({});\n188\t    setSaveError(null);\n189\t    setSaving(true);\n190\t    try {\n191\t      await onSave(result.data, sources);\n192\t      setSaving(false);\n193\t    } catch (err) {\n194\t      setSaveError(err instanceof Error ? err.message : String(err));\n195\t      setSaving(false);\n196\t    }\n197\t  }, [current, dirty, onSave, saving, sources]);\n198\t\n199\t  const addItem = useCallback(() => {\n200\t    setItems((prev) => [\n201\t      ...prev,\n202\t      { rowId: makeRowId(), id: '', label: '' },\n203\t    ]);\n204\t  }, []);\n205\t\n206\t  const updateItem = useCallback((rowId: string, patch: Partial<ItemRow>) => {\n207\t    setItems((prev) =>\n208\t      prev.map((i) => (i.rowId === rowId ? { ...i, ...patch } : i)),\n209\t    );\n210\t  }, []);\n211\t\n212\t  const removeItem = useCallback((rowId: string) => {\n213\t    const removed = items.find((i) => i.rowId === rowId);\n214\t    setItems((prev) => prev.filter((i) => i.rowId !== rowId));\n215\t    if (removed) {\n216\t      setZones((prev) =>\n217\t        prev.map((z) => ({\n218\t          ...z,\n219\t          accepts: z.accepts.filter((id) => id !== removed.id),\n220\t        })),\n221\t      );\n222\t    }\n223\t  }, [items]);\n224\t\n225\t  const addZone = useCallback(() => {\n226\t    setZones((prev) => [\n227\t      ...prev,\n228\t      { rowId: makeRowId(), id: '', label: '', accepts: [] },\n229\t    ]);\n230\t  }, []);\n231\t\n232\t  const updateZone = useCallback((rowId: string, patch: Partial<ZoneRow>) => {\n233\t    setZones((prev) =>\n234\t      prev.map((z) => (z.rowId === rowId ? { ...z, ...patch } : z)),\n235\t    );\n236\t  }, []);\n237\t\n238\t  const removeZone = useCallback((rowId: string) => {\n239\t    setZones((prev) => prev.filter((z) => z.rowId !== rowId));\n240\t  }, []);\n241\t\n242\t  const toggleAccepts = useCallback(\n243\t    (rowId: string, itemId: string) => {\n244\t      setZones((prev) =>\n245\t        prev.map((z) => {\n246\t          if (z.rowId !== rowId) return z;\n247\t          const has = z.accepts.includes(itemId);\n248\t          return {\n249\t            ...z,\n250\t            accepts: has\n251\t              ? z.accepts.filter((id) => id !== itemId)\n252\t              : [...z.accepts, itemId],\n253\t          };\n254\t        }),\n255\t      );\n256\t    },\n257\t    [],\n258\t  );\n259\t\n260\t  return (\n261\t    <div\n262\t      data-testid=\"drag-match-editor\"\n263\t      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n264\t    >\n265\t      <div style={formBodyStyle}>\n266\t        <label style={fieldStyle}>\n267\t          <span style={labelStyle}>Prompt</span>\n268\t          <input\n269\t            type=\"text\"\n270\t            data-testid=\"dragmatch-edit-prompt\"\n271\t            value={prompt}\n272\t            onChange={(e) => setPrompt(e.target.value)}\n273\t            style={inputStyle}\n274\t          />\n275\t          {errors.prompt && <div style={errorTextStyle}>{errors.prompt}</div>}\n276\t        </label>\n277\t\n278\t        <div style={fieldStyle}>\n279\t          <span style={labelStyle}>Items</span>\n280\t          <div data-testid=\"dragmatch-edit-items\">\n281\t            {items.map((item, i) => (\n282\t              <div key={item.rowId} style={cardStyle} data-test-item-index={i}>\n283\t                <div style={cardHeaderStyle}>\n284\t                  <input\n285\t                    type=\"text\"\n286\t                    data-testid={`dragmatch-edit-item-id-${i}`}\n287\t                    value={item.id}\n288\t                    placeholder=\"itemId\"\n289\t                    onChange={(e) =>\n290\t                      updateItem(item.rowId, { id: e.target.value })\n291\t                    }\n292\t                    style={{\n293\t                      ...inputStyle,\n294\t                      flex: 1,\n295\t                      minWidth: 0,\n296\t                      fontFamily: 'var(--font-mono)',\n297\t                      fontSize: '12.5px',\n298\t                    }}\n299\t                  />\n300\t                  <button\n301\t                    type=\"button\"\n302\t                    data-testid={`dragmatch-edit-item-remove-${i}`}\n303\t                    onClick={() => removeItem(item.rowId)}\n304\t                    aria-label={`Remove item ${i + 1}`}\n305\t                    style={removeButtonStyle}\n306\t                  >\n307\t                    <Trash2 size={13} aria-hidden />\n308\t                  </button>\n309\t                </div>\n310\t                <label>\n311\t                  <span style={subLabelStyle}>Label</span>\n312\t                  <input\n313\t                    type=\"text\"\n314\t                    data-testid={`dragmatch-edit-item-label-${i}`}\n315\t                    value={item.label}\n316\t                    onChange={(e) =>\n317\t                      updateItem(item.rowId, { label: e.target.value })\n318\t                    }\n319\t                    style={inputStyle}\n320\t                  />\n321\t                </label>\n322\t              </div>\n323\t            ))}\n324\t          </div>\n325\t          <button\n326\t            type=\"button\"\n327\t            data-testid=\"dragmatch-edit-add-item\"\n328\t            onClick={addItem}\n329\t            style={addButtonStyle}\n330\t          >\n331\t            <Plus size={12} aria-hidden /> Add item\n332\t          </button>\n333\t        </div>\n334\t\n335\t        <div style={fieldStyle}>\n336\t          <span style={labelStyle}>Zones</span>\n337\t          <div data-testid=\"dragmatch-edit-zones\">\n338\t            {zones.map((zone, i) => (\n339\t              <div key={zone.rowId} style={cardStyle} data-test-zone-index={i}>\n340\t                <div style={cardHeaderStyle}>\n341\t                  <input\n342\t                    type=\"text\"\n343\t                    data-testid={`dragmatch-edit-zone-id-${i}`}\n344\t                    value={zone.id}\n345\t                    placeholder=\"zoneId\"\n346\t                    onChange={(e) =>\n347\t                      updateZone(zone.rowId, { id: e.target.value })\n348\t                    }\n349\t                    style={{\n350\t                      ...inputStyle,\n351\t                      flex: 1,\n352\t                      minWidth: 0,\n353\t                      fontFamily: 'var(--font-mono)',\n354\t                      fontSize: '12.5px',\n355\t                    }}\n356\t                  />\n357\t                  <button\n358\t                    type=\"button\"\n359\t                    data-testid={`dragmatch-edit-zone-remove-${i}`}\n360\t                    onClick={() => removeZone(zone.rowId)}\n361\t                    aria-label={`Remove zone ${i + 1}`}\n362\t                    style={removeButtonStyle}\n363\t                  >\n364\t                    <Trash2 size={13} aria-hidden />\n365\t                  </button>\n366\t                </div>\n367\t                <label>\n368\t                  <span style={subLabelStyle}>Label</span>\n369\t                  <input\n370\t                    type=\"text\"\n371\t                    data-testid={`dragmatch-edit-zone-label-${i}`}\n372\t                    value={zone.label}\n373\t                    onChange={(e) =>\n374\t                      updateZone(zone.rowId, { label: e.target.value })\n375\t                    }\n376\t                    style={inputStyle}\n377\t                  />\n378\t                </label>\n379\t                <div>\n380\t                  <span style={subLabelStyle}>Accepts (click items)</span>\n381\t                  <div style={acceptsListStyle}>\n382\t                    {items.length === 0 ? (\n383\t                      <span style={{ ...subLabelStyle, marginBottom: 0 }}>\n384\t                        Add items first\n385\t                      </span>\n386\t                    ) : (\n387\t                      items.map((it, j) => {\n388\t                        const active = zone.accepts.includes(it.id);\n389\t                        return (\n390\t                          <button\n391\t                            key={it.rowId}\n392\t                            type=\"button\"\n393\t                            data-testid={`dragmatch-edit-accepts-${i}-${j}`}\n394\t                            data-active={active ? 'true' : 'false'}\n395\t                            onClick={() => toggleAccepts(zone.rowId, it.id)}\n396\t                            style={chipStyle(active)}\n397\t                            disabled={!it.id}\n398\t                          >\n399\t                            {it.label || it.id || `(item ${j + 1})`}\n400\t                          </button>\n401\t                        );\n402\t                      })\n403\t                    )}\n404\t                  </div>\n405\t                </div>\n406\t              </div>\n407\t            ))}\n408\t          </div>\n409\t          <button\n410\t            type=\"button\"\n411\t            data-testid=\"dragmatch-edit-add-zone\"\n412\t            onClick={addZone}\n413\t            style={addButtonStyle}\n414\t          >\n415\t            <Plus size={12} aria-hidden /> Add zone\n416\t          </button>\n417\t        </div>\n418\t\n419\t        <label style={{ ...fieldStyle, ...toggleRowStyle }}>\n420\t          <input\n421\t            type=\"checkbox\"\n422\t            data-testid=\"dragmatch-edit-multiple\"\n423\t            checked={multipleItemsPerZone}\n424\t            onChange={(e) => setMultipleItemsPerZone(e.target.checked)}\n425\t          />\n426\t          <span>Allow multiple items per zone (ordering matters)</span>\n427\t        </label>\n428\t\n429\t        <label style={fieldStyle}>\n430\t          <span style={labelStyle}>Explanation (optional)</span>\n431\t          <textarea\n432\t            data-testid=\"dragmatch-edit-explanation\"\n433\t            value={explanation}\n434\t            onChange={(e) => setExplanation(e.target.value)}\n435\t            style={{ ...textareaStyle, minHeight: 70 }}\n436\t          />\n437\t        </label>\n438\t\n439\t        <SourcesField sources={sources} onChange={setSources} />\n440\t\n441\t        {errors._root && <div style={errorTextStyle}>{errors._root}</div>}\n442\t      </div>\n443\t\n444\t      <EditorFormSaveError message={saveError} />\n445\t      <EditorFormFooter\n446\t        saving={saving}\n447\t        saveDisabled={!dirty}\n448\t        onCancel={onCancel}\n449\t        onSave={() => void handleSave()}\n450\t        cancelTestId=\"dragmatch-edit-cancel\"\n451\t        saveTestId=\"dragmatch-edit-save\"\n452\t      />\n453\t    </div>\n454\t  );\n455\t}\n456\t"}]},"parent_tool_use_id":null,"session_id":"46b898f2-0f25-403b-8a34-d68b7e60e547","uuid":"9f0c90b5-aa78-4010-ba32-6cde38be0928","timestamp":"2026-05-03T22:18:07.427Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-048/src/widgets/DragMatch/DragMatchEditor.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useMemo,\n  useState,\n  type CSSProperties,\n} from 'react';\nimport { Plus, Trash2 } from 'lucide-react';\nimport type { z } from 'zod';\n\nimport {\n  EditorFormFooter,\n  EditorFormSaveError,\n  errorTextStyle,\n  fieldStyle,\n  formBodyStyle,\n  inputStyle,\n  labelStyle,\n  textareaStyle,\n  type FieldErrors,\n} from '@/components/EditorForm';\nimport { SourcesField } from '@/components/Sources';\nimport type { Source } from '@/lib/schemas/lesson';\n\nimport {\n  DragMatchDataSchema,\n  type DragMatchData,\n  type DragMatchItem,\n  type DragMatchZone,\n} from './schema';\n\nexport interface DragMatchEditorProps {\n  initial: DragMatchData;\n  initialSources?: Source[];\n  onCancel: () => void;\n  onSave: (next: DragMatchData, sources?: Source[]) => Promise<void>;\n}\n\ninterface ItemRow extends DragMatchItem {\n  rowId: string;\n}\n\ninterface ZoneRow extends DragMatchZone {\n  rowId: string;\n}\n\nfunction makeRowId(): string {\n  return `r-${Math.random().toString(36).slice(2, 9)}`;\n}\n\nfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n  const out: FieldErrors = {};\n  for (const issue of error.issues) {\n    const path = issue.path.join('.') || '_root';\n    if (!out[path]) out[path] = issue.message;\n  }\n  return out;\n}\n\nconst cardStyle: CSSProperties = {\n  border: '1px solid var(--border)',\n  borderRadius: 'var(--radius-md)',\n  padding: 'var(--space-3)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-2)',\n  background: 'var(--bg-elevated)',\n  marginBottom: 6,\n};\n\nconst cardHeaderStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  gap: 'var(--space-2)',\n};\n\nconst removeButtonStyle: CSSProperties = {\n  width: 24,\n  height: 24,\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  background: 'transparent',\n  border: '1px solid transparent',\n  borderRadius: 'var(--radius-sm)',\n  color: 'var(--text-tertiary)',\n  cursor: 'pointer',\n  flexShrink: 0,\n};\n\nconst addButtonStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 4,\n  background: 'transparent',\n  border: '1px dashed var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  color: 'var(--text-secondary)',\n  fontSize: 'var(--fs-xs)',\n  fontWeight: 500,\n  padding: '6px 10px',\n  cursor: 'pointer',\n  marginTop: 4,\n};\n\nconst subLabelStyle: CSSProperties = {\n  display: 'block',\n  fontSize: '11px',\n  color: 'var(--text-tertiary)',\n  marginBottom: 4,\n};\n\nconst acceptsListStyle: CSSProperties = {\n  display: 'flex',\n  flexWrap: 'wrap',\n  gap: 4,\n};\n\nconst chipStyle = (active: boolean): CSSProperties => ({\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 4,\n  padding: '3px 8px',\n  borderRadius: 'var(--radius-sm)',\n  fontSize: 'var(--fs-xs)',\n  border: '1px solid',\n  borderColor: active ? 'var(--accent)' : 'var(--border-strong)',\n  background: active ? 'var(--accent-subtle)' : 'var(--bg-elevated)',\n  color: active ? 'var(--accent-text)' : 'var(--text-secondary)',\n  cursor: 'pointer',\n});\n\nconst toggleRowStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  gap: 8,\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text)',\n};\n\nexport function DragMatchEditor({\n  initial,\n  initialSources,\n  onCancel,\n  onSave,\n}: DragMatchEditorProps) {\n  const [prompt, setPrompt] = useState<string>(initial.prompt);\n  const [items, setItems] = useState<ItemRow[]>(() =>\n    initial.items.map((i) => ({ ...i, rowId: makeRowId() })),\n  );\n  const [zones, setZones] = useState<ZoneRow[]>(() =>\n    initial.zones.map((z) => ({ ...z, rowId: makeRowId() })),\n  );\n  const [multipleItemsPerZone, setMultipleItemsPerZone] = useState<boolean>(\n    initial.multipleItemsPerZone ?? false,\n  );\n  const [explanation, setExplanation] = useState<string>(initial.explanation ?? '');\n  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n  const [errors, setErrors] = useState<FieldErrors>({});\n  const [saving, setSaving] = useState(false);\n  const [saveError, setSaveError] = useState<string | null>(null);\n\n  const current: DragMatchData = useMemo(() => {\n    const obj: DragMatchData = {\n      prompt,\n      items: items.map((i) => ({ id: i.id, label: i.label })),\n      zones: zones.map((z) => ({ id: z.id, label: z.label, accepts: z.accepts })),\n      multipleItemsPerZone,\n    };\n    if (explanation.trim()) obj.explanation = explanation;\n    return obj;\n  }, [prompt, items, zones, multipleItemsPerZone, explanation]);\n\n  const dirty = useMemo(() => {\n    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n  }, [current, initial, sources, initialSources]);\n\n  const handleSave = useCallback(async () => {\n    if (!dirty || saving) return;\n    const result = DragMatchDataSchema.safeParse(current);\n    if (!result.success) {\n      setErrors(flattenIssues(result.error));\n      return;\n    }\n    setErrors({});\n    setSaveError(null);\n    setSaving(true);\n    try {\n      await onSave(result.data, sources);\n      setSaving(false);\n    } catch (err) {\n      setSaveError(err instanceof Error ? err.message : String(err));\n      setSaving(false);\n    }\n  }, [current, dirty, onSave, saving, sources]);\n\n  const addItem = useCallback(() => {\n    setItems((prev) => [\n      ...prev,\n      { rowId: makeRowId(), id: '', label: '' },\n    ]);\n  }, []);\n\n  const updateItem = useCallback((rowId: string, patch: Partial<ItemRow>) => {\n    setItems((prev) =>\n      prev.map((i) => (i.rowId === rowId ? { ...i, ...patch } : i)),\n    );\n  }, []);\n\n  const removeItem = useCallback((rowId: string) => {\n    const removed = items.find((i) => i.rowId === rowId);\n    setItems((prev) => prev.filter((i) => i.rowId !== rowId));\n    if (removed) {\n      setZones((prev) =>\n        prev.map((z) => ({\n          ...z,\n          accepts: z.accepts.filter((id) => id !== removed.id),\n        })),\n      );\n    }\n  }, [items]);\n\n  const addZone = useCallback(() => {\n    setZones((prev) => [\n      ...prev,\n      { rowId: makeRowId(), id: '', label: '', accepts: [] },\n    ]);\n  }, []);\n\n  const updateZone = useCallback((rowId: string, patch: Partial<ZoneRow>) => {\n    setZones((prev) =>\n      prev.map((z) => (z.rowId === rowId ? { ...z, ...patch } : z)),\n    );\n  }, []);\n\n  const removeZone = useCallback((rowId: string) => {\n    setZones((prev) => prev.filter((z) => z.rowId !== rowId));\n  }, []);\n\n  const toggleAccepts = useCallback(\n    (rowId: string, itemId: string) => {\n      setZones((prev) =>\n        prev.map((z) => {\n          if (z.rowId !== rowId) return z;\n          const has = z.accepts.includes(itemId);\n          return {\n            ...z,\n            accepts: has\n              ? z.accepts.filter((id) => id !== itemId)\n              : [...z.accepts, itemId],\n          };\n        }),\n      );\n    },\n    [],\n  );\n\n  return (\n    <div\n      data-testid=\"drag-match-editor\"\n      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n    >\n      <div style={formBodyStyle}>\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Prompt</span>\n          <input\n            type=\"text\"\n            data-testid=\"dragmatch-edit-prompt\"\n            value={prompt}\n            onChange={(e) => setPrompt(e.target.value)}\n            style={inputStyle}\n          />\n          {errors.prompt && <div style={errorTextStyle}>{errors.prompt}</div>}\n        </label>\n\n        <div style={fieldStyle}>\n          <span style={labelStyle}>Items</span>\n          <div data-testid=\"dragmatch-edit-items\">\n            {items.map((item, i) => (\n              <div key={item.rowId} style={cardStyle} data-test-item-index={i}>\n                <div style={cardHeaderStyle}>\n                  <input\n                    type=\"text\"\n                    data-testid={`dragmatch-edit-item-id-${i}`}\n                    value={item.id}\n                    placeholder=\"itemId\"\n                    onChange={(e) =>\n                      updateItem(item.rowId, { id: e.target.value })\n                    }\n                    style={{\n                      ...inputStyle,\n                      flex: 1,\n                      minWidth: 0,\n                      fontFamily: 'var(--font-mono)',\n                      fontSize: '12.5px',\n                    }}\n                  />\n                  <button\n                    type=\"button\"\n                    data-testid={`dragmatch-edit-item-remove-${i}`}\n                    onClick={() => removeItem(item.rowId)}\n                    aria-label={`Remove item ${i + 1}`}\n                    style={removeButtonStyle}\n                  >\n                    <Trash2 size={13} aria-hidden />\n                  </button>\n                </div>\n                <label>\n                  <span style={subLabelStyle}>Label</span>\n                  <input\n                    type=\"text\"\n                    data-testid={`dragmatch-edit-item-label-${i}`}\n                    value={item.label}\n                    onChange={(e) =>\n                      updateItem(item.rowId, { label: e.target.value })\n                    }\n                    style={inputStyle}\n                  />\n                </label>\n              </div>\n            ))}\n          </div>\n          <button\n            type=\"button\"\n            data-testid=\"dragmatch-edit-add-item\"\n            onClick={addItem}\n            style={addButtonStyle}\n          >\n            <Plus size={12} aria-hidden /> Add item\n          </button>\n        </div>\n\n        <div style={fieldStyle}>\n          <span style={labelStyle}>Zones</span>\n          <div data-testid=\"dragmatch-edit-zones\">\n            {zones.map((zone, i) => (\n              <div key={zone.rowId} style={cardStyle} data-test-zone-index={i}>\n                <div style={cardHeaderStyle}>\n                  <input\n                    type=\"text\"\n                    data-testid={`dragmatch-edit-zone-id-${i}`}\n                    value={zone.id}\n                    placeholder=\"zoneId\"\n                    onChange={(e) =>\n                      updateZone(zone.rowId, { id: e.target.value })\n                    }\n                    style={{\n                      ...inputStyle,\n                      flex: 1,\n                      minWidth: 0,\n                      fontFamily: 'var(--font-mono)',\n                      fontSize: '12.5px',\n                    }}\n                  />\n                  <button\n                    type=\"button\"\n                    data-testid={`dragmatch-edit-zone-remove-${i}`}\n                    onClick={() => removeZone(zone.rowId)}\n                    aria-label={`Remove zone ${i + 1}`}\n                    style={removeButtonStyle}\n                  >\n                    <Trash2 size={13} aria-hidden />\n                  </button>\n                </div>\n                <label>\n                  <span style={subLabelStyle}>Label</span>\n                  <input\n                    type=\"text\"\n                    data-testid={`dragmatch-edit-zone-label-${i}`}\n                    value={zone.label}\n                    onChange={(e) =>\n                      updateZone(zone.rowId, { label: e.target.value })\n                    }\n                    style={inputStyle}\n                  />\n                </label>\n                <div>\n                  <span style={subLabelStyle}>Accepts (click items)</span>\n                  <div style={acceptsListStyle}>\n                    {items.length === 0 ? (\n                      <span style={{ ...subLabelStyle, marginBottom: 0 }}>\n                        Add items first\n                      </span>\n                    ) : (\n                      items.map((it, j) => {\n                        const active = zone.accepts.includes(it.id);\n                        return (\n                          <button\n                            key={it.rowId}\n                            type=\"button\"\n                            data-testid={`dragmatch-edit-accepts-${i}-${j}`}\n                            data-active={active ? 'true' : 'false'}\n                            onClick={() => toggleAccepts(zone.rowId, it.id)}\n                            style={chipStyle(active)}\n                            disabled={!it.id}\n                          >\n                            {it.label || it.id || `(item ${j + 1})`}\n                          </button>\n                        );\n                      })\n                    )}\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n          <button\n            type=\"button\"\n            data-testid=\"dragmatch-edit-add-zone\"\n            onClick={addZone}\n            style={addButtonStyle}\n          >\n            <Plus size={12} aria-hidden /> Add zone\n          </button>\n        </div>\n\n        <label style={{ ...fieldStyle, ...toggleRowStyle }}>\n          <input\n            type=\"checkbox\"\n            data-testid=\"dragmatch-edit-multiple\"\n            checked={multipleItemsPerZone}\n            onChange={(e) => setMultipleItemsPerZone(e.target.checked)}\n          />\n          <span>Allow multiple items per zone (ordering matters)</span>\n        </label>\n\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Explanation (optional)</span>\n          <textarea\n            data-testid=\"dragmatch-edit-explanation\"\n            value={explanation}\n            onChange={(e) => setExplanation(e.target.value)}\n            style={{ ...textareaStyle, minHeight: 70 }}\n          />\n        </label>\n\n        <SourcesField sources={sources} onChange={setSources} />\n\n        {errors._root && <div style={errorTextStyle}>{errors._root}</div>}\n      </div>\n\n      <EditorFormSaveError message={saveError} />\n      <EditorFormFooter\n        saving={saving}\n        saveDisabled={!dirty}\n        onCancel={onCancel}\n        onSave={() => void handleSave()}\n        cancelTestId=\"dragmatch-edit-cancel\"\n        saveTestId=\"dragmatch-edit-save\"\n      />\n    </div>\n  );\n}\n","numLines":456,"startLine":1,"totalLines":456}}}
