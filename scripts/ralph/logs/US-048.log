oken)).toThrow();\n48\t  });\n49\t\n50\t  it('defaults schemaVersion to 1 when missing', () => {\n51\t    const parsed = CourseSchema.parse(minimal);\n52\t    expect(parsed.schemaVersion).toBe(1);\n53\t  });\n54\t\n55\t  it('parses successfully when schemaVersion: 1 is present', () => {\n56\t    const parsed = CourseSchema.parse({ ...minimal, schemaVersion: 1 });\n57\t    expect(parsed.schemaVersion).toBe(1);\n58\t  });\n59\t});\n60\t"}]},"parent_tool_use_id":null,"session_id":"46b898f2-0f25-403b-8a34-d68b7e60e547","uuid":"1ba40b9f-3e0a-4974-9a14-2c5c7b7bae34","timestamp":"2026-05-03T22:19:04.094Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-048/src/lib/schemas/schemas.test.ts","content":"import { describe, expect, it } from 'vitest';\n\nimport { CourseSchema } from '@/lib/schemas/course';\nimport { LessonSchema, SectionSchema } from '@/lib/schemas/lesson';\nimport { ProgressSchema } from '@/lib/schemas/progress';\nimport { CourseSpecSchema } from '@/lib/schemas/courseSpec';\nimport { TheoryDataSchema } from '@/widgets/Theory/schema';\nimport { QuizDataSchema } from '@/widgets/Quiz/schema';\nimport { CodeDataSchema } from '@/widgets/Code/schema';\nimport {\n  CodeClozeDataSchema,\n  validateSlotValue,\n} from '@/widgets/CodeCloze/schema';\nimport { DemoDataSchema } from '@/widgets/Demo/schema';\nimport {\n  DragMatchDataSchema,\n  validateDragMatch,\n  type DragMatchData,\n} from '@/widgets/DragMatch/schema';\nimport { SandboxDataSchema } from '@/widgets/Sandbox/schema';\nimport { ParametricExplorerDataSchema } from '@/widgets/ParametricExplorer/schema';\nimport { PlotImageDataSchema } from '@/widgets/PlotImage/schema';\n\ndescribe('CourseSchema', () => {\n  const minimal = {\n    slug: 'algebra',\n    title: 'Algebra',\n    description: 'Intro to algebra',\n    accentColor: 'indigo',\n    icon: 'sigma',\n    modules: [],\n    createdAt: '2026-04-30T00:00:00Z',\n    updatedAt: '2026-04-30T00:00:00Z',\n  };\