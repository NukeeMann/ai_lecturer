itialIconCount === 0) ok('no icons before any input (initial)');\n  else bad(`expected 0 icons initially, found ${initialIconCount}`);\n\n  const initialFeedbackCount = await page.locator('[data-cloze-feedback]').count();\n  if (initialFeedbackCount === 0) ok('no feedback comment before any input (initial)');\n  else bad(`expected 0 feedback comments initially, found ${initialFeedbackCount}`);\n\n  // === 2. Type a wrong answer in aggregator slot, blur ===\n  const aggInput = page.locator('[data-testid=\"cloze-slot-aggregator\"]');\n  await aggInput.click();\n  await aggInput.fill('avg');\n  await page.locator('body').click({ position: { x: 5, y: 5 } });\n  await page.waitForFunction(\n    () => document.querySelector('[data-testid=\"cloze-slot-aggregator\"]')?.getAttribute('data-slot-state') === 'incorrect',\n    { timeout: 3000 },\n  );\n  ok('aggregator slot transitions to incorrect after wrong answer');\n\n  // === 3. ✗ icon appears INLINE (immediately to the right of the input) ===\n  const xIconBox = await page.locator('[data-testid=\"cloze-slot-icon-aggregator\"][data-icon=\"incorrect\"]').boundingBox();\n  const aggInputBox = await aggInput.boundingBox();\n  if (!xIconBox) {\n    bad('✗ icon for aggregator slot not rendered');\n  } else if (Math.abs(xIconBox.y + xIconBox.height / 2 - (aggInputBox.y + aggInputBox.height / 2)) > aggInputBox.height) {\n    bad(`✗ icon is not vertically aligned with input (input center ${aggInputBox.y + aggInputBox.height / 2}, icon center ${xIconBox.y + xIconBox.height / 2})`);\n  } else if (xIconBox.x < aggInputBox.x + aggInputBox.width) {\n    bad(`✗ icon is not to the right of input (input right edge ${aggInputBox.x + aggInputBox.width}, icon left ${xIconBox.x})`);\n  } else if (xIconBox.x > aggInputBox.x + aggInputBox.width + 30) {\n    bad(`✗ icon is too far right of input (gap ${xIconBox.x - (aggInputBox.x + aggInputBox.width)}px)`);\n  } else {\n    ok('✗ icon renders inline immediately to the right of the input');\n  }\n\n  // === 4. Error message renders as inline `# hint` comment, NOT below input ===\n  // The aggregator slot is on line 1 of the template (line index 1; line 0 is `def box_blur(values):`).\n  const feedback = page.locator('[data-cloze-feedback]').first();\n  const feedbackCount = await page.locator('[data-cloze-feedback]').count();\n  if (feedbackCount !== 1) bad(`expected 1 feedback span, got ${feedbackCount}`);\n  else ok('exactly one feedback comment appears (one incorrect slot)');\n\n  const feedbackText = await feedback.textContent();\n  if (feedbackText && feedbackText.startsWith('  # ') && feedbackText.includes('built-in that totals an iterable')) {\n    ok(`feedback text formatted as Python comment: \"${feedbackText.trim()}\"`);\n  } else {\n    bad(`feedback text not formatted as Python comment: \"${feedbackText}\"`);\n  }\n\n  // Inline check: feedback span is on the SAME row as the input (not below)\n  const feedbackBox = await feedback.boundingBox();\n  if (!feedbackBox) {\n    bad('feedback span has no bounding box');\n  } else if (Math.abs(feedbackBox.y + feedbackBox.height / 2 - (aggInputBox.y + aggInputBox.height / 2)) > aggInputBox.height) {\n    bad(`feedback comment NOT inline (input center y=${aggInputBox.y + aggInputBox.height / 2}, feedback center y=${feedbackBox.y + feedbackBox.height / 2})`);\n  } else if (feedbackBox.x < aggInputBox.x) {\n    bad(`feedback x=${feedbackBox.x} is left of input x=${aggInputBox.x} — should be after`);\n  } else {\n    ok('feedback comment renders inline (same row as input, to the right)');\n  }\n\n  // === 5. Italic + comment color ===\n  const feedbackStyles = await feedback.evaluate((el) => {\n    const cs = getComputedStyle(el);\n    return { fontStyle: cs.fontStyle, color: cs.color };\n  });\n  if (feedbackStyles.fontStyle === 'italic') ok('feedback comment is italic (matches code-comment style)');\n  else bad(`feedback fontStyle = ${feedbackStyles.fontStyle}, expected italic`);\n\n  // === 6. Type correct answer → icon flips to ✓, feedback disappears ===\n  await aggInput.click();\n  await aggInput.fill('sum');\n  await page.locator('body').click({ position: { x: 5, y: 5 } });\n  await page.waitForFunction(\n    () => document.querySelector('[data-testid=\"cloze-slot-aggregator\"]')?.getAttribute('data-slot-state') === 'correct',\n    { timeout: 3000 },\n  );\n  ok('aggregator slot transitions to correct after right answer');\n\n  const checkBox = await page.locator('[data-testid=\"cloze-slot-icon-aggregator\"][data-icon=\"correct\"]').boundingBox();\n  const aggInputBox2 = await aggInput.boundingBox();\n  if (!checkBox) {\n    bad('✓ icon for aggregator not rendered');\n  } else if (checkBox.x < aggInputBox2.x + aggInputBox2.width || checkBox.x > aggInputBox2.x + aggInputBox2.width + 30) {\n    bad('✓ icon not inline to the right of input');\n  } else {\n    ok('✓ icon renders inline immediately to the right of the input (correct state)');\n  }\n\n  const remainingFeedback = await page.locator('[data-cloze-feedback]').count();\n  if (remainingFeedback === 0) ok('feedback comment cleared when slot becomes correct');\n  else bad(`expected 0 feedback spans, found ${remainingFeedback}`);\n\n  await page.screenshot({ path: '/tmp/US-058-correct.png', fullPage: true });\n\n  // === 7. Multiple incorrect slots / line with existing comment branch ===\n  // Re-trigger incorrect state on aggregator + put divisor wrong too.\n  await aggInput.click();\n  await aggInput.fill('avg');\n  await page.locator('body').click({ position: { x: 5, y: 5 } });\n  await page.waitForFunction(\n    () => document.querySelector('[data-testid=\"cloze-slot-aggregator\"]')?.getAttribute('data-slot-state') === 'incorrect',\n    { timeout: 3000 },\n  );\n\n  const divInput = page.locator('[data-testid=\"cloze-slot-divisor\"]');\n  await divInput.click();\n  await divInput.fill('zzz');\n  await page.locator('body').click({ position: { x: 5, y: 5 } });\n  await page.waitForFunction(\n    () => document.querySelector('[data-testid=\"cloze-slot-divisor\"]')?.getAttribute('data-slot-state') === 'incorrect',\n    { timeout: 3000 },\n  );\n\n  const totalFeedback = await page.locator('[data-cloze-feedback]').count();\n  if (totalFeedback === 2) ok('two feedback comments — one per line with an incorrect slot');\n  else bad(`expected 2 feedback spans (one per line), got ${totalFeedback}`);\n\n  // Each feedback should start with \"  # \"\n  const allFeedbackText = await page.locator('[data-cloze-feedback]').allTextContents();\n  const allHaveHash = allFeedbackText.every((t) => t.startsWith('  # '));\n  if (allHaveHash) ok(`both feedback comments use Python \"# \" prefix: ${JSON.stringify(allFeedbackText.map((s) => s.trim()))}`);\n  else bad(`some feedback missing prefix: ${JSON.stringify(allFeedbackText)}`);\n\n  await page.screenshot({ path: '/tmp/US-058-both-wrong.png', fullPage: true });\n\n  // === 8. No console errors ===\n  if (errors.length === 0) ok('no console errors during interaction');\n  else bad(`console errors: ${JSON.stringify(errors)}`);\n\n  await browser.close();\n  console.log(`\\n${pass} passed, ${fail} failed`);\n  if (fail > 0) process.exit(1);\n};\n","userModified":false}}
