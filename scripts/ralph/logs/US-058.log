t    out.push({ kind: 'text', content: template.slice(lastIndex) });\n66\t  }\n67\t  return out;\n68\t}\n69\t\n70\tconst PY_KEYWORDS = new Set([\n71\t  'False',\n72\t  'None',\n73\t  'True',\n74\t  'and',\n75\t  'as',\n76\t  'assert',\n77\t  'async',\n78\t  'await',\n79\t  'break',\n80\t  'class',\n81\t  'continue',\n82\t  'def',\n83\t  'del',\n84\t  'elif',\n85\t  'else',\n86\t  'except',\n87\t  'finally',\n88\t  'for',\n89\t  'from',\n90\t  'global',\n91\t  'if',\n92\t  'import',\n93\t  'in',\n94\t  'is',\n95\t  'lambda',\n96\t  'nonlocal',\n97\t  'not',\n98\t  'or',\n99\t  'pass',\n100\t  'raise',\n101\t  'return',\n102\t  'try',\n103\t  'while',\n104\t  'with',\n105\t  'yield',\n106\t  'self',\n107\t]);\n108\t\n109\tconst PY_BUILTINS = new Set([\n110\t  'abs',\n111\t  'all',\n112\t  'any',\n113\t  'bool',\n114\t  'dict',\n115\t  'enumerate',\n116\t  'filter',\n117\t  'float',\n118\t  'int',\n119\t  'len',\n120\t  'list',\n121\t  'map',\n122\t  'max',\n123\t  'min',\n124\t  'print',\n125\t  'range',\n126\t  'round',\n127\t  'set',\n128\t  'sorted',\n129\t  'str',\n130\t  'sum',\n131\t  'tuple',\n132\t  'type',\n133\t  'zip',\n134\t]);\n135\t\n136\ttype TokenKind = 'kw' | 'str' | 'num' | 'cm' | 'fn' | 'plain' | 'builtin';\n137\t\n138\tinterface Token {\n139\t  kind: TokenKind;\n140\t  text: string;\n141\t}\n142\t\n143\tfunction tokenizePython(src: string): Token[] {\n144\t  const tokens: Token[] = [];\n145\t  const len = src.length;\n146\t  let i = 0;\n147\t  while (i < len) {\n148\t    const c = src[i];\n149\t\n150\t    if (c === '#') {\n151\t      const j = src.indexOf('\\n', i);\n152\t      const end = j === -1 ? len : j;\n153\t      tokens.push({ kind: 'cm', text: src.slice(i, end) });\n154\t      i = end;\n155\t      continue;\n156\t    }\n157\t\n158\t    if (c === '\"' || c === \"'\") {\n159\t      const quote = c;\n160\t      let j = i + 1;\n161\t      while (j < len && src[j] !== quote) {\n162\t        if (src[j] === '\\\\' && j + 1 < len) j += 2;\n163\t        else j++;\n164\t      }\n165\t      if (j < len) j++;\n166\t      tokens.push({ kind: 'str', text: src.slice(i, j) });\n167\t      i = j;\n168\t      continue;\n169\t    }\n170\t\n171\t    if (c >= '0' && c <= '9') {\n172\t      let j = i;\n173\t      while (j < len && /[0-9._]/.test(src[j])) j++;\n174\t      tokens.push({ kind: 'num', text: src.slice(i, j) });\n175\t      i = j;\n176\t      continue;\n177\t    }\n178\t\n179\t    if (/[A-Za-z_]/.test(c)) {\n180\t      let j = i;\n181\t      while (j < len && /[A-Za-z_0-9]/.test(src[j])) j++;\n182\t      const word = src.slice(i, j);\n183\t      if (PY_KEYWORDS.has(word)) {\n184\t        tokens.push({ kind: 'kw', text: word });\n185\t      } else if (PY_BUILTINS.has(word) && src[j] === '(') {\n186\t        tokens.push({ kind: 'builtin', text: word });\n187\t      } else if (src[j] === '(') {\n188\t        tokens.push({ kind: 'fn', text: word });\n189\t      } else {\n190\t        tokens.push({ kind: 'plain', text: word });\n191\t      }\n192\t      i = j;\n193\t      continue;\n194\t    }\n195\t\n196\t    tokens.push({ kind: 'plain', text: c });\n197\t    i++;\n198\t  }\n199\t  return tokens;\n200\t}\n201\t\n202\tfunction tokenStyle(kind: TokenKind): CSSProperties | undefined {\n203\t  switch (kind) {\n204\t    case 'kw':\n205\t      return { color: 'var(--code-keyword)', fontWeight: 500 };\n206\t    case 'str':\n207\t      return { color: 'var(--code-string)' };\n208\t    case 'cm':\n209\t      return { color: 'var(--code-comment)', fontStyle: 'italic' };\n210\t    case 'num':\n211\t      return { color: 'var(--code-number)' };\n212\t    case 'fn':\n213\t    case 'builtin':\n214\t      return { color: 'var(--code-fn)' };\n215\t    default:\n216\t      return undefined;\n217\t  }\n218\t}\n219\t\n220\tfunction renderHighlighted(text: string, keyPrefix: string): ReactNode[] {\n221\t  const tokens = tokenizePython(text);\n222\t  return tokens.map((tok, i) => {\n223\t    const style = tokenStyle(tok.kind);\n224\t    if (!style) return <span key={`${keyPrefix}-${i}`}>{tok.text}</span>;\n225\t    return (\n226\t      <span key={`${keyPrefix}-${i}`} style={style}>\n227\t        {tok.text}\n228\t      </span>\n229\t    );\n230\t  });\n231\t}\n232\t\n233\tconst wrapStyle: CSSProperties = {\n234\t  display: 'flex',\n235\t  flexDirection: 'column',\n236\t};\n237\t\n238\tconst taskStyle: CSSProperties = {\n239\t  padding: 'var(--space-4) var(--space-5)',\n240\t  borderBottom: '1px solid var(--border)',\n241\t  background: 'var(--bg-elevated)',\n242\t  fontSize: 'var(--fs-sm)',\n243\t  color: 'var(--text)',\n244\t  lineHeight: 1.6,\n245\t};\n246\t\n247\tconst codeBlockStyle: CSSProperties = {\n248\t  background: 'var(--code-bg)',\n249\t  color: 'var(--code-text)',\n250\t  fontFamily: 'var(--font-mono)',\n251\t  fontSize: '13px',\n252\t  lineHeight: 1.55,\n253\t  padding: 'var(--space-4) var(--space-5)',\n254\t  whiteSpace: 'pre-wrap',\n255\t  wordBreak: 'break-word',\n256\t  margin: 0,\n257\t  overflowX: 'auto',\n258\t};\n259\t\n260\tconst slotInputBase: CSSProperties = {\n261\t  fontFamily: 'var(--font-mono)',\n262\t  fontSize: '13px',\n263\t  lineHeight: 1.55,\n264\t  padding: '0 6px',\n265\t  margin: '0 1px',\n266\t  borderRadius: 'var(--radius-sm)',\n267\t  background: 'var(--bg-elevated)',\n268\t  outline: 'none',\n269\t  verticalAlign: 'baseline',\n270\t  boxSizing: 'border-box',\n271\t  height: '1.55em',\n272\t};\n273\t\n274\tfunction slotBorder(state: SlotState): string {\n275\t  if (state === 'correct') return '1px solid var(--success-border)';\n276\t  if (state === 'incorrect') return '1px solid var(--danger-border)';\n277\t  return '1px solid var(--border-strong)';\n278\t}\n279\t\n280\tfunction slotBackground(state: SlotState): string {\n281\t  if (state === 'correct') return 'var(--success-subtle)';\n282\t  if (state === 'incorrect') return 'var(--danger-subtle)';\n283\t  return 'var(--bg-elevated)';\n284\t}\n285\t\n286\tconst slotIconStyle: CSSProperties = {\n287\t  marginLeft: 4,\n288\t  verticalAlign: 'middle',\n289\t};\n290\t\n291\tconst slotHintStyle: CSSProperties = {\n292\t  display: 'block',\n293\t  marginTop: 4,\n294\t  fontFamily: 'var(--font-sans)',\n295\t  fontSize: 'var(--fs-xs)',\n296\t  color: 'var(--danger)',\n297\t  fontStyle: 'normal',\n298\t  lineHeight: 1.4,\n299\t};\n300\t\n301\tconst footerStyle: CSSProperties = {\n302\t  display: 'flex',\n303\t  alignItems: 'center',\n304\t  justifyContent: 'space-between',\n305\t  gap: 'var(--space-3)',\n306\t  padding: 'var(--space-3) var(--space-5)',\n307\t  borderTop: '1px solid var(--border)',\n308\t  background: 'var(--bg-elevated)',\n309\t};\n310\t\n311\tconst statusLabelStyle: CSSProperties = {\n312\t  fontSize: 'var(--fs-xs)',\n313\t  fontWeight: 600,\n314\t  letterSpacing: '0.06em',\n315\t  textTransform: 'uppercase',\n316\t  color: 'var(--text-tertiary)',\n317\t};\n318\t\n319\tconst submitButtonBase: CSSProperties = {\n320\t  display: 'inline-flex',\n321\t  alignItems: 'center',\n322\t  gap: 6,\n323\t  height: 32,\n324\t  padding: '0 var(--space-4)',\n325\t  border: '1px solid transparent',\n326\t  borderRadius: 'var(--radius-md)',\n327\t  fontSize: 'var(--fs-sm)',\n328\t  fontWeight: 500,\n329\t  cursor: 'pointer',\n330\t};\n331\t\n332\tconst hintsBlockStyle: CSSProperties = {\n333\t  borderTop: '1px solid var(--border)',\n334\t  background: 'var(--bg-subtle)',\n335\t  padding: 'var(--space-3) var(--space-5)',\n336\t  display: 'flex',\n337\t  flexDirection: 'column',\n338\t  gap: 'var(--space-2)',\n339\t};\n340\t\n341\tconst hintLabelStyle: CSSProperties = {\n342\t  ...statusLabelStyle,\n343\t  marginBottom: 4,\n344\t};\n345\t\n346\tconst hintBodyStyle: CSSProperties = {\n347\t  fontSize: 'var(--fs-sm)',\n348\t  color: 'var(--text-secondary)',\n349\t  lineHeight: 1.55,\n350\t};\n351\t\n352\tconst finalTestsBlockStyle: CSSProperties = {\n353\t  borderTop: '1px solid var(--border)',\n354\t  background: 'var(--bg-subtle)',\n355\t  padding: 'var(--space-3) var(--space-5)',\n356\t  display: 'flex',\n357\t  flexDirection: 'column',\n358\t  gap: 'var(--space-2)',\n359\t};\n360\t\n361\tconst testRowStyle: CSSProperties = {\n362\t  display: 'flex',\n363\t  alignItems: 'center',\n364\t  gap: 'var(--space-2)',\n365\t  fontFamily: 'var(--font-mono)',\n366\t  fontSize: '12px',\n367\t  color: 'var(--text)',\n368\t};\n369\t\n370\tfunction widthForValue(value: string): string {\n371\t  const ch = Math.max(value.length, 4);\n372\t  return `calc(${ch}ch + 16px)`;\n373\t}\n374\t\n375\tinterface SlotInputProps {\n376\t  slot: CodeClozeSlot;\n377\t  value: string;\n378\t  state: SlotState;\n379\t  showHint: boolean;\n380\t  disabled: boolean;\n381\t  onChange: (slotId: string, value: string) => void;\n382\t  onBlur: (slotId: string) => void;\n383\t}\n384\t\n385\tfunction SlotInput({\n386\t  slot,\n387\t  value,\n388\t  state,\n389\t  showHint,\n390\t  disabled,\n391\t  onChange,\n392\t  onBlur,\n393\t}: SlotInputProps) {\n394\t  const inputStyle: CSSProperties = {\n395\t    ...slotInputBase,\n396\t    width: widthForValue(value),\n397\t    minWidth: 60,\n398\t    border: slotBorder(state),\n399\t    background: slotBackground(state),\n400\t    color: 'var(--code-text)',\n401\t  };\n402\t\n403\t  return (\n404\t    <span style={{ display: 'inline-block', verticalAlign: 'baseline' }}>\n405\t      <input\n406\t        type=\"text\"\n407\t        spellCheck={false}\n408\t        autoCorrect=\"off\"\n409\t        autoCapitalize=\"off\"\n410\t        autoComplete=\"off\"\n411\t        data-testid={`cloze-slot-${slot.id}`}\n412\t        data-slot-id={slot.id}\n413\t        data-slot-state={state}\n414\t        aria-label={`Slot ${slot.id}`}\n415\t        value={value}\n416\t        disabled={disabled}\n417\t        onChange={(e) => onChange(slot.id, e.target.value)}\n418\t        onBlur={() => onBlur(slot.id)}\n419\t        style={inputStyle}\n420\t      />\n421\t      {state === 'correct' && (\n422\t        <Check\n423\t          size={12}\n424\t          aria-hidden\n425\t          strokeWidth={2.5}\n426\t          style={{ ...slotIconStyle, color: 'var(--success)' }}\n427\t        />\n428\t      )}\n429\t      {state === 'incorrect' && (\n430\t        <X\n431\t          size={12}\n432\t          aria-hidden\n433\t          strokeWidth={2.5}\n434\t          style={{ ...slotIconStyle, color: 'var(--danger)' }}\n435\t        />\n436\t      )}\n437\t      {state === 'incorrect' && showHint && slot.hint && (\n438\t        <span data-testid={`cloze-slot-hint-${slot.id}`} style={slotHintStyle}>\n439\t          {slot.hint}\n440\t        </span>\n441\t      )}\n442\t    </span>\n443\t  );\n444\t}\n445\t\n446\texport function CodeClozeWidget({\n447\t  data: rawData,\n448\t  progressKey,\n449\t  onComplete,\n450\t}: CodeClozeWidgetProps) {\n451\t  const data = useMemo(() => CodeClozeDataSchema.parse(rawData), [rawData]);\n452\t  const segments = useMemo(() => parseTemplate(data.template), [data.template]);\n453\t\n454\t  const slotById = useMemo(() => {\n455\t    const m = new Map<string, CodeClozeSlot>();\n456\t    for (const s of data.slots) m.set(s.id, s);\n457\t    return m;\n458\t  }, [data.slots]);\n459\t\n460\t  const initialValues = useMemo(() => {\n461\t    const out: Record<string, string> = {};\n462\t    for (const s of data.slots) out[s.id] = '';\n463\t    return out;\n464\t  }, [data.slots]);\n465\t\n466\t  const initialStates = useMemo(() => {\n467\t    const out: Record<string, SlotState> = {};\n468\t    for (const s of data.slots) out[s.id] = 'idle';\n469\t    return out;\n470\t  }, [data.slots]);\n471\t\n472\t  const [values, setValues] = useState<Record<string, string>>(initialValues);\n473\t  const [slotStates, setSlotStates] =\n474\t    useState<Record<string, SlotState>>(initialStates);\n475\t  const [failedAttempts, setFailedAttempts] = useState(0);\n476\t  const [submission, setSubmission] = useState<\n477\t    'idle' | 'running' | 'pass' | 'fail'\n478\t  >('idle');\n479\t  const [testResults, setTestResults] = useState<TestResult[] | null>(null);\n480\t  const [traceback, setTraceback] = useState<string | null>(null);\n481\t\n482\t  const onCompleteRef = useRef(onComplete);\n483\t  useEffect(() => {\n484\t    onCompleteRef.current = onComplete;\n485\t  }, [onComplete]);\n486\t\n487\t  const { status, runWithTests } = usePyodide();\n488\t\n489\t  const finalTests = useMemo(() => data.finalTests ?? [], [data.finalTests]);\n490\t  const hints = useMemo(() => data.hints ?? [], [data.hints]);\n491\t\n492\t  const allSlotsCorrect =\n493\t    data.slots.length > 0 &&\n494\t    data.slots.every((s) => slotStates[s.id] === 'correct');\n495\t\n496\t  const revealedHints = useMemo(() => {\n497\t    return hints.filter((h) => failedAttempts >= h.revealAfterAttempts);\n498\t  }, [hints, failedAttempts]);\n499\t\n500\t  const handleChange = useCallback((slotId: string, next: string) => {\n501\t    setValues((prev) => ({ ...prev, [slotId]: next }));\n502\t    setSlotStates((prev) => {\n503\t      if (prev[slotId] === 'idle') return prev;\n504\t      return { ...prev, [slotId]: 'idle' };\n505\t    });\n506\t  }, []);\n507\t\n508\t  const handleBlur = useCallback(\n509\t    (slotId: string) => {\n510\t      const slot = slotById.get(slotId);\n511\t      if (!slot) return;\n512\t      const value = values[slotId] ?? '';\n513\t      if (value.length === 0) {\n514\t        setSlotStates((prev) =>\n515\t          prev[slotId] === 'idle' ? prev : { ...prev, [slotId]: 'idle' },\n516\t        );\n517\t        return;\n518\t      }\n519\t      const ok = validateSlotValue(slot.validation, value);\n520\t      setSlotStates((prev) => ({\n521\t        ...prev,\n522\t        [slotId]: ok ? 'correct' : 'incorrect',\n523\t      }));\n524\t      if (!ok) {\n525\t        setFailedAttempts((n) => n + 1);\n526\t      }\n527\t    },\n528\t    [slotById, values],\n529\t  );\n530\t\n531\t  const assembleCode = useCallback((): string => {\n532\t    return data.template.replace(SLOT_PATTERN, (_match, slotId: string) => {\n533\t      return values[slotId] ?? '';\n534\t    });\n535\t  }, [data.template, values]);\n536\t\n537\t  const runFinalTests = useCallback(async () => {\n538\t    if (status !== 'ready') return;\n539\t    if (finalTests.length === 0) {\n540\t      setSubmission('pass');\n541\t      if (progressKey) void patchSectionDone(progressKey);\n542\t      onCompleteRef.current?.();\n543\t      return;\n544\t    }\n545\t    setSubmission('running');\n546\t    setTraceback(null);\n547\t    setTestResults(null);\n548\t    try {\n549\t      const result: RunWithTestsResult = await runWithTests(\n550\t        assembleCode(),\n551\t        finalTests.map((t) => ({ name: t.name, body: t.body })),\n552\t      );\n553\t      const tr = result.testResults ?? [];\n554\t      setTestResults(tr);\n555\t      setTraceback(result.traceback ?? null);\n556\t      const passed = tr.length > 0 && tr.every((r) => r.passed);\n557\t      if (passed) {\n558\t        setSubmission('pass');\n559\t        if (progressKey) void patchSectionDone(progressKey);\n560\t        onCompleteRef.current?.();\n561\t      } else {\n562\t        setSubmission('fail');\n563\t      }\n564\t    } catch (err) {\n565\t      if (err instanceof PyodideStopError) {\n566\t        setSubmission('idle');\n567\t        return;\n568\t      }\n569\t      setTraceback(err instanceof Error ? err.message : String(err));\n570\t      setSubmission('fail');\n571\t    }\n572\t  }, [assembleCode, finalTests, progressKey, runWithTests, status]);\n573\t\n574\t  const submitDisabled =\n575\t    !allSlotsCorrect ||\n576\t    submission === 'running' ||\n577\t    submission === 'pass' ||\n578\t    (finalTests.length > 0 && status !== 'ready');\n579\t\n580\t  const submitButtonStyle: CSSProperties = useMemo(() => {\n581\t    if (submission === 'pass') {\n582\t      return {\n583\t        ...submitButtonBase,\n584\t        background: 'transparent',\n585\t        border: '1px solid var(--success-border)',\n586\t        color: 'var(--success)',\n587\t        cursor: 'default',\n588\t      };\n589\t    }\n590\t    return {\n591\t      ...submitButtonBase,\n592\t      background: submitDisabled ? 'var(--bg-active)' : 'var(--accent)',\n593\t      color: submitDisabled ? 'var(--text-tertiary)' : 'var(--text-on-accent)',\n594\t      cursor: submitDisabled ? 'not-allowed' : 'pointer',\n595\t      opacity: submitDisabled ? 0.7 : 1,\n596\t    };\n597\t  }, [submission, submitDisabled]);\n598\t\n599\t  const slotsCorrectCount = useMemo(\n600\t    () => data.slots.filter((s) => slotStates[s.id] === 'correct').length,\n601\t    [data.slots, slotStates],\n602\t  );\n603\t\n604\t  return (\n605\t    <div data-cloze-body style={wrapStyle}>\n606\t      {data.taskMarkdown && (\n607\t        <div data-cloze-task style={taskStyle}>\n608\t          <ReactMarkdown remarkPlugins={[remarkMath]} rehypePlugins={[rehypeKatex]}>\n609\t            {data.taskMarkdown}\n610\t          </ReactMarkdown>\n611\t        </div>\n612\t      )}\n613\t\n614\t      <pre data-cloze-template style={codeBlockStyle}>\n615\t        {segments.map((seg, idx) => {\n616\t          if (seg.kind === 'text') {\n617\t            return (\n618\t              <span key={`t-${idx}`} data-cloze-text>\n619\t                {renderHighlighted(seg.content, `t-${idx}`)}\n620\t              </span>\n621\t            );\n622\t          }\n623\t          const slot = slotById.get(seg.slotId);\n624\t          if (!slot) {\n625\t            return (\n626\t              <span\n627\t                key={`s-${idx}`}\n628\t                data-cloze-missing-slot\n629\t                style={{ color: 'var(--danger)', fontStyle: 'italic' }}\n630\t              >\n631\t                {`{{${seg.slotId}}}`}\n632\t              </span>\n633\t            );\n634\t          }\n635\t          return (\n636\t            <SlotInput\n637\t              key={`s-${idx}-${slot.id}`}\n638\t              slot={slot}\n639\t              value={values[slot.id] ?? ''}\n640\t              state={slotStates[slot.id] ?? 'idle'}\n641\t              showHint={(slotStates[slot.id] ?? 'idle') === 'incorrect'}\n642\t              disabled={submission === 'pass'}\n643\t              onChange={handleChange}\n644\t              onBlur={handleBlur}\n645\t            />\n646\t          );\n647\t        })}\n648\t      </pre>\n649\t\n650\t      {revealedHints.length > 0 && (\n651\t        <div data-cloze-hints style={hintsBlockStyle}>\n652\t          <div style={hintLabelStyle}>Progressive hints</div>\n653\t          {revealedHints.map((h, i) => (\n654\t            <div\n655\t              key={i}\n656\t              data-testid={`cloze-progressive-hint-${i}`}\n657\t              style={hintBodyStyle}\n658\t            >\n659\t              <ReactMarkdown remarkPlugins={[remarkMath]} rehypePlugins={[rehypeKatex]}>\n660\t                {h.markdown}\n661\t              </ReactMarkdown>\n662\t            </div>\n663\t          ))}\n664\t        </div>\n665\t      )}\n666\t\n667\t      {submission === 'fail' && testResults && (\n668\t        <div data-cloze-final-tests style={finalTestsBlockStyle}>\n669\t          <div style={statusLabelStyle}>Final tests</div>\n670\t          {testResults.map((r, i) => (\n671\t            <div\n672\t              key={i}\n673\t              data-testid={`cloze-final-test-${i}`}\n674\t              data-state={r.passed ? 'pass' : 'fail'}\n675\t              style={testRowStyle}\n676\t            >\n677\t              {r.passed ? (\n678\t                <Check size={12} aria-hidden style={{ color: 'var(--success)' }} />\n679\t              ) : (\n680\t                <X size={12} aria-hidden style={{ color: 'var(--danger)' }} />\n681\t              )}\n682\t              <span>{r.name}</span>\n683\t              {!r.passed && r.assertionDetail && (\n684\t                <span style={{ color: 'var(--text-tertiary)', marginLeft: 6 }}>\n685\t                  — {r.assertionDetail}\n686\t                </span>\n687\t              )}\n688\t            </div>\n689\t          ))}\n690\t          {traceback && (\n691\t            <pre\n692\t              data-testid=\"cloze-final-traceback\"\n693\t              style={{\n694\t                margin: 0,\n695\t                fontFamily: 'var(--font-mono)',\n696\t                fontSize: 'var(--fs-sm)',\n697\t                color: 'var(--danger)',\n698\t                whiteSpace: 'pre-wrap',\n699\t              }}\n700\t            >\n701\t              {traceback}\n702\t            </pre>\n703\t          )}\n704\t        </div>\n705\t      )}\n706\t\n707\t      {submission === 'fail' && !testResults && traceback && (\n708\t        <div data-cloze-final-tests style={finalTestsBlockStyle}>\n709\t          <Callout tone=\"danger\" title=\"Execution error\">\n710\t            <pre\n711\t              style={{\n712\t                margin: 0,\n713\t                fontFamily: 'var(--font-mono)',\n714\t                fontSize: 'var(--fs-sm)',\n715\t                whiteSpace: 'pre-wrap',\n716\t              }}\n717\t            >\n718\t              {traceback}\n719\t            </pre>\n720\t          </Callout>\n721\t        </div>\n722\t      )}\n723\t\n724\t      <div style={footerStyle}>\n725\t        <span style={statusLabelStyle} data-testid=\"cloze-status\">\n726\t          {submission === 'pass'\n727\t            ? 'Solved'\n728\t            : `${slotsCorrectCount}/${data.slots.length} slot${data.slots.length === 1 ? '' : 's'}`}\n729\t        </span>\n730\t        <button\n731\t          type=\"button\"\n732\t          data-testid=\"cloze-submit\"\n733\t          onClick={() => void runFinalTests()}\n734\t          disabled={submitDisabled}\n735\t          aria-label={\n736\t            submission === 'pass' ? 'Tests passed' : 'Run final tests'\n737\t          }\n738\t          style={submitButtonStyle}\n739\t        >\n740\t          {submission === 'pass' ? (\n741\t            <>\n742\t              <Check size={14} aria-hidden /> Solved\n743\t            </>\n744\t          ) : submission === 'running' ? (\n745\t            'Running…'\n746\t          ) : (\n747\t            'Submit'\n748\t          )}\n749\t        </button>\n750\t      </div>\n751\t    </div>\n752\t  );\n753\t}\n754\t\n755\tasync function patchSectionDone(key: CodeClozeProgressKey): Promise<void> {\n756\t  try {\n757\t    await fetch('/api/progress', {\n758\t      method: 'PATCH',\n759\t      headers: { 'Content-Type': 'application/json' },\n760\t      body: JSON.stringify({\n761\t        courseSlug: key.courseSlug,\n762\t        lessonSlug: key.lessonSlug,\n763\t        sectionState: { [key.sectionId]: { done: true } },\n764\t      }),\n765\t    });\n766\t  } catch {\n767\t    // Persistence is non-fatal.\n768\t  }\n769\t}\n770\t"}]},"parent_tool_use_id":null,"session_id":"ae8df7de-da98-42e4-9412-547c888ddf87","uuid":"ee638b72-8a81-4670-8e74-069d8aed42a9","timestamp":"2026-05-04T07:56:34.347Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-058/src/widgets/CodeCloze/CodeClozeWidget.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useEffect,\n  useMemo,\n  useRef,\n  useState,\n  type CSSProperties,\n  type ReactNode,\n} from 'react';\nimport { Check, X } from 'lucide-react';\nimport ReactMarkdown from 'react-markdown';\nimport remarkMath from 'remark-math';\nimport rehypeKatex from 'rehype-katex';\n\nimport { Callout } from '@/components/Callout';\nimport {\n  PyodideStopError,\n  usePyodide,\n  type RunWithTestsResult,\n  type TestResult,\n} from '@/lib/pyodide/client';\n\nimport {\n  CodeClozeDataSchema,\n  validateSlotValue,\n  type CodeClozeData,\n  type CodeClozeSlot,\n} from './schema';\n\nexport interface CodeClozeProgressKey {\n  courseSlug: string;\n  lessonSlug: string;\n  sectionId: string;\n}\n\nexport interface CodeClozeWidgetProps {\n  data: CodeClozeData;\n  progressKey?: CodeClozeProgressKey;\n  onComplete?: () => void;\n}\n\ntype SlotState = 'idle' | 'correct' | 'incorrect';\n\ntype TemplateSegment =\n  | { kind: 'text'; content: string }\n  | { kind: 'slot'; slotId: string };\n\nconst SLOT_PATTERN = /\\{\\{\\s*([A-Za-z_][\\w-]*)\\s*\\}\\}/g;\n\nfunction parseTemplate(template: string): TemplateSegment[] {\n  const out: TemplateSegment[] = [];\n  let lastIndex = 0;\n  SLOT_PATTERN.lastIndex = 0;\n  let match: RegExpExecArray | null;\n  while ((match = SLOT_PATTERN.exec(template)) !== null) {\n    if (match.index > lastIndex) {\n      out.push({ kind: 'text', content: template.slice(lastIndex, match.index) });\n    }\n    out.push({ kind: 'slot', slotId: match[1] });\n    lastIndex = match.index + match[0].length;\n  }\n  if (lastIndex < template.length) {\n    out.push({ kind: 'text', content: template.slice(lastIndex) });\n  }\n  return out;\n}\n\nconst PY_KEYWORDS = new Set([\n  'False',\n  'None',\n  'True',\n  'and',\n  'as',\n  'assert',\n  'async',\n  'await',\n  'break',\n  'class',\n  'continue',\n  'def',\n  'del',\n  'elif',\n  'else',\n  'except',\n  'finally',\n  'for',\n  'from',\n  'global',\n  'if',\n  'import',\n  'in',\n  'is',\n  'lambda',\n  'nonlocal',\n  'not',\n  'or',\n  'pass',\n  'raise',\n  'return',\n  'try',\n  'while',\n  'with',\n  'yield',\n  'self',\n]);\n\nconst PY_BUILTINS = new Set([\n  'abs',\n  'all',\n  'any',\n  'bool',\n  'dict',\n  'enumerate',\n  'filter',\n  'float',\n  'int',\n  'len',\n  'list',\n  'map',\n  'max',\n  'min',\n  'print',\n  'range',\n  'round',\n  'set',\n  'sorted',\n  'str',\n  'sum',\n  'tuple',\n  'type',\n  'zip',\n]);\n\ntype TokenKind = 'kw' | 'str' | 'num' | 'cm' | 'fn' | 'plain' | 'builtin';\n\ninterface Token {\n  kind: TokenKind;\n  text: string;\n}\n\nfunction tokenizePython(src: string): Token[] {\n  const tokens: Token[] = [];\n  const len = src.length;\n  let i = 0;\n  while (i < len) {\n    const c = src[i];\n\n    if (c === '#') {\n      const j = src.indexOf('\\n', i);\n      const end = j === -1 ? len : j;\n      tokens.push({ kind: 'cm', text: src.slice(i, end) });\n      i = end;\n      continue;\n    }\n\n    if (c === '\"' || c === \"'\") {\n      const quote = c;\n      let j = i + 1;\n      while (j < len && src[j] !== quote) {\n        if (src[j] === '\\\\' && j + 1 < len) j += 2;\n        else j++;\n      }\n      if (j < len) j++;\n      tokens.push({ kind: 'str', text: src.slice(i, j) });\n      i = j;\n      continue;\n    }\n\n    if (c >= '0' && c <= '9') {\n      let j = i;\n      while (j < len && /[0-9._]/.test(src[j])) j++;\n      tokens.push({ kind: 'num', text: src.slice(i, j) });\n      i = j;\n      continue;\n    }\n\n    if (/[A-Za-z_]/.test(c)) {\n      let j = i;\n      while (j < len && /[A-Za-z_0-9]/.test(src[j])) j++;\n      const word = src.slice(i, j);\n      if (PY_KEYWORDS.has(word)) {\n        tokens.push({ kind: 'kw', text: word });\n      } else if (PY_BUILTINS.has(word) && src[j] === '(') {\n        tokens.push({ kind: 'builtin', text: word });\n      } else if (src[j] === '(') {\n        tokens.push({ kind: 'fn', text: word });\n      } else {\n        tokens.push({ kind: 'plain', text: word });\n      }\n      i = j;\n      continue;\n    }\n\n    tokens.push({ kind: 'plain', text: c });\n    i++;\n  }\n  return tokens;\n}\n\nfunction tokenStyle(kind: TokenKind): CSSProperties | undefined {\n  switch (kind) {\n    case 'kw':\n      return { color: 'var(--code-keyword)', fontWeight: 500 };\n    case 'str':\n      return { color: 'var(--code-string)' };\n    case 'cm':\n      return { color: 'var(--code-comment)', fontStyle: 'italic' };\n    case 'num':\n      return { color: 'var(--code-number)' };\n    case 'fn':\n    case 'builtin':\n      return { color: 'var(--code-fn)' };\n    default:\n      return undefined;\n  }\n}\n\nfunction renderHighlighted(text: string, keyPrefix: string): ReactNode[] {\n  const tokens = tokenizePython(text);\n  return tokens.map((tok, i) => {\n    const style = tokenStyle(tok.kind);\n    if (!style) return <span key={`${keyPrefix}-${i}`}>{tok.text}</span>;\n    return (\n      <span key={`${keyPrefix}-${i}`} style={style}>\n        {tok.text}\n      </span>\n    );\n  });\n}\n\nconst wrapStyle: CSSProperties = {\n  display: 'flex',\n  flexDirection: 'column',\n};\n\nconst taskStyle: CSSProperties = {\n  padding: 'var(--space-4) var(--space-5)',\n  borderBottom: '1px solid var(--border)',\n  background: 'var(--bg-elevated)',\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text)',\n  lineHeight: 1.6,\n};\n\nconst codeBlockStyle: CSSProperties = {\n  background: 'var(--code-bg)',\n  color: 'var(--code-text)',\n  fontFamily: 'var(--font-mono)',\n  fontSize: '13px',\n  lineHeight: 1.55,\n  padding: 'var(--space-4) var(--space-5)',\n  whiteSpace: 'pre-wrap',\n  wordBreak: 'break-word',\n  margin: 0,\n  overflowX: 'auto',\n};\n\nconst slotInputBase: CSSProperties = {\n  fontFamily: 'var(--font-mono)',\n  fontSize: '13px',\n  lineHeight: 1.55,\n  padding: '0 6px',\n  margin: '0 1px',\n  borderRadius: 'var(--radius-sm)',\n  background: 'var(--bg-elevated)',\n  outline: 'none',\n  verticalAlign: 'baseline',\n  boxSizing: 'border-box',\n  height: '1.55em',\n};\n\nfunction slotBorder(state: SlotState): string {\n  if (state === 'correct') return '1px solid var(--success-border)';\n  if (state === 'incorrect') return '1px solid var(--danger-border)';\n  return '1px solid var(--border-strong)';\n}\n\nfunction slotBackground(state: SlotState): string {\n  if (state === 'correct') return 'var(--success-subtle)';\n  if (state === 'incorrect') return 'var(--danger-subtle)';\n  return 'var(--bg-elevated)';\n}\n\nconst slotIconStyle: CSSProperties = {\n  marginLeft: 4,\n  verticalAlign: 'middle',\n};\n\nconst slotHintStyle: CSSProperties = {\n  display: 'block',\n  marginTop: 4,\n  fontFamily: 'var(--font-sans)',\n  fontSize: 'var(--fs-xs)',\n  color: 'var(--danger)',\n  fontStyle: 'normal',\n  lineHeight: 1.4,\n};\n\nconst footerStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  justifyContent: 'space-between',\n  gap: 'var(--space-3)',\n  padding: 'var(--space-3) var(--space-5)',\n  borderTop: '1px solid var(--border)',\n  background: 'var(--bg-elevated)',\n};\n\nconst statusLabelStyle: CSSProperties = {\n  fontSize: 'var(--fs-xs)',\n  fontWeight: 600,\n  letterSpacing: '0.06em',\n  textTransform: 'uppercase',\n  color: 'var(--text-tertiary)',\n};\n\nconst submitButtonBase: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 6,\n  height: 32,\n  padding: '0 var(--space-4)',\n  border: '1px solid transparent',\n  borderRadius: 'var(--radius-md)',\n  fontSize: 'var(--fs-sm)',\n  fontWeight: 500,\n  cursor: 'pointer',\n};\n\nconst hintsBlockStyle: CSSProperties = {\n  borderTop: '1px solid var(--border)',\n  background: 'var(--bg-subtle)',\n  padding: 'var(--space-3) var(--space-5)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-2)',\n};\n\nconst hintLabelStyle: CSSProperties = {\n  ...statusLabelStyle,\n  marginBottom: 4,\n};\n\nconst hintBodyStyle: CSSProperties = {\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text-secondary)',\n  lineHeight: 1.55,\n};\n\nconst finalTestsBlockStyle: CSSProperties = {\n  borderTop: '1px solid var(--border)',\n  background: 'var(--bg-subtle)',\n  padding: 'var(--space-3) var(--space-5)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-2)',\n};\n\nconst testRowStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  gap: 'var(--space-2)',\n  fontFamily: 'var(--font-mono)',\n  fontSize: '12px',\n  color: 'var(--text)',\n};\n\nfunction widthForValue(value: string): string {\n  const ch = Math.max(value.length, 4);\n  return `calc(${ch}ch + 16px)`;\n}\n\ninterface SlotInputProps {\n  slot: CodeClozeSlot;\n  value: string;\n  state: SlotState;\n  showHint: boolean;\n  disabled: boolean;\n  onChange: (slotId: string, value: string) => void;\n  onBlur: (slotId: string) => void;\n}\n\nfunction SlotInput({\n  slot,\n  value,\n  state,\n  showHint,\n  disabled,\n  onChange,\n  onBlur,\n}: SlotInputProps) {\n  const inputStyle: CSSProperties = {\n    ...slotInputBase,\n    width: widthForValue(value),\n    minWidth: 60,\n    border: slotBorder(state),\n    background: slotBackground(state),\n    color: 'var(--code-text)',\n  };\n\n  return (\n    <span style={{ display: 'inline-block', verticalAlign: 'baseline' }}>\n      <input\n        type=\"text\"\n        spellCheck={false}\n        autoCorrect=\"off\"\n        autoCapitalize=\"off\"\n        autoComplete=\"off\"\n        data-testid={`cloze-slot-${slot.id}`}\n        data-slot-id={slot.id}\n        data-slot-state={state}\n        aria-label={`Slot ${slot.id}`}\n        value={value}\n        disabled={disabled}\n        onChange={(e) => onChange(slot.id, e.target.value)}\n        onBlur={() => onBlur(slot.id)}\n        style={inputStyle}\n      />\n      {state === 'correct' && (\n        <Check\n          size={12}\n          aria-hidden\n          strokeWidth={2.5}\n          style={{ ...slotIconStyle, color: 'var(--success)' }}\n        />\n      )}\n      {state === 'incorrect' && (\n        <X\n          size={12}\n          aria-hidden\n          strokeWidth={2.5}\n          style={{ ...slotIconStyle, color: 'var(--danger)' }}\n        />\n      )}\n      {state === 'incorrect' && showHint && slot.hint && (\n        <span data-testid={`cloze-slot-hint-${slot.id}`} style={slotHintStyle}>\n          {slot.hint}\n        </span>\n      )}\n    </span>\n  );\n}\n\nexport function CodeClozeWidget({\n  data: rawData,\n  progressKey,\n  onComplete,\n}: CodeClozeWidgetProps) {\n  const data = useMemo(() => CodeClozeDataSchema.parse(rawData), [rawData]);\n  const segments = useMemo(() => parseTemplate(data.template), [data.template]);\n\n  const slotById = useMemo(() => {\n    const m = new Map<string, CodeClozeSlot>();\n    for (const s of data.slots) m.set(s.id, s);\n    return m;\n  }, [data.slots]);\n\n  const initialValues = useMemo(() => {\n    const out: Record<string, string> = {};\n    for (const s of data.slots) out[s.id] = '';\n    return out;\n  }, [data.slots]);\n\n  const initialStates = useMemo(() => {\n    const out: Record<string, SlotState> = {};\n    for (const s of data.slots) out[s.id] = 'idle';\n    return out;\n  }, [data.slots]);\n\n  const [values, setValues] = useState<Record<string, string>>(initialValues);\n  const [slotStates, setSlotStates] =\n    useState<Record<string, SlotState>>(initialStates);\n  const [failedAttempts, setFailedAttempts] = useState(0);\n  const [submission, setSubmission] = useState<\n    'idle' | 'running' | 'pass' | 'fail'\n  >('idle');\n  const [testResults, setTestResults] = useState<TestResult[] | null>(null);\n  const [traceback, setTraceback] = useState<string | null>(null);\n\n  const onCompleteRef = useRef(onComplete);\n  useEffect(() => {\n    onCompleteRef.current = onComplete;\n  }, [onComplete]);\n\n  const { status, runWithTests } = usePyodide();\n\n  const finalTests = useMemo(() => data.finalTests ?? [], [data.finalTests]);\n  const hints = useMemo(() => data.hints ?? [], [data.hints]);\n\n  const allSlotsCorrect =\n    data.slots.length > 0 &&\n    data.slots.every((s) => slotStates[s.id] === 'correct');\n\n  const revealedHints = useMemo(() => {\n    return hints.filter((h) => failedAttempts >= h.revealAfterAttempts);\n  }, [hints, failedAttempts]);\n\n  const handleChange = useCallback((slotId: string, next: string) => {\n    setValues((prev) => ({ ...prev, [slotId]: next }));\n    setSlotStates((prev) => {\n      if (prev[slotId] === 'idle') return prev;\n      return { ...prev, [slotId]: 'idle' };\n    });\n  }, []);\n\n  const handleBlur = useCallback(\n    (slotId: string) => {\n      const slot = slotById.get(slotId);\n      if (!slot) return;\n      const value = values[slotId] ?? '';\n      if (value.length === 0) {\n        setSlotStates((prev) =>\n          prev[slotId] === 'idle' ? prev : { ...prev, [slotId]: 'idle' },\n        );\n        return;\n      }\n      const ok = validateSlotValue(slot.validation, value);\n      setSlotStates((prev) => ({\n        ...prev,\n        [slotId]: ok ? 'correct' : 'incorrect',\n      }));\n      if (!ok) {\n        setFailedAttempts((n) => n + 1);\n      }\n    },\n    [slotById, values],\n  );\n\n  const assembleCode = useCallback((): string => {\n    return data.template.replace(SLOT_PATTERN, (_match, slotId: string) => {\n      return values[slotId] ?? '';\n    });\n  }, [data.template, values]);\n\n  const runFinalTests = useCallback(async () => {\n    if (status !== 'ready') return;\n    if (finalTests.length === 0) {\n      setSubmission('pass');\n      if (progressKey) void patchSectionDone(progressKey);\n      onCompleteRef.current?.();\n      return;\n    }\n    setSubmission('running');\n    setTraceback(null);\n    setTestResults(null);\n    try {\n      const result: RunWithTestsResult = await runWithTests(\n        assembleCode(),\n        finalTests.map((t) => ({ name: t.name, body: t.body })),\n      );\n      const tr = result.testResults ?? [];\n      setTestResults(tr);\n      setTraceback(result.traceback ?? null);\n      const passed = tr.length > 0 && tr.every((r) => r.passed);\n      if (passed) {\n        setSubmission('pass');\n        if (progressKey) void patchSectionDone(progressKey);\n        onCompleteRef.current?.();\n      } else {\n        setSubmission('fail');\n      }\n    } catch (err) {\n      if (err instanceof PyodideStopError) {\n        setSubmission('idle');\n        return;\n      }\n      setTraceback(err instanceof Error ? err.message : String(err));\n      setSubmission('fail');\n    }\n  }, [assembleCode, finalTests, progressKey, runWithTests, status]);\n\n  const submitDisabled =\n    !allSlotsCorrect ||\n    submission === 'running' ||\n    submission === 'pass' ||\n    (finalTests.length > 0 && status !== 'ready');\n\n  const submitButtonStyle: CSSProperties = useMemo(() => {\n    if (submission === 'pass') {\n      return {\n        ...submitButtonBase,\n        background: 'transparent',\n        border: '1px solid var(--success-border)',\n        color: 'var(--success)',\n        cursor: 'default',\n      };\n    }\n    return {\n      ...submitButtonBase,\n      background: submitDisabled ? 'var(--bg-active)' : 'var(--accent)',\n      color: submitDisabled ? 'var(--text-tertiary)' : 'var(--text-on-accent)',\n      cursor: submitDisabled ? 'not-allowed' : 'pointer',\n      opacity: submitDisabled ? 0.7 : 1,\n    };\n  }, [submission, submitDisabled]);\n\n  const slotsCorrectCount = useMemo(\n    () => data.slots.filter((s) => slotStates[s.id] === 'correct').length,\n    [data.slots, slotStates],\n  );\n\n  return (\n    <div data-cloze-body style={wrapStyle}>\n      {data.taskMarkdown && (\n        <div data-cloze-task style={taskStyle}>\n          <ReactMarkdown remarkPlugins={[remarkMath]} rehypePlugins={[rehypeKatex]}>\n            {data.taskMarkdown}\n          </ReactMarkdown>\n        </div>\n      )}\n\n      <pre data-cloze-template style={codeBlockStyle}>\n        {segments.map((seg, idx) => {\n          if (seg.kind === 'text') {\n            return (\n              <span key={`t-${idx}`} data-cloze-text>\n                {renderHighlighted(seg.content, `t-${idx}`)}\n              </span>\n            );\n          }\n          const slot = slotById.get(seg.slotId);\n          if (!slot) {\n            return (\n              <span\n                key={`s-${idx}`}\n                data-cloze-missing-slot\n                style={{ color: 'var(--danger)', fontStyle: 'italic' }}\n              >\n                {`{{${seg.slotId}}}`}\n              </span>\n            );\n          }\n          return (\n            <SlotInput\n              key={`s-${idx}-${slot.id}`}\n              slot={slot}\n              value={values[slot.id] ?? ''}\n              state={slotStates[slot.id] ?? 'idle'}\n              showHint={(slotStates[slot.id] ?? 'idle') === 'incorrect'}\n              disabled={submission === 'pass'}\n              onChange={handleChange}\n              onBlur={handleBlur}\n            />\n          );\n        })}\n      </pre>\n\n      {revealedHints.length > 0 && (\n        <div data-cloze-hints style={hintsBlockStyle}>\n          <div style={hintLabelStyle}>Progressive hints</div>\n          {revealedHints.map((h, i) => (\n            <div\n              key={i}\n              data-testid={`cloze-progressive-hint-${i}`}\n              style={hintBodyStyle}\n            >\n              <ReactMarkdown remarkPlugins={[remarkMath]} rehypePlugins={[rehypeKatex]}>\n                {h.markdown}\n              </ReactMarkdown>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {submission === 'fail' && testResults && (\n        <div data-cloze-final-tests style={finalTestsBlockStyle}>\n          <div style={statusLabelStyle}>Final tests</div>\n          {testResults.map((r, i) => (\n            <div\n              key={i}\n              data-testid={`cloze-final-test-${i}`}\n              data-state={r.passed ? 'pass' : 'fail'}\n              style={testRowStyle}\n            >\n              {r.passed ? (\n                <Check size={12} aria-hidden style={{ color: 'var(--success)' }} />\n              ) : (\n                <X size={12} aria-hidden style={{ color: 'var(--danger)' }} />\n              )}\n              <span>{r.name}</span>\n              {!r.passed && r.assertionDetail && (\n                <span style={{ color: 'var(--text-tertiary)', marginLeft: 6 }}>\n                  — {r.assertionDetail}\n                </span>\n              )}\n            </div>\n          ))}\n          {traceback && (\n            <pre\n              data-testid=\"cloze-final-traceback\"\n              style={{\n                margin: 0,\n                fontFamily: 'var(--font-mono)',\n                fontSize: 'var(--fs-sm)',\n                color: 'var(--danger)',\n                whiteSpace: 'pre-wrap',\n              }}\n            >\n              {traceback}\n            </pre>\n          )}\n        </div>\n      )}\n\n      {submission === 'fail' && !testResults && traceback && (\n        <div data-cloze-final-tests style={finalTestsBlockStyle}>\n          <Callout tone=\"danger\" title=\"Execution error\">\n            <pre\n              style={{\n                margin: 0,\n                fontFamily: 'var(--font-mono)',\n                fontSize: 'var(--fs-sm)',\n                whiteSpace: 'pre-wrap',\n              }}\n            >\n              {traceback}\n            </pre>\n          </Callout>\n        </div>\n      )}\n\n      <div style={footerStyle}>\n        <span style={statusLabelStyle} data-testid=\"cloze-status\">\n          {submission === 'pass'\n            ? 'Solved'\n            : `${slotsCorrectCount}/${data.slots.length} slot${data.slots.length === 1 ? '' : 's'}`}\n        </span>\n        <button\n          type=\"button\"\n          data-testid=\"cloze-submit\"\n          onClick={() => void runFinalTests()}\n          disabled={submitDisabled}\n          aria-label={\n            submission === 'pass' ? 'Tests passed' : 'Run final tests'\n          }\n          style={submitButtonStyle}\n        >\n          {submission === 'pass' ? (\n            <>\n              <Check size={14} aria-hidden /> Solved\n            </>\n          ) : submission === 'running' ? (\n            'Running…'\n          ) : (\n            'Submit'\n          )}\n        </button>\n      </div>\n    </div>\n  );\n}\n\nasync function patchSectionDone(key: CodeClozeProgressKey): Promise<void> {\n  try {\n    await fetch('/api/progress', {\n      method: 'PATCH',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        courseSlug: key.courseSlug,\n        lessonSlug: key.lessonSlug,\n        sectionState: { [key.sectionId]: { done: true } },\n      }),\n    });\n  } catch {\n    // Persistence is non-fatal.\n  }\n}\n","numLines":770,"startLine":1,"totalLines":770}}}
