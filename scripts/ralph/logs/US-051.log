{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wv4UAq4Cnb5qniiEvN4ZvN","type":"tool_result","content":"1140\t    },\n1141\t    {\n1142\t      \"id\": \"US-050\",\n1143\t      \"title\": \"New widget — Image (URL src + local prefetch cache)\",\n1144\t      \"description\": \"As a course author, I want an Image widget that takes a URL and locally caches the image into the course's assets folder on first save, so lessons remain available offline and source attribution is preserved.\",\n1145\t      \"acceptanceCriteria\": [\n1146\t        \"Zod schema in src/widgets/Image/schema.ts defines ImageData: { src: string (URL or local relative path), alt: string (required), caption?: string, attribution?: { text: string, url?: string }, maxWidth?: string (px or %, default '100%') }\",\n1147\t        \"JSON Schema regenerates via `npm run build:schemas`; committed to src/widgets/schemas/image.json\",\n1148\t        \"Registry entry added in src/widgets/registry.ts; WidgetType union extended with 'image'\",\n1149\t        \"ImageSectionSchema variant added to SectionSchema discriminated union in src/lib/schemas/lesson.ts\",\n1150\t        \"`--widget-image` CSS var defined in both light + dark blocks of src/styles/tokens.css\",\n1151\t        \"ImageEditor.tsx follows US-023 pattern (src input as text URL, alt input, caption textarea, attribution.text + attribution.url, maxWidth input); wired into WidgetEditPanel and SectionRenderer\",\n1152\t        \"Sample data file src/widgets/Image/sample.ts exports a minimal valid instance\",\n1153\t        \"On lesson save (PUT /api/courses/[slug]/lessons/[lessonSlug]): if any Image section has an external URL src (http/https), server-side fetch the image, store in courses/<slug>/assets/images/<sha256(url).slice(0,16)>.<ext>, rewrite src in saved JSON to local relative path '/api/courses/<slug>/assets/images/<filename>'\",\n1154\t        \"Asset API route extends US-043 to serve courses/<slug>/assets/images/ subdirectory\",\n1155\t        \"Widget renders <figure>: <img src alt style={{maxWidth}}> + optional <figcaption> with caption text + attribution (linked if attribution.url present, plain text otherwise)\",\n1156\t        \"Caching is idempotent: same URL hashes to same filename → no duplicate downloads\",\n1157\t        \"Failed fetch on save: log warning, keep original URL in saved JSON (graceful degradation), return 200 with a warning field in response body\",\n1158\t        \"Vitest tests cover: schema parses minimal valid object; hash-based filename generation; URL→local rewrite happy path; failed-fetch graceful path\",\n1159\t        \"Verify in browser using playwright-skill: render lesson with Image section using a local cached path, confirm image displays in light + dark with caption + attribution link\",\n1160\t        \"Typecheck passes\",\n1161\t        \"Tests pass\"\n1162\t      ],\n1163\t      \"priority\": 50,\n1164\t      \"passes\": true,\n1165\t      \"notes\": \"Caches at lesson-save time, not at view time. Path traversal protected via assertSafeSlug.\",\n1166\t      \"tags\": [\n1167\t        \"ui\"\n1168\t      ]\n1169\t    },"}]},"parent_tool_use_id":null,"session_id":"a5179973-6d3e-41c1-821c-3b55ae720415","uuid":"5bd6ed66-91f7-4ff4-9e0b-8144c65720e8","timestamp":"2026-05-04T00:51:11.096Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-051/scripts/ralph/prd.json","content":"    },\n    {\n      \"id\": \"US-050\",\n      \"title\": \"New widget — Image (URL src + local prefetch cache)\",\n      \"description\": \"As a course author, I want an Image widget that takes a URL and locally caches the image into the course's assets folder on first save, so lessons remain available offline and source attribution is preserved.\",\n      \"acceptanceCriteria\": [\n        \"Zod schema in src/widgets/Image/schema.ts defines ImageData: { src: string (URL or local relative path), alt: string (required), caption?: string, attribution?: { text: string, url?: string }, maxWidth?: string (px or %, default '100%') }\",\n        \"JSON Schema regenerates via `npm run build:schemas`; committed to src/widgets/schemas/image.json\",\n        \"Registry entry added in src/widgets/registry.ts; WidgetType union extended with 'image'\",\n        \"ImageSectionSchema variant added to SectionSchema discriminated union in src/lib/schemas/lesson.ts\",\n        \"`--widget-image` CSS var defined in both light + dark blocks of src/styles/tokens.css\",\n        \"ImageEditor.tsx follows US-023 pattern (src input as text URL, alt input, caption textarea, attribution.text + attribution.url, maxWidth input); wired into WidgetEditPanel and SectionRenderer\",\n        \"Sample data file src/widgets/Image/sample.ts exports a minimal valid instance\",\n        \"On lesson save (PUT /api/courses/[slug]/lessons/[lessonSlug]): if any Image section has an external URL src (http/https), server-side fetch the image, store in courses/<slug>/assets/images/<sha256(url).slice(0,16)>.<ext>, rewrite src in saved JSON to local relative path '/api/courses/<slug>/assets/images/<filename>'\",\n        \"Asset API route extends US-043 to serve courses/<slug>/assets/images/ subdirectory\",\n        \"Widget renders <figure>: <img src alt style={{maxWidth}}> + optional <figcaption> with caption text + attribution (linked if attribution.url present, plain text otherwise)\",\n        \"Caching is idempotent: same URL hashes to same filename → no duplicate downloads\",\n        \"Failed fetch on save: log warning, keep original URL in saved JSON (graceful degradation), return 200 with a warning field in response body\",\n        \"Vitest tests cover: schema parses minimal valid object; hash-based filename generation; URL→local rewrite happy path; failed-fetch graceful path\",\n        \"Verify in browser using playwright-skill: render lesson with Image section using a local cached path, confirm image displays in light + dark with caption + attribution link\",\n        \"Typecheck passes\",\n        \"Tests pass\"\n      ],\n      \"priority\": 50,\n      \"passes\": true,\n      \"notes\": \"Caches at lesson-save time, not at view time. Path traversal protected via assertSafeSlug.\",\n      \"tags\": [\n        \"ui\"\n      ]\n    },","numLines":30,"startLine":1140,"totalLines":1307}}}
