.width / 2;\n    const sy = itemBox.y + itemBox.height / 2;\n    const tx = zoneBox.x + zoneBox.width / 2;\n    const ty = zoneBox.y + zoneBox.height / 2;\n\n    await page.mouse.move(sx, sy);\n    await page.mouse.down();\n    // dnd-kit PointerSensor activation distance: 4. Move past threshold first.\n    await page.mouse.move(sx + 8, sy + 8, { steps: 5 });\n    await page.mouse.move(tx, ty, { steps: 12 });\n    await page.mouse.up();\n    await page.waitForTimeout(120);\n  }\n\n  console.log('2. drag i-var → z-fn (wrong), i-fn → z-var (wrong), i-loop → z-loop (right)');\n  await dragItemToZone('i-var', 'z-fn');\n  await dragItemToZone('i-fn', 'z-var');\n  await dragItemToZone('i-loop', 'z-loop');\n  await page.screenshot({ path: '/tmp/us-047-2-placed-wrong.png', fullPage: true });\n\n  // Submit\n  console.log('3. click submit');\n  await page.click('[data-testid=\"dragmatch-submit\"]');\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: '/tmp/us-047-3-after-wrong-submit.png', fullPage: true });\n\n  // Expect explanation visible\n  const explanationCount = await page.locator('text=/Explanation/').count();\n  console.log('   explanation visible:', explanationCount > 0);\n\n  // Verify wrong zones got data-misplaced=true on items\n  const misplacedVar = await page.getAttribute(\n    '[data-testid=\"dragmatch-item-i-var\"]',\n    'data-misplaced',\n  );\n  const misplacedFn = await page.getAttribute(\n    '[data-testid=\"dragmatch-item-i-fn\"]',\n    'data-misplaced',\n  );\n  const misplacedLoop = await page.getAttribute(\n    '[data-testid=\"dragmatch-item-i-loop\"]',\n    'data-misplaced',\n  );\n  console.log('   i-var misplaced:', misplacedVar);\n  console.log('   i-fn misplaced:', misplacedFn);\n  console.log('   i-loop misplaced:', misplacedLoop);\n\n  if (misplacedVar !== 'true' || misplacedFn !== 'true' || misplacedLoop !== 'false') {\n    throw new Error('expected i-var/i-fn misplaced and i-loop placed correctly');\n  }\n\n  // Click \"Try again\"\n  console.log('4. click Try again, fix the swap');\n  await page.click('[data-testid=\"dragmatch-reset\"]');\n  await page.waitForTimeout(200);\n\n  // Now drag correctly\n  await dragItemToZone('i-var', 'z-var');\n  await dragItemToZone('i-fn', 'z-fn');\n  await dragItemToZone('i-loop', 'z-loop');\n  await page.screenshot({ path: '/tmp/us-047-4-correct-placement.png', fullPage: true });\n\n  await page.click('[data-testid=\"dragmatch-submit\"]');\n  await page.waitForTimeout(500);\n  await page.screenshot({ path: '/tmp/us-047-5-after-correct-submit.png', fullPage: true });\n\n  const submitText = await page.textContent('[data-testid=\"dragmatch-submit\"]');\n  console.log('   submit button text:', submitText);\n  if (!submitText || !submitText.includes('Solved')) {\n    throw new Error('expected Solved state after correct submission');\n  }\n\n  // Status badge should appear with data-status=\"done\"\n  console.log('5. wait for done badge');\n  await page.waitForSelector(\n    '[data-section-id=\"dm1\"] [data-status=\"done\"]',\n    { timeout: 5_000 },\n  );\n  await page.screenshot({ path: '/tmp/us-047-6-status-done.png', fullPage: true });\n\n  console.log('SUCCESS');\n  await browser.close();\n}\n\nmain().catch((err) => {\n  console.error('FAILURE', err);\n  process.exit(1);\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
