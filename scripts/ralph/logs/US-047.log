{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014L9HrC6uzoR1sNWSASLxqB","type":"tool_result","content":"1\timport { writeFileSync, mkdirSync } from 'node:fs';\n2\timport { dirname, join } from 'node:path';\n3\timport { fileURLToPath } from 'node:url';\n4\timport { ZodSchema } from 'zod';\n5\timport { zodToJsonSchema } from 'zod-to-json-schema';\n6\t\n7\timport { TheoryDataSchema } from '@/widgets/Theory/schema';\n8\timport { QuizDataSchema } from '@/widgets/Quiz/schema';\n9\timport { CodeDataSchema } from '@/widgets/Code/schema';\n10\timport { CodeClozeDataSchema } from '@/widgets/CodeCloze/schema';\n11\timport { DemoDataSchema } from '@/widgets/Demo/schema';\n12\timport { SandboxDataSchema } from '@/widgets/Sandbox/schema';\n13\timport { HistogramDataSchema } from '@/widgets/Histogram/schema';\n14\timport { ParametricExplorerDataSchema } from '@/widgets/ParametricExplorer/schema';\n15\timport { PlotImageDataSchema } from '@/widgets/PlotImage/schema';\n16\timport { CourseSchema } from '@/lib/schemas/course';\n17\timport { LessonSchema } from '@/lib/schemas/lesson';\n18\t\n19\tconst widgets: Record<string, ZodSchema> = {\n20\t  theory: TheoryDataSchema,\n21\t  quiz: QuizDataSchema,\n22\t  code: CodeDataSchema,\n23\t  'code-cloze': CodeClozeDataSchema,\n24\t  demo: DemoDataSchema,\n25\t  sandbox: SandboxDataSchema,\n26\t  histogram: HistogramDataSchema,\n27\t  'plot-image': PlotImageDataSchema,\n28\t  'parametric-explorer': ParametricExplorerDataSchema,\n29\t};\n30\t\n31\tconst topLevel: Record<string, ZodSchema> = {\n32\t  course: CourseSchema,\n33\t  lesson: LessonSchema,\n34\t};\n35\t\n36\tconst outDir = dirname(fileURLToPath(import.meta.url));\n37\tmkdirSync(outDir, { recursive: true });\n38\t\n39\tfor (const [name, schema] of Object.entries(widgets)) {\n40\t  const jsonSchema = zodToJsonSchema(schema, { name: `${name}Data`, target: 'jsonSchema7' });\n41\t  const outPath = join(outDir, `${name}.json`);\n42\t  writeFileSync(outPath, JSON.stringify(jsonSchema, null, 2) + '\\n', 'utf8');\n43\t  console.log(`wrote ${outPath}`);\n44\t}\n45\t\n46\tfor (const [name, schema] of Object.entries(topLevel)) {\n47\t  const jsonSchema = zodToJsonSchema(schema, { name, target: 'jsonSchema7' });\n48\t  const outPath = join(outDir, `${name}.json`);\n49\t  writeFileSync(outPath, JSON.stringify(jsonSchema, null, 2) + '\\n', 'utf8');\n50\t  console.log(`wrote ${outPath}`);\n51\t}\n52\t"}]},"parent_tool_use_id":null,"session_id":"07080243-aa8d-441b-9ce0-ebebd57b013c","uuid":"0c201746-552b-49a1-bf79-bd2d987b6fd5","timestamp":"2026-05-03T22:03:34.882Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-047/src/widgets/schemas/build.ts","content":"import { writeFileSync, mkdirSync } from 'node:fs';\nimport { dirname, join } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { ZodSchema } from 'zod';\nimport { zodToJsonSchema } from 'zod-to-json-schema';\n\nimport { TheoryDataSchema } from '@/widgets/Theory/schema';\nimport { QuizDataSchema } from '@/widgets/Quiz/schema';\nimport { CodeDataSchema } from '@/widgets/Code/schema';\nimport { CodeClozeDataSchema } from '@/widgets/CodeCloze/schema';\nimport { DemoDataSchema } from '@/widgets/Demo/schema';\nimport { SandboxDataSchema } from '@/widgets/Sandbox/schema';\nimport { HistogramDataSchema } from '@/widgets/Histogram/schema';\nimport { ParametricExplorerDataSchema } from '@/widgets/ParametricExplorer/schema';\nimport { PlotImageDataSchema } from '@/widgets/PlotImage/schema';\nimport { CourseSchema } from '@/lib/schemas/course';\nimport { LessonSchema } from '@/lib/schemas/lesson';\n\nconst widgets: Record<string, ZodSchema> = {\n  theory: TheoryDataSchema,\n  quiz: QuizDataSchema,\n  code: CodeDataSchema,\n  'code-cloze': CodeClozeDataSchema,\n  demo: DemoDataSchema,\n  sandbox: SandboxDataSchema,\n  histogram: HistogramDataSchema,\n  'plot-image': PlotImageDataSchema,\n  'parametric-explorer': ParametricExplorerDataSchema,\n};\n\nconst topLevel: Record<string, ZodSchema> = {\n  course: CourseSchema,\n  lesson: LessonSchema,\n};\n\nconst outDir = dirname(fileURLToPath(import.meta.url));\nmkdirSync(outDir, { recursive: true });\n\nfor (const [name, schema] of Object.entries(widgets)) {\n  const jsonSchema = zodToJsonSchema(schema, { name: `${name}Data`, target: 'jsonSchema7' });\n  const outPath = join(outDir, `${name}.json`);\n  writeFileSync(outPath, JSON.stringify(jsonSchema, null, 2) + '\\n', 'utf8');\n  console.log(`wrote ${outPath}`);\n}\n\nfor (const [name, schema] of Object.entries(topLevel)) {\n  const jsonSchema = zodToJsonSchema(schema, { name, target: 'jsonSchema7' });\n  const outPath = join(outDir, `${name}.json`);\n  writeFileSync(outPath, JSON.stringify(jsonSchema, null, 2) + '\\n', 'utf8');\n  console.log(`wrote ${outPath}`);\n}\n","numLines":52,"startLine":1,"totalLines":52}}}
