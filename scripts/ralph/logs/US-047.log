{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011j9vnPbCamXoRVr6JKxD34","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport {\n4\t  useCallback,\n5\t  useEffect,\n6\t  useMemo,\n7\t  useRef,\n8\t  useState,\n9\t  type CSSProperties,\n10\t} from 'react';\n11\timport { ChevronDown, ChevronRight, Plus, Trash2 } from 'lucide-react';\n12\timport { EditorState } from '@codemirror/state';\n13\timport { EditorView, keymap, lineNumbers } from '@codemirror/view';\n14\timport {\n15\t  defaultKeymap,\n16\t  history,\n17\t  historyKeymap,\n18\t  indentWithTab,\n19\t} from '@codemirror/commands';\n20\timport {\n21\t  bracketMatching,\n22\t  indentOnInput,\n23\t  syntaxHighlighting,\n24\t} from '@codemirror/language';\n25\timport { python } from '@codemirror/lang-python';\n26\timport type { z } from 'zod';\n27\t\n28\timport {\n29\t  EditorFormFooter,\n30\t  EditorFormSaveError,\n31\t  errorTextStyle,\n32\t  fieldStyle,\n33\t  formBodyStyle,\n34\t  inputStyle,\n35\t  labelStyle,\n36\t  textareaStyle,\n37\t  type FieldErrors,\n38\t} from '@/components/EditorForm';\n39\timport { SourcesField } from '@/components/Sources';\n40\timport type { Source } from '@/lib/schemas/lesson';\n41\t\n42\timport {\n43\t  codeRunnerEditorTheme,\n44\t  codeRunnerHighlightStyle,\n45\t} from '../Code/CodeRunner';\n46\timport {\n47\t  CodeClozeDataSchema,\n48\t  type CodeClozeData,\n49\t  type CodeClozeFinalTest,\n50\t  type CodeClozeProgressiveHint,\n51\t  type CodeClozeSlot,\n52\t  type CodeClozeSlotValidation,\n53\t} from './schema';\n54\t\n55\texport interface CodeClozeEditorProps {\n56\t  initial: CodeClozeData;\n57\t  initialSources?: Source[];\n58\t  onCancel: () => void;\n59\t  onSave: (next: CodeClozeData, sources?: Source[]) => Promise<void>;\n60\t}\n61\t\n62\tinterface SlotRow extends CodeClozeSlot {\n63\t  rowId: string;\n64\t}\n65\t\n66\tinterface TestRow extends CodeClozeFinalTest {\n67\t  rowId: string;\n68\t}\n69\t\n70\tinterface HintRow extends CodeClozeProgressiveHint {\n71\t  rowId: string;\n72\t}\n73\t\n74\tfunction makeRowId(): string {\n75\t  return `r-${Math.random().toString(36).slice(2, 9)}`;\n76\t}\n77\t\n78\tfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n79\t  const out: FieldErrors = {};\n80\t  for (const issue of error.issues) {\n81\t    const path = issue.path.join('.') || '_root';\n82\t    if (!out[path]) out[path] = issue.message;\n83\t  }\n84\t  return out;\n85\t}\n86\t\n87\tconst cmContainerStyle: CSSProperties = {\n88\t  background: 'var(--code-bg)',\n89\t  border: '1px solid var(--border-strong)',\n90\t  borderRadius: 'var(--radius-md)',\n91\t  overflow: 'hidden',\n92\t};\n93\t\n94\tconst cardStyle: CSSProperties = {\n95\t  border: '1px solid var(--border)',\n96\t  borderRadius: 'var(--radius-md)',\n97\t  padding: 'var(--space-3)',\n98\t  display: 'flex',\n99\t  flexDirection: 'column',\n100\t  gap: 'var(--space-2)',\n101\t  background: 'var(--bg-elevated)',\n102\t  marginBottom: 6,\n103\t};\n104\t\n105\tconst cardHeaderStyle: CSSProperties = {\n106\t  display: 'flex',\n107\t  alignItems: 'center',\n108\t  gap: 'var(--space-2)',\n109\t};\n110\t\n111\tconst removeButtonStyle: CSSProperties = {\n112\t  width: 24,\n113\t  height: 24,\n114\t  display: 'inline-flex',\n115\t  alignItems: 'center',\n116\t  justifyContent: 'center',\n117\t  background: 'transparent',\n118\t  border: '1px solid transparent',\n119\t  borderRadius: 'var(--radius-sm)',\n120\t  color: 'var(--text-tertiary)',\n121\t  cursor: 'pointer',\n122\t  flexShrink: 0,\n123\t};\n124\t\n125\tconst addButtonStyle: CSSProperties = {\n126\t  display: 'inline-flex',\n127\t  alignItems: 'center',\n128\t  gap: 4,\n129\t  background: 'transparent',\n130\t  border: '1px dashed var(--border-strong)',\n131\t  borderRadius: 'var(--radius-md)',\n132\t  color: 'var(--text-secondary)',\n133\t  fontSize: 'var(--fs-xs)',\n134\t  fontWeight: 500,\n135\t  padding: '6px 10px',\n136\t  cursor: 'pointer',\n137\t  marginTop: 4,\n138\t};\n139\t\n140\tconst subLabelStyle: CSSProperties = {\n141\t  display: 'block',\n142\t  fontSize: '11px',\n143\t  color: 'var(--text-tertiary)',\n144\t  marginBottom: 4,\n145\t};\n146\t\n147\tconst expandToggleStyle: CSSProperties = {\n148\t  width: 22,\n149\t  height: 22,\n150\t  display: 'inline-flex',\n151\t  alignItems: 'center',\n152\t  justifyContent: 'center',\n153\t  background: 'transparent',\n154\t  border: '1px solid transparent',\n155\t  borderRadius: 'var(--radius-sm)',\n156\t  color: 'var(--text-tertiary)',\n157\t  cursor: 'pointer',\n158\t  flexShrink: 0,\n159\t};\n160\t\n161\tconst testBodyContainerStyle: CSSProperties = {\n162\t  ...cmContainerStyle,\n163\t  marginTop: 4,\n164\t};\n165\t\n166\tinterface PythonEditorProps {\n167\t  initial: string;\n168\t  onChange: (value: string) => void;\n169\t  testId?: string;\n170\t}\n171\t\n172\tfunction PythonEditor({ initial, onChange, testId }: PythonEditorProps) {\n173\t  const parentRef = useRef<HTMLDivElement | null>(null);\n174\t  const onChangeRef = useRef(onChange);\n175\t\n176\t  useEffect(() => {\n177\t    onChangeRef.current = onChange;\n178\t  }, [onChange]);\n179\t\n180\t  useEffect(() => {\n181\t    if (!parentRef.current) return;\n182\t    const updateListener = EditorView.updateListener.of((update) => {\n183\t      if (update.docChanged) {\n184\t        onChangeRef.current(update.state.doc.toString());\n185\t      }\n186\t    });\n187\t    const view = new EditorView({\n188\t      parent: parentRef.current,\n189\t      state: EditorState.create({\n190\t        doc: initial,\n191\t        extensions: [\n192\t          lineNumbers(),\n193\t          history(),\n194\t          indentOnInput(),\n195\t          bracketMatching(),\n196\t          python(),\n197\t          syntaxHighlighting(codeRunnerHighlightStyle),\n198\t          codeRunnerEditorTheme,\n199\t          keymap.of([...defaultKeymap, ...historyKeymap, indentWithTab]),\n200\t          updateListener,\n201\t        ],\n202\t      }),\n203\t    });\n204\t    return () => {\n205\t      view.destroy();\n206\t    };\n207\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n208\t  }, []);\n209\t\n210\t  return <div ref={parentRef} data-testid={testId} style={cmContainerStyle} />;\n211\t}\n212\t\n213\tfunction defaultValidation(\n214\t  kind: CodeClozeSlotValidation['kind'],\n215\t): CodeClozeSlotValidation {\n216\t  if (kind === 'exact') return { kind: 'exact', value: '' };\n217\t  if (kind === 'regex') return { kind: 'regex', pattern: '' };\n218\t  return { kind: 'oneOf', values: [''] };\n219\t}\n220\t\n221\texport function CodeClozeEditor({\n222\t  initial,\n223\t  initialSources,\n224\t  onCancel,\n225\t  onSave,\n226\t}: CodeClozeEditorProps) {\n227\t  const [taskMarkdown, setTaskMarkdown] = useState<string>(\n228\t    initial.taskMarkdown ?? '',\n229\t  );\n230\t  const [template, setTemplate] = useState<string>(initial.template);\n231\t  const [slots, setSlots] = useState<SlotRow[]>(() =>\n232\t    (initial.slots ?? []).map((s) => ({ ...s, rowId: makeRowId() })),\n233\t  );\n234\t  const [tests, setTests] = useState<TestRow[]>(() =>\n235\t    (initial.finalTests ?? []).map((t) => ({ ...t, rowId: makeRowId() })),\n236\t  );\n237\t  const [hints, setHints] = useState<HintRow[]>(() =>\n238\t    (initial.hints ?? []).map((h) => ({ ...h, rowId: makeRowId() })),\n239\t  );\n240\t  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n241\t  const [expandedTests, setExpandedTests] = useState<Record<string, boolean>>(\n242\t    {},\n243\t  );\n244\t  const [errors, setErrors] = useState<FieldErrors>({});\n245\t  const [saving, setSaving] = useState(false);\n246\t  const [saveError, setSaveError] = useState<string | null>(null);\n247\t\n248\t  const current: CodeClozeData = useMemo(() => {\n249\t    const obj: CodeClozeData = {\n250\t      template,\n251\t      slots: slots.map((s) => ({\n252\t        id: s.id,\n253\t        ...(s.hint ? { hint: s.hint } : {}),\n254\t        validation: s.validation,\n255\t      })),\n256\t    };\n257\t    if (taskMarkdown.trim()) obj.taskMarkdown = taskMarkdown;\n258\t    if (tests.length > 0) {\n259\t      obj.finalTests = tests.map((t) => ({\n260\t        name: t.name,\n261\t        body: t.body,\n262\t        hidden: t.hidden,\n263\t      }));\n264\t    }\n265\t    if (hints.length > 0) {\n266\t      obj.hints = hints.map((h) => ({\n267\t        revealAfterAttempts: h.revealAfterAttempts,\n268\t        markdown: h.markdown,\n269\t      }));\n270\t    }\n271\t    return obj;\n272\t  }, [taskMarkdown, template, slots, tests, hints]);\n273\t\n274\t  const dirty = useMemo(() => {\n275\t    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n276\t    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n277\t  }, [current, initial, sources, initialSources]);\n278\t\n279\t  const handleSave = useCallback(async () => {\n280\t    if (!dirty || saving) return;\n281\t    const result = CodeClozeDataSchema.safeParse(current);\n282\t    if (!result.success) {\n283\t      setErrors(flattenIssues(result.error));\n284\t      return;\n285\t    }\n286\t    setErrors({});\n287\t    setSaveError(null);\n288\t    setSaving(true);\n289\t    try {\n290\t      await onSave(result.data, sources);\n291\t      setSaving(false);\n292\t    } catch (err) {\n293\t      setSaveError(err instanceof Error ? err.message : String(err));\n294\t      setSaving(false);\n295\t    }\n296\t  }, [current, dirty, onSave, saving, sources]);\n297\t\n298\t  const addSlot = useCallback(() => {\n299\t    setSlots((prev) => [\n300\t      ...prev,\n301\t      {\n302\t        rowId: makeRowId(),\n303\t        id: '',\n304\t        validation: { kind: 'exact', value: '' },\n305\t      },\n306\t    ]);\n307\t  }, []);\n308\t\n309\t  const updateSlot = useCallback(\n310\t    (rowId: string, patch: Partial<SlotRow>) => {\n311\t      setSlots((prev) =>\n312\t        prev.map((s) => (s.rowId === rowId ? { ...s, ...patch } : s)),\n313\t      );\n314\t    },\n315\t    [],\n316\t  );\n317\t\n318\t  const removeSlot = useCallback((rowId: string) => {\n319\t    setSlots((prev) => prev.filter((s) => s.rowId !== rowId));\n320\t  }, []);\n321\t\n322\t  const addTest = useCallback(() => {\n323\t    const row: TestRow = { rowId: makeRowId(), name: '', body: '', hidden: true };\n324\t    setTests((prev) => [...prev, row]);\n325\t    setExpandedTests((prev) => ({ ...prev, [row.rowId]: true }));\n326\t  }, []);\n327\t\n328\t  const updateTestName = useCallback((rowId: string, value: string) => {\n329\t    setTests((prev) =>\n330\t      prev.map((t) => (t.rowId === rowId ? { ...t, name: value } : t)),\n331\t    );\n332\t  }, []);\n333\t\n334\t  const updateTestBody = useCallback((rowId: string, value: string) => {\n335\t    setTests((prev) =>\n336\t      prev.map((t) => (t.rowId === rowId ? { ...t, body: value } : t)),\n337\t    );\n338\t  }, []);\n339\t\n340\t  const removeTest = useCallback((rowId: string) => {\n341\t    setTests((prev) => prev.filter((t) => t.rowId !== rowId));\n342\t    setExpandedTests((prev) => {\n343\t      const copy = { ...prev };\n344\t      delete copy[rowId];\n345\t      return copy;\n346\t    });\n347\t  }, []);\n348\t\n349\t  const toggleTest = useCallback((rowId: string) => {\n350\t    setExpandedTests((prev) => ({ ...prev, [rowId]: !prev[rowId] }));\n351\t  }, []);\n352\t\n353\t  const addHint = useCallback(() => {\n354\t    setHints((prev) => [\n355\t      ...prev,\n356\t      { rowId: makeRowId(), revealAfterAttempts: prev.length + 1, markdown: '' },\n357\t    ]);\n358\t  }, []);\n359\t\n360\t  const updateHint = useCallback((rowId: string, patch: Partial<HintRow>) => {\n361\t    setHints((prev) =>\n362\t      prev.map((h) => (h.rowId === rowId ? { ...h, ...patch } : h)),\n363\t    );\n364\t  }, []);\n365\t\n366\t  const removeHint = useCallback((rowId: string) => {\n367\t    setHints((prev) => prev.filter((h) => h.rowId !== rowId));\n368\t  }, []);\n369\t\n370\t  return (\n371\t    <div\n372\t      data-testid=\"code-cloze-editor\"\n373\t      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n374\t    >\n375\t      <div style={formBodyStyle}>\n376\t        <label style={fieldStyle}>\n377\t          <span style={labelStyle}>Task description (markdown, optional)</span>\n378\t          <textarea\n379\t            data-testid=\"cloze-edit-task\"\n380\t            value={taskMarkdown}\n381\t            onChange={(e) => setTaskMarkdown(e.target.value)}\n382\t            style={{\n383\t              ...textareaStyle,\n384\t              minHeight: 70,\n385\t              fontFamily: 'var(--font-mono)',\n386\t              fontSize: '12.5px',\n387\t            }}\n388\t          />\n389\t        </label>\n390\t\n391\t        <div style={fieldStyle}>\n392\t          <span style={labelStyle}>\n393\t            Template (Python — use {'{{slotId}}'} for blanks)\n394\t          </span>\n395\t          <PythonEditor\n396\t            initial={initial.template}\n397\t            onChange={setTemplate}\n398\t            testId=\"cloze-edit-template\"\n399\t          />\n400\t          {errors.template && <div style={errorTextStyle}>{errors.template}</div>}\n401\t        </div>\n402\t\n403\t        <div style={fieldStyle}>\n404\t          <div\n405\t            style={{\n406\t              display: 'flex',\n407\t              alignItems: 'center',\n408\t              justifyContent: 'space-between',\n409\t              marginBottom: 6,\n410\t            }}\n411\t          >\n412\t            <span style={{ ...labelStyle, marginBottom: 0 }}>Slots</span>\n413\t          </div>\n414\t          <div data-testid=\"cloze-edit-slots\">\n415\t            {slots.map((slot, i) => {\n416\t              const validation = slot.validation;\n417\t              return (\n418\t                <div key={slot.rowId} style={cardStyle} data-test-slot-index={i}>\n419\t                  <div style={cardHeaderStyle}>\n420\t                    <input\n421\t                      type=\"text\"\n422\t                      data-testid={`cloze-edit-slot-id-${i}`}\n423\t                      value={slot.id}\n424\t                      placeholder=\"slotId\"\n425\t                      onChange={(e) =>\n426\t                        updateSlot(slot.rowId, { id: e.target.value })\n427\t                      }\n428\t                      style={{\n429\t                        ...inputStyle,\n430\t                        flex: 1,\n431\t                        minWidth: 0,\n432\t                        fontFamily: 'var(--font-mono)',\n433\t                        fontSize: '12.5px',\n434\t                      }}\n435\t                    />\n436\t                    <button\n437\t                      type=\"button\"\n438\t                      data-testid={`cloze-edit-slot-remove-${i}`}\n439\t                      onClick={() => removeSlot(slot.rowId)}\n440\t                      aria-label={`Remove slot ${i + 1}`}\n441\t                      style={removeButtonStyle}\n442\t                    >\n443\t                      <Trash2 size={13} aria-hidden />\n444\t                    </button>\n445\t                  </div>\n446\t\n447\t                  <label>\n448\t                    <span style={subLabelStyle}>Hint (shown on incorrect)</span>\n449\t                    <input\n450\t                      type=\"text\"\n451\t                      data-testid={`cloze-edit-slot-hint-${i}`}\n452\t                      value={slot.hint ?? ''}\n453\t                      onChange={(e) =>\n454\t                        updateSlot(slot.rowId, {\n455\t                          hint: e.target.value || undefined,\n456\t                        })\n457\t                      }\n458\t                      style={inputStyle}\n459\t                    />\n460\t                  </label>\n461\t\n462\t                  <label>\n463\t                    <span style={subLabelStyle}>Validation kind</span>\n464\t                    <select\n465\t                      data-testid={`cloze-edit-slot-kind-${i}`}\n466\t                      value={validation.kind}\n467\t                      onChange={(e) =>\n468\t                        updateSlot(slot.rowId, {\n469\t                          validation: defaultValidation(\n470\t                            e.target.value as CodeClozeSlotValidation['kind'],\n471\t                          ),\n472\t                        })\n473\t                      }\n474\t                      style={inputStyle}\n475\t                    >\n476\t                      <option value=\"exact\">exact</option>\n477\t                      <option value=\"regex\">regex</option>\n478\t                      <option value=\"oneOf\">oneOf</option>\n479\t                    </select>\n480\t                  </label>\n481\t\n482\t                  {validation.kind === 'exact' && (\n483\t                    <label>\n484\t                      <span style={subLabelStyle}>Expected value</span>\n485\t                      <input\n486\t                        type=\"text\"\n487\t                        data-testid={`cloze-edit-slot-value-${i}`}\n488\t                        value={validation.value}\n489\t                        onChange={(e) =>\n490\t                          updateSlot(slot.rowId, {\n491\t                            validation: { kind: 'exact', value: e.target.value },\n492\t                          })\n493\t                        }\n494\t                        style={{\n495\t                          ...inputStyle,\n496\t                          fontFamily: 'var(--font-mono)',\n497\t                          fontSize: '12.5px',\n498\t                        }}\n499\t                      />\n500\t                    </label>\n501\t                  )}\n502\t\n503\t                  {validation.kind === 'regex' && (\n504\t                    <label>\n505\t                      <span style={subLabelStyle}>Regex pattern</span>\n506\t                      <input\n507\t                        type=\"text\"\n508\t                        data-testid={`cloze-edit-slot-pattern-${i}`}\n509\t                        value={validation.pattern}\n510\t                        onChange={(e) =>\n511\t                          updateSlot(slot.rowId, {\n512\t                            validation: {\n513\t                              kind: 'regex',\n514\t                              pattern: e.target.value,\n515\t                            },\n516\t                          })\n517\t                        }\n518\t                        style={{\n519\t                          ...inputStyle,\n520\t                          fontFamily: 'var(--font-mono)',\n521\t                          fontSize: '12.5px',\n522\t                        }}\n523\t                      />\n524\t                    </label>\n525\t                  )}\n526\t\n527\t                  {validation.kind === 'oneOf' && (\n528\t                    <label>\n529\t                      <span style={subLabelStyle}>\n530\t                        Allowed values (comma-separated)\n531\t                      </span>\n532\t                      <input\n533\t                        type=\"text\"\n534\t                        data-testid={`cloze-edit-slot-values-${i}`}\n535\t                        value={validation.values.join(',')}\n536\t                        onChange={(e) =>\n537\t                          updateSlot(slot.rowId, {\n538\t                            validation: {\n539\t                              kind: 'oneOf',\n540\t                              values: e.target.value\n541\t                                .split(',')\n542\t                                .map((v) => v.trim())\n543\t                                .filter((v) => v.length > 0),\n544\t                            },\n545\t                          })\n546\t                        }\n547\t                        style={{\n548\t                          ...inputStyle,\n549\t                          fontFamily: 'var(--font-mono)',\n550\t                          fontSize: '12.5px',\n551\t                        }}\n552\t                      />\n553\t                    </label>\n554\t                  )}\n555\t                </div>\n556\t              );\n557\t            })}\n558\t          </div>\n559\t          <button\n560\t            type=\"button\"\n561\t            data-testid=\"cloze-edit-add-slot\"\n562\t            onClick={addSlot}\n563\t            style={addButtonStyle}\n564\t          >\n565\t            <Plus size={12} aria-hidden /> Add slot\n566\t          </button>\n567\t        </div>\n568\t\n569\t        <div style={fieldStyle}>\n570\t          <span style={labelStyle}>Final tests (optional)</span>\n571\t          <div data-testid=\"cloze-edit-tests\">\n572\t            {tests.map((test, i) => {\n573\t              const isExpanded = Boolean(expandedTests[test.rowId]);\n574\t              return (\n575\t                <div key={test.rowId} data-test-test-index={i}>\n576\t                  <div style={cardHeaderStyle}>\n577\t                    <button\n578\t                      type=\"button\"\n579\t                      data-testid={`cloze-edit-test-toggle-${i}`}\n580\t                      onClick={() => toggleTest(test.rowId)}\n581\t                      aria-expanded={isExpanded}\n582\t                      style={expandToggleStyle}\n583\t                    >\n584\t                      {isExpanded ? (\n585\t                        <ChevronDown size={13} aria-hidden />\n586\t                      ) : (\n587\t                        <ChevronRight size={13} aria-hidden />\n588\t                      )}\n589\t                    </button>\n590\t                    <input\n591\t                      type=\"text\"\n592\t                      data-testid={`cloze-edit-test-name-${i}`}\n593\t                      value={test.name}\n594\t                      onChange={(e) => updateTestName(test.rowId, e.target.value)}\n595\t                      placeholder=\"test_name\"\n596\t                      style={{\n597\t                        ...inputStyle,\n598\t                        flex: 1,\n599\t                        minWidth: 0,\n600\t                        fontFamily: 'var(--font-mono)',\n601\t                        fontSize: '12.5px',\n602\t                      }}\n603\t                    />\n604\t                    <button\n605\t                      type=\"button\"\n606\t                      data-testid={`cloze-edit-test-remove-${i}`}\n607\t                      onClick={() => removeTest(test.rowId)}\n608\t                      aria-label={`Remove test ${i + 1}`}\n609\t                      style={removeButtonStyle}\n610\t                    >\n611\t                      <Trash2 size={13} aria-hidden />\n612\t                    </button>\n613\t                  </div>\n614\t                  {isExpanded && (\n615\t                    <div style={testBodyContainerStyle}>\n616\t                      <PythonEditor\n617\t                        initial={test.body}\n618\t                        onChange={(v) => updateTestBody(test.rowId, v)}\n619\t                        testId={`cloze-edit-test-body-${i}`}\n620\t                      />\n621\t                    </div>\n622\t                  )}\n623\t                </div>\n624\t              );\n625\t            })}\n626\t          </div>\n627\t          <button\n628\t            type=\"button\"\n629\t            data-testid=\"cloze-edit-add-test\"\n630\t            onClick={addTest}\n631\t            style={addButtonStyle}\n632\t          >\n633\t            <Plus size={12} aria-hidden /> Add final test\n634\t          </button>\n635\t        </div>\n636\t\n637\t        <div style={fieldStyle}>\n638\t          <span style={labelStyle}>Progressive hints (optional)</span>\n639\t          <div data-testid=\"cloze-edit-hints\">\n640\t            {hints.map((hint, i) => (\n641\t              <div key={hint.rowId} style={cardStyle} data-test-hint-index={i}>\n642\t                <div style={cardHeaderStyle}>\n643\t                  <span style={{ ...subLabelStyle, marginBottom: 0 }}>\n644\t                    Reveal after\n645\t                  </span>\n646\t                  <input\n647\t                    type=\"number\"\n648\t                    min={0}\n649\t                    data-testid={`cloze-edit-hint-after-${i}`}\n650\t                    value={hint.revealAfterAttempts}\n651\t                    onChange={(e) =>\n652\t                      updateHint(hint.rowId, {\n653\t                        revealAfterAttempts: Math.max(\n654\t                          0,\n655\t                          Math.floor(Number(e.target.value) || 0),\n656\t                        ),\n657\t                      })\n658\t                    }\n659\t                    style={{ ...inputStyle, width: 90 }}\n660\t                  />\n661\t                  <span style={{ ...subLabelStyle, marginBottom: 0 }}>\n662\t                    failed attempts\n663\t                  </span>\n664\t                  <button\n665\t                    type=\"button\"\n666\t                    data-testid={`cloze-edit-hint-remove-${i}`}\n667\t                    onClick={() => removeHint(hint.rowId)}\n668\t                    aria-label={`Remove hint ${i + 1}`}\n669\t                    style={{ ...removeButtonStyle, marginLeft: 'auto' }}\n670\t                  >\n671\t                    <Trash2 size={13} aria-hidden />\n672\t                  </button>\n673\t                </div>\n674\t                <textarea\n675\t                  data-testid={`cloze-edit-hint-md-${i}`}\n676\t                  value={hint.markdown}\n677\t                  onChange={(e) =>\n678\t                    updateHint(hint.rowId, { markdown: e.target.value })\n679\t                  }\n680\t                  placeholder=\"Hint markdown\"\n681\t                  style={{ ...textareaStyle, minHeight: 56 }}\n682\t                />\n683\t              </div>\n684\t            ))}\n685\t          </div>\n686\t          <button\n687\t            type=\"button\"\n688\t            data-testid=\"cloze-edit-add-hint\"\n689\t            onClick={addHint}\n690\t            style={addButtonStyle}\n691\t          >\n692\t            <Plus size={12} aria-hidden /> Add hint\n693\t          </button>\n694\t        </div>\n695\t\n696\t        <SourcesField sources={sources} onChange={setSources} />\n697\t\n698\t        {errors._root && <div style={errorTextStyle}>{errors._root}</div>}\n699\t      </div>\n700\t\n701\t      <EditorFormSaveError message={saveError} />\n702\t      <EditorFormFooter\n703\t        saving={saving}\n704\t        saveDisabled={!dirty}\n705\t        onCancel={onCancel}\n706\t        onSave={() => void handleSave()}\n707\t        cancelTestId=\"cloze-edit-cancel\"\n708\t        saveTestId=\"cloze-edit-save\"\n709\t      />\n710\t    </div>\n711\t  );\n712\t}\n713\t"}]},"parent_tool_use_id":null,"session_id":"07080243-aa8d-441b-9ce0-ebebd57b013c","uuid":"7aa0e7a8-1486-47d9-b7a1-2fbbe0146902","timestamp":"2026-05-03T22:03:29.365Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-047/src/widgets/CodeCloze/CodeClozeEditor.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useEffect,\n  useMemo,\n  useRef,\n  useState,\n  type CSSProperties,\n} from 'react';\nimport { ChevronDown, ChevronRight, Plus, Trash2 } from 'lucide-react';\nimport { EditorState } from '@codemirror/state';\nimport { EditorView, keymap, lineNumbers } from '@codemirror/view';\nimport {\n  defaultKeymap,\n  history,\n  historyKeymap,\n  indentWithTab,\n} from '@codemirror/commands';\nimport {\n  bracketMatching,\n  indentOnInput,\n  syntaxHighlighting,\n} from '@codemirror/language';\nimport { python } from '@codemirror/lang-python';\nimport type { z } from 'zod';\n\nimport {\n  EditorFormFooter,\n  EditorFormSaveError,\n  errorTextStyle,\n  fieldStyle,\n  formBodyStyle,\n  inputStyle,\n  labelStyle,\n  textareaStyle,\n  type FieldErrors,\n} from '@/components/EditorForm';\nimport { SourcesField } from '@/components/Sources';\nimport type { Source } from '@/lib/schemas/lesson';\n\nimport {\n  codeRunnerEditorTheme,\n  codeRunnerHighlightStyle,\n} from '../Code/CodeRunner';\nimport {\n  CodeClozeDataSchema,\n  type CodeClozeData,\n  type CodeClozeFinalTest,\n  type CodeClozeProgressiveHint,\n  type CodeClozeSlot,\n  type CodeClozeSlotValidation,\n} from './schema';\n\nexport interface CodeClozeEditorProps {\n  initial: CodeClozeData;\n  initialSources?: Source[];\n  onCancel: () => void;\n  onSave: (next: CodeClozeData, sources?: Source[]) => Promise<void>;\n}\n\ninterface SlotRow extends CodeClozeSlot {\n  rowId: string;\n}\n\ninterface TestRow extends CodeClozeFinalTest {\n  rowId: string;\n}\n\ninterface HintRow extends CodeClozeProgressiveHint {\n  rowId: string;\n}\n\nfunction makeRowId(): string {\n  return `r-${Math.random().toString(36).slice(2, 9)}`;\n}\n\nfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n  const out: FieldErrors = {};\n  for (const issue of error.issues) {\n    const path = issue.path.join('.') || '_root';\n    if (!out[path]) out[path] = issue.message;\n  }\n  return out;\n}\n\nconst cmContainerStyle: CSSProperties = {\n  background: 'var(--code-bg)',\n  border: '1px solid var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  overflow: 'hidden',\n};\n\nconst cardStyle: CSSProperties = {\n  border: '1px solid var(--border)',\n  borderRadius: 'var(--radius-md)',\n  padding: 'var(--space-3)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-2)',\n  background: 'var(--bg-elevated)',\n  marginBottom: 6,\n};\n\nconst cardHeaderStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  gap: 'var(--space-2)',\n};\n\nconst removeButtonStyle: CSSProperties = {\n  width: 24,\n  height: 24,\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  background: 'transparent',\n  border: '1px solid transparent',\n  borderRadius: 'var(--radius-sm)',\n  color: 'var(--text-tertiary)',\n  cursor: 'pointer',\n  flexShrink: 0,\n};\n\nconst addButtonStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 4,\n  background: 'transparent',\n  border: '1px dashed var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  color: 'var(--text-secondary)',\n  fontSize: 'var(--fs-xs)',\n  fontWeight: 500,\n  padding: '6px 10px',\n  cursor: 'pointer',\n  marginTop: 4,\n};\n\nconst subLabelStyle: CSSProperties = {\n  display: 'block',\n  fontSize: '11px',\n  color: 'var(--text-tertiary)',\n  marginBottom: 4,\n};\n\nconst expandToggleStyle: CSSProperties = {\n  width: 22,\n  height: 22,\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  background: 'transparent',\n  border: '1px solid transparent',\n  borderRadius: 'var(--radius-sm)',\n  color: 'var(--text-tertiary)',\n  cursor: 'pointer',\n  flexShrink: 0,\n};\n\nconst testBodyContainerStyle: CSSProperties = {\n  ...cmContainerStyle,\n  marginTop: 4,\n};\n\ninterface PythonEditorProps {\n  initial: string;\n  onChange: (value: string) => void;\n  testId?: string;\n}\n\nfunction PythonEditor({ initial, onChange, testId }: PythonEditorProps) {\n  const parentRef = useRef<HTMLDivElement | null>(null);\n  const onChangeRef = useRef(onChange);\n\n  useEffect(() => {\n    onChangeRef.current = onChange;\n  }, [onChange]);\n\n  useEffect(() => {\n    if (!parentRef.current) return;\n    const updateListener = EditorView.updateListener.of((update) => {\n      if (update.docChanged) {\n        onChangeRef.current(update.state.doc.toString());\n      }\n    });\n    const view = new EditorView({\n      parent: parentRef.current,\n      state: EditorState.create({\n        doc: initial,\n        extensions: [\n          lineNumbers(),\n          history(),\n          indentOnInput(),\n          bracketMatching(),\n          python(),\n          syntaxHighlighting(codeRunnerHighlightStyle),\n          codeRunnerEditorTheme,\n          keymap.of([...defaultKeymap, ...historyKeymap, indentWithTab]),\n          updateListener,\n        ],\n      }),\n    });\n    return () => {\n      view.destroy();\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  return <div ref={parentRef} data-testid={testId} style={cmContainerStyle} />;\n}\n\nfunction defaultValidation(\n  kind: CodeClozeSlotValidation['kind'],\n): CodeClozeSlotValidation {\n  if (kind === 'exact') return { kind: 'exact', value: '' };\n  if (kind === 'regex') return { kind: 'regex', pattern: '' };\n  return { kind: 'oneOf', values: [''] };\n}\n\nexport function CodeClozeEditor({\n  initial,\n  initialSources,\n  onCancel,\n  onSave,\n}: CodeClozeEditorProps) {\n  const [taskMarkdown, setTaskMarkdown] = useState<string>(\n    initial.taskMarkdown ?? '',\n  );\n  const [template, setTemplate] = useState<string>(initial.template);\n  const [slots, setSlots] = useState<SlotRow[]>(() =>\n    (initial.slots ?? []).map((s) => ({ ...s, rowId: makeRowId() })),\n  );\n  const [tests, setTests] = useState<TestRow[]>(() =>\n    (initial.finalTests ?? []).map((t) => ({ ...t, rowId: makeRowId() })),\n  );\n  const [hints, setHints] = useState<HintRow[]>(() =>\n    (initial.hints ?? []).map((h) => ({ ...h, rowId: makeRowId() })),\n  );\n  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n  const [expandedTests, setExpandedTests] = useState<Record<string, boolean>>(\n    {},\n  );\n  const [errors, setErrors] = useState<FieldErrors>({});\n  const [saving, setSaving] = useState(false);\n  const [saveError, setSaveError] = useState<string | null>(null);\n\n  const current: CodeClozeData = useMemo(() => {\n    const obj: CodeClozeData = {\n      template,\n      slots: slots.map((s) => ({\n        id: s.id,\n        ...(s.hint ? { hint: s.hint } : {}),\n        validation: s.validation,\n      })),\n    };\n    if (taskMarkdown.trim()) obj.taskMarkdown = taskMarkdown;\n    if (tests.length > 0) {\n      obj.finalTests = tests.map((t) => ({\n        name: t.name,\n        body: t.body,\n        hidden: t.hidden,\n      }));\n    }\n    if (hints.length > 0) {\n      obj.hints = hints.map((h) => ({\n        revealAfterAttempts: h.revealAfterAttempts,\n        markdown: h.markdown,\n      }));\n    }\n    return obj;\n  }, [taskMarkdown, template, slots, tests, hints]);\n\n  const dirty = useMemo(() => {\n    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n  }, [current, initial, sources, initialSources]);\n\n  const handleSave = useCallback(async () => {\n    if (!dirty || saving) return;\n    const result = CodeClozeDataSchema.safeParse(current);\n    if (!result.success) {\n      setErrors(flattenIssues(result.error));\n      return;\n    }\n    setErrors({});\n    setSaveError(null);\n    setSaving(true);\n    try {\n      await onSave(result.data, sources);\n      setSaving(false);\n    } catch (err) {\n      setSaveError(err instanceof Error ? err.message : String(err));\n      setSaving(false);\n    }\n  }, [current, dirty, onSave, saving, sources]);\n\n  const addSlot = useCallback(() => {\n    setSlots((prev) => [\n      ...prev,\n      {\n        rowId: makeRowId(),\n        id: '',\n        validation: { kind: 'exact', value: '' },\n      },\n    ]);\n  }, []);\n\n  const updateSlot = useCallback(\n    (rowId: string, patch: Partial<SlotRow>) => {\n      setSlots((prev) =>\n        prev.map((s) => (s.rowId === rowId ? { ...s, ...patch } : s)),\n      );\n    },\n    [],\n  );\n\n  const removeSlot = useCallback((rowId: string) => {\n    setSlots((prev) => prev.filter((s) => s.rowId !== rowId));\n  }, []);\n\n  const addTest = useCallback(() => {\n    const row: TestRow = { rowId: makeRowId(), name: '', body: '', hidden: true };\n    setTests((prev) => [...prev, row]);\n    setExpandedTests((prev) => ({ ...prev, [row.rowId]: true }));\n  }, []);\n\n  const updateTestName = useCallback((rowId: string, value: string) => {\n    setTests((prev) =>\n      prev.map((t) => (t.rowId === rowId ? { ...t, name: value } : t)),\n    );\n  }, []);\n\n  const updateTestBody = useCallback((rowId: string, value: string) => {\n    setTests((prev) =>\n      prev.map((t) => (t.rowId === rowId ? { ...t, body: value } : t)),\n    );\n  }, []);\n\n  const removeTest = useCallback((rowId: string) => {\n    setTests((prev) => prev.filter((t) => t.rowId !== rowId));\n    setExpandedTests((prev) => {\n      const copy = { ...prev };\n      delete copy[rowId];\n      return copy;\n    });\n  }, []);\n\n  const toggleTest = useCallback((rowId: string) => {\n    setExpandedTests((prev) => ({ ...prev, [rowId]: !prev[rowId] }));\n  }, []);\n\n  const addHint = useCallback(() => {\n    setHints((prev) => [\n      ...prev,\n      { rowId: makeRowId(), revealAfterAttempts: prev.length + 1, markdown: '' },\n    ]);\n  }, []);\n\n  const updateHint = useCallback((rowId: string, patch: Partial<HintRow>) => {\n    setHints((prev) =>\n      prev.map((h) => (h.rowId === rowId ? { ...h, ...patch } : h)),\n    );\n  }, []);\n\n  const removeHint = useCallback((rowId: string) => {\n    setHints((prev) => prev.filter((h) => h.rowId !== rowId));\n  }, []);\n\n  return (\n    <div\n      data-testid=\"code-cloze-editor\"\n      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n    >\n      <div style={formBodyStyle}>\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Task description (markdown, optional)</span>\n          <textarea\n            data-testid=\"cloze-edit-task\"\n            value={taskMarkdown}\n            onChange={(e) => setTaskMarkdown(e.target.value)}\n            style={{\n              ...textareaStyle,\n              minHeight: 70,\n              fontFamily: 'var(--font-mono)',\n              fontSize: '12.5px',\n            }}\n          />\n        </label>\n\n        <div style={fieldStyle}>\n          <span style={labelStyle}>\n            Template (Python — use {'{{slotId}}'} for blanks)\n          </span>\n          <PythonEditor\n            initial={initial.template}\n            onChange={setTemplate}\n            testId=\"cloze-edit-template\"\n          />\n          {errors.template && <div style={errorTextStyle}>{errors.template}</div>}\n        </div>\n\n        <div style={fieldStyle}>\n          <div\n            style={{\n              display: 'flex',\n              alignItems: 'center',\n              justifyContent: 'space-between',\n              marginBottom: 6,\n            }}\n          >\n            <span style={{ ...labelStyle, marginBottom: 0 }}>Slots</span>\n          </div>\n          <div data-testid=\"cloze-edit-slots\">\n            {slots.map((slot, i) => {\n              const validation = slot.validation;\n              return (\n                <div key={slot.rowId} style={cardStyle} data-test-slot-index={i}>\n                  <div style={cardHeaderStyle}>\n                    <input\n                      type=\"text\"\n                      data-testid={`cloze-edit-slot-id-${i}`}\n                      value={slot.id}\n                      placeholder=\"slotId\"\n                      onChange={(e) =>\n                        updateSlot(slot.rowId, { id: e.target.value })\n                      }\n                      style={{\n                        ...inputStyle,\n                        flex: 1,\n                        minWidth: 0,\n                        fontFamily: 'var(--font-mono)',\n                        fontSize: '12.5px',\n                      }}\n                    />\n                    <button\n                      type=\"button\"\n                      data-testid={`cloze-edit-slot-remove-${i}`}\n                      onClick={() => removeSlot(slot.rowId)}\n                      aria-label={`Remove slot ${i + 1}`}\n                      style={removeButtonStyle}\n                    >\n                      <Trash2 size={13} aria-hidden />\n                    </button>\n                  </div>\n\n                  <label>\n                    <span style={subLabelStyle}>Hint (shown on incorrect)</span>\n                    <input\n                      type=\"text\"\n                      data-testid={`cloze-edit-slot-hint-${i}`}\n                      value={slot.hint ?? ''}\n                      onChange={(e) =>\n                        updateSlot(slot.rowId, {\n                          hint: e.target.value || undefined,\n                        })\n                      }\n                      style={inputStyle}\n                    />\n                  </label>\n\n                  <label>\n                    <span style={subLabelStyle}>Validation kind</span>\n                    <select\n                      data-testid={`cloze-edit-slot-kind-${i}`}\n                      value={validation.kind}\n                      onChange={(e) =>\n                        updateSlot(slot.rowId, {\n                          validation: defaultValidation(\n                            e.target.value as CodeClozeSlotValidation['kind'],\n                          ),\n                        })\n                      }\n                      style={inputStyle}\n                    >\n                      <option value=\"exact\">exact</option>\n                      <option value=\"regex\">regex</option>\n                      <option value=\"oneOf\">oneOf</option>\n                    </select>\n                  </label>\n\n                  {validation.kind === 'exact' && (\n                    <label>\n                      <span style={subLabelStyle}>Expected value</span>\n                      <input\n                        type=\"text\"\n                        data-testid={`cloze-edit-slot-value-${i}`}\n                        value={validation.value}\n                        onChange={(e) =>\n                          updateSlot(slot.rowId, {\n                            validation: { kind: 'exact', value: e.target.value },\n                          })\n                        }\n                        style={{\n                          ...inputStyle,\n                          fontFamily: 'var(--font-mono)',\n                          fontSize: '12.5px',\n                        }}\n                      />\n                    </label>\n                  )}\n\n                  {validation.kind === 'regex' && (\n                    <label>\n                      <span style={subLabelStyle}>Regex pattern</span>\n                      <input\n                        type=\"text\"\n                        data-testid={`cloze-edit-slot-pattern-${i}`}\n                        value={validation.pattern}\n                        onChange={(e) =>\n                          updateSlot(slot.rowId, {\n                            validation: {\n                              kind: 'regex',\n                              pattern: e.target.value,\n                            },\n                          })\n                        }\n                        style={{\n                          ...inputStyle,\n                          fontFamily: 'var(--font-mono)',\n                          fontSize: '12.5px',\n                        }}\n                      />\n                    </label>\n                  )}\n\n                  {validation.kind === 'oneOf' && (\n                    <label>\n                      <span style={subLabelStyle}>\n                        Allowed values (comma-separated)\n                      </span>\n                      <input\n                        type=\"text\"\n                        data-testid={`cloze-edit-slot-values-${i}`}\n                        value={validation.values.join(',')}\n                        onChange={(e) =>\n                          updateSlot(slot.rowId, {\n                            validation: {\n                              kind: 'oneOf',\n                              values: e.target.value\n                                .split(',')\n                                .map((v) => v.trim())\n                                .filter((v) => v.length > 0),\n                            },\n                          })\n                        }\n                        style={{\n                          ...inputStyle,\n                          fontFamily: 'var(--font-mono)',\n                          fontSize: '12.5px',\n                        }}\n                      />\n                    </label>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n          <button\n            type=\"button\"\n            data-testid=\"cloze-edit-add-slot\"\n            onClick={addSlot}\n            style={addButtonStyle}\n          >\n            <Plus size={12} aria-hidden /> Add slot\n          </button>\n        </div>\n\n        <div style={fieldStyle}>\n          <span style={labelStyle}>Final tests (optional)</span>\n          <div data-testid=\"cloze-edit-tests\">\n            {tests.map((test, i) => {\n              const isExpanded = Boolean(expandedTests[test.rowId]);\n              return (\n                <div key={test.rowId} data-test-test-index={i}>\n                  <div style={cardHeaderStyle}>\n                    <button\n                      type=\"button\"\n                      data-testid={`cloze-edit-test-toggle-${i}`}\n                      onClick={() => toggleTest(test.rowId)}\n                      aria-expanded={isExpanded}\n                      style={expandToggleStyle}\n                    >\n                      {isExpanded ? (\n                        <ChevronDown size={13} aria-hidden />\n                      ) : (\n                        <ChevronRight size={13} aria-hidden />\n                      )}\n                    </button>\n                    <input\n                      type=\"text\"\n                      data-testid={`cloze-edit-test-name-${i}`}\n                      value={test.name}\n                      onChange={(e) => updateTestName(test.rowId, e.target.value)}\n                      placeholder=\"test_name\"\n                      style={{\n                        ...inputStyle,\n                        flex: 1,\n                        minWidth: 0,\n                        fontFamily: 'var(--font-mono)',\n                        fontSize: '12.5px',\n                      }}\n                    />\n                    <button\n                      type=\"button\"\n                      data-testid={`cloze-edit-test-remove-${i}`}\n                      onClick={() => removeTest(test.rowId)}\n                      aria-label={`Remove test ${i + 1}`}\n                      style={removeButtonStyle}\n                    >\n                      <Trash2 size={13} aria-hidden />\n                    </button>\n                  </div>\n                  {isExpanded && (\n                    <div style={testBodyContainerStyle}>\n                      <PythonEditor\n                        initial={test.body}\n                        onChange={(v) => updateTestBody(test.rowId, v)}\n                        testId={`cloze-edit-test-body-${i}`}\n                      />\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n          <button\n            type=\"button\"\n            data-testid=\"cloze-edit-add-test\"\n            onClick={addTest}\n            style={addButtonStyle}\n          >\n            <Plus size={12} aria-hidden /> Add final test\n          </button>\n        </div>\n\n        <div style={fieldStyle}>\n          <span style={labelStyle}>Progressive hints (optional)</span>\n          <div data-testid=\"cloze-edit-hints\">\n            {hints.map((hint, i) => (\n              <div key={hint.rowId} style={cardStyle} data-test-hint-index={i}>\n                <div style={cardHeaderStyle}>\n                  <span style={{ ...subLabelStyle, marginBottom: 0 }}>\n                    Reveal after\n                  </span>\n                  <input\n                    type=\"number\"\n                    min={0}\n                    data-testid={`cloze-edit-hint-after-${i}`}\n                    value={hint.revealAfterAttempts}\n                    onChange={(e) =>\n                      updateHint(hint.rowId, {\n                        revealAfterAttempts: Math.max(\n                          0,\n                          Math.floor(Number(e.target.value) || 0),\n                        ),\n                      })\n                    }\n                    style={{ ...inputStyle, width: 90 }}\n                  />\n                  <span style={{ ...subLabelStyle, marginBottom: 0 }}>\n                    failed attempts\n                  </span>\n                  <button\n                    type=\"button\"\n                    data-testid={`cloze-edit-hint-remove-${i}`}\n                    onClick={() => removeHint(hint.rowId)}\n                    aria-label={`Remove hint ${i + 1}`}\n                    style={{ ...removeButtonStyle, marginLeft: 'auto' }}\n                  >\n                    <Trash2 size={13} aria-hidden />\n                  </button>\n                </div>\n                <textarea\n                  data-testid={`cloze-edit-hint-md-${i}`}\n                  value={hint.markdown}\n                  onChange={(e) =>\n                    updateHint(hint.rowId, { markdown: e.target.value })\n                  }\n                  placeholder=\"Hint markdown\"\n                  style={{ ...textareaStyle, minHeight: 56 }}\n                />\n              </div>\n            ))}\n          </div>\n          <button\n            type=\"button\"\n            data-testid=\"cloze-edit-add-hint\"\n            onClick={addHint}\n            style={addButtonStyle}\n          >\n            <Plus size={12} aria-hidden /> Add hint\n          </button>\n        </div>\n\n        <SourcesField sources={sources} onChange={setSources} />\n\n        {errors._root && <div style={errorTextStyle}>{errors._root}</div>}\n      </div>\n\n      <EditorFormSaveError message={saveError} />\n      <EditorFormFooter\n        saving={saving}\n        saveDisabled={!dirty}\n        onCancel={onCancel}\n        onSave={() => void handleSave()}\n        cancelTestId=\"cloze-edit-cancel\"\n        saveTestId=\"cloze-edit-save\"\n      />\n    </div>\n  );\n}\n","numLines":713,"startLine":1,"totalLines":713}}}
