t\n454\t  it('regex: invalid pattern returns false instead of throwing', () => {\n455\t    const v = { kind: 'regex' as const, pattern: '(' };\n456\t    expect(validateSlotValue(v, 'x')).toBe(false);\n457\t  });\n458\t});\n459\t\n460\tdescribe('ParametricExplorer param value serialization', () => {\n461\t  // Param values are passed to Pyodide as a plain JS object — Pyodide's\n462\t  // automatic JS↔Python conversion turns:\n463\t  //   number → float, boolean → bool, string → str\n464\t  // These tests pin the serialized shape that the worker forwards to Python\n465\t  // so a future refactor doesn't silently change types under the user's code.\n466\t  it('slider param serializes as a JS number (→ Python float)', () => {\n467\t    const params: Record<string, number | string | boolean> = { freq: 1.5 };\n468\t    expect(typeof params.freq).toBe('number');\n469\t    expect(Number.isFinite(params.freq as number)).toBe(true);\n470\t  });\n471\t\n472\t  it('toggle param serializes as a JS boolean (→ Python bool)', () => {\n473\t    const params: Record<string, number | string | boolean> = { on: true };\n474\t    expect(typeof params.on).toBe('boolean');\n475\t    expect(params.on).toBe(true);\n476\t  });\n477\t\n478\t  it('select param serializes as a JS string (→ Python str)', () => {\n479\t    const params: Record<string, number | string | boolean> = { mode: 'fast' };\n480\t    expect(typeof params.mode).toBe('string');\n481\t    expect(params.mode).toBe('fast');\n482\t  });\n483\t\n484\t  it('mixed params object preserves each per-param type', () => {\n485\t    const params: Record<string, number | string | boolean> = {\n486\t      freq: 2,\n487\t      mode: 'fast',\n488\t      on: false,\n489\t    };\n490\t    expect(typeof params.freq).toBe('number');\n491\t    expect(typeof params.mode).toBe('string');\n492\t    expect(typeof params.on).toBe('boolean');\n493\t  });\n494\t});\n495\t\n496\tdescribe('ProgressSchema', () => {\n497\t  const minimal = { courses: {} };\n498\t\n499\t  it('parses an empty progress object', () => {\n500\t    expect(() => ProgressSchema.parse(minimal)).not.toThrow();\n501\t  });\n502\t\n503\t  it('parses nested course/lesson progress', () => {\n504\t    const ok = {\n505\t      courses: {\n506\t        algebra: {\n507\t          lastVisitedLessonSlug: 'lesson-1',\n508\t          lastVisitedAt: '2026-04-30T00:00:00Z',\n509\t          lessons: {\n510\t            'lesson-1': {\n511\t              status: 'started',\n512\t              startedAt: '2026-04-30T00:00:00Z',\n513\t              sectionState: {\n514\t                's1': { userCode: 'x = 1' },\n515\t              },\n516\t            },\n517\t          },\n518\t        },\n519\t      },\n520\t    };\n521\t    expect(() => ProgressSchema.parse(ok)).not.toThrow();\n522\t  });\n523\t\n524\t  it('throws on missing required field (courses)', () => {\n525\t    expect(() => ProgressSchema.parse({})).toThrow();\n526\t  });\n527\t\n528\t  it('rejects an unknown lesson status', () => {\n529\t    expect(() =>\n530\t      ProgressSchema.parse({\n531\t        courses: {\n532\t          algebra: { lessons: { 'l1': { status: 'paused' } } },\n533\t        },\n534\t      }),\n535\t    ).toThrow();\n536\t  });\n537\t});\n538\t\n539\tdescribe('CourseSpecSchema', () => {\n540\t  const minimal = {\n541\t    topic: 'Linear algebra',\n542\t    level: 'beginner',\n543\t    durationTarget: '1h',\n544\t    theoryPracticeRatio: 0.5,\n545\t    draftStructure: {\n546\t      courseTitle: 'LA 101',\n547\t      courseDescription: 'Intro',\n548\t      modules: [\n549\t        {\n550\t          title: 'Vectors',\n551\t          lessons: [{ title: 'What is a vector?', summary: '...', estimatedMinutes: 10 }],\n552\t        },\n553\t      ],\n554\t    },\n555\t    createdAt: '2026-04-30T00:00:00Z',\n556\t  };\n557\t\n558\t  it('parses a minimal valid spec', () => {\n559\t    expect(() => CourseSpecSchema.parse(minimal)).not.toThrow();\n560\t  });\n561\t\n562\t  it('throws on missing required field (topic)', () => {\n563\t    const broken: Partial<typeof minimal> = { ...minimal };\n564\t    delete broken.topic;\n565\t    expect(() => CourseSpecSchema.parse(broken)).toThrow();\n566\t  });\n567\t\n568\t  it('rejects an unknown level', () => {\n569\t    expect(() => CourseSpecSchema.parse({ ...minimal, level: 'expert' })).toThrow();\n570\t  });\n571\t\n572\t  it('parses each new durationTarget enum value', () => {\n573\t    for (const dt of ['short', 'standard', 'extensive', 'comprehensive'] as const) {\n574\t      const parsed = CourseSpecSchema.parse({ ...minimal, durationTarget: dt });\n575\t      expect(parsed.durationTarget).toBe(dt);\n576\t    }\n577\t  });\n578\t\n579\t  it('maps legacy durationTarget values to the new enum', () => {\n580\t    const cases: { input: string; expected: 'short' | 'standard' | 'extensive' }[] = [\n581\t      { input: '30min', expected: 'short' },\n582\t      { input: '1h', expected: 'standard' },\n583\t      { input: 'weekend', expected: 'extensive' },\n584\t    ];\n585\t    for (const { input, expected } of cases) {\n586\t      const parsed = CourseSpecSchema.parse({ ...minimal, durationTarget: input });\n587\t      expect(parsed.durationTarget).toBe(expected);\n588\t    }\n589\t  });\n590\t\n591\t  it('rejects an out-of-enum durationTarget value', () => {\n592\t    expect(() => CourseSpecSchema.parse({ ...minimal, durationTarget: 'forever' })).toThrow();\n593\t  });\n594\t});\n595\t"}]},"parent_tool_use_id":null,"session_id":"07080243-aa8d-441b-9ce0-ebebd57b013c","uuid":"45238c85-6692-4720-ad75-60bed67d17d5","timestamp":"2026-05-03T22:04:23.407Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-047/src/lib/schemas/schemas.test.ts","content":"  it('CodeClozeData: rejects unknown validation kind', () => {\n    expect(() =>\n      CodeClozeDataSchema.parse({\n        template: '{{x}}',\n        slots: [\n          {\n            id: 'x',\n            valid