{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EEaSH1XNqmtnSFmG8eThBt","type":"tool_result","content":"1\timport { z } from 'zod';\n2\timport { TheoryDataSchema } from '@/widgets/Theory/schema';\n3\timport { QuizDataSchema } from '@/widgets/Quiz/schema';\n4\timport { CodeDataSchema } from '@/widgets/Code/schema';\n5\timport { CodeClozeDataSchema } from '@/widgets/CodeCloze/schema';\n6\timport { DemoDataSchema } from '@/widgets/Demo/schema';\n7\timport { SandboxDataSchema } from '@/widgets/Sandbox/schema';\n8\timport { HistogramDataSchema } from '@/widgets/Histogram/schema';\n9\timport { ParametricExplorerDataSchema } from '@/widgets/ParametricExplorer/schema';\n10\timport { PlotImageDataSchema } from '@/widgets/PlotImage/schema';\n11\t\n12\texport const SourceKindSchema = z.enum(['paper', 'video', 'article', 'book']);\n13\t\n14\texport const SourceSchema = z.object({\n15\t  url: z.string().url(),\n16\t  title: z.string().min(1),\n17\t  kind: SourceKindSchema,\n18\t  author: z.string().optional(),\n19\t  year: z.number().int().optional(),\n20\t});\n21\t\n22\texport type SourceKind = z.infer<typeof SourceKindSchema>;\n23\texport type Source = z.infer<typeof SourceSchema>;\n24\t\n25\tconst sectionBase = {\n26\t  id: z.string(),\n27\t  title: z.string(),\n28\t  sources: z.array(SourceSchema).optional(),\n29\t};\n30\t\n31\texport const TheorySectionSchema = z.object({\n32\t  ...sectionBase,\n33\t  type: z.literal('theory'),\n34\t  data: TheoryDataSchema,\n35\t});\n36\t\n37\texport const QuizSectionSchema = z.object({\n38\t  ...sectionBase,\n39\t  type: z.literal('quiz'),\n40\t  data: QuizDataSchema,\n41\t});\n42\t\n43\texport const CodeSectionSchema = z.object({\n44\t  ...sectionBase,\n45\t  type: z.literal('code'),\n46\t  data: CodeDataSchema,\n47\t});\n48\t\n49\texport const CodeClozeSectionSchema = z.object({\n50\t  ...sectionBase,\n51\t  type: z.literal('codeCloze'),\n52\t  data: CodeClozeDataSchema,\n53\t});\n54\t\n55\texport const DemoSectionSchema = z.object({\n56\t  ...sectionBase,\n57\t  type: z.literal('demo'),\n58\t  data: DemoDataSchema,\n59\t});\n60\t\n61\texport const SandboxSectionSchema = z.object({\n62\t  ...sectionBase,\n63\t  type: z.literal('sandbox'),\n64\t  data: SandboxDataSchema,\n65\t});\n66\t\n67\texport const HistogramSectionSchema = z.object({\n68\t  ...sectionBase,\n69\t  type: z.literal('histogram'),\n70\t  data: HistogramDataSchema,\n71\t});\n72\t\n73\texport const PlotImageSectionSchema = z.object({\n74\t  ...sectionBase,\n75\t  type: z.literal('plotImage'),\n76\t  data: PlotImageDataSchema,\n77\t});\n78\t\n79\texport const ParametricExplorerSectionSchema = z.object({\n80\t  ...sectionBase,\n81\t  type: z.literal('parametricExplorer'),\n82\t  data: ParametricExplorerDataSchema,\n83\t});\n84\t\n85\texport const CustomSectionSchema = z.object({\n86\t  ...sectionBase,\n87\t  type: z.literal('custom'),\n88\t  data: z.record(z.unknown()),\n89\t});\n90\t\n91\texport const SectionSchema = z.discriminatedUnion('type', [\n92\t  TheorySectionSchema,\n93\t  QuizSectionSchema,\n94\t  CodeSectionSchema,\n95\t  CodeClozeSectionSchema,\n96\t  DemoSectionSchema,\n97\t  SandboxSectionSchema,\n98\t  HistogramSectionSchema,\n99\t  PlotImageSectionSchema,\n100\t  ParametricExplorerSectionSchema,\n101\t  CustomSectionSchema,\n102\t]);\n103\t\n104\texport type Section = z.infer<typeof SectionSchema>;\n105\t\n106\texport const LessonSchema = z.object({\n107\t  schemaVersion: z.number().int().default(1),\n108\t  slug: z.string(),\n109\t  courseSlug: z.string(),\n110\t  moduleId: z.string(),\n111\t  title: z.string(),\n112\t  eyebrow: z.string(),\n113\t  description: z.string(),\n114\t  estimatedMinutes: z.number().int().positive(),\n115\t  pythonSession: z.enum(['shared', 'isolated']).optional(),\n116\t  sections: z.array(SectionSchema),\n117\t  sources: z.array(SourceSchema).optional(),\n118\t});\n119\t\n120\texport type Lesson = z.infer<typeof LessonSchema>;\n121\t"}]},"parent_tool_use_id":null