{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UqpFjJrWf3ARuAH8jWcM3j","type":"tool_result","content":"1\timport type { ComponentType, CSSProperties, ReactNode } from 'react';\n2\timport {\n3\t  AlertOctagon,\n4\t  AlertTriangle,\n5\t  Info,\n6\t  Lightbulb,\n7\t  type LucideProps,\n8\t} from 'lucide-react';\n9\t\n10\texport type CalloutTone = 'info' | 'insight' | 'warning' | 'danger';\n11\t\n12\tinterface ToneSpec {\n13\t  bg: string;\n14\t  border: string;\n15\t  color: string;\n16\t  Icon: ComponentType<LucideProps>;\n17\t}\n18\t\n19\tconst toneMap: Record<CalloutTone, ToneSpec> = {\n20\t  info: {\n21\t    bg: 'var(--info-subtle)',\n22\t    border: 'var(--info-border)',\n23\t    color: 'var(--info)',\n24\t    Icon: Info,\n25\t  },\n26\t  insight: {\n27\t    bg: 'var(--insight-subtle)',\n28\t    border: 'var(--insight-border)',\n29\t    color: 'var(--insight)',\n30\t    Icon: Lightbulb,\n31\t  },\n32\t  warning: {\n33\t    bg: 'var(--warning-subtle)',\n34\t    border: 'var(--warning-border)',\n35\t    color: 'var(--warning)',\n36\t    Icon: AlertTriangle,\n37\t  },\n38\t  danger: {\n39\t    bg: 'var(--danger-subtle)',\n40\t    border: 'var(--danger-border)',\n41\t    color: 'var(--danger)',\n42\t    Icon: AlertOctagon,\n43\t  },\n44\t};\n45\t\n46\texport interface CalloutProps {\n47\t  tone?: CalloutTone;\n48\t  title?: string;\n49\t  children?: ReactNode;\n50\t}\n51\t\n52\tconst wrapStyle = (spec: ToneSpec): CSSProperties => ({\n53\t  background: spec.bg,\n54\t  border: `1px solid ${spec.border}`,\n55\t  borderRadius: 'var(--radius-md)',\n56\t  padding: 'var(--space-4) var(--space-5)',\n57\t  display: 'flex',\n58\t  gap: 'var(--space-3)',\n59\t  margin: 'var(--space-4) 0',\n60\t});\n61\t\n62\tconst iconStyle = (spec: ToneSpec): CSSProperties => ({\n63\t  color: spec.color,\n64\t  flexShrink: 0,\n65\t  marginTop: 2,\n66\t  lineHeight: 0,\n67\t});\n68\t\n69\tconst titleStyle = (spec: ToneSpec): CSSProperties => ({\n70\t  fontWeight: 600,\n71\t  color: spec.color,\n72\t  marginBottom: 4,\n73\t  fontSize: 'var(--fs-sm)',\n74\t  lineHeight: 1.35,\n75\t});\n76\t\n77\tconst bodyStyle: CSSProperties = {\n78\t  color: 'var(--text-secondary)',\n79\t  fontSize: 'var(--fs-sm)',\n80\t  lineHeight: 1.65,\n81\t};\n82\t\n83\texport function Callout({ tone = 'info', title, children }: CalloutProps) {\n84\t  const spec = toneMap[tone];\n85\t  const Icon = spec.Icon;\n86\t  return (\n87\t    <aside data-callout-tone={tone} style={wrapStyle(spec)}>\n88\t      <div style={iconStyle(spec)}>\n89\t        <Icon size={16} aria-hidden />\n90\t      </div>\n91\t      <div style={{ flex: 1, minWidth: 0 }}>\n92\t        {title ? <div style={titleStyle(spec)}>{title}</div> : null}\n93\t        <div style={bodyStyle}>{children}</div>\n94\t      </div>\n95\t    </aside>\n96\t  );\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"07080243-aa8d-441b-9ce0-ebebd57b013c","uuid":"deb905f7-a7ac-46b2-ae10-1e69dfb79500","timestamp":"2026-05-03T22:04:46.195Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-047/src/components/Callout.tsx","content":"import type { ComponentType, CSSProperties, ReactNode } from 'react';\nimport {\n  AlertOctagon,\n  AlertTriangle,\n  Info,\n  Lightbulb,\n  type LucideProps,\n} from 'lucide-react';\n\nexport type CalloutTone = 'info' | 'insight' | 'warning' | 'danger';\n\ninterface ToneSpec {\n  bg: string;\n  border: string;\n  color: string;\n  Icon: ComponentType<LucideProps>;\n}\n\nconst toneMap: Record<CalloutTone, ToneSpec> = {\n  info: {\n    bg: 'var(--info-subtle)',\n    border: 'var(--info-border)',\n    color: 'var(--info)',\n    Icon: Info,\n  },\n  insight: {\n    bg: 'var(--insight-subtle)',\n    border: 'var(--insight-border)',\n    color: 'var(--insight)',\n    Icon: Lightbulb,\n  },\n  warning: {\n    bg: 'var(--warning-subtle)',\n    border: 'var(--warning-border)',\n    color: 'var(--warning)',\n    Icon: AlertTriangle,\n  },\n  danger: {\n    bg: 'var(--danger-subtle)',\n    border: 'var(--danger-border)',\n    color: 'var(--danger)',\n    Icon: AlertOctagon,\n  },\n};\n\nexport interface CalloutProps {\n  tone?: CalloutTone;\n  title?: string;\n  children?: ReactNode;\n}\n\nconst wrapStyle = (spec: ToneSpec): CSSProperties => ({\n  background: spec.bg,\n  border: `1px solid ${spec.border}`,\n  borderRadius: 'var(--radius-md)',\n  padding: 'var(--space-4) var(--space-5)',\n  display: 'flex',\n  gap: 'var(--space-3)',\n  margin: 'var(--space-4) 0',\n});\n\nconst iconStyle = (spec: ToneSpec): CSSProperties => ({\n  color: spec.color,\n  flexShrink: 0,\n  marginTop: 2,\n  lineHeight: 0,\n});\n\nconst titleStyle = (spec: ToneSpec): CSSProperties => ({\n  fontWeight: 600,\n  color: spec.color,\n  marginBottom: 4,\n  fontSize: 'var(--fs-sm)',\n  lineHeight: 1.35,\n});\n\nconst bodyStyle: CSSProperties = {\n  color: 'var(--text-secondary)',\n  fontSize: 'var(--fs-sm)',\n  lineHeight: 1.65,\n};\n\nexport function Callout({ tone = 'info', title, children }: CalloutProps) {\n  const spec = toneMap[tone];\n  const Icon = spec.Icon;\n  return (\n    <aside data-callout-tone={tone} style={wrapStyle(spec)}>\n      <div style={iconStyle(spec)}>\n        <Icon size={16} aria-hidden />\n      </div>\n      <div style={{ flex: 1, minWidth: 0 }}>\n        {title ? <div style={titleStyle(spec)}>{title}</div> : null}\n        <div style={bodyStyle}>{children}</div>\n      </div>\n    </aside>\n  );\n}\n","numLines":98,"startLine":1,"totalLines":98}}}
