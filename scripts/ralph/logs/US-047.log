\nconst os = require('os');\n\nasync function main() {\n  // Clear persisted \"done\" state so the badge isn't pre-set from a prior run.\n  const progressFile = path.join(os.homedir(), '.ai-lecturer', 'progress.json');\n  if (fs.existsSync(progressFile)) {\n    try {\n      const j = JSON.parse(fs.readFileSync(progressFile, 'utf8'));\n      const ls =\n        j?.courses?.['dragmatch-test']?.lessons?.['terms']?.sectionState ?? null;\n      if (ls && ls.dm1) {\n        delete ls.dm1;\n        fs.writeFileSync(progressFile, JSON.stringify(j, null, 2));\n        console.log('cleared progress for dm1');\n      }\n    } catch {}\n  }\n\n  const browser = await chromium.launch({ headless: true });\n  const context = await browser.newContext({ viewport: { width: 1280, height: 900 } });\n  const page = await context.newPage();\n  page.on('pageerror', (err) => console.log('PAGE EXCEPTION:', err.message));\n\n  await page.goto(TARGET_URL, { waitUntil: 'domcontentloaded', timeout: 30_000 });\n  await page.waitForSelector('[data-testid=\"dragmatch-bank\"]', { timeout: 15_000 });\n\n  // Focus i-var\n  await page.focus('[data-testid=\"dragmatch-item-i-var\"]');\n  await page.keyboard.press('Space'); // lift\n  await page.waitForTimeout(150);\n  // Move down (move to zone area via arrow key)\n  await page.keyboard.press('ArrowDown');\n  await page.waitForTimeout(80);\n  await page.keyboard.press('ArrowDown');\n  await page.waitForTimeout(80);\n  await page.keyboard.press('Space'); // drop\n  await page.waitForTimeout(200);\n\n  await page.screenshot({ path: '/tmp/us-047-keyboard.png', fullPage: true });\n\n  // Check that i-var moved out of the bank (regardless of which zone it landed in)\n  const bankItems = await page.$$eval(\n    '[data-testid=\"dragmatch-bank\"] [data-item-id]',\n    (els) => els.map((e) => e.getAttribute('data-item-id')),\n  );\n  console.log('   bank items after keyboard drag:', bankItems);\n\n  if (bankItems.includes('i-var')) {\n    throw new Error('keyboard drag did not move i-var out of bank');\n  }\n\n  console.log('SUCCESS - keyboard drag works');\n  await browser.close();\n}\n\nmain().catch((err) => {\n  console.error('FAILURE', err);\n  process.exit(1);\n});\n","userModified":false}}
