n  --insight-border: #ddccf2;\n\n  /* Widget accent rails */\n  --widget-theory: #56524a;\n  --widget-demo: #2563eb;\n  --widget-quiz: #6b3eaa;\n  --widget-code: #0d7a5f;\n  --widget-code-cloze: #1f6f8b;\n  --widget-sandbox: #b45309;\n  --widget-histogram: #4e7a85;\n  --widget-plot-image: #876b3a;\n  --widget-parametric-explorer: #5a4f8a;\n  --widget-drag-match: #8a4a6f;\n\n  /* Code block */\n  --code-bg: #fafaf7;\n  --code-text: #18171a;\n  --code-keyword: #6b3eaa;\n  --code-string: #0d7a5f;\n  --code-comment: #8a8479;\n  --code-fn: #2563eb;\n  --code-number: #b45309;\n\n  /* Shadows */\n  --shadow-xs: 0 1px 2px rgba(24, 23, 26, 0.04);\n  --shadow-sm: 0 1px 3px rgba(24, 23, 26, 0.06), 0 1px 2px rgba(24, 23, 26, 0.04);\n  --shadow-md: 0 2px 6px rgba(24, 23, 26, 0.06), 0 4px 12px rgba(24, 23, 26, 0.04);\n  --shadow-lg: 0 4px 12px rgba(24, 23, 26, 0.08), 0 12px 32px rgba(24, 23, 26, 0.06);\n  --shadow-focus: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);\n}\n\n:root[data-theme=\"dark\"] {\n  --bg: #0f0e11;\n  --bg-elevated: #18171a;\n  --bg-subtle: #1c1b1f;\n  --bg-hover: #232227;\n  --bg-active: #2c2b30;\n  --bg-inverse: #fdfcfa;\n\n  --border: #2a282d;\n  --border-strong: #3a383e;\n  --border-focus: var(--accent);\n\n  --text: #f0ede7;\n  --text-secondary: #b3ad9f;\n  --text-tertiary: #8a8479;\n  --text-quaternary: #56524a;\n  --text-inverse: #18171a;\n  --text-on-accent: #ffffff;\n\n  --accent: #4f8aff;\n  --accent-hover: #6b9eff;\n  --accent-active: #3f7aef;\n  --accent-subtle: #1a2336;\n  --accent-subtle-hover: #1f2a44;\n  --accent-border: #2c3e6a;\n  --accent-text: #87aeff;\n\n  --success: #4ec79a;\n  --success-subtle: #142b22;\n  --success-border: #1e4435;\n\n  --warning: #e0a458;\n  --warning-subtle: #2c2317;\n  --warning-border: #4a3a22;\n\n  --danger: #ef6f6f;\n  --danger-subtle: #2c1818;\n  --danger-border: #4a2727;\n\n  --insight: #b794ed;\n  --insight-subtle: #251c36;\n  --insight-border: #3d2f57;\n\n  --widget-theory: #b3ad9f;\n  --widget-demo: #4f8aff;\n  --widget-quiz: #b794ed;\n  --widget-code: #4ec79a;\n  --widget-code-cloze: #6cc0d8;\n  --widget-sandbox: #e0a458;\n  --widget-histogram: #82b3bd;\n  --widget-plot-image: #c9a96b;\n  --widget-parametric-explorer: #a594d8;\n\n  --code-bg: #131215;\n  --code-text: #f0ede7;\n  --code-keyword: #b794ed;\n  --code-string: #4ec79a;\n  --code-comment: #6a655c;\n  --code-fn: #87aeff;\n  --code-number: #e0a458;\n\n  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.3);\n  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.2);\n  --shadow-md: 0 2px 6px rgba(0, 0, 0, 0.4), 0 4px 12px rgba(0, 0, 0, 0.25);\n  --shadow-lg: 0 4px 12px rgba(0, 0, 0, 0.5), 0 12px 32px rgba(0, 0, 0, 0.3);\n  --shadow-focus: 0 0 0 3px color-mix(in srgb, var(--accent) 30%, transparent);\n}\n\n/* Accent variants */\n:root[data-accent=\"default\"] {\n  --accent: #2563eb;\n  --accent-hover: #1d4fd7;\n  --accent-active: #1a44b8;\n  --accent-subtle: #eaf0fd;\n  --accent-subtle-hover: #dbe5fc;\n  --accent-border: #c2d2f8;\n  --accent-text: #1d4fd7;\n}\n:root[data-theme=\"dark\"][data-accent=\"default\"] {\n  --accent: #4f8aff;\n  --accent-hover: #6b9eff;\n  --accent-active: #3f7aef;\n  --accent-subtle: #1a2336;\n  --accent-subtle-hover: #1f2a44;\n  --accent-border: #2c3e6a;\n  --accent-text: #87aeff;\n}\n\n:root[data-accent=\"black\"] {\n  --accent: #18171a;\n  --accent-hover: #2c2b30;\n  --accent-active: #000000;\n  --accent-subtle: #f0ede7;\n  --accent-subtle-hover: #e8e4dc;\n  --accent-border: #d4cec3;\n  --accent-text: #18171a;\n}\n:root[data-theme=\"dark\"][data-accent=\"black\"] {\n  --accent: #f0ede7;\n  --accent-hover: #ffffff;\n  --accent-active: #d4cec3;\n  --accent-subtle: #232227;\n  --accent-subtle-hover: #2c2b30;\n  --accent-border: #3a383e;\n  --accent-text: #f0ede7;\n}\n\n:root[data-accent=\"indigo\"] {\n  --accent: #5b5bd6;\n  --accent-hover: #4a4ac3;\n  --accent-active: #3d3da8;\n  --accent-subtle: #eeeefb;\n  --accent-subtle-hover: #dfdff7;\n  --accent-border: #c8c8ee;\n  --accent-text: #4a4ac3;\n}\n:root[data-theme=\"dark\"][data-accent=\"indigo\"] {\n  --accent: #8989f0;\n  --accent-hover: #a0a0f5;\n  --accent-active: #7373eb;\n  --accent-subtle: #21213a;\n  --accent-subtle-hover: #292946;\n  --accent-border: #3a3a5e;\n  --accent-text: #b0b0f5;\n}\n\n:root[data-accent=\"terracotta\"] {\n  --accent: #d97757;\n  --accent-hover: #c8654a;\n  --accent-active: #b45736;\n  --accent-subtle: #fbeee7;\n  --accent-subtle-hover: #f7dccf;\n  --accent-border: #efbfa8;\n  --accent-text: #b45736;\n}\n:root[data-theme=\"dark\"][data-accent=\"terracotta\"] {\n  --accent: #e89172;\n  --accent-hover: #f0a589;\n  --accent-active: #d97757;\n  --accent-subtle: #2e1d15;\n  --accent-subtle-hover: #3a261c;\n  --accent-border: #56382a;\n  --accent-text: #f0a589;\n}\n\n:root[data-accent=\"emerald\"] {\n  --accent: #0d7a5f;\n  --accent-hover: #0a6b53;\n  --accent-active: #075a45;\n  --accent-subtle: #e3f3ec;\n  --accent-subtle-hover: #cfe9dc;\n  --accent-border: #a8d6bf;\n  --accent-text: #0a6b53;\n}\n:root[data-theme=\"dark\"][data-accent=\"emerald\"] {\n  --accent: #4ec79a;\n  --accent-hover: #6dd2ad;\n  --accent-active: #3eb888;\n  --accent-subtle: #142b22;\n  --accent-subtle-hover: #1c3d30;\n  --accent-border: #285a47;\n  --accent-text: #6dd2ad;\n}\n\n/* Density modes — affect spacing scale globally */\n:root,\n:root[data-density=\"comfortable\"] {\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-7: 32px;\n  --space-8: 40px;\n  --space-9: 56px;\n  --space-10: 80px;\n  --space-section: 48px;\n  --line-height-prose: 1.7;\n}\n\n:root[data-density=\"compact\"] {\n  --space-1: 3px;\n  --space-2: 6px;\n  --space-3: 9px;\n  --space-4: 12px;\n  --space-5: 16px;\n  --space-6: 20px;\n  --space-7: 24px;\n  --space-8: 32px;\n  --space-9: 44px;\n  --space-10: 64px;\n  --space-section: 32px;\n  --line-height-prose: 1.6;\n}\n\n:root[data-density=\"spacious\"] {\n  --space-1: 4px;\n  --space-2: 10px;\n  --space-3: 14px;\n  --space-4: 20px;\n  --space-5: 26px;\n  --space-6: 32px;\n  --space-7: 44px;\n  --space-8: 56px;\n  --space-9: 72px;\n  --space-10: 96px;\n  --space-section: 64px;\n  --line-height-prose: 1.8;\n}\n\n:root {\n  /* Info tone aliases — info ≡ accent in this design system (per claude/design/source/components.jsx) */\n  --info: var(--accent);\n  --info-subtle: var(--accent-subtle);\n  --info-border: var(--accent-border);\n\n  /* Border radii */\n  --radius-xs: 3px;\n  --radius-sm: 5px;\n  --radius-md: 7px;\n  --radius-lg: 10px;\n  --radius-xl: 14px;\n  --radius-2xl: 20px;\n  --radius-full: 9999px;\n\n  /* Type scale */\n  --fs-xs: 11px;\n  --fs-sm: 13px;\n  --fs-base: 14.5px;\n  --fs-md: 16px;\n  --fs-lg: 18px;\n  --fs-xl: 22px;\n  --fs-2xl: 28px;\n  --fs-3xl: 36px;\n  --fs-4xl: 48px;\n  --fs-5xl: 64px;\n\n  /* Fonts — wired by next/font in layout.tsx via --font-geist-sans / --font-geist-mono */\n  --font-sans: var(--font-geist-sans), -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n  --font-mono: var(--font-geist-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  --font-prose: var(--font-geist-sans), -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n  --font-display: var(--font-geist-sans), -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n\n  /* Easings / transitions */\n  --t-fast: 120ms cubic-bezier(0.16, 1, 0.3, 1);\n  --t-base: 180ms cubic-bezier(0.16, 1, 0.3, 1);\n  --t-slow: 280ms cubic-bezier(0.16, 1, 0.3, 1);\n}\n","structuredPatch":[{"oldStart":131,"oldLines":6,"newStart":131,"newLines":7,"lines":["   --widget-histogram: #82b3bd;","   --widget-plot-image: #c9a96b;","   --widget-parametric-explorer: #a594d8;","+  --widget-drag-match: #d094b3;"," ","   --code-bg: #131215;","   --code-text: #f0ede7;"]}],"userModified":false,"replaceAll":false}}
