{
  "$ref": "#/definitions/videoData",
  "definitions": {
    "videoData": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "youtube",
            "mp4"
          ]
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tStart": {
                "type": "number",
                "minimum": 0
              },
              "tEnd": {
                "type": "number",
                "minimum": 0
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "speaker": {
                "type": "string"
              }
            },
            "required": [
              "tStart",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "autoplay": {
          "type": "boolean",
          "default": false
        },
        "startAt": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "src"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
