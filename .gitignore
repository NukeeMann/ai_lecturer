# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# atomic-write scratch files (course.json.tmp, course-spec.json.tmp, lessons/*.json.tmp)
/courses/**/*.tmp

# US-103: server-side staging dir for /create's "I have materials" path
# (uploads bound to a draftId before the slug is finalized). Files get
# moved into /courses/<slug>/sources/ at POST /api/courses time.
/courses/.drafts/

# ralph orchestrator runtime locks (transient; prd.json + logs are committed)
/.ralph-locks/

# ralph orchestrator per-story worktrees (transient; merged work is on main)
/.worktrees/
