# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.claude/
temp/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
secrets.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# atomic-write scratch files (course.json.tmp, course-spec.json.tmp, lessons/*.json.tmp)
/courses/**/*.tmp

# US-148: per-lesson "previous version" snapshot written by the regenerate
# route so the companion undo route can revert. Single-step undo by design;
# the snapshot is local UX state, not committed history.
/courses/**/*.lesson-prev.json

# US-103: server-side staging dir for /create's "I have materials" path
# (uploads bound to a draftId before the slug is finalized). Files get
# moved into /courses/<slug>/sources/ at POST /api/courses time.
/courses/.drafts/

# US-142: soft-deleted courses (mv to .trash/<slug>-<ts>/ instead of rm).
# Recoverable from the filesystem but not part of the project's tracked
# state — keep them out of git so a delete doesn't leave a tombstone.
/courses/.trash/

# Institutional exam source material — entire course pulled from VCS
# because the bachelor's-defense question list (institutional IP) seeds
# every artifact here: lessons quote it, generation/per-lesson logs cite
# it, and course-spec/research embed it. Keep local-only.
/courses/opracowanie-pytan-na-obrone-licencjacka-zarzadzanie/

# Analytic-geometry kartkówka course — untracked at user request, kept local-only.
/courses/geometria-analityczna-szybkie-przygotowanie-do-kartkowki/

# ralph orchestrator runtime locks (transient; prd.json + logs are committed)
/.ralph-locks/

# ralph orchestrator per-story worktrees (transient; merged work is on main)
/.worktrees/

# US-154: TTS/STT install artifacts produced by scripts/setup-{tts,stt}.sh.
# whisper.cpp clone + build (~150MB) and the Coqui venv (~3GB with torch +
# XTTS model) are reproducible from those scripts, never tracked.
/scripts/.bin/
/scripts/.venv/

.scratch/
.course-backups/

courses/ukad-moczowy-budowa-funkcjonowanie-i-choroby/
courses/faza-i-intuicja-matematyczna-w-robotyce-i-inzynierii-symulacyjnej/
courses/weterynaryjne-badanie-miesa-i-nadzor-sanitarny-quiz-powtorkowy-do-egzaminu
courses/higiena-miesa-powtorka-egzaminacyjna-z-notatek-k1-i-k2