er = new IntersectionObserver(\n100\t      (entries) => {\n101\t        for (const entry of entries) {\n102\t          const id = (entry.target as HTMLElement).getAttribute(\n103\t            'data-section-id',\n104\t          );\n105\t          if (id === null) continue;\n106\t          if (entry.isIntersecting) {\n107\t            visible.add(id);\n108\t          } else {\n109\t            visible.delete(id);\n110\t          }\n111\t        }\n112\t        recompute();\n113\t      },\n114\t      { rootMargin: '0px 0px -75% 0px', threshold: 0 },\n115\t    );\n116\t\n117\t    for (const el of targets) {\n118\t      observer.observe(el);\n119\t    }\n120\t\n121\t    // Seed activeSectionId with the section nearest the top right now,\n122\t    // so the very first message after opening the panel has a reasonable\n123\t    // sectionId before the observer fires.\n124\t    const main =\n125\t      document.querySelector<HTMLElement>('[data-testid=\"lesson-content\"]') ??\n126\t      null;\n127\t    if (main && targets.length > 0) {\n128\t      const mainTop = main.scrollTop;\n129\t      let seedId: string | null = null;\n130\t      for (const el of targets) {\n131\t        const id = el.getAttribute('data-section-id');\n132\t        if (id === null) continue;\n133\t        const offset =\n134\t          el.getBoundingClientRect().top -\n135\t          main.getBoundingClientRect().top +\n136\t          main.scrollTop;\n137\t        if (offset <= mainTop + 8) {\n138\t          seedId = id;\n139\t        }\n140\t      }\n141\t      if (seedId !== null) {\n142\t        // eslint-disable-next-line react-hooks/set-state-in-effect\n143\t        setActiveSectionId(seedId);\n144\t      }\n145\t    }\n146\t\n147\t    return () => {\n148\t      observer.disconnect();\n149\t      // Reset the tracker if the lesson changes mid-flight.\n150\t      if (lessonSlugAtMount !== lessonSlug) {\n151\t        ratios.clear();\n152\t      }\n153\t    };\n154\t  }, [open, lessonSlug, courseSlug]