orderStyle: 'solid',\n  borderRadius: 'var(--radius-sm)',\n  fontSize: 'var(--fs-sm)',\n  fontFamily: 'var(--font-sans)',\n  fontWeight: 500,\n};\n\nconst sendBtnStyle: CSSProperties = {\n  ...sendBtnBase,\n  borderColor: 'var(--accent)',\n  background: 'var(--accent)',\n  color: 'var(--accent-fg, #ffffff)',\n  cursor: 'pointer',\n};\n\nconst sendBtnDisabledStyle: CSSProperties = {\n  ...sendBtnBase,\n  borderColor: 'var(--border)',\n  background: 'var(--bg-subtle)',\n  color: 'var(--text-quaternary)',\n  cursor: 'not-allowed',\n};\n","structuredPatch":[{"oldStart":63,"oldLines":21,"newStart":63,"newLines":13,"lines":["     if (!open) return;","     if (typeof IntersectionObserver === 'undefined') return;"," ","-    const lessonSlugAtMount = lessonSlug;","     // Map the section id → its DOM order index, so when several sections","     // straddle the \"active\" band at the top of the viewport, we pick the","     // last one (the one the learner has scrolled into).","     const orderById = new Map<string, number>();","     const visible = new Set<string>();","+    const observed = new WeakSet<Element>();"," ","-    const targets = Array.from(","-      document.querySelectorAll<HTMLElement>('[data-section-id]'),","-    );","-    targets.forEach((el, idx) => {","-      const id = el.getAttribute('data-section-id');","-      if (id !== null) orderById.set(id, idx);","-    });","-","     const recompute = () => {","       let bestId: string | null = null;","       let bestOrder = -1;"]},{"oldStart":93,"oldLines":12,"newStart":85,"newLines":8,"lines":["       }","     };"," ","-    // rootMargin biases the \"intersecting\" band to a thin strip near the","-    // top of the viewport so the active section corresponds to whatever","-    // is currently in view at the top, not whatever is biggest.","-    const observer = new IntersectionObserver(","+    const intersection = new IntersectionObserver(","       (entries) => {","-        console.log('[LessonChat] IO fired, entri