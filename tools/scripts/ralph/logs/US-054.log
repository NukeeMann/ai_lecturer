{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015nysNtTgAVUzDWejRR4rXy","type":"tool_result","content":"1\t/**\n2\t * LessonChat connector — bridges the API route to a backing Claude implementation.\n3\t *\n4\t * Two implementations are tried in order at first use, then cached for the lifetime\n5\t * of the server process:\n6\t *   1. Agent SDK (`@anthropic-ai/claude-agent-sdk`) — uses the user's local Claude\n7\t *      Code subscription. No API key.\n8\t *   2. Subprocess — spawns `claude -p \"<prompt>\" --output-format json` and parses\n9\t *      the resulting JSON.\n10\t *\n11\t * If neither works, `selectConnector()` returns `null` and the API surfaces a 503.\n12\t *\n13\t * Prompt assembly is intentionally minimal — full lesson-context wiring is US-054.\n14\t */\n15\timport { spawn, type ChildProcess } from 'node:child_process';\n16\t\n17\texport interface ChatMessage {\n18\t  role: 'user' | 'assistant';\n19\t  content: string;\n20\t}\n21\t\n22\texport interface ConnectorRequest {\n23\t  message: string;\n24\t  history?: ChatMessage[];\n25\t}\n26\t\n27\texport type ConnectorName = 'agent-sdk' | 'subprocess';\n28\t\n29\texport interface Connector {\n30\t  readonly name: ConnectorName;\n31\t  chat(req: ConnectorRequest): Promise<string>;\n32\t}\n33\t\n34\tconst SYSTEM_PREFIX =\n35\t  'You are an AI tutor for an interactive course. Answer concisely.';\n36\t\n37\texport function assemblePrompt(message: string): string {\n38\t  return `${SYSTEM_PREFIX}\\n\\n${message}`;\n39\t}\n40\t\n41\t// ---------------------------------------------------------------------------\n42\t// Subprocess connector\n43\t// ---------------------------------------------------------------------------\n44\t\n45\tconst SUBPROCESS_TIMEOUT_MS = 60_000;\n46\tconst SUBPROCESS_KILL_GRACE_MS = 5_000;\n47\t\n48\texport type SpawnFn = typeof spawn;\n49\t\n50\texport interface SubprocessConnectorOptions {\n51\t  command?: string;\n52\t  spawnFn?: SpawnFn;\n53\t  timeoutMs?: number;\n54\t  killGraceMs?: number;\n55\t}\n56\t\n57\texport function subprocessConnector(\n58\t  opts: SubprocessConnectorOptions = {},\n59\t): Connector {\n60\t  const command = opts.command ?? 'claude';\n61\t  const spawnFn = opts.spawnFn ?? spawn;\n62\t  const timeoutMs = opts.timeoutMs ?? SUBPROCESS_TIMEOUT_MS;\n63\t  const killGraceMs = opts.killGraceMs ?? SUBPROCESS_KILL_GRACE_MS;\n64\t\n65\t  return {\n66\t    name: 'subprocess',\n67\t    chat(req) {\n68\t      const prompt = assemblePrompt(req.message);\n69\t      return runClaudeCli(spawnFn, command, prompt, timeoutMs, killGraceMs);\n70\t    },\n71\t  };\n72\t}\n73\t\n74\tfunction runClaudeCli(\n75\t  spawnFn: SpawnFn,\n76\t  command: string,\n77\t  prompt: string,\n78\t  timeoutMs: number,\n79\t  killGraceMs: number,\n80\t): Promise<string> {\n81\t  return new Promise((resolve, reject) => {\n82\t    let child: ChildProcess;\n83\t    try {\n84\t      child = spawnFn(command, ['-p', prompt, '--output-format', 'json']);\n85\t    } catch (err) {\n86\t      reject(new Error(`claude spawn failed: ${(err as Error).message}`));\n87\t      return;\n88\t    }\n89\t\n90\t    let stdoutBuf = '';\n91\t    let stderrBuf = '';\n92\t    let timedOut = false;\n93\t    let settled = false;\n94\t    let killTimer: NodeJS.Timeout | null = null;\n95\t\n96\t    const settle = (fn: () => void) => {\n97\t      if (settled) return;\n98\t      settled = true;\n99\t      if (killTimer !== null) {\n100\t        clearTimeout(killTimer);\n101\t        killTimer = null;\n102\t      }\n103\t      fn();\n104\t    };\n105\t\n106\t    const timer = setTimeout(() => {\n107\t      timedOut = true;\n108\t      try {\n109\t        child.kill('SIGTERM');\n110\t      } catch {\n111\t        // ignore — handled by close/error below\n112\t      }\n113\t      killTimer = setTimeout(() => {\n114\t        try {\n115\t          child.kill('SIGKILL');\n116\t        } catch {\n117\t          // ignore\n118\t        }\n119\t      }, killGraceMs);\n120\t    }, timeoutMs);\n121\t\n122\t    child.stdout?.on('data', (chunk: Buffer | string) => {\n123\t      stdoutBuf += chunk.toString();\n124\t    });\n125\t    child.stderr?.on('data', (chunk: Buffer | string) => {\n126\t      stderrBuf += chunk.toString();\n127\t    });\n128\t    child.on('error', (err: Error) => {\n129\t      clearTimeout(timer);\n130\t      settle(() => reject(new Error(`claude spawn failed: ${err.message}`)));\n131\t    });\n132\t    child.on('close', (code: number | null) => {\n133\t      clearTimeout(timer);\n134\t      if (timedOut) {\n135\t        settle(() =>\n136\t          reject(new Error(`claude CLI timed out after ${timeoutMs}ms`)),\n137\t        );\n138\t        return;\n139\t      }\n140\t      if (code !== 0) {\n141\t        const msg = stderrBuf.trim() || stdoutBuf.trim() || `exit code ${code}`;\n142\t        settle(() =>\n143\t          reject(new Error(`claude exited ${code}: ${msg}`)),\n144\t        );\n145\t        return;\n146\t      }\n147\t      let parsed: unknown;\n148\t      try {\n149\t        parsed = JSON.parse(stdoutBuf);\n150\t      } catch (err) {\n151\t        settle(() =>\n152\t          reject(\n153\t            new Error(\n154\t              `failed to parse claude JSON output: ${(err as Error).message}`,\n155\t            ),\n156\t          ),\n157\t        );\n158\t        return;\n159\t      }\n160\t      if (!parsed || typeof parsed !== 'object') {\n161\t        settle(() => reject(new Error('claude JSON output not an object')));\n162\t        return;\n163\t      }\n164\t      const obj = parsed as { result?: unknown; is_error?: unknown };\n165\t      if (obj.is_error === true) {\n166\t        settle(() =>\n167\t          reject(new Error(`claude returned is_error=true: ${stdoutBuf}`)),\n168\t        );\n169\t        return;\n170\t      }\n171\t      if (typeof obj.result !== 'string') {\n172\t        settle(() =>\n173\t          reject(new Error(\"claude JSON output missing string 'result' field\")),\n174\t        );\n175\t        return;\n176\t      }\n177\t      settle(() => resolve(obj.result as string));\n178\t    });\n179\t  });\n180\t}\n181\t\n182\t// ---------------------------------------------------------------------------\n183\t// Agent SDK connector\n184\t// ---------------------------------------------------------------------------\n185\t\n186\tinterface AgentSdkLike {\n187\t  query: (args: { prompt: string }) => AsyncIterable<unknown>;\n188\t}\n189\t\n190\texport interface AgentSdkConnectorOptions {\n191\t  // Allow tests to inject a fake SDK; production path leaves it undefined and\n192\t  // the connector dynamically imports the real package.\n193\t  sdk?: AgentSdkLike;\n194\t  loadSdk?: () => Promise<AgentSdkLike>;\n195\t}\n196\t\n197\texport async function agentSdkConnector(\n198\t  opts: AgentSdkConnectorOptions = {},\n199\t): Promise<Connector> {\n200\t  let sdk: AgentSdkLike;\n201\t  if (opts.sdk) {\n202\t    sdk = opts.sdk;\n203\t  } else {\n204\t    const loader =\n205\t      opts.loadSdk ??\n206\t      (async () => {\n207\t        // Dynamic import so a missing package raises here and the caller can\n208\t        // fall back to subprocess. The string literal is hidden behind a\n209\t        // variable to discourage Next/webpack from trying to bundle it\n210\t        // statically.\n211\t        const mod = '@anthropic-ai/claude-agent-sdk';\n212\t        return (await import(/* webpackIgnore: true */ mod)) as AgentSdkLike;\n213\t      });\n214\t    sdk = await loader();\n215\t  }\n216\t\n217\t  if (typeof sdk.query !== 'function') {\n218\t    throw new Error('Agent SDK has unexpected shape: query() not found');\n219\t  }\n220\t\n221\t  return {\n222\t    name: 'agent-sdk',\n223\t    async chat(req) {\n224\t      const prompt = assemblePrompt(req.message);\n225\t      let assistantText = '';\n226\t      let resultFallback = '';\n227\t      const stream = sdk.query({ prompt });\n228\t      for await (const raw of stream) {\n229\t        if (!raw || typeof raw !== 'object') continue;\n230\t        const msg = raw as {\n231\t          type?: string;\n232\t          message?: { content?: Array<{ type?: string; text?: string }> };\n233\t          result?: string;\n234\t          is_error?: boolean;\n235\t        };\n236\t        if (msg.type === 'assistant') {\n237\t          for (const block of msg.message?.content ?? []) {\n238\t            if (block?.type === 'text' && typeof block.text === 'string') {\n239\t              assistantText += block.text;\n240\t            }\n241\t          }\n242\t        } else if (msg.type === 'result') {\n243\t          if (msg.is_error) {\n244\t            throw new Error('Agent SDK returned is_error=true');\n245\t          }\n246\t          if (typeof msg.result === 'string') {\n247\t            resultFallback = msg.result;\n248\t          }\n249\t        }\n250\t      }\n251\t      const text = assistantText || resultFallback;\n252\t      if (!text) {\n253\t        throw new Error('Agent SDK stream produced no assistant text');\n254\t      }\n255\t      return text;\n256\t    },\n257\t  };\n258\t}\n259\t\n260\t// ---------------------------------------------------------------------------\n261\t// Selection — try SDK first, fall back to subprocess. Cached per process.\n262\t// ---------------------------------------------------------------------------\n263\t\n264\tinterface SelectConnectorOptions {\n265\t  forceReselect?: boolean;\n266\t  agentSdk?: () => Promise<Connector>;\n267\t  subprocess?: () => Connector;\n268\t  probeSubprocess?: () => Promise<void>;\n269\t  log?: (line: string) => void;\n270\t}\n271\t\n272\tlet cachedConnector: Connector | null | undefined;\n273\t\n274\texport async function selectConnector(\n275\t  opts: SelectConnectorOptions = {},\n276\t): Promise<Connector | null> {\n277\t  if (!opts.forceReselect && cachedConnector !== undefined) {\n278\t    return cachedConnector;\n279\t  }\n280\t\n281\t  const log = opts.log ?? ((line: string) => console.log(line));\n282\t  const buildAgentSdk = opts.agentSdk ?? (() => agentSdkConnector());\n283\t  const buildSubprocess = opts.subprocess ?? (() => subprocessConnector());\n284\t  const probe = opts.probeSubprocess ?? probeClaudeCli;\n285\t\n286\t  try {\n287\t    cachedConnector = await buildAgentSdk();\n288\t    log('[lesson-chat] using Agent SDK connector');\n289\t    return cachedConnector;\n290\t  } catch (err) {\n291\t    log(\n292\t      `[lesson-chat] Agent SDK unavailable, trying subprocess: ${\n293\t        (err as Error).message\n294\t      }`,\n295\t    );\n296\t  }\n297\t\n298\t  try {\n299\t    await probe();\n300\t    cachedConnector = buildSubprocess();\n301\t    log('[lesson-chat] using subprocess connector');\n302\t    return cachedConnector;\n303\t  } catch (err) {\n304\t    log(\n305\t      `[lesson-chat] subprocess unavailable: ${(err as Error).message}`,\n306\t    );\n307\t    cachedConnector = null;\n308\t    return null;\n309\t  }\n310\t}\n311\t\n312\tfunction probeClaudeCli(): Promise<void> {\n313\t  return new Promise((resolve, reject) => {\n314\t    let child: ChildProcess;\n315\t    try {\n316\t      child = spawn('claude', ['--version']);\n317\t    } catch (err) {\n318\t      reject(err as Error);\n319\t      return;\n320\t    }\n321\t    let settled = false;\n322\t    const settle = (fn: () => void) => {\n323\t      if (settled) return;\n324\t      settled = true;\n325\t      fn();\n326\t    };\n327\t    const timer = setTimeout(() => {\n328\t      try {\n329\t        child.kill('SIGTERM');\n330\t      } catch {\n331\t        // ignore\n332\t      }\n333\t      settle(() => reject(new Error('claude --version timed out')));\n334\t    }, 5_000);\n335\t    child.on('error', (err: Error) => {\n336\t      clearTimeout(timer);\n337\t      settle(() => reject(err));\n338\t    });\n339\t    child.on('close', (code: number | null) => {\n340\t      clearTimeout(timer);\n341\t      if (code === 0) settle(() => resolve());\n342\t      else settle(() => reject(new Error(`claude --version exited ${code}`)));\n343\t    });\n344\t  });\n345\t}\n346\t\n347\texport function _resetConnectorCacheForTesting(): void {\n348\t  cachedConnector = undefined;\n349\t}\n350\t"}]},"parent_tool_use_id":null,"session_id":"ac2e4d8e-61f9-4667-9e24-a812af5dbc90","uuid":"42201a99-395f-4d20-90eb-f6fc678c6b6c","timestamp":"2026-05-04T06:29:47.600Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-054/src/lib/lessonChat/connector.ts","content":"/**\n * LessonChat connector — bridges the API route to a backing Claude implementation.\n *\n * Two implementations are tried in order at first use, then cached for the lifetime\n * of the server process:\n *   1. Agent SDK (`@anthropic-ai/claude-agent-sdk`) — uses the user's local Claude\n *      Code subscription. No API key.\n *   2. Subprocess — spawns `claude -p \"<prompt>\" --output-format json` and parses\n *      the resulting JSON.\n *\n * If neither works, `selectConnector()` returns `null` and the API surfaces a 503.\n *\n * Prompt assembly is intentionally minimal — full lesson-context wiring is US-054.\n */\nimport { spawn, type ChildProcess } from 'node:child_process';\n\nexport interface ChatMessage {\n  role: 'user' | 'assistant';\n  content: string;\n}\n\nexport interface ConnectorRequest {\n  message: string;\n  history?: ChatMessage[];\n}\n\nexport type ConnectorName = 'agent-sdk' | 'subprocess';\n\nexport interface Connector {\n  readonly name: ConnectorName;\n  chat(req: ConnectorRequest): Promise<string>;\n}\n\nconst SYSTEM_PREFIX =\n  'You are an AI tutor for an interactive course. Answer concisely.';\n\nexport function assemblePrompt(message: string): string {\n  return `${SYSTEM_PREFIX}\\n\\n${message}`;\n}\n\n// ---------------------------------------------------------------------------\n// Subprocess connector\n// ---------------------------------------------------------------------------\n\nconst SUBPROCESS_TIMEOUT_MS = 60_000;\nconst SUBPROCESS_KILL_GRACE_MS = 5_000;\n\nexport type SpawnFn = typeof spawn;\n\nexport interface SubprocessConnectorOptions {\n  command?: string;\n  spawnFn?: SpawnFn;\n  timeoutMs?: number;\n  killGraceMs?: number;\n}\n\nexport function subprocessConnector(\n  opts: SubprocessConnectorOptions = {},\n): Connector {\n  const command = opts.command ?? 'claude';\n  const spawnFn = opts.spawnFn ?? spawn;\n  const timeoutMs = opts.timeoutMs ?? SUBPROCESS_TIMEOUT_MS;\n  const killGraceMs = opts.killGraceMs ?? SUBPROCESS_KILL_GRACE_MS;\n\n  return {\n    name: 'subprocess',\n    chat(req) {\n      const prompt = assemblePrompt(req.message);\n      return runClaudeCli(spawnFn, command, prompt, timeoutMs, killGraceMs);\n    },\n  };\n}\n\nfunction runClaudeCli(\n  spawnFn: SpawnFn,\n  command: string,\n  prompt: string,\n  timeoutMs: number,\n  killGraceMs: number,\n): Promise<string> {\n  return new Promise((resolve, reject) => {\n    let child: ChildProcess;\n    try {\n      child = spawnFn(command, ['-p', prompt, '--output-format', 'json']);\n    } catch (err) {\n      reject(new Error(`claude spawn failed: ${(err as Error).message}`));\n      return;\n    }\n\n    let stdoutBuf = '';\n    let stderrBuf = '';\n    let timedOut = false;\n    let settled = false;\n    let killTimer: NodeJS.Timeout | null = null;\n\n    const settle = (fn: () => void) => {\n      if (settled) return;\n      settled = true;\n      if (killTimer !== null) {\n        clearTimeout(killTimer);\n        killTimer = null;\n      }\n      fn();\n    };\n\n    const timer = setTimeout(() => {\n      timedOut = true;\n      try {\n        child.kill('SIGTERM');\n      } catch {\n        // ignore — handled by close/error below\n      }\n      killTimer = setTimeout(() => {\n        try {\n          child.kill('SIGKILL');\n        } catch {\n          // ignore\n        }\n      }, killGraceMs);\n    }, timeoutMs);\n\n    child.stdout?.on('data', (chunk: Buffer | string) => {\n      stdoutBuf += chunk.toString();\n    });\n    child.stderr?.on('data', (chunk: Buffer | string) => {\n      stderrBuf += chunk.toString();\n    });\n    child.on('error', (err: Error) => {\n      clearTimeout(timer);\n      settle(() => reject(new Error(`claude spawn failed: ${err.message}`)));\n    });\n    child.on('close', (code: number | null) => {\n      clearTimeout(timer);\n      if (timedOut) {\n        settle(() =>\n          reject(new Error(`claude CLI timed out after ${timeoutMs}ms`)),\n        );\n        return;\n      }\n      if (code !== 0) {\n        const msg = stderrBuf.trim() || stdoutBuf.trim() || `exit code ${code}`;\n        settle(() =>\n          reject(new Error(`claude exited ${code}: ${msg}`)),\n        );\n        return;\n      }\n      let parsed: unknown;\n      try {\n        parsed = JSON.parse(stdoutBuf);\n      } catch (err) {\n        settle(() =>\n          reject(\n            new Error(\n              `failed to parse claude JSON output: ${(err as Error).message}`,\n            ),\n          ),\n        );\n        return;\n      }\n      if (!parsed || typeof parsed !== 'object') {\n        settle(() => reject(new Error('claude JSON output not an object')));\n        return;\n      }\n      const obj = parsed as { result?: unknown; is_error?: unknown };\n      if (obj.is_error === true) {\n        settle(() =>\n          reject(new Error(`claude returned is_error=true: ${stdoutBuf}`)),\n        );\n        return;\n      }\n      if (typeof obj.result !== 'string') {\n        settle(() =>\n          reject(new Error(\"claude JSON output missing string 'result' field\")),\n        );\n        return;\n      }\n      settle(() => resolve(obj.result as string));\n    });\n  });\n}\n\n// ---------------------------------------------------------------------------\n// Agent SDK connector\n// ---------------------------------------------------------------------------\n\ninterface AgentSdkLike {\n  query: (args: { prompt: string }) => AsyncIterable<unknown>;\n}\n\nexport interface AgentSdkConnectorOptions {\n  // Allow tests to inject a fake SDK; production path leaves it undefined and\n  // the connector dynamically imports the real package.\n  sdk?: AgentSdkLike;\n  loadSdk?: () => Promise<AgentSdkLike>;\n}\n\nexport async function agentSdkConnector(\n  opts: AgentSdkConnectorOptions = {},\n): Promise<Connector> {\n  let sdk: AgentSdkLike;\n  if (opts.sdk) {\n    sdk = opts.sdk;\n  } else {\n    const loader =\n      opts.loadSdk ??\n      (async () => {\n        // Dynamic import so a missing package raises here and the caller can\n        // fall back to subprocess. The string literal is hidden behind a\n        // variable to discourage Next/webpack from trying to bundle it\n        // statically.\n        const mod = '@anthropic-ai/claude-agent-sdk';\n        return (await import(/* webpackIgnore: true */ mod)) as AgentSdkLike;\n      });\n    sdk = await loader();\n  }\n\n  if (typeof sdk.query !== 'function') {\n    throw new Error('Agent SDK has unexpected shape: query() not found');\n  }\n\n  return {\n    name: 'agent-sdk',\n    async chat(req) {\n      const prompt = assemblePrompt(req.message);\n      let assistantText = '';\n      let resultFallback = '';\n      const stream = sdk.query({ prompt });\n      for await (const raw of stream) {\n        if (!raw || typeof raw !== 'object') continue;\n        const msg = raw as {\n          type?: string;\n          message?: { content?: Array<{ type?: string; text?: string }> };\n          result?: string;\n          is_error?: boolean;\n        };\n        if (msg.type === 'assistant') {\n          for (const block of msg.message?.content ?? []) {\n            if (block?.type === 'text' && typeof block.text === 'string') {\n              assistantText += block.text;\n            }\n          }\n        } else if (msg.type === 'result') {\n          if (msg.is_error) {\n            throw new Error('Agent SDK returned is_error=true');\n          }\n          if (typeof msg.result === 'string') {\n            resultFallback = msg.result;\n          }\n        }\n      }\n      const text = assistantText || resultFallback;\n      if (!text) {\n        throw new Error('Agent SDK stream produced no assistant text');\n      }\n      return text;\n    },\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Selection — try SDK first, fall back to subprocess. Cached per process.\n// ---------------------------------------------------------------------------\n\ninterface SelectConnectorOptions {\n  forceReselect?: boolean;\n  agentSdk?: () => Promise<Connector>;\n  subprocess?: () => Connector;\n  probeSubprocess?: () => Promise<void>;\n  log?: (line: string) => void;\n}\n\nlet cachedConnector: Connector | null | undefined;\n\nexport async function selectConnector(\n  opts: SelectConnectorOptions = {},\n): Promise<Connector | null> {\n  if (!opts.forceReselect && cachedConnector !== undefined) {\n    return cachedConnector;\n  }\n\n  const log = opts.log ?? ((line: string) => console.log(line));\n  const buildAgentSdk = opts.agentSdk ?? (() => agentSdkConnector());\n  const buildSubprocess = opts.subprocess ?? (() => subprocessConnector());\n  const probe = opts.probeSubprocess ?? probeClaudeCli;\n\n  try {\n    cachedConnector = await buildAgentSdk();\n    log('[lesson-chat] using Agent SDK connector');\n    return cachedConnector;\n  } catch (err) {\n    log(\n      `[lesson-chat] Agent SDK unavailable, trying subprocess: ${\n        (err as Error).message\n      }`,\n    );\n  }\n\n  try {\n    await probe();\n    cachedConnector = buildSubprocess();\n    log('[lesson-chat] using subprocess connector');\n    return cachedConnector;\n  } catch (err) {\n    log(\n      `[lesson-chat] subprocess unavailable: ${(err as Error).message}`,\n    );\n    cachedConnector = null;\n    return null;\n  }\n}\n\nfunction probeClaudeCli(): Promise<void> {\n  return new Promise((resolve, reject) => {\n    let child: ChildProcess;\n    try {\n      child = spawn('claude', ['--version']);\n    } catch (err) {\n      reject(err as Error);\n      return;\n    }\n    let settled = false;\n    const settle = (fn: () => void) => {\n      if (settled) return;\n      settled = true;\n      fn();\n    };\n    const timer = setTimeout(() => {\n      try {\n        child.kill('SIGTERM');\n      } catch {\n        // ignore\n      }\n      settle(() => reject(new Error('claude --version timed out')));\n    }, 5_000);\n    child.on('error', (err: Error) => {\n      clearTimeout(timer);\n      settle(() => reject(err));\n    });\n    child.on('close', (code: number | null) => {\n      clearTimeout(timer);\n      if (code === 0) settle(() => resolve());\n      else settle(() => reject(new Error(`claude --version exited ${code}`)));\n    });\n  });\n}\n\nexport function _resetConnectorCacheForTesting(): void {\n  cachedConnector = undefined;\n}\n","numLines":350,"startLine":1,"totalLines":350}}}
{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_01GgSAqq382BohEecfpfePtq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DCny4ufV76Z9gbeDPcbix6","name":"Read","input":{"file_path":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-054/src/components/LessonChat.tsx"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":5737,"cache_read_input_tokens":47856,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5737},"output_tokens":43,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ac2e4d8e-61f9-4667-9e24-a812af5dbc90","uuid":"cbcb3a88-11ac-4a04-8fae-b20555a82f82"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DCny4ufV76Z9gbeDPcbix6","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport {\n4\t  useCallback,\n5\t  useEffect,\n6\t  useLayoutEffect,\n7\t  useMemo,\n8\t  useRef,\n9\t  useState,\n10\t  type CSSProperties,\n11\t  type KeyboardEvent as ReactKeyboardEvent,\n12\t} from 'react';\n13\timport { Square, X } from 'lucide-react';\n14\t\n15\tinterface ChatMessage {\n16\t  id: string;\n17\t  role: 'user' | 'assistant' | 'error';\n18\t  text: string;\n19\t  pending?: boolean;\n20\t}\n21\t\n22\tinterface LessonChatProps {\n23\t  open: boolean;\n24\t  courseSlug: string;\n25\t  lessonSlug: string;\n26\t  onClose: () => void;\n27\t}\n28\t\n29\tconst LINE_HEIGHT_PX = 20;\n30\tconst MIN_LINES = 1;\n31\tconst MAX_LINES = 6;\n32\tconst TEXTAREA_VERTICAL_PADDING = 16;\n33\tconst DRAFT_DEBOUNCE_MS = 200;\n34\t\n35\texport function draftStorageKey(courseSlug: string, lessonSlug: string): string {\n36\t  return `lessonChatDraft:${courseSlug}:${lessonSlug}`;\n37\t}\n38\t\n39\texport function LessonChat({\n40\t  open,\n41\t  courseSlug,\n42\t  lessonSlug,\n43\t  onClose,\n44\t}: LessonChatProps) {\n45\t  const [draft, setDraft] = useState('');\n46\t  const [messages, setMessages] = useState<ChatMessage[]>([]);\n47\t  const [sending, setSending] = useState(false);\n48\t  const textareaRef = useRef<HTMLTextAreaElement | null>(null);\n49\t  const messagesRef = useRef<HTMLDivElement | null>(null);\n50\t  const debounceRef = useRef<number | null>(null);\n51\t  const draftKey = useMemo(\n52\t    () => draftStorageKey(courseSlug, lessonSlug),\n53\t    [courseSlug, lessonSlug],\n54\t  );\n55\t\n56\t  // Restore draft on mount or when slug changes. New mount per panel toggle is\n57\t  // fine — `open=false` returns null below so the effect only fires when the\n58\t  // panel actually appears.\n59\t  useEffect(() => {\n60\t    try {\n61\t      const stored = window.localStorage.getItem(draftKey);\n62\t      // eslint-disable-next-line react-hooks/set-state-in-effect\n63\t      setDraft(stored ?? '');\n64\t    } catch {\n65\t      // localStorage unavailable — start with empty draft.\n66\t    }\n67\t  }, [draftKey]);\n68\t\n69\t  // Debounced write of the draft to localStorage.\n70\t  useEffect(() => {\n71\t    if (debounceRef.current !== null) {\n72\t      window.clearTimeout(debounceRef.current);\n73\t    }\n74\t    debounceRef.current = window.setTimeout(() => {\n75\t      try {\n76\t        if (draft.length === 0) {\n77\t          window.localStorage.removeItem(draftKey);\n78\t        } else {\n79\t          window.localStorage.setItem(draftKey, draft);\n80\t        }\n81\t      } catch {\n82\t        // Persistence unavailable; in-memory draft still works.\n83\t      }\n84\t    }, DRAFT_DEBOUNCE_MS);\n85\t    return () => {\n86\t      if (debounceRef.current !== null) {\n87\t        window.clearTimeout(debounceRef.current);\n88\t        debounceRef.current = null;\n89\t      }\n90\t    };\n91\t  }, [draft, draftKey]);\n92\t\n93\t  // Autoresize the textarea: measure scrollHeight, clamp to MAX_LINES.\n94\t  useLayoutEffect(() => {\n95\t    const el = textareaRef.current;\n96\t    if (!el) return;\n97\t    el.style.height = 'auto';\n98\t    const maxHeight = LINE_HEIGHT_PX * MAX_LINES + TEXTAREA_VERTICAL_PADDING;\n99\t    const minHeight = LINE_HEIGHT_PX * MIN_LINES + TEXTAREA_VERTICAL_PADDING;\n100\t    const next = Math.max(\n101\t      minHeight,\n102\t      Math.min(maxHeight, el.scrollHeight),\n103\t    );\n104\t    el.style.height = `${next}px`;\n105\t    el.style.overflowY = el.scrollHeight > maxHeight ? 'auto' : 'hidden';\n106\t  }, [draft]);\n107\t\n108\t  // Auto-scroll to bottom when new messages land.\n109\t  useEffect(() => {\n110\t    const el = messagesRef.current;\n111\t    if (!el) return;\n112\t    el.scrollTop = el.scrollHeight;\n113\t  }, [messages.length]);\n114\t\n115\t  const trimmedDraft = draft.trim();\n116\t  const canSend = trimmedDraft.length > 0 && !sending;\n117\t\n118\t  const handleSend = useCallback(() => {\n119\t    const text = draft.trim();\n120\t    if (text.length === 0 || sending) return;\n121\t    const stamp = Date.now();\n122\t    const userId = `m-${stamp}-u`;\n123\t    const pendingId = `m-${stamp}-p`;\n124\t    setMessages((prev) => [\n125\t      ...prev,\n126\t      { id: userId, role: 'user', text },\n127\t      { id: pendingId, role: 'assistant', text: '', pending: true },\n128\t    ]);\n129\t    setDraft('');\n130\t    setSending(true);\n131\t    try {\n132\t      window.localStorage.removeItem(draftKey);\n133\t    } catch {\n134\t      // ignore — draft already cleared from in-memory state\n135\t    }\n136\t\n137\t    const history = messages\n138\t      .filter((m) => m.role === 'user' || m.role === 'assistant')\n139\t      .filter((m) => !m.pending)\n140\t      .map((m) => ({ role: m.role as 'user' | 'assistant', content: m.text }));\n141\t\n142\t    void (async () => {\n143\t      try {\n144\t        const res = await fetch('/api/lesson-chat', {\n145\t          method: 'POST',\n146\t          headers: { 'Content-Type': 'application/json' },\n147\t          body: JSON.stringify({\n148\t            courseSlug,\n149\t            lessonSlug,\n150\t            message: text,\n151\t            history,\n152\t          }),\n153\t        });\n154\t        const json = (await res\n155\t          .json()\n156\t          .catch(() => ({}))) as { assistant?: string; error?: string };\n157\t        if (!res.ok) {\n158\t          const errText =\n159\t            json.error ?? `AI Tutor error (status ${res.status})`;\n160\t          setMessages((prev) =>\n161\t            prev.map((m) =>\n162\t              m.id === pendingId\n163\t                ? { id: pendingId, role: 'error', text: errText }\n164\t                : m,\n165\t            ),\n166\t          );\n167\t        } else {\n168\t          setMessages((prev) =>\n169\t            prev.map((m) =>\n170\t              m.id === pendingId\n171\t                ? {\n172\t                    id: pendingId,\n173\t                    role: 'assistant',\n174\t                    text: json.assistant ?? '',\n175\t                  }\n176\t                : m,\n177\t            ),\n178\t          );\n179\t        }\n180\t      } catch (err) {\n181\t        const errText = `AI Tutor error: ${(err as Error).message}`;\n182\t        setMessages((prev) =>\n183\t          prev.map((m) =>\n184\t            m.id === pendingId\n185\t              ? { id: pendingId, role: 'error', text: errText }\n186\t              : m,\n187\t          ),\n188\t        );\n189\t      } finally {\n190\t        setSending(false);\n191\t      }\n192\t    })();\n193\t  }, [courseSlug, draft, draftKey, lessonSlug, messages, sending]);\n194\t\n195\t  const handleKeyDown = useCallback(\n196\t    (e: ReactKeyboardEvent<HTMLTextAreaElement>) => {\n197\t      const isMod = e.metaKey || e.ctrlKey;\n198\t      if (isMod && e.key === 'Enter') {\n199\t        e.preventDefault();\n200\t        handleSend();\n201\t      }\n202\t    },\n203\t    [handleSend],\n204\t  );\n205\t\n206\t  if (!open) {\n207\t    return (\n208\t      <aside\n209\t        data-testid=\"lesson-chat\"\n210\t        data-open=\"false\"\n211\t        aria-hidden\n212\t        style={asideHiddenStyle}\n213\t      />\n214\t    );\n215\t  }\n216\t\n217\t  return (\n218\t    <aside\n219\t      data-testid=\"lesson-chat\"\n220\t      data-open=\"true\"\n221\t      style={asideStyle}\n222\t    >\n223\t      <header style={headerStyle}>\n224\t        <h2 style={titleStyle}>AI Tutor</h2>\n225\t        <button\n226\t          type=\"button\"\n227\t          data-testid=\"lesson-chat-close\"\n228\t          aria-label=\"Close AI tutor panel\"\n229\t          onClick={onClose}\n230\t          style={closeBtnStyle}\n231\t        >\n232\t          <X size={16} strokeWidth={2} />\n233\t        </button>\n234\t      </header>\n235\t\n236\t      <div\n237\t        ref={messagesRef}\n238\t        data-testid=\"lesson-chat-messages\"\n239\t        style={messagesStyle}\n240\t      >\n241\t        {messages.length === 0 ? (\n242\t          <p data-testid=\"lesson-chat-empty\" style={emptyStyle}>\n243\t            Ask anything about this lesson — I have its content as context.\n244\t          </p>\n245\t        ) : (\n246\t          <ul style={messageListStyle}>\n247\t            {messages.map((m) => {\n248\t              const rowStyle =\n249\t                m.role === 'user' ? userBubbleRowStyle : assistantBubbleRowStyle;\n250\t              let bubbleStyle: CSSProperties = assistantBubbleStyle;\n251\t              if (m.role === 'user') bubbleStyle = userBubbleStyle;\n252\t              else if (m.role === 'error') bubbleStyle = errorBubbleStyle;\n253\t              return (\n254\t                <li\n255\t                  key={m.id}\n256\t                  data-role={m.role}\n257\t                  data-pending={m.pending ? 'true' : undefined}\n258\t                  style={rowStyle}\n259\t                >\n260\t                  <div style={bubbleStyle}>\n261\t                    {m.pending ? <TypingDots /> : m.text}\n262\t                  </div>\n263\t                </li>\n264\t              );\n265\t            })}\n266\t          </ul>\n267\t        )}\n268\t      </div>\n269\t\n270\t      <footer style={footerStyle}>\n271\t        <textarea\n272\t          ref={textareaRef}\n273\t          data-testid=\"lesson-chat-textarea\"\n274\t          aria-label=\"Message AI tutor\"\n275\t          placeholder=\"Ask about this lesson…\"\n276\t          value={draft}\n277\t          onChange={(e) => setDraft(e.target.value)}\n278\t          onKeyDown={handleKeyDown}\n279\t          rows={1}\n280\t          style={textareaStyle}\n281\t        />\n282\t        <div style={composerControlsStyle}>\n283\t          <span style={hintStyle}>⌘+Enter to send</span>\n284\t          <div style={btnGroupStyle}>\n285\t            <button\n286\t              type=\"button\"\n287\t              data-testid=\"lesson-chat-stop\"\n288\t              aria-label=\"Stop response\"\n289\t              disabled\n290\t              style={stopBtnStyle}\n291\t            >\n292\t              <Square size={12} strokeWidth={2} />\n293\t            </button>\n294\t            <button\n295\t              type=\"button\"\n296\t              data-testid=\"lesson-chat-send\"\n297\t              aria-label=\"Send message\"\n298\t              disabled={!canSend}\n299\t              onClick={handleSend}\n300\t              style={canSend ? sendBtnStyle : sendBtnDisabledStyle}\n301\t            >\n302\t              Send\n303\t            </button>\n304\t          </div>\n305\t        </div>\n306\t      </footer>\n307\t    </aside>\n308\t  );\n309\t}\n310\t\n311\tconst asideHiddenStyle: CSSProperties = {\n312\t  gridColumn: '3 / 4',\n313\t  gridRow: '2 / 3',\n314\t  display: 'none',\n315\t};\n316\t\n317\tconst asideStyle: CSSProperties = {\n318\t  gridColumn: '3 / 4',\n319\t  gridRow: '2 / 3',\n320\t  borderLeft: '1px solid var(--border)',\n321\t  background: 'var(--bg-elevated)',\n322\t  display: 'flex',\n323\t  flexDirection: 'column',\n324\t  minWidth: 0,\n325\t  overflow: 'hidden',\n326\t};\n327\t\n328\tconst headerStyle: CSSProperties = {\n329\t  display: 'flex',\n330\t  alignItems: 'center',\n331\t  justifyContent: 'space-between',\n332\t  gap: 'var(--space-3)',\n333\t  padding: 'var(--space-3) var(--space-4)',\n334\t  borderBottom: '1px solid var(--border)',\n335\t  flexShrink: 0,\n336\t  minHeight: 48,\n337\t};\n338\t\n339\tconst titleStyle: CSSProperties = {\n340\t  margin: 0,\n341\t  fontSize: 'var(--fs-md)',\n342\t  fontWeight: 600,\n343\t  color: 'var(--text)',\n344\t  lineHeight: 1.2,\n345\t};\n346\t\n347\tconst closeBtnStyle: CSSProperties = {\n348\t  width: 28,\n349\t  height: 28,\n350\t  display: 'inline-flex',\n351\t  alignItems: 'center',\n352\t  justifyContent: 'center',\n353\t  background: 'transparent',\n354\t  borderWidth: 1,\n355\t  borderStyle: 'solid',\n356\t  borderColor: 'transparent',\n357\t  borderRadius: 'var(--radius-sm)',\n358\t  color: 'var(--text-tertiary)',\n359\t  cursor: 'pointer',\n360\t};\n361\t\n362\tconst messagesStyle: CSSProperties = {\n363\t  flex: 1,\n364\t  minHeight: 0,\n365\t  overflowY: 'auto',\n366\t  padding: 'var(--space-4)',\n367\t  display: 'flex',\n368\t  flexDirection: 'column',\n369\t  gap: 'var(--space-3)',\n370\t};\n371\t\n372\tconst emptyStyle: CSSProperties = {\n373\t  margin: 'auto 0',\n374\t  textAlign: 'center',\n375\t  color: 'var(--text-tertiary)',\n376\t  fontSize: 'var(--fs-sm)',\n377\t  fontFamily: 'var(--font-prose)',\n378\t  lineHeight: 1.5,\n379\t  padding: '0 var(--space-3)',\n380\t};\n381\t\n382\tconst messageListStyle: CSSProperties = {\n383\t  listStyle: 'none',\n384\t  margin: 0,\n385\t  padding: 0,\n386\t  display: 'flex',\n387\t  flexDirection: 'column',\n388\t  gap: 'var(--space-3)',\n389\t};\n390\t\n391\tconst userBubbleRowStyle: CSSProperties = {\n392\t  display: 'flex',\n393\t  justifyContent: 'flex-end',\n394\t};\n395\t\n396\tconst assistantBubbleRowStyle: CSSProperties = {\n397\t  display: 'flex',\n398\t  justifyContent: 'flex-start',\n399\t};\n400\t\n401\tconst userBubbleStyle: CSSProperties = {\n402\t  maxWidth: '88%',\n403\t  padding: '8px 12px',\n404\t  background: 'var(--accent-subtle)',\n405\t  color: 'var(--accent-text)',\n406\t  borderRadius: '10px 10px 2px 10px',\n407\t  fontSize: 'var(--fs-sm)',\n408\t  lineHeight: 1.5,\n409\t  fontFamily: 'var(--font-prose)',\n410\t  whiteSpace: 'pre-wrap',\n411\t  wordBreak: 'break-word',\n412\t};\n413\t\n414\tconst assistantBubbleStyle: CSSProperties = {\n415\t  maxWidth: '94%',\n416\t  padding: '8px 12px',\n417\t  background: 'var(--bg-subtle)',\n418\t  color: 'var(--text)',\n419\t  borderRadius: '10px 10px 10px 2px',\n420\t  fontSize: 'var(--fs-sm)',\n421\t  lineHeight: 1.5,\n422\t  fontFamily: 'var(--font-prose)',\n423\t  whiteSpace: 'pre-wrap',\n424\t  wordBreak: 'break-word',\n425\t};\n426\t\n427\tconst errorBubbleStyle: CSSProperties = {\n428\t  maxWidth: '94%',\n429\t  padding: '8px 12px',\n430\t  background: 'var(--danger-subtle, #fee2e2)',\n431\t  color: 'var(--danger-text, #991b1b)',\n432\t  borderWidth: 1,\n433\t  borderStyle: 'solid',\n434\t  borderColor: 'var(--danger-border, #fecaca)',\n435\t  borderRadius: '10px 10px 10px 2px',\n436\t  fontSize: 'var(--fs-sm)',\n437\t  lineHeight: 1.5,\n438\t  fontFamily: 'var(--font-prose)',\n439\t  whiteSpace: 'pre-wrap',\n440\t  wordBreak: 'break-word',\n441\t};\n442\t\n443\tfunction TypingDots() {\n444\t  return (\n445\t    <span\n446\t      data-testid=\"lesson-chat-typing\"\n447\t      aria-label=\"AI tutor is typing\"\n448\t      style={typingDotsStyle}\n449\t    >\n450\t      <span style={{ ...typingDotStyle, animationDelay: '0ms' }} />\n451\t      <span style={{ ...typingDotStyle, animationDelay: '150ms' }} />\n452\t      <span style={{ ...typingDotStyle, animationDelay: '300ms' }} />\n453\t      <style>{typingKeyframes}</style>\n454\t    </span>\n455\t  );\n456\t}\n457\t\n458\tconst typingDotsStyle: CSSProperties = {\n459\t  display: 'inline-flex',\n460\t  gap: 4,\n461\t  alignItems: 'center',\n462\t  height: 12,\n463\t  paddingTop: 4,\n464\t  paddingBottom: 4,\n465\t};\n466\t\n467\tconst typingDotStyle: CSSProperties = {\n468\t  width: 6,\n469\t  height: 6,\n470\t  borderRadius: '50%',\n471\t  background: 'var(--text-tertiary)',\n472\t  display: 'inline-block',\n473\t  animation: 'lesson-chat-typing-bounce 1s infinite ease-in-out',\n474\t};\n475\t\n476\tconst typingKeyframes = `\n477\t@keyframes lesson-chat-typing-bounce {\n478\t  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }\n479\t  40% { transform: scale(1); opacity: 1; }\n480\t}\n481\t`;\n482\t\n483\tconst footerStyle: CSSProperties = {\n484\t  borderTop: '1px solid var(--border)',\n485\t  background: 'var(--bg-elevated)',\n486\t  padding: 'var(--space-3) var(--space-4)',\n487\t  display: 'flex',\n488\t  flexDirection: 'column',\n489\t  gap: 6,\n490\t  flexShrink: 0,\n491\t};\n492\t\n493\tconst textareaStyle: CSSProperties = {\n494\t  width: '100%',\n495\t  resize: 'none',\n496\t  borderWidth: 1,\n497\t  borderStyle: 'solid',\n498\t  borderColor: 'var(--border-strong)',\n499\t  borderRadius: 'var(--radius-md)',\n500\t  padding: '8px 10px',\n501\t  fontFamily: 'var(--font-prose)',\n502\t  fontSize: 'var(--fs-sm)',\n503\t  lineHeight: `${LINE_HEIGHT_PX}px`,\n504\t  color: 'var(--text)',\n505\t  background: 'var(--bg)',\n506\t  outline: 'none',\n507\t  boxSizing: 'border-box',\n508\t};\n509\t\n510\tconst composerControlsStyle: CSSProperties = {\n511\t  display: 'flex',\n512\t  alignItems: 'center',\n513\t  justifyContent: 'space-between',\n514\t  gap: 6,\n515\t};\n516\t\n517\tconst hintStyle: CSSProperties = {\n518\t  fontSize: '11px',\n519\t  color: 'var(--text-quaternary)',\n520\t  fontFamily: 'var(--font-mono)',\n521\t};\n522\t\n523\tconst btnGroupStyle: CSSProperties = {\n524\t  display: 'inline-flex',\n525\t  alignItems: 'center',\n526\t  gap: 6,\n527\t};\n528\t\n529\tconst stopBtnStyle: CSSProperties = {\n530\t  width: 28,\n531\t  height: 28,\n532\t  display: 'inline-flex',\n533\t  alignItems: 'center',\n534\t  justifyContent: 'center',\n535\t  borderWidth: 1,\n536\t  borderStyle: 'solid',\n537\t  borderColor: 'var(--border)',\n538\t  borderRadius: 'var(--radius-sm)',\n539\t  background: 'var(--bg-subtle)',\n540\t  color: 'var(--text-quaternary)',\n541\t  cursor: 'not-allowed',\n542\t  opacity: 0.6,\n543\t};\n544\t\n545\tconst sendBtnBase: CSSProperties = {\n546\t  height: 28,\n547\t  padding: '0 12px',\n548\t  borderWidth: 1,\n549\t  borderStyle: 'solid',\n550\t  borderRadius: 'var(--radius-sm)',\n551\t  fontSize: 'var(--fs-sm)',\n552\t  fontFamily: 'var(--font-sans)',\n553\t  fontWeight: 500,\n554\t};\n555\t\n556\tconst sendBtnStyle: CSSProperties = {\n557\t  ...sendBtnBase,\n558\t  borderColor: 'var(--accent)',\n559\t  background: 'var(--accent)',\n560\t  color: 'var(--accent-fg, #ffffff)',\n561\t  cursor: 'pointer',\n562\t};\n563\t\n564\tconst sendBtnDisabledStyle: CSSProperties = {\n565\t  ...sendBtnBase,\n566\t  borderColor: 'var(--border)',\n567\t  background: 'var(--bg-subtle)',\n568\t  color: 'var(--text-quaternary)',\n569\t  cursor: 'not-allowed',\n570\t};\n571\t"}]},"parent_tool_use_id":null,"session_id":"ac2e4d8e-61f9-4667-9e24-a812af5dbc90","uuid":"a077fb52-675c-4c7d-9d61-dc47e37cc2a3","timestamp":"2026-05-04T06:29:51.458Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-054/src/components/LessonChat.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useEffect,\n  useLayoutEffect,\n  useMemo,\n  useRef,\n  useState,\n  type CSSProperties,\n  type KeyboardEvent as ReactKeyboardEvent,\n} from 'react';\nimport { Square, X } from 'lucide-react';\n\ninterface ChatMessage {\n  id: string;\n  role: 'user' | 'assistant' | 'error';\n  text: string;\n  pending?: boolean;\n}\n\ninterface LessonChatProps {\n  open: boolean;\n  courseSlug: string;\n  lessonSlug: string;\n  onClose: () => void;\n}\n\nconst LINE_HEIGHT_PX = 20;\nconst MIN_LINES = 1;\nconst MAX_LINES = 6;\nconst TEXTAREA_VERTICAL_PADDING = 16;\nconst DRAFT_DEBOUNCE_MS = 200;\n\nexport function draftStorageKey(courseSlug: string, lessonSlug: string): string {\n  return `lessonChatDraft:${courseSlug}:${lessonSlug}`;\n}\n\nexport function LessonChat({\n  open,\n  courseSlug,\n  lessonSlug,\n  onClose,\n}: LessonChatProps) {\n  const [draft, setDraft] = useState('');\n  const [messages, setMessages] = useState<ChatMessage[]>([]);\n  const [sending, setSending] = useState(false);\n  const textareaRef = useRef<HTMLTextAreaElement | null>(null);\n  const messagesRef = useRef<HTMLDivElement | null>(null);\n  const debounceRef = useRef<number | null>(null);\n  const draftKey = useMemo(\n    () => draftStorageKey(courseSlug, lessonSlug),\n    [courseSlug, lessonSlug],\n  );\n\n  // Restore draft on mount or when slug changes. New mount per panel toggle is\n  // fine — `open=false` returns null below so the effect only fires when the\n  // panel actually appears.\n  useEffect(() => {\n    try {\n      const stored = window.localStorage.getItem(draftKey);\n      // eslint-disable-next-line react-hooks/set-state-in-effect\n      setDraft(stored ?? '');\n    } catch {\n      // localStorage unavailable — start with empty draft.\n    }\n  }, [draftKey]);\n\n  // Debounced write of the draft to localStorage.\n  useEffect(() => {\n    if (debounceRef.current !== null) {\n      window.clearTimeout(debounceRef.current);\n    }\n    debounceRef.current = window.setTimeout(() => {\n      try {\n        if (draft.length === 0) {\n          window.localStorage.removeItem(draftKey);\n        } else {\n          window.localStorage.setItem(draftKey, draft);\n        }\n      } catch {\n        // Persistence unavailable; in-memory draft still works.\n      }\n    }, DRAFT_DEBOUNCE_MS);\n    return () => {\n      if (debounceRef.current !== null) {\n        window.clearTimeout(debounceRef.current);\n        debounceRef.current = null;\n      }\n    };\n  }, [draft, draftKey]);\n\n  // Autoresize the textarea: measure scrollHeight, clamp to MAX_LINES.\n  useLayoutEffect(() => {\n    const el = textareaRef.current;\n    if (!el) return;\n    el.style.height = 'auto';\n    const maxHeight = LINE_HEIGHT_PX * MAX_LINES + TEXTAREA_VERTICAL_PADDING;\n    const minHeight = LINE_HEIGHT_PX * MIN_LINES + TEXTAREA_VERTICAL_PADDING;\n    const next = Math.max(\n      minHeight,\n      Math.min(maxHeight, el.scrollHeight),\n    );\n    el.style.height = `${next}px`;\n    el.style.overflowY = el.scrollHeight > maxHeight ? 'auto' : 'hidden';\n  }, [draft]);\n\n  // Auto-scroll to bottom when new messages land.\n  useEffect(() => {\n    const el = messagesRef.current;\n    if (!el) return;\n    el.scrollTop = el.scrollHeight;\n  }, [messages.length]);\n\n  const trimmedDraft = draft.trim();\n  const canSend = trimmedDraft.length > 0 && !sending;\n\n  const handleSend = useCallback(() => {\n    const text = draft.trim();\n    if (text.length === 0 || sending) return;\n    const stamp = Date.now();\n    const userId = `m-${stamp}-u`;\n    const pendingId = `m-${stamp}-p`;\n    setMessages((prev) => [\n      ...prev,\n      { id: userId, role: 'user', text },\n      { id: pendingId, role: 'assistant', text: '', pending: true },\n    ]);\n    setDraft('');\n    setSending(true);\n    try {\n      window.localStorage.removeItem(draftKey);\n    } catch {\n      // ignore — draft already cleared from in-memory state\n    }\n\n    const history = messages\n      .filter((m) => m.role === 'user' || m.role === 'assistant')\n      .filter((m) => !m.pending)\n      .map((m) => ({ role: m.role as 'user' | 'assistant', content: m.text }));\n\n    void (async () => {\n      try {\n        const res = await fetch('/api/lesson-chat', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n            courseSlug,\n            lessonSlug,\n            message: text,\n            history,\n          }),\n        });\n        const json = (await res\n          .json()\n          .catch(() => ({}))) as { assistant?: string; error?: string };\n        if (!res.ok) {\n          const errText =\n            json.error ?? `AI Tutor error (status ${res.status})`;\n          setMessages((prev) =>\n            prev.map((m) =>\n              m.id === pendingId\n                ? { id: pendingId, role: 'error', text: errText }\n                : m,\n            ),\n          );\n        } else {\n          setMessages((prev) =>\n            prev.map((m) =>\n              m.id === pendingId\n                ? {\n                    id: pendingId,\n                    role: 'assistant',\n                    text: json.assistant ?? '',\n                  }\n                : m,\n            ),\n          );\n        }\n      } catch (err) {\n        const errText = `AI Tutor error: ${(err as Error).message}`;\n        setMessages((prev) =>\n          prev.map((m) =>\n            m.id === pendingId\n              ? { id: pendingId, role: 'error', text: errText }\n              : m,\n          ),\n        );\n      } finally {\n        setSending(false);\n      }\n    })();\n  }, [courseSlug, draft, draftKey, lessonSlug, messages, sending]);\n\n  const handleKeyDown = useCallback(\n    (e: ReactKeyboardEvent<HTMLTextAreaElement>) => {\n      const isMod = e.metaKey || e.ctrlKey;\n      if (isMod && e.key === 'Enter') {\n        e.preventDefault();\n        handleSend();\n      }\n    },\n    [handleSend],\n  );\n\n  if (!open) {\n    return (\n      <aside\n        data-testid=\"lesson-chat\"\n        data-open=\"false\"\n        aria-hidden\n        style={asideHiddenStyle}\n      />\n    );\n  }\n\n  return (\n    <aside\n      data-testid=\"lesson-chat\"\n      data-open=\"true\"\n      style={asideStyle}\n    >\n      <header style={headerStyle}>\n        <h2 style={titleStyle}>AI Tutor</h2>\n        <button\n          type=\"button\"\n          data-testid=\"lesson-chat-close\"\n          aria-label=\"Close AI tutor panel\"\n          onClick={onClose}\n          style={closeBtnStyle}\n        >\n          <X size={16} strokeWidth={2} />\n        </button>\n      </header>\n\n      <div\n        ref={messagesRef}\n        data-testid=\"lesson-chat-messages\"\n        style={messagesStyle}\n      >\n        {messages.length === 0 ? (\n          <p data-testid=\"lesson-chat-empty\" style={emptyStyle}>\n            Ask anything about this lesson — I have its content as context.\n          </p>\n        ) : (\n          <ul style={messageListStyle}>\n            {messages.map((m) => {\n              const rowStyle =\n                m.role === 'user' ? userBubbleRowStyle : assistantBubbleRowStyle;\n              let bubbleStyle: CSSProperties = assistantBubbleStyle;\n              if (m.role === 'user') bubbleStyle = userBubbleStyle;\n              else if (m.role === 'error') bubbleStyle = errorBubbleStyle;\n              return (\n                <li\n                  key={m.id}\n                  data-role={m.role}\n                  data-pending={m.pending ? 'true' : undefined}\n                  style={rowStyle}\n                >\n                  <div style={bubbleStyle}>\n                    {m.pending ? <TypingDots /> : m.text}\n                  </div>\n                </li>\n              );\n            })}\n          </ul>\n        )}\n      </div>\n\n      <footer style={footerStyle}>\n        <textarea\n          ref={textareaRef}\n          data-testid=\"lesson-chat-textarea\"\n          aria-label=\"Message AI tutor\"\n          placeholder=\"Ask about this lesson…\"\n          value={draft}\n          onChange={(e) => setDraft(e.target.value)}\n          onKeyDown={handleKeyDown}\n          rows={1}\n          style={textareaStyle}\n        />\n        <div style={composerControlsStyle}>\n          <span style={hintStyle}>⌘+Enter to send</span>\n          <div style={btnGroupStyle}>\n            <button\n              type=\"button\"\n              data-testid=\"lesson-chat-stop\"\n              aria-label=\"Stop response\"\n              disabled\n              style={stopBtnStyle}\n            >\n              <Square size={12} strokeWidth={2} />\n            </button>\n            <button\n              type=\"button\"\n              data-testid=\"lesson-chat-send\"\n              aria-label=\"Send message\"\n              disabled={!canSend}\n              onClick={handleSend}\n              style={canSend ? sendBtnStyle : sendBtnDisabledStyle}\n            >\n              Send\n            </button>\n          </div>\n        </div>\n      </footer>\n    </aside>\n  );\n}\n\nconst asideHiddenStyle: CSSProperties = {\n  gridColumn: '3 / 4',\n  gridRow: '2 / 3',\n  display: 'none',\n};\n\nconst asideStyle: CSSProperties = {\n  gridColumn: '3 / 4',\n  gridRow: '2 / 3',\n  borderLeft: '1px solid var(--border)',\n  background: 'var(--bg-elevated)',\n  display: 'flex',\n  flexDirection: 'column',\n  minWidth: 0,\n  overflow: 'hidden',\n};\n\nconst headerStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  justifyContent: 'space-between',\n  gap: 'var(--space-3)',\n  padding: 'var(--space-3) var(--space-4)',\n  borderBottom: '1px solid var(--border)',\n  flexShrink: 0,\n  minHeight: 48,\n};\n\nconst titleStyle: CSSProperties = {\n  margin: 0,\n  fontSize: 'var(--fs-md)',\n  fontWeight: 600,\n  color: 'var(--text)',\n  lineHeight: 1.2,\n};\n\nconst closeBtnStyle: CSSProperties = {\n  width: 28,\n  height: 28,\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  background: 'transparent',\n  borderWidth: 1,\n  borderStyle: 'solid',\n  borderColor: 'transparent',\n  borderRadius: 'var(--radius-sm)',\n  color: 'var(--text-tertiary)',\n  cursor: 'pointer',\n};\n\nconst messagesStyle: CSSProperties = {\n  flex: 1,\n  minHeight: 0,\n  overflowY: 'auto',\n  padding: 'var(--space-4)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-3)',\n};\n\nconst emptyStyle: CSSProperties = {\n  margin: 'auto 0',\n  textAlign: 'center',\n  color: 'var(--text-tertiary)',\n  fontSize: 'var(--fs-sm)',\n  fontFamily: 'var(--font-prose)',\n  lineHeight: 1.5,\n  padding: '0 var(--space-3)',\n};\n\nconst messageListStyle: CSSProperties = {\n  listStyle: 'none',\n  margin: 0,\n  padding: 0,\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-3)',\n};\n\nconst userBubbleRowStyle: CSSProperties = {\n  display: 'flex',\n  justifyContent: 'flex-end',\n};\n\nconst assistantBubbleRowStyle: CSSProperties = {\n  display: 'flex',\n  justifyContent: 'flex-start',\n};\n\nconst userBubbleStyle: CSSProperties = {\n  maxWidth: '88%',\n  padding: '8px 12px',\n  background: 'var(--accent-subtle)',\n  color: 'var(--accent-text)',\n  borderRadius: '10px 10px 2px 10px',\n  fontSize: 'var(--fs-sm)',\n  lineHeight: 1.5,\n  fontFamily: 'var(--font-prose)',\n  whiteSpace: 'pre-wrap',\n  wordBreak: 'break-word',\n};\n\nconst assistantBubbleStyle: CSSProperties = {\n  maxWidth: '94%',\n  padding: '8px 12px',\n  background: 'var(--bg-subtle)',\n  color: 'var(--text)',\n  borderRadius: '10px 10px 10px 2px',\n  fontSize: 'var(--fs-sm)',\n  lineHeight: 1.5,\n  fontFamily: 'var(--font-prose)',\n  whiteSpace: 'pre-wrap',\n  wordBreak: 'break-word',\n};\n\nconst errorBubbleStyle: CSSProperties = {\n  maxWidth: '94%',\n  padding: '8px 12px',\n  background: 'var(--danger-subtle, #fee2e2)',\n  color: 'var(--danger-text, #991b1b)',\n  borderWidth: 1,\n  borderStyle: 'solid',\n  borderColor: 'var(--danger-border, #fecaca)',\n  borderRadius: '10px 10px 10px 2px',\n  fontSize: 'var(--fs-sm)',\n  lineHeight: 1.5,\n  fontFamily: 'var(--font-prose)',\n  whiteSpace: 'pre-wrap',\n  wordBreak: 'break-word',\n};\n\nfunction TypingDots() {\n  return (\n    <span\n      data-testid=\"lesson-chat-typing\"\n      aria-label=\"AI tutor is typing\"\n      style={typingDotsStyle}\n    >\n      <span style={{ ...typingDotStyle, animationDelay: '0ms' }} />\n      <span style={{ ...typingDotStyle, animationDelay: '150ms' }} />\n      <span style={{ ...typingDotStyle, animationDelay: '300ms' }} />\n      <style>{typingKeyframes}</style>\n    </span>\n  );\n}\n\nconst typingDotsStyle: CSSProperties = {\n  display: 'inline-flex',\n  gap: 4,\n  alignItems: 'center',\n  height: 12,\n  paddingTop: 4,\n  paddingBottom: 4,\n};\n\nconst typingDotStyle: CSSProperties = {\n  width: 6,\n  height: 6,\n  borderRadius: '50%',\n  background: 'var(--text-tertiary)',\n  display: 'inline-block',\n  animation: 'lesson-chat-typing-bounce 1s infinite ease-in-out',\n};\n\nconst typingKeyframes = `\n@keyframes lesson-chat-typing-bounce {\n  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }\n  40% { transform: scale(1); opacity: 1; }\n}\n`;\n\nconst footerStyle: CSSProperties = {\n