{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H5VoEbrtxweBYXK5d7ybRJ","type":"tool_result","content":"390\t    } catch {\n391\t      // Local optimistic update already applied; surfacing the error here\n392\t      // would require an inline toast we don't have yet.\n393\t    }\n394\t\n395\t    if (nextLesson) {\n396\t      setAdvancing(true);\n397\t      window.setTimeout(() => {\n398\t        router.push(`/courses/${slug}/lessons/${nextLesson.slug}`);\n399\t      }, 600);\n400\t    }\n401\t  }, [slug, lessonSlug, nextLesson, router]);\n402\t\n403\t  // Computes a position offset for each section relative to the main content\n404\t  // scroll container's content origin. Plus identifies the \"current\" section\n405\t  // (the last one whose top has scrolled past the viewport top).\n406\t  const getSectionState = useCallback(() => {\n407\t    const main = document.querySelector(\n408\t      '[data-testid=\"lesson-content\"]',\n409\t    ) as HTMLElement | null;\n410\t    if (!main) return null;\n411\t    const sections = Array.from(\n412\t      main.querySelectorAll<HTMLElement>('[data-section-id]'),\n413\t    );\n414\t    if (sections.length === 0) return null;\n415\t    const mainRect = main.getBoundingClientRect();\n416\t    const offsets = sections.map(\n417\t      (s) => s.getBoundingClientRect().top - mainRect.top + main.scrollTop,\n418\t    );\n419\t    const buffer = 8;\n420\t    // \"current\" = last section whose top has scrolled to/past the viewport top.\n421\t    let currentIdx = 0;\n422\t    for (let i = 0; i < offsets.length; i++) {\n423\t      if (offsets[i] <= main.scrollTop + buffer) currentIdx = i;\n424\t    }\n425\t    return { main, sections, offsets, currentIdx, buffer };\n426\t  }, []);\n427\t\n428\t  const scrollToSection = useCallback(\n429\t    (direction: 'next' | 'prev') => {\n430\t      const state = getSectionState();\n431\t      if (!state) return;\n432\t      const { main, offsets, buffer } = state;\n433\t      // For 'next': first section whose top is strictly below viewport top.\n434\t      // For 'prev': last section whose top is strictly above viewport top.\n435\t      let targetIdx = -1;\n436\t      if (direction === 'next') {\n437\t        for (let i = 0; i < offsets.length; i++) {\n438\t          if (offsets[i] > main.scrollTop + buffer) {\n439\t            targetIdx = i;\n440\t            break;\n441\t          }\n442\t        }\n443\t      } else {\n444\t        for (let i = 0; i < offsets.length; i++) {\n445\t          if (offsets[i] < main.scrollTop - buffer) {\n446\t            targetIdx = i;\n447\t          }\n448\t        }\n449\t      }\n450\t      if (targetIdx < 0) return;\n451\t      main.scrollTo({\n452\t        top: Math.max(0, offsets[targetIdx] - buffer),\n453\t        behavior: preferredScrollBehavior(),\n454\t      });\n455\t    },\n456\t    [getSectionState],\n457\t  );\n458\t\n459\t  const handleSpaceMarkSection = useCallback(() => {\n460\t    const state = getSectionState();\n461\t    if (!state) return;\n462\t    const { sections, currentIdx } = state;\n463\t    const target = sections[currentIdx];\n464\t    const sectionId = target.getAttribute('data-section-id');\n465\t    if (!sectionId) return;\n466\t\n467\t    const current: SectionState =\n468\t      progress?.courses?.[slug]?.lessons?.[lessonSlug]?.sectionState?.[sectionId] ??\n469\t      {};\n470\t    if (current.done) return; // Already complete — Space is a no-op.\n471\t    const nextState: SectionState = { ...current, done: true };\n472\t\n473\t    // Optimistic local update so the toolbar pill / TOC reflect immediately.\n474\t    setProgress((prev) => {\n475\t      const base: Progress = prev ?? { courses: {} };\n476\t      const courses = { ...base.courses };\n477\t      const cp = courses[slug]\n478\t        ? { ...courses[slug], lessons: { ...courses[slug].lessons } }\n479\t        : { lessons: {} };"}]},"parent_tool_use_id":null,"session_id":"ac2e4d8e-61f9-4667-9e24-a812af5dbc9