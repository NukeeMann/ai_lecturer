{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DuBLQksu7PsbLUxMTGrgxA","type":"tool_result","content":"110\t  // section.id; true means the editor is rendered in place of the read-mode\n111\t  // body. Each TheoryEditor instance owns its own draft, so opening edit mode\n112\t  // on multiple sections does not lose drafts in the others.\n113\t  const [editingSections, setEditingSections] = useState<Record<string, boolean>>(\n114\t    {},\n115\t  );\n116\t  // Side-panel edit (US-023): non-theory widgets open a 320px side panel\n117\t  // instead of an inline editor. At most one panel is open at a time.\n118\t  const [panelSectionId, setPanelSectionId] = useState<string | null>(null);\n119\t  // Lesson-level sources side panel (US-040). Independent of section panel.\n120\t  const [lessonSourcesPanelOpen, setLessonSourcesPanelOpen] = useState(false);\n121\t  // LessonChat side-panel state, persisted to localStorage['lessonChat-open'].\n122\t  // Hydrated from storage in the same effect that hydrates TOC collapse below.\n123\t  const [chatOpen, setChatOpen] = useState(false);\n124\t  // Focus mode (US-021 'f'): when on, both side panels are collapsed; when\n125\t  // toggled off, the previous TOC-collapsed state is restored.\n126\t  const focusModeRef = useRef<{ active: boolean; previousToc: boolean }>({\n127\t    active: false,\n128\t    previousToc: false,\n129\t  });\n130\t\n131\t  // Hydrate collapse state from localStorage on mount. Lazy useState init can't\n132\t  // touch window during SSR, so we read after mount and accept a one-frame flash.\n133\t  useEffect(() => {\n134\t    try {\n135\t      const stored = window.localStorage.getItem(TOC_COLLAPSED_KEY);\n136\t      if (stored === 'true') {\n137\t        // eslint-disable-next-line react-hooks/set-state-in-effect\n138\t        setTocCollapsed(true);\n139\t      }\n140\t      const chatStored = window.localStorage.getItem(CHAT_OPEN_KEY);\n141\t      if (chatStored === 'true') {\n142\t        // eslint-disable-next-line react-hooks/set-state-in-effect\n143\t        setChatOpen(true);\n144\t      }\n145\t    } catch {\n146\t      // localStorage unavailable (SSR / privacy mode) — fall back to default.\n147\t    }\n148\t  }, []);\n149\t\n150\t  const toggleToc = useCallback(() => {\n151\t    setTocCollapsed((prev) => {\n152\t      const next = !prev;\n153\t      try {\n154\t        window.localStorage.setItem(TOC_COLLAPSED_KEY, next ? 'true' : 'false');\n155\t      } catch {\n156\t        // Persistence unavailable — toggle still works for the session.\n157\t      }\n158\t      return next;\n159\t    });"}]},"parent_tool_use_id":null,"session_id":"ac2e4d8e-61f9-4667-9e24-a812af5dbc90","uuid":"fe2b6022-66fb-4140-b3d1-1e5a04a772d1","timestamp":"2026-05-04T06:30:30.527Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-054/src/app/courses/[slug]/lessons/[lessonSlug]/page.tsx","content":"  // section.id; true means the editor is rendered in place of the read-mode\n  // body. Each TheoryEditor instance owns its own draft, so opening edit mode\n  // on multiple sections does not lose drafts in the others.\n  const [editingSections, setEditingSections] = useState<Record<string, boolean>>(\n    {},\n  );\n  // Side-panel edit (US-023): non-theory widgets open a 320px side panel\n  // instead of an inline editor. At most one panel is open at a time.\n  const [panelSectionId, setPanelSectionId] = useState<string | null>(null);\n  // Lesson-level sources side panel (US-040). Independent of section panel.\n  const [lessonSourcesPanelOpen, setLessonSourcesPanelOpen] = useState(false);\n  // LessonChat side-panel state, persisted to localStorage['lessonChat-open'].\n  // Hydrated from storage in the same effect that hydrates TOC collapse below.\n  const [chatOpen, setChatOpen] = useState(false);\n  // Focus mode (US-021 'f'): when on, both side panels are collapsed; when\n  // toggled off, the previous TOC-collapsed state is restored.\n  const focusModeRef = useRef<{ active: boolean; previousToc: boolean }>({\n    active: false,\n    previousToc: false,\n  });\n\n  // Hydrate collapse state from localStorage on mount. Lazy useState init can't\n  // touch window during SSR, so we read after mount and accept a one-frame flash.\n  useEffect(() => {\n    try {\n      const stored = window.localStorage.getItem(TOC_COLLAPSED_KEY);\n      if (stored === 'true') {\n        // eslint-disable-next-line react-hooks/set-state-in-effect\n        setTocCollapsed(true);\n      }\n      const chatStored = window.localStorage.getItem(CHAT_OPEN_KEY);\n      if (chatStored === 'true') {\n        // eslint-disable-next-line react-hooks/set-state-in-effect\n        setChatOpen(true);\n      }\n    } catch {\n      // localStorage unavailable (SSR / privacy mode) — fall back to default.\n    }\n  }, []);\n\n  const toggleToc = useCallback(() => {\n    setTocCollapsed((prev) => {\n      const next = !prev;\n      try {\n        window.localStorage.setItem(TOC_COLLAPSED_KEY, next ? 'true' : 'false');\n      } catch {\n        // Persistence unavailable — toggle still works for the session.\n      }\n      return next;\n    });","numLines":50,"startLine":110,"totalLines":2454}}}
