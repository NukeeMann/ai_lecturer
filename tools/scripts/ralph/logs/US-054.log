{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016HGg2Fy1hcrbh7ibWrdGVj","type":"tool_result","content":"1\timport { NextResponse } from 'next/server';\n2\timport { promises as fs } from 'node:fs';\n3\timport { LessonSchema } from '@/lib/schemas/lesson';\n4\timport { atomicWriteJson } from '@/lib/server/atomic';\n5\timport { InvalidSlugError, lessonFile } from '@/lib/server/paths';\n6\t\n7\texport const dynamic = 'force-dynamic';\n8\t\n9\ttype RouteCtx = { params: Promise<{ slug: string; lessonSlug: string }> };\n10\t\n11\texport async function GET(_req: Request, { params }: RouteCtx) {\n12\t  const { slug, lessonSlug } = await params;\n13\t  let file: string;\n14\t  try {\n15\t    file = lessonFile(slug, lessonSlug);\n16\t  } catch (err) {\n17\t    if (err instanceof InvalidSlugError) {\n18\t      return NextResponse.json({ error: err.message }, { status: 400 });\n19\t    }\n20\t    throw err;\n21\t  }\n22\t\n23\t  let raw: string;\n24\t  try {\n25\t    raw = await fs.readFile(file, 'utf8');\n26\t  } catch (err) {\n27\t    if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n28\t      return NextResponse.json({ error: 'Lesson not found' }, { status: 404 });\n29\t    }\n30\t    throw err;\n31\t  }\n32\t\n33\t  try {\n34\t    const json: unknown = JSON.parse(raw);\n35\t    const parsed = LessonSchema.parse(json);\n36\t    return NextResponse.json(parsed);\n37\t  } catch (err) {\n38\t    return NextResponse.json(\n39\t      { error: 'Stored lesson is invalid', detail: String(err) },\n40\t      { status: 500 },\n41\t    );\n42\t  }\n43\t}\n44\t\n45\texport async function PUT(req: Request, { params }: RouteCtx) {\n46\t  const { slug, lessonSlug } = await params;\n47\t  let file: string;\n48\t  try {\n49\t    file = lessonFile(slug, lessonSlug);\n50\t  } catch (err) {\n51\t    if (err instanceof InvalidSlugError) {\n52\t      return NextResponse.json({ error: err.message }, { status: 400 });\n53\t    }\n54\t    throw err;\n55\t  }\n56\t\n57\t  let body: unknown;\n58\t  try {\n59\t    body = await req.json();\n60\t  } catch {\n61\t    return NextResponse.json({ error: 'Invalid JSON body' }, { status: 400 });\n62\t  }\n63\t\n64\t  const parsed = LessonSchema.safeParse(body);\n65\t  if (!parsed.success) {\n66\t    return NextResponse.json(\n67\t      { error: 'Invalid Lesson', issues: parsed.error.issues },\n68\t      { status: 400 },\n69\t    );\n70\t  }\n71\t\n72\t  await atomicWriteJson(file, parsed.data);\n73\t  return NextResponse.json(parsed.data);\n74\t}\n75\t"}]},"parent_tool_use_id":null,"session_id":"ac2e4d8e-61f9-4667-9e24-a812af5dbc90","uuid":"410bc0e0-22e8-4668-b4ad-b1dfb6a91853","timestamp":"2026-05-04T06:30:52.601Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-054/src/app/api/courses/[slug]/lessons/[lessonSlug]/route.ts","content":"import { NextResponse } from 'next/server';\nimport { promises as fs } from 'node:fs';\nimport { LessonSchema } from '@/lib/schemas/lesson';\nimport { atomicWriteJson } from '@/lib/server/atomic';\nimport { InvalidSlugError, lessonFile } from '@/lib/server/paths';\n\nexport const dynamic = 'force-dynamic';\n\ntype RouteCtx = { params: Promise<{ slug: string; lessonSlug: string }> };\n\nexport async function GET(_req: Request, { params }: RouteCtx) {\n  const { slug, lessonSlug } = await params;\n  let file: string;\n  try {\n    file = lessonFile(slug, lessonSlug);\n  } catch (err) {\n    if (err instanceof InvalidSlugError) {\n      return NextResponse.json({ error: err.message }, { status: 400 });\n    }\n    throw err;\n  }\n\n  let raw: string;\n  try {\n    raw = await fs.readFile(file, 'utf8');\n  } catch (err) {\n    if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n      return NextResponse.json({ error: 'Lesson not found' }, { status: 404 });\n    }\n    throw err;\n  }\n\n  try {\n    const json: unknown = JSON.parse(raw);\n    const parsed = LessonSchema.parse(json);\n    return NextResponse.json(parsed);\n  } catch (err) {\n    return NextResponse.json(\n      { error: 'Stored lesson is invalid', detail: String(err) },\n      { status: 500 },\n    );\n  }\n}\n\nexport async function PUT(req: Request, { params }: RouteCtx) {\n  const { slug, lessonSlug } = await params;\n  let file: string;\n  try {\n    file = lessonFile(slug, lessonSlug);\n  } catch (err) {\n    if (err instanceof InvalidSlugError) {\n      return NextResponse.json({ error: err.message }, { status: 400 });\n    }\n    throw err;\n  }\n\n  let body: unknown;\n  try {\n    body = await req.json();\n  } catch {\n    return NextResponse.json({ error: 'Invalid JSON body' }, { status: 400 });\n  }\n\n  const parsed = LessonSchema.safeParse(body);\n  if (!parsed.success) {\n    return NextResponse.json(\n      { error: 'Invalid Lesson', issues: parsed.error.issues },\n      { status: 400 },\n    );\n  }\n\n  await atomicWriteJson(file, parsed.data);\n  return NextResponse.json(parsed.data);\n}\n","numLines":75,"startLine":1,"totalLines":75}}}
