{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011Wp2VY3sfa1csto8ychAMs","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport type { CSSProperties, ReactNode } from 'react';\n4\timport { useEffect } from 'react';\n5\timport { X } from 'lucide-react';\n6\t\n7\tinterface ShortcutSpec {\n8\t  keys: string[];\n9\t  label: string;\n10\t}\n11\t\n12\tinterface ShortcutGroup {\n13\t  title: string;\n14\t  items: ShortcutSpec[];\n15\t}\n16\t\n17\tconst GROUPS: ShortcutGroup[] = [\n18\t  {\n19\t    title: 'Global',\n20\t    items: [\n21\t      { keys: ['?'], label: 'Show keyboard shortcuts' },\n22\t      { keys: ['Esc'], label: 'Close modal' },\n23\t    ],\n24\t  },\n25\t  {\n26\t    title: 'Lesson',\n27\t    items: [\n28\t      { keys: ['j'], label: 'Next section' },\n29\t      { keys: ['↓'], label: 'Next section' },\n30\t      { keys: ['k'], label: 'Previous section' },\n31\t      { keys: ['↑'], label: 'Previous section' },\n32\t      { keys: ['⌘', 'B'], label: 'Toggle table of contents' },\n33\t      { keys: ['⌘', '.'], label: 'Toggle AI tutor' },\n34\t      { keys: ['Space'], label: 'Mark current section complete' },\n35\t      { keys: ['n'], label: 'Next lesson (when current is complete)' },\n36\t      { keys: ['p'], label: 'Previous lesson' },\n37\t      { keys: ['f'], label: 'Focus mode (collapse panels)' },\n38\t    ],\n39\t  },\n40\t  {\n41\t    title: 'Code editor',\n42\t    items: [\n43\t      { keys: ['⌘', '↵'], label: 'Run code' },\n44\t      { keys: ['Tab'], label: 'Indent' },\n45\t      { keys: ['⇧', 'Tab'], label: 'Outdent' },\n46\t    ],\n47\t  },\n48\t  {\n49\t    title: 'Chat composer',\n50\t    items: [\n51\t      { keys: ['↵'], label: 'Send message' },\n52\t      { keys: ['⇧', '↵'], label: 'New line' },\n53\t    ],\n54\t  },\n55\t];\n56\t\n57\tconst backdropStyle: CSSProperties = {\n58\t  position: 'fixed',\n59\t  inset: 0,\n60\t  background: 'rgba(0, 0, 0, 0.5)',\n61\t  backdropFilter: 'blur(4px)',\n62\t  WebkitBackd