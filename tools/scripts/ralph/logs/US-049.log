t showPagination = data.rows.length > pageSize;\n197\t\n198\t  const clampedPage = Math.min(page, totalPages - 1);\n199\t  const start = clampedPage * pageSize;\n200\t  const visibleRows = sorted.slice(start, start + pageSize);\n201\t\n202\t  const updateTextFilter = (key: string, value: string) => {\n203\t    setFilters((prev) => ({ ...prev, [key]: value }));\n204\t    setPage(0);\n205\t  };\n206\t\n207\t  const updateRangeFilter = (key: string, side: 'min' | 'max', value: string) => {\n208\t    setFilters((prev) => {\n209\t      const existing = (prev[key] as NumberRangeFilter | undefined) ?? {};\n210\t      const next: NumberRangeFilter = { ...existing };\n211\t      if (value === '') {\n212\t        delete next[side];\n213\t      } else {\n214\t        const num = Number(value);\n215\t        if (Number.isNaN(num)) return prev;\n216\t        next[side] = num;\n217\t      }\n218\t      return { ...prev, [key]: next };\n219\t    });\n220\t    setPage(0);\n221\t  };\n222\t\n223\t  const handleHeaderClick = (col: DataTableColumn) => {\n224\t    if (col.sortable === false) return;\n225\t    setSort((current) => nextSort(current, col.key));\n226\t  };\n227\t\n228\t  const anyFilterable = data.columns.some((c) => c.filterable);\n229\t\n230\t  return (\n231\t    <div data-datatable-body style={wrapStyle}>\n232\t      <div style={tableContainerStyle} data-testid=\"datatable-scroll\">\n233\t        <table style={tableStyle} data-testid=\"datatable\">\n234\t          <thead style={theadStyle}>\n235\t            <tr>\n236\t              {data.columns.map((col) => {\n237\t                const isSorted = sort?.key === col.key;\n238\t                const dir = isSorted ? sort?.dir : null;\n239\t                const sortable = col.sortable !== false;\n240\t                return (\n241\t                  <th\n242\t                    key={col.key}\n243\t                    scope=\"col\"\n244\t                    style={thBaseStyle}\n245\t                    data-testid={`dat