{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Bdis8TisFmLL3wCjyZpah","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t/**\n3\t * Universal Playwright Executor for Claude Code\n4\t *\n5\t * Executes Playwright automation code from:\n6\t * - File path: node run.js script.js\n7\t * - Inline code: node run.js 'await page.goto(\"...\")'\n8\t * - Stdin: cat script.js | node run.js\n9\t *\n10\t * Ensures proper module resolution by running from skill directory.\n11\t */\n12\t\n13\tconst fs = require('fs');\n14\tconst path = require('path');\n15\tconst { execSync } = require('child_process');\n16\t\n17\t// Change to skill directory for proper module resolution\n18\tprocess.chdir(__dirname);\n19\t\n20\t/**\n21\t * Check if Playwright is installed\n22\t */\n23\tfunction checkPlaywrightInstalled() {\n24\t  try {\n25\t    require.resolve('playwright');\n26\t    return true;\n27\t  } catch (e) {\n28\t    return false;\n29\t  }\n30\t}\n31\t\n32\t/**\n33\t * Install Playwright if missing\n34\t */\n35\tfunction installPlaywright() {\n36\t  console.log('📦 Playwright not found. Installing...');\n37\t  try {\n38\t    execSync('npm install', { stdio: 'inherit', cwd: __dirname });\n39\t    execSync('npx playwright install chromium', { stdio: 'inherit', cwd: __dirname });\n40\t    console.log('✅ Playwright installed successfully');\n41\t    return true;\n42\t  } catch (e) {\n43\t    console.error('❌ Failed to install Playwright:', e.message);\n44\t    console.error('Please run manually: cd', __dirname, '&& npm run setup');\n45\t    return false;\n46\t  }\n47\t}\n48\t\n49\t/**\n50\t * Get code to execute from various sources\n51\t */\n52\tfunction getCodeToExecute() {\n53\t  const args = process.argv.slice(2);\n54\t\n55\t  // Case 1: File path provided\n56\t  if (args.length > 0 && fs.existsSync(args[0])) {\n57\t    const filePath = path.resolve(args[0]);\n58\t    console.log(`📄 Executing file: ${filePath}`);\n59\t    return fs.readFileSync(filePath, 'utf8');\n60\t  }\n61\t\n62\t  // Case 2: Inline code provided as argument\n63\t  if (args.length > 0) {\n64\t    console.log('⚡ Executing inline code');\n65\t    return args.join(' ');\n66\t  }\n67\t\n68\t  // Case 3: Code from stdin\n69\t  if (!process.stdin.isTTY) {\n70\t    console.log('📥 Reading from stdin');\n71\t    return fs.readFileSync(0, 'utf8');\n72\t  }\n73\t\n74\t  // No input\n75\t  console.error('❌ No code to execute');\n76\t  console.error('Usage:');\n77\t  console.error('  node run.js script.js          # Execute file');\n78\t  console.error('  node run.js \"code here\"        # Execute inline');\n79\t  console.error('  cat script.js | node run.js    # Execute from stdin');\n80\t  process.exit(1);"}]},"parent_tool_use_id":null,"session_id":"fb5c9adb-fc42-4b13-8a3c-82c2b6f512d6","uuid":"7c8c6e5b-6439-44f3-a43a-6781ae23f7d7","timestamp":"2026-05-03T22:37:53.233Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-049/scripts/ralph/skills/playwright-skill/run.js","content":"#!/usr/bin/env node\n/**\n * Universal Playwright Executor for Claude Code\n *\n * Executes Playwright automation code from:\n * - File path: node run.js script.js\n * - Inline code: node run.js 'await page.goto(\"...\")'\n * - Stdin: cat script.js | node run.js\n *\n * Ensures proper module resolution by running from skill directory.\n */\n\nconst fs = require('fs');\nconst path = require('path');\nconst { execSync } = require('child_process');\n\n// Change to skill directory for proper module resolution\nprocess.chdir(__dirname);\n\n/**\n * Check if Playwright is installed\n */\nfunction checkPlaywrightInstalled() {\n  try {\n    require.resolve('playwright');\n    return true;\n  } catch (e) {\n    return false;\n  }\n}\n\n/**\n * Install Playwright if missing\n */\nfunction installPlaywright() {\n  console.log('📦 Playwright not found. Installing...');\n  try {\n    execSync('npm install', { stdio: 'inherit', cwd: __dirname });\n    execSync('npx playwright install chromium', { stdio: 'inherit', cwd: __dirname });\n    console.log('✅ Playwright installed successfully');\n    return true;\n  } catch (e) {\n    console.error('❌ Failed to install Playwright:', e.message);\n    console.error('Please run manually: cd', __dirname, '&& npm run setup');\n    return false;\n  }\n}\n\n/**\n * Get code to execute from various sources\n */\nfunction getCodeToExecute() {\n  const args = process.argv.slice(2);\n\n  // Case 1: File path provided\n  if (args.length > 0 && fs.existsSync(args[0])) {\n    const filePath = path.resolve(args[0]);\n    console.log(`📄 Executing file: ${filePath}`);\n    return fs.readFileSync(filePath, 'utf8');\n  }\n\n  // Case 2: Inline code provided as argument\n  if (args.length > 0) {\n    console.log('⚡ Executing inline code');\n    return args.join(' ');\n  }\n\n  // Case 3: Code from stdin\n  if (!process.stdin.isTTY) {\n    console.log('📥 Reading from stdin');\n    return fs.readFileSync(0, 'utf8');\n  }\n\n  // No input\n  console.error('❌ No code to execute');\n  console.error('Usage:');\n  console.error('  node run.js script.js          # Execute file');\n  console.error('  node run.js \"code here\"        # Execute inline');\n  console.error('  cat script.js | node run.js    # Execute from stdin');\n  process.exit(1);","numLines":80,"startLine":1,"totalLines":229}}}
