h item.',\n186\t          items: [{ id: 'a', label: 'A' }],\n187\t          zones: [{ id: 'z', label: 'Z', accepts: ['a'] }],\n188\t        },\n189\t      },\n190\t      {\n191\t        id: 's-dt',\n192\t        title: 't',\n193\t        type: 'dataTable',\n194\t        data: {\n195\t          columns: [{ key: 'name', label: 'Name' }],\n196\t          rows: [{ name: 'Ada' }],\n197\t        },\n198\t      },\n199\t    ];\n200\t    for (const section of cases) {\n201\t      expect(() => SectionSchema.parse(section)).not.toThrow();\n202\t    }\n203\t  });\n204\t\n205\t  it('discriminated union rejects an unknown widget type', () => {\n206\t    expect(() =>\n207\t      SectionSchema.parse({ id: 's', title: 't', type: 'mystery', data: {} }),\n208\t    ).toThrow();\n209\t  });\n210\t\n211\t  it('accepts lesson-level + section-level sources', () => {\n212\t    const lessonWithSources = {\n213\t      ...lesson,\n214\t      sources: [\n215\t        {\n216\t          url: 'https://example.com/a',\n217\t          title: 'A',\n218\t          kind: 'paper',\n219\t          author: 'A. Author',\n220\t          year: 2024,\n221\t        },\n222\t      ],\n223\t      sections: [\n224\t        {\n225\t          id: 's1',\n226\t          title: 'Read',\n227\t          type: 'theory',\n228\t          data: { markdown: '# hi' },\n229\t          sources: [\n230\t            { url: 'https://example.com/v', title: 'Vid', kind: 'video' },\n231\t          ],\n232\t        },\n233\t      ],\n234\t    };\n235\t    const parsed = LessonSchema.parse(lessonWithSources);\n236\t    expect(parsed.sources?.[0].kind).toBe('paper');\n237\t    expect(parsed.sections[0].sources?.[0].kind).toBe('video');\n238\t  });\n239\t\n240\t  it('rejects sources with an unknown kind', () => {\n241\t    const bad = {\n242\t      ...lesson,\n243\t      sources: [{ url: 'https://example.com', title: 'T', kind: 'tweet' }],\n244\t    };\n245\t    expect(() => LessonSchema.parse(bad)).toThrow();\n246\t  });\n247\t});\n248