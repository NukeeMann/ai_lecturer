urrentTime in useEffect immediately after first paint.\n    const initialCurrentTime = await page.evaluate(() => {\n      const v = document.querySelector('[data-testid=\"video-mp4\"]');\n      return v.currentTime;\n    });\n    console.log('INITIAL currentTime:', initialCurrentTime);\n    if (initialCurrentTime !== 5) {\n      throw new Error('Expected startAt=5 to be applied on mount, got ' + initialCurrentTime);\n    }\n\n    // 3) Override currentTime setter to capture subsequent seek calls\n    await page.evaluate(() => {\n      const v = document.querySelector('[data-testid=\"video-mp4\"]');\n      let _t = v.currentTime;\n      window.__videoSeekCalls = [];\n      Object.defineProperty(v, 'currentTime', {\n        get() {\n          return _t;\n        },\n        set(value) {\n          _t = value;\n          window.__videoSeekCalls.push(value);\n        },\n        configurable: true,\n      });\n      v.play = () => Promise.resolve();\n    });\n\n    // 4) Click 2nd transcript segment (index 1 => tStart=10)\n    await page.locator('[data-testid=\"video-transcript-seg-1\"]').click();\n    await page.waitForTimeout(200);\n\n    const seekCalls = await page.evaluate(() => window.__videoSeekCalls || []);\n    console.log('VIDEO SEEK CALLS:', JSON.stringify(seekCalls));\n    if (!seekCalls.includes(10)) {\n      throw new Error('Expected currentTime=10 after click, got ' + JSON.stringify(seekCalls));\n    }","originalFile":"const { chromium } = require('playwright');\n\nconst TARGET_URL = 'http://localhost:3049/courses/video-test/lessons/mp4-demo';\n\n(async () => {\n  const browser = await chromium.launch({ headless: true });\n  const context = await browser.newContext();\n  const page = await context.newPage();\n\n  page.on('console', (msg) => {\n    if (msg.type() === 'error') console.log('PAGE ERROR:', msg.text());\n  });\n  page.on('pageerror', (err) => console.log('PAGE EXCEPTION:', err.message));\n\n  try {\n    await page.goto(TARGET_URL, { waitUntil: 'networkidle', timeout: 60_000 });\n    await page.waitForSelector('[data-video-widget]', { timeout: 30_000 });\n\n    // 1) <video> element is rendered with the right attrs\n    const videoAttrs = await page.evaluate(() => {\n      const v = document.querySelector('[data-testid=\"video-mp4\"]');\n      if (!v) return null;\n      return {\n        tag: v.tagName.toLowerCase(),\n        controls: v.hasAttribute('controls'),\n        src: v.getAttribute('src'),\n        autoplay: v.hasAttribute('autoplay') || v.autoplay,\n      };\n    });\n    console.log('VIDEO ATTRS:', JSON.stringify(videoAttrs));\n    if (!videoAttrs) throw new Error('No <video> rendered');\n    if (videoAttrs.tag !== 'video') throw new Error('Expected <video>, got ' + videoAttrs.tag);\n    if (!videoAttrs.controls) throw new Error('controls attribute missing');\n    if (!videoAttrs.src.includes('/api/courses/video-test/assets/sample.mp4')) {\n      throw new Error('src wrong: ' + videoAttrs.src);\n    }\n    if (videoAttrs.autoplay) throw new Error('autoplay should be false by default');\n\n    // 2) Override currentTime setter to capture seek calls\n    await page.evaluate(() => {\n      const v = document.querySelector('[data-testid=\"video-mp4\"]');\n      let _t = 0;\n      window.__videoSeekCalls = [];\n      Object.defineProperty(v, 'currentTime', {\n        get() {\n          return _t;\n        },\n        set(value) {\n          _t = value;\n          window.__videoSeekCalls.push(value);\n        },\n        configurable: true,\n      });\n      // Also stub play() so it doesn't error on missing media.\n      v.play = () => Promise.resolve();\n    });\n\n    // 3) Click 2nd transcript segment (index 1 => tStart=10)\n    await page.locator('[data-testid=\"video-transcript-seg-1\"]').click();\n    await page.waitForTimeout(200);\n\n    const seekCalls = await page.evaluate(() => window.__videoSeekCalls || []);\n    console.log('VIDEO SEEK CALLS:', JSON.stringify(seekCalls));\n    // Includes one initial assignment (startAt=5 on mount) + the click seek.\n    if (!seekCalls.includes(10)) {\n      throw new Error('Expected currentTime=10 after click, got ' + JSON.stringify(seekCalls));\n    }\n\n    // 4) startAt was applied on mount\n    if (!seekCalls.includes(5)) {\n      throw new Error('Expected startAt=5 to be applied on mount, got ' + JSON.stringify(seekCalls));\n    }\n\n    // 5) Speaker label appears on segment 1\n    const seg1Text = await page.locator('[data-testid=\"video-transcript-seg-1\"]').textContent();\n    console.log('SEG 1 TEXT:', seg1Text);\n    if (!seg1Text || !seg1Text.toLowerCase().includes('narrator')) {\n      throw new Error('Speaker \"Narrator\" not visible');\n    }\n\n    await page.screenshot({ path: '/tmp/us-049-2-mp4.png', fullPage: true });\n    console.log('MP4 TEST PASSED');\n  } catch (err) {\n    console.log('FAIL:', err.message);\n    process.exitCode = 1;\n  } finally {\n    await browser.close();\n  }\n})();\n","structuredPatch":[{"oldStart":36,"oldLines":10,"newStart":36,"newLines":22,"lines":["     }","     if (videoAttrs.autoplay) throw new Error('autoplay should be false by default');"," ","-    // 2) Override currentTime setter to capture seek calls","+    // 2) Capture initial currentTime (startAt=5 should have been applied during mount).","+    //    The 404 on the asset itself doesn't prevent the assignment from being recorded","+    //    because our component sets currentTime in useEffect immediately after first paint.","+    const initialCurrentTime = await page.evaluate(() => {","+      const v = document.querySelector('[data-testid=\"video-mp4\"]');","+      return v.currentTime;","+    });","+    console.log('INITIAL currentTime:', initialCurrentTime);","+    if (initialCurrentTime !== 5) {","+      throw new Error('Expected startAt=5 to be applied on mount, got ' + initialCurrentTime);","+    }","+","+    // 3) Override currentTime setter to capture subsequent seek calls","     await page.evalu