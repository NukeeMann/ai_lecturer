{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Psr9gUcuAQSTV3Bo3LtTAj","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport {\n4\t  useCallback,\n5\t  useEffect,\n6\t  useMemo,\n7\t  useRef,\n8\t  useState,\n9\t  type CSSProperties,\n10\t} from 'react';\n11\timport { Upload } from 'lucide-react';\n12\timport { EditorState } from '@codemirror/state';\n13\timport { EditorView, keymap, lineNumbers } from '@codemirror/view';\n14\timport {\n15\t  defaultKeymap,\n16\t  history,\n17\t  historyKeymap,\n18\t  indentWithTab,\n19\t} from '@codemirror/commands';\n20\timport {\n21\t  bracketMatching,\n22\t  indentOnInput,\n23\t  syntaxHighlighting,\n24\t} from '@codemirror/language';\n25\timport { python } from '@codemirror/lang-python';\n26\timport type { z } from 'zod';\n27\t\n28\timport {\n29\t  EditorFormFooter,\n30\t  EditorFormSaveError,\n31\t  errorTextStyle,\n32\t  fieldStyle,\n33\t  formBodyStyle,\n34\t  inputStyle,\n35\t  labelStyle,\n36\t  textareaStyle,\n37\t  type FieldErrors,\n38\t} from '@/components/EditorForm';\n39\timport { SourcesField } from '@/components/Sources';\n40\timport type { Source } from '@/lib/schemas/lesson';\n41\t\n42\timport {\n43\t  codeRunnerEditorTheme,\n44\t  codeRunnerHighlightStyle,\n45\t} from '../Code/CodeRunner';\n46\timport { PlotImageDataSchema, type PlotImageData } from './schema';\n47\t\n48\texport interface PlotImageEditorProps {\n49\t  initial: PlotImageData;\n50\t  initialSources?: Source[];\n51\t  courseSlug: string;\n52\t  onCancel: () => void;\n53\t  onSave: (next: PlotImageData, sources?: Source[]) => Promise<void>;\n54\t}\n55\t\n56\tfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n57\t  const out: FieldErrors = {};\n58\t  for (const issue of error.issues) {\n59\t    const path = issue.path.join('.') || '_root';\n60\t    if (!out[path]) out[path] = issue.message;\n61\t  }\n62\t  return out;\n63\t}\n64\t\n65\tconst cmContainerStyle: CSSProperties = {\n66\t  background: 'var(--code-bg)',\n67\t  border: '1px solid var(--border-strong)',\n68\t  borderRadius: 'var(--radius-md)',\n69\t  overflow: 'hidden',\n70\t};\n71\t\n72\tconst uploadButtonStyle: CSSProperties = {\n73\t  display: 'inline-flex',\n74\t  alignItems: 'center',\n75\t  gap: 6,\n76\t  padding: '6px 10px',\n77\t  background: 'transparent',\n78\t  border: '1px dashed var(--border-strong)',\n79\t  borderRadius: 'var(--radius-md)',\n80\t  color: 'var(--text-secondary)',\n81\t  fontSize: 'var(--fs-xs)',\n82\t  fontWeight: 500,\n83\t  cursor: 'pointer',\n84\t  marginTop: 6,\n85\t};\n86\t\n87\tconst segmentedRowStyle: CSSProperties = {\n88\t  display: 'inline-flex',\n89\t  border: '1px solid var(--border-strong)',\n90\t  borderRadius: 'var(--radius-md)',\n91\t  overflow: 'hidden',\n92\t};\n93\t\n94\tfunction segmentedButtonStyle(active: boolean): CSSProperties {\n95\t  return {\n96\t    padding: '4px 12px',\n97\t    fontSize: 'var(--fs-xs)',\n98\t    fontWeight: 500,\n99\t    background: active ? 'var(--accent-subtle)' : 'transparent',\n100\t    color: active ? 'var(--accent-text)' : 'var(--text-secondary)',\n101\t    border: 'none',\n102\t    cursor: 'pointer',\n103\t  };\n104\t}\n105\t\n106\tinterface SourceCodeEditorProps {\n107\t  initial: string;\n108\t  language: 'python' | 'r';\n109\t  onChange: (value: string) => void;\n110\t}\n111\t\n112\tfunction SourceCodeEditor({ initial, language, onChange }: SourceCodeEditorProps) {\n113\t  const parentRef = useRef<HTMLDivElement | null>(null);\n114\t  const onChangeRef = useRef(onChange);\n115\t\n116\t  useEffect(() => {\n117\t    onChangeRef.current = onChange;\n118\t  }, [onChange]);\n119\t\n120\t  useEffect(() => {\n121\t    if (!parentRef.current) return;\n122\t    const langExtensions = language === 'python' ? [python()] : [];\n123\t    const updateListener = EditorView.updateListener.of((update) => {\n124\t      if (update.docChanged) {\n125\t        onChangeRef.current(update.state.doc.toString());\n126\t      }\n127\t    });\n128\t    const view = new EditorView({\n129\t      parent: parentRef.current,\n130\t      state: EditorState.create({\n131\t        doc: initial,\n132\t        extensions: [\n133\t          lineNumbers(),\n134\t          history(),\n135\t          indentOnInput(),\n136\t          bracketMatching(),\n137\t          ...langExtensions,\n138\t          syntaxHighlighting(codeRunnerHighlightStyle),\n139\t          codeRunnerEditorTheme,\n140\t          keymap.of([...defaultKeymap, ...historyKeymap, indentWithTab]),\n141\t          updateListener,\n142\t        ],\n143\t      }),\n144\t    });\n145\t    return () => {\n146\t      view.destroy();\n147\t    };\n148\t    // Re-mount when language changes so the python() extension is added/removed.\n149\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n150\t  }, [language]);\n151\t\n152\t  return <div ref={parentRef} data-testid=\"plotimage-edit-source-code\" style={cmContainerStyle} />;\n153\t}\n154\t\n155\texport function PlotImageEditor({\n156\t  initial,\n157\t  initialSources,\n158\t  courseSlug,\n159\t  onCancel,\n160\t  onSave,\n161\t}: PlotImageEditorProps) {\n162\t  const [src, setSrc] = useState(initial.src);\n163\t  const [alt, setAlt] = useState(initial.alt);\n164\t  const [caption, setCaption] = useState(initial.caption ?? '');\n165\t  const [sourceCode, setSourceCode] = useState<string>(initial.sourceCode ?? '');\n166\t  const [sourceLanguage, setSourceLanguage] = useState<'python' | 'r'>(\n167\t    initial.sourceLanguage ?? 'python',\n168\t  );\n169\t  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n170\t  const [errors, setErrors] = useState<FieldErrors>({});\n171\t  const [saving, setSaving] = useState(false);\n172\t  const [saveError, setSaveError] = useState<string | null>(null);\n173\t  const [uploading, setUploading] = useState(false);\n174\t  const [uploadError, setUploadError] = useState<string | null>(null);\n175\t  const fileInputRef = useRef<HTMLInputElement | null>(null);\n176\t\n177\t  const current: PlotImageData = useMemo(() => {\n178\t    const obj: PlotImageData = { src, alt };\n179\t    if (caption.trim()) obj.caption = caption;\n180\t    if (sourceCode.trim()) {\n181\t      obj.sourceCode = sourceCode;\n182\t      obj.sourceLanguage = sourceLanguage;\n183\t    }\n184\t    return obj;\n185\t  }, [src, alt, caption, sourceCode, sourceLanguage]);\n186\t\n187\t  const dirty = useMemo(() => {\n188\t    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n189\t    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n190\t  }, [current, initial, sources, initialSources]);\n191\t\n192\t  const handleSave = useCallback(async () => {\n193\t    if (!dirty || saving) return;\n194\t    const result = PlotImageDataSchema.safeParse(current);\n195\t    if (!result.success) {\n196\t      setErrors(flattenIssues(result.error));\n197\t      return;\n198\t    }\n199\t    setErrors({});\n200\t    setSaveError(null);\n201\t    setSaving(true);\n202\t    try {\n203\t      await onSave(result.data, sources);\n204\t      setSaving(false);\n205\t    } catch (err) {\n206\t      setSaveError(err instanceof Error ? err.message : String(err));\n207\t      setSaving(false);\n208\t    }\n209\t  }, [current, dirty, onSave, saving, sources]);\n210\t\n211\t  const handleFileChange = useCallback(\n212\t    async (event: React.ChangeEvent<HTMLInputElement>) => {\n213\t      const file = event.target.files?.[0];\n214\t      if (!file) return;\n215\t      setUploadError(null);\n216\t      setUploading(true);\n217\t      try {\n218\t        const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '-');\n219\t        const url = `/api/courses/${encodeURIComponent(courseSlug)}/assets/plots/${encodeURIComponent(safeName)}`;\n220\t        const res = await fetch(url, {\n221\t          method: 'PUT',\n222\t          headers: { 'Content-Type': file.type || 'application/octet-stream' },\n223\t          body: