se<void>;\n788\t}\n789\t\n790\tfunction WidgetEditPanel({ section, courseSlug, open, onClose, onSave }: WidgetEditPanelProps) {\n791\t  const title = section ? `Edit ${widgetRegistry[section.type as WidgetType].label}` : 'Edit';\n792\t  return (\n793\t    <SidePanel\n794\t      open={open}\n795\t      onClose={onClose}\n796\t      title={title}\n797\t      testId=\"widget-edit-panel\"\n798\t    >\n799\t      {section?.type === 'quiz' && (\n800\t        <QuizEditor\n801\t          key={section.id}\n802\t          initial={section.data}\n803\t          initialSources={section.sources}\n804\t          onCancel={onClose}"}]},"parent_tool_use_id":null,"session_id":"fb5c9adb-fc42-4b13-8a3c-82c2b6f512d6","uuid":"2254dd76-38eb-413c-b97c-ff11a9f907f4","timestamp":"2026-05-03T22:35:14.575Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-049/src/app/courses/[slug]/lessons/[lessonSlug]/page.tsx","content":"        prevLesson={prevLesson}\n        nextLesson={nextLesson}\n        status={lessonStatus}\n        onMarkComplete={handleMarkComplete}\n        onNavigate={handleNavigate}\n      />\n\n      <WidgetEditPanel\n        section={panelSection}\n        courseSlug={slug}\n        open={panelSectionId !== null && panelSection !== null}\n        onClose={handleClosePanel}\n        onSave={handleSavePanelSection}\n      />\n\n      <LessonSourcesEditPanel\n        open={lessonSourcesPanelOpen}\n        sources={lesson?.sources}\n        onClose={() => setLessonSourcesPanelOpen(false)}\n        onSave={handleSaveLessonSources}\n      />\n\n      {sessionToast && <SessionToast message={sessionToast} />}\n    </div>\n  );\n}\n\nfunction SessionToast({ message }: { message: string }) {\n  return (\n    <div\n      data-testid=\"session-toast\"\n      role=\"status\"\n      aria-live=\"polite\"\n      style={{\n        position: 'fixed',\n        top: TOOLBAR_H + 12,\n        right: 16,\n        zIndex: 50,\n        background