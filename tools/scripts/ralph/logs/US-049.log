e: c.filterable === true,\n144\t      rowId: makeRowId(),\n145\t    })),\n146\t  );\n147\t  const [rowsText, setRowsText] = useState<string>(() =>\n148\t    JSON.stringify(initial.rows, null, 2),\n149\t  );\n150\t  const [pageSize, setPageSize] = useState<string>(() =>\n151\t    String(initial.pageSize ?? 25),\n152\t  );\n153\t  const [initialSortKey, setInitialSortKey] = useState<string>(\n154\t    initial.initialSort?.key ?? '',\n155\t  );\n156\t  const [initialSortDir, setInitialSortDir] = useState<'asc' | 'desc'>(\n157\t    initial.initialSort?.dir ?? 'asc',\n158\t  );\n159\t  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n160\t  const [errors, setErrors] = useState<FieldErrors>({});\n161\t  const [saving, setSaving] = useState(false);\n162\t  const [saveError, setSaveError] = useState<string | null>(null);\n163\t\n164\t  const rowsParse = useMemo(() => {\n165\t    try {\n166\t      const parsed = JSON.parse(rowsText) as unknown;\n167\t      if (!Array.isArray(parsed)) {\n168\t        return { ok: false as const, error: 'Rows must be a JSON array' };\n169\t      }\n170\t      return { ok: true as const, value: parsed as DataTableRow[] };\n171\t    } catch (err) {\n172\t      return {\n173\t        ok: false as const,\n174\t        error: err instanceof Error ? err.message : 'Invalid JSON',\n175\t      };\n176\t    }\n177\t  }, [rowsText]);\n178\t\n179\t  const pageSizeParse = useMemo(() => {\n180\t    const trimmed = pageSize.trim();\n181\t    if (!trimmed) return { ok: false as const, error: 'Page size required' };\n182\t    const n = Number(trimmed);\n183\t    if (!Number.isInteger(n) || n <= 0) {\n184\t      return { ok: false as const, error: 'Page size must be a positive integer' };\n185\t    }\n186\t    return { ok: true as const, value: n };\n187\t  }, [pageSize]);\n188\t\n189\t  const current: DataTableData | null = useMemo(() => {\n190\t    if (!rowsParse.ok || !pageSizeParse.ok) return null;\n191\t    const out: DataTableData = {\n192\t      columns: columns.map((c) => ({\n193\t        key: c.key,\n194\t        label: c.label,\n195\t        type: c.type,\n196\t        sortable: c.sortable,\n197\t        filterable: c.filterable,\n198\t      })),\n199\t      rows: rowsParse.value,\n200\t      pageSize: pageSizeParse.value,\n201\t    };\n202\t    if (initialSortKey.trim()) {\n203\t      out.initialSort = { key: initialSortKey.trim(), dir: initialSortDir };\n204\t    }\n205\t    return out;\n206\t  }, [columns, rowsParse, pageSizeParse, initialSortKey, initialSortDir]);\n207\t\n208\t  const dirty = useMemo(() => {\n209\t    if (!current) return true;\n210\t    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n211\t    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n212\t  }, [current, initial, sources, initialSources]);\n213\t\n214\t  const handleSave = useCallback(async () => {\n215\t    if (saving) return;\n216\t    if (!rowsParse.ok) {\n217\t      setErrors({ rows: rowsParse.error });\n218\t      return;\n219\t    }\n220\t    if (!pageSizeParse.ok) {\n221\t      setErrors({ pageSize: pageSizeParse.error });\n222\t      return;\n223\t    }\n224\t    if (!current) return;\n225\t    const result = DataTableDataSchema.safeParse(current);\n226\t    if (!result.success) {\n227\t      setErrors(flattenIssues(result.error));\n228\t      return;\n229\t    }\n230\t    setErrors({});\n231\t    setSaveError(null);\n232\t    setSaving(true);\n233\t    try {\n234\t      await onSave(result.data, sources);\n235\t      setSaving(false);\n236\t    } catch (err) {\n237\t      setSaveError(err instanceof Error ? err.message : String(err));\n238\t      setSaving(false);\n239\t    }\n240\t  }, [current, onSave, pageSizeParse, rowsParse, saving, sources]);\n241\t\n242\t  const addColumn = useCallback(() => {\n243\t    setColumns((prev) => [\n244\t      ...prev,\n245\t      {\n246\t        rowId: makeRowId(),\n247\t        key: '',\n248\t        label: '',\n249\t        type: 'string',\n250\t        sortable: true,\n251\t        filterable: false,\n252\t      },\n253\t    ]);\n254\t  }, []);\n255\t\n256\t  const updateColumn = useCallback((rowId: string, patch: Partial<ColumnRow>) => {\n257\t    setColumns((prev) =>\n258\t      prev.map((c) => (c.rowId === rowId ? { ...c, ...patch } : c)),\n259\t    );\n260\t  }, []);\n261\t\n262\t  const removeColumn = useCallback((rowId: string) => {\n263\t    setColumns((prev) => prev.filter((c) => c.rowId !== rowId));\n264\t  }, []);\n265\t\n266\t  return (\n267\t    <div\n268\t      data-testid=\"data-table-editor\"\n269\t      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n270\t    >\n271\t      <div style={formBodyStyle}>\n272\t        <div style={fieldStyle}>\n273\t          <span style={labelStyle}>Columns</span>\n274\t          <div data-testid=\"datatable-edit-columns\">\n275\t            {columns.map((col, i) => (\n276\t              <div key={col.rowId} style={cardStyle} data-test-col-index={i}>\n277\t                <div style={cardHeaderStyle}>\n278\t                  <input\n279\t                    type=\"text\"\n280\t                    data-testid={`datatable-edit-col-key-${i}`}\n281\t                    value={col.key}\n282\t                    placeholder=\"key\"\n283\t                    onChange={(e) => updateColumn(col.rowId, { key: e.target.value })}\n284\t                    style={{\n285\t                      ...inputStyle,\n286\t                      flex: 1,\n287\t                      minWidth: 0,\n288\t                      fontFamily: 'var(--font-mono)',\n289\t                      fontSize: '12.5px',\n290\t                    }}\n291\t                  />\n292\t                  <button\n293\t                    type=\"button\"\n294\t                    data-testid={`datatable-edit-col-remove-${i}`}\n295\t                    onClick={() => removeColumn(col.rowId)}\n296\t                    aria-label={`Remove column ${i + 1}`}\n297\t                    style={removeButtonStyle}\n298\t                  >\n299\t                    <Trash2 size={13} aria-hidden />\n300\t                  </button>\n301\t                </div>\n302\t                <label>\n303\t                  <span style={subLabelStyle}>Label</span>\n304\t                  <input\n305\t                    type=\"text\"\n306\t                    data-testid={`datatable-edit-col-label-${i}`}\n307\t                    value={col.label}\n308\t                    onChange={(e) => updateColumn(col.rowId, { label: e.target.value })}\n309\t                    style={inputStyle}\n310\t                  />\n311\t                </label>\n312\t                <div style={inlineRowStyle}>\n313\t                  <label>\n314\t                    <span style={subLabelStyle}>Type</span>\n315\t                    <select\n316\t                      data-testid={`datatable-edit-col-type-${i}`}\n317\t                      value={col.type}\n318\t                      onChange={(e) =>\n319\t                        updateColumn(col.rowId, {\n320\t                          type: e.target.value as DataTableColumnType,\n321\t                        })\n322\t                      }\n323\t                      style={selectStyle}\n324\t                    >\n325\t                      <option value=\"string\">string</option>\n326\t                      <option value=\"number\">number</option>\n327\t                      <option value=\"boolean\">boolean</option>\n328\t                    </select>\n329\t                  </label>\n330\t                  <label style={checkLabelStyle}>\n331\t                    <input\n332\t                      type=\"checkbox\"\n333\t                      data-testid={`datatable-edit-col-sortable-${i}`}\n334\t                      checked={col.sortable !== false}\n335\t                      onChange={(e) =>\n336\t                        updateColumn(col.rowId, { sortable: e.target.checked })\n337\t                      }\n338\t                    />\n339\t                    Sortable\n340\t                  </label>\n341\t                  <label style={checkLabelStyle}>\n342\t                    <input\n343\t                      type=\"checkbox\"\n344\t                      data-testid={`datatable-edit-col-filterable-${i}`}\n345\t                      checked={col.filterable === true}\n346\t                      onChange={(e) =>\n347\t                        updateColumn(col.rowId, { filterable: e.target.checked })\n348\t                      }\n349\t                    />\n350\t                    Filterable\n351\t                  </label>\n352\t                </div>\n353\t              </div>\n354\t            ))}\n355\t          </div>\n356\t          <button\n357\t            type=\"button\"\n358\t            data-testid=\"datatable-edit-add-column\"\n359\t            onClick={addColumn}\n360\t            style={addButtonStyle}\n361\t          >\n362\t            <Plus size={12} aria-hidden /> Add column\n363\t          </button>\n364\t        </div>\n365\t\n366\t        <label style={fieldStyle}>\n367\t          <span style={labelStyle}>Rows (JSON array)</span>\n368\t          <textarea\n369\t            data-testid=\"datatable-edit-rows\"\n370\t            value={rowsText}\n371\t            onChange={(e) => setRowsText(e.target.value)}\n372\t            style={{\n373\t              ...textareaStyle,\n374\t              minHeight: 160,\n375\t              fontFamily: 'var(--font-mono)',\n376\t              fontSize: '12.5px',\n377\t            }}\n378\t            spellCheck={false}\n379\t          />\n380\t          {!rowsParse.ok && (\n381\t            <div style={errorTextStyle} data-testid=\"datatable-edit-rows-error\">\n382\t              {rowsParse.error}\n383\t            </div>\n384\t          )}\n385\t          {errors.rows && rowsParse.ok && (\n386\t            <div style={errorTextStyle}>{errors.rows}</div>\n387\t          )}\n388\t        </label>\n389\t\n390\t        <div style={inlineRowStyle}>\n391\t          <label style={fieldStyle}>\n392\t            <span style={labelStyle}>Page size</span>\n393\t            <input\n394\t              type=\"number\"\n395\t              min={1}\n396\t              data-testid=\"datatable-edit-page-size\"\n397\t              value={pageSize}\n398\t              onChange={(e) => setPageSize(e.target.value)}\n399\t              style={{ ...inputStyle, width: 96 }}\n400\t            />\n401\t            {!pageSizeParse.ok && (\n402\t              <div style={errorTextStyle}>{pageSizeParse.error}</div>\n403\t            )}\n404\t          </label>\n405\t\n406\t          <label style={fieldStyle}>\n407\t            <span style={labelStyle}>Initial sort key (optional)</span>\n408\t            <input\n409\t              type=\"text\"\n410\t              data-testid=\"datatable-edit-sort-key\"\n411\t              value={initialSortKey}\n412\t              onChange={(e) => setInitialSortKey(e.target.value)}\n413\t              style={{ ...inputStyle, width: 160 }}\n414\t              placeholder=\"(none)\"\n415\t            />\n416\t          </label>\n417\t\n418\t          <label style={fieldStyle}>\n419\t            <span style={labelStyle}>Initial sort direction</span>\n420\t            <select\n421\t              data-testid=\"datatable-edit-sort-dir\"\n422\t              value={initialSortDir}\n423\t              onChange={(e) =>\n424\t                setInitialSortDir(e.target.value as 'asc' | 'desc')\n425\t              }\n426\t              style={selectStyle}\n427\t            >\n428\t              <option value=\"asc\">asc</option>\n429\t              <option value=\"desc\">desc</option>\n430\t            </select>\n431\t          </label>\n432\t        </div>\n433\t\n434\t        <SourcesField sources={sources} onChange={setSources} />\n435\t\n436\t        {errors._root && <div style={errorTextStyle}>{errors._root}</div>}\n437\t      </div>\n438\t\n439\t      <EditorFormSaveError message={saveError} />\n440\t      <EditorFormFooter\n441\t        saving={saving}\n442\t        saveDisabled={!dirty}\n443\t        onCancel={onCancel}\n444\t        onSave={() => void handleSave()}\n445\t        cancelTestId=\"datatable-edit-cancel\"\n446\t        saveTestId=\"datatable-edit-save\"\n447\t      />\n448\t    </div>\n449\t  );\n450\t}\n451\t"}]},"parent_tool_use_id":null,"session_id":"fb5c9adb-fc42-4b13-8a3c-82c2b6f512d6","uuid":"2e44a431-5351-4e63-a9e2-3992d5840839","timestamp":"2026-05-03T22:30:03.460Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-049/src/widgets/DataTable/DataTableEditor.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useMemo,\n  useState,\n  type CSSProperties,\n} from 'react';\nimport { Plus, Trash2 } from 'lucide-react';\nimport type { z } from 'zod';\n\nimport {\n  EditorFormFooter,\n  EditorFormSaveError,\n  errorTextStyle,\n  fieldStyle,\n  formBodyStyle,\n  inputStyle,\n  labelStyle,\n  textareaStyle,\n  type FieldErrors,\n} from '@/components/EditorForm';\nimport { SourcesField } from '@/components/Sources';\nimport type { Source } from '@/lib/schemas/lesson';\n\nimport {\n  DataTableDataSchema,\n  type DataTableColumn,\n  type DataTableColumnType,\n  type DataTableData,\n  type DataTableRow,\n} from './schema';\n\nexport interface DataTableEditorProps {\n  initial: DataTableData;\n  initialSources?: Source[];\n  onCancel: () => void;\n  onSave: (next: DataTableData, sources?: Source[]) => Promise<void>;\n}\n\ninterface ColumnRow extends DataTableColumn {\n  rowId: string;\n}\n\nfunction makeRowId(): string {\n  return `r-${Math.random().toString(36).slice(2, 9)}`;\n}\n\nfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n  const out: FieldErrors = {};\n  for (const issue of error.issues) {\n    const path = issue.path.join('.') || '_root';\n    if (!out[path]) out[path] = issue.message;\n  }\n  return out;\n}\n\nconst cardStyle: CSSProperties = {\n  border: '1px solid var(--border)',\n  borderRadius: 'var(--radius-md)',\n  padding: 'var(--space-3)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-2)',\n  background: 'var(--bg-elevated)',\n  marginBottom: 6,\n};\n\nconst cardHeaderStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  gap: 'var(--space-2)',\n};\n\nconst removeButtonStyle: CSSProperties = {\n  width: 24,\n  height: 24,\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  background: 'transparent',\n  border: '1px solid transparent',\n  borderRadius: 'var(--radius-sm)',\n  color: 'var(--text-tertiary)',\n  cursor: 'pointer',\n  flexShrink: 0,\n};\n\nconst addButtonStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 4,\n  background: 'transparent',\n  border: '1px dashed var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  color: 'var(--text-secondary)',\n  fontSize: 'var(--fs-xs)',\n  fontWeight: 500,\n  padding: '6px 10px',\n  cursor: 'pointer',\n  marginTop: 4,\n};\n\nconst subLabelStyle: CSSProperties = {\n  display: 'block',\n  fontSize: '11px',\n  color: 'var(--text-tertiary)',\n  marginBottom: 4,\n};\n\nconst inlineRowStyle: CSSProperties = {\n  display: 'flex',\n  flexWrap: 'wrap',\n  gap: 'var(--space-3)',\n  alignItems: 'center',\n};\n\nconst checkLabelStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 6,\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text-secondary)',\n};\n\nconst selectStyle: CSSProperties = {\n  ...inputStyle,\n  width: 'auto',\n  paddingRight: 24,\n};\n\nexport function DataTableEditor({\n  initial,\n  initialSources,\n  onCancel,\n  onSave,\n}: DataTableEditorProps) {\n  const [columns, setColumns] = useState<ColumnRow[]>(() =>\n    initial.columns.map((c) => ({\n      ...c,\n      type: c.type ?? 'string',\n      sortable: c.sortable !== false,\n      filterable: c.filterable === true,\n      rowId: makeRowId(),\n    })),\n  );\n  const [rowsText, setRowsText] = useState<string>(() =>\n    JSON.stringify(initial.rows, null, 2),\n  );\n  const [pageSize, setPageSize] = useState<string>(() =>\n    String(initial.pageSize ?? 25),\n  );\n  const [initialSortKey, setInitialSortKey] = useState<string>(\n    initial.initialSort?.key ?? '',\n  );\n  const [initialSortDir, setInitialSortDir] = useState<'asc' | 'desc'>(\n    initial.initialSort?.dir ?? 'asc',\n  );\n  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n  const [errors, setErrors] = useState<FieldErrors>({});\n  const [saving, setSaving] = useState(false);\n  const [saveError, setSaveError] = useState<string | null>(null);\n\n  const rowsParse = useMemo(() => {\n    try {\n      const parsed = JSON.parse(rowsText) as unknown;\n      if (!Array.isArray(parsed)) {\n        return { ok: false as const, error: 'Rows must be a JSON array' };\n      }\n      return { ok: true as const, value: parsed as DataTableRow[] };\n    } catch (err) {\n      return {\n        ok: false as const,\n        error: err instanceof Error ? err.message : 'Invalid JSON',\n      };\n    }\n  }, [rowsText]);\n\n  const pageSizeParse = useMemo(() => {\n    const trimmed = pageSize.trim();\n    if (!trimmed) return { ok: false as const, error: 'Page size required' };\n    const n = Number(trimmed);\n    if (!Number.isInteger(n) || n <= 0) {\n      return { ok: false as const, error: 'Page size must be a positive integer' };\n    }\n    return { ok: true as const, value: n };\n  }, [pageSize]);\n\n  const current: DataTableData | null = useMemo(() => {\n    if (!rowsParse.ok || !pageSizeParse.ok) return null;\n    const out: DataTableData = {\n      columns: columns.map((c) => ({\n        key: c.key,\n        label: c.label,\n        type: c.type,\n        sortable: c.sortable,\n        filterable: c.filterable,\n      })),\n      rows: rowsParse.value,\n      pageSize: pageSizeParse.value,\n    };\n    if (initialSortKey.trim()) {\n      out.initialSort = { key: initialSortKey.trim(), dir: initialSortDir };\n    }\n    return out;\n  }, [columns, rowsParse, pageSizeParse, initialSortKey, initialSortDir]);\n\n  const dirty = useMemo(() => {\n    if (!current) return true;\n    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n  }, [current, initial, sources, initialSources]);\n\n  const handleSave = useCallback(async () => {\n    if (saving) return;\n    if (!rowsParse.ok) {\n      setErrors({ rows: rowsParse.error });\n      return;\n    }\n    if (!pageSizeParse.ok) {\n      setErrors({ pageSize: pageSizeParse.error });\n      return;\n    }\n    if (!current) return;\n    const result = DataTableDataSchema.safeParse(current);\n    if (!result.success) {\n      setErrors(flattenIssues(result.error));\n      return;\n    }\n    setErrors({});\n    setSaveError(null);\n    setSaving(true);\n    try {\n      await onSave(result.data, sources);\n      setSaving(false);\n    } catch (err) {\n      setSaveError(err instanceof Error ? err.message : String(err));\n      setSaving(false);\n    }\n  }, [current, onSave, pageSizeParse, rowsParse, saving, sources]);\n\n  const addColumn = useCallback(() => {\n    setColumns((prev) => [\n      ...prev,\n      {\n        rowId: makeRowId(),\n        key: '',\n        label: '',\n        type: 'string',\n        sortable: true,\n        filterable: false,\n      },\n    ]);\n  }, []);\n\n  const updateColumn = useCallback((rowId: string, patch: Partial<ColumnRow>) => {\n    setColumns((prev) =>\n      prev.map((c) => (c.rowId === rowId ? { ...c, ...patch } : c)),\n    );\n  }, []);\n\n  const removeColumn = useCallback((rowId: string) => {\n    setColumns((prev) => prev.filter((c) => c.rowId !== rowId));\n  }, []);\n\n  return (\n    <div\n      data-testid=\"data-table-editor\"\n      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n    >\n      <div style={formBodyStyle}>\n        <div style={fieldStyle}>\n          <span style={labelStyle}>Columns</span>\n          <div data-testid=\"datatable-edit-columns\">\n            {columns.map((col, i) => (\n              <div key={col.rowId} style={cardStyle} data-test-col-index={i}>\n                <div style={cardHeaderStyle}>\n                  <input\n                    type=\"text\"\n                    data-testid={`datatable-edit-col-key-${i}`}\n                    value={col.key}\n                    placeholder=\"key\"\n                    onChange={(e) => updateColumn(col.rowId, { key: e.target.value })}\n                    style={{\n                      ...inputStyle,\n                      flex: 1,\n                      minWidth: 0,\n                      fontFamily: 'var(--font-mono)',\n                      fontSize: '12.5px',\n                    }}\n                  />\n                  <button\n                    type=\"button\"\n                    data-testid={`datatable-edit-col-remove-${i}`}\n                    onClick={() => removeColumn(col.rowId)}\n                    aria-label={`Remove column ${i + 1}`}\n                    style={removeButtonStyle}\n                  >\n                    <Trash2 size={13} aria-hidden />\n                  </button>\n                </div>\n                <label>\n                  <span style={subLabelStyle}>Label</span>\n                  <input\n                    type=\"text\"\n                    data-testid={`datatable-edit-col-label-${i}`}\n                    value={col.label}\n                    onChange={(e) => updateColumn(col.rowId, { label: e.target.value })}\n                    style={inputStyle}\n                  />\n                </label>\n                <div style={inlineRowStyle}>\n                  <label>\n                    <span style={subLabelStyle}>Type</span>\n                    <select\n                      data-testid={`datatable-edit-col-type-${i}`}\n                      value={col.type}\n                      onChange={(e) =>\n                        updateColumn(col.rowId, {\n                          type: e.target.value as DataTableColumnType,\n                        })\n                      }\n                      style={selectStyle}\n                    >\n                      <option value=\"string\">string</option>\n                      <option value=\"number\">number</option>\n                      <option value=\"boolean\">boolean</option>\n                    </select>\n                  </label>\n                  <label style={checkLabelStyle}>\n                    <input\n                      type=\"checkbox\"\n                      data-testid={`datatable-edit-col-sortable-${i}`}\n                      checked={col.sortable !== false}\n                      onChange={(e) =>\n                        updateColumn(col.rowId, { sortable: e.target.checked })\n                      }\n                    />\n                    Sortable\n                  </label>\n                  <label style={checkLabelStyle}>\n                    <input\n                      type=\"checkbox\"\n                      data-testid={`datatable-edit-col-filterable-${i}`}\n                      checked={col.filterable === true}\n                      onChange={(e) =>\n                        updateColumn(col.rowId, { filterable: e.target.checked })\n                      }\n                    />\n                    Filterable\n                  </label>\n                </div>\n              </div>\n            ))}\n          </div>\n          <button\n            type=\"button\"\n            data-testid=\"datatable-edit-add-column\"\n            onClick={addColumn}\n            style={addButtonStyle}\n          >\n            <Plus size={12} aria-hidden /> Add column\n          </button>\n        </div>\n\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Rows (JSON array)</span>\n          <textarea\n            data-testid=\"datatable-edit-rows\"\n            value={rowsText}\n            onChange={(e) => setRowsText(e.target.value)}\n            style={{\n              ...textareaStyle,\n              minHeight: 160,\n              fontFamily: 'var(--font-mono)',\n              fontSize: '12.5px',\n            }}\n            spellCheck={false}\n          />\n          {!rowsParse.ok && (\n            <div style={errorTextStyle} data-testid=\"datatable-edit-rows-error\">\n              {rowsParse.error}\n            </div>\n          )}\n          {errors.rows && rowsParse.ok && (\n            <div style={errorTextStyle}>{errors.rows}</div>\n          )}\n        </label>\n\n        <div style={inlineRowStyle}>\n          <label style={fieldStyle}>\n            <span style={labelStyle}>Page size</span>\n            <input\n              type=\"number\"\n              min={1}\n              data-testid=\"datatable-edit-page-size\"\n              value={pageSize}\n              onChange={(e) => setPageSize(e.target.value)}\n              style={{ ...inputStyle, width: 96 }}\n            />\n            {!pageSizeParse.ok && (\n              <div style={errorTextStyle}>{pageSizeParse.error}</div>\n            )}\n          </label>\n\n          <label style={fieldStyle}>\n            <span style={labelStyle}>Initial sort key (optional)</span>\n            <input\n              type=\"text\"\n              data-testid=\"datatable-edit-sort-key\"\n              value={initialSortKey}\n              onChange={(e) => setInitialSortKey(e.target.value)}\n              style={{ ...inputStyle, width: 160 }}\n              placeholder=\"(none)\"\n            />\n          </label>\n\n          <label style={fieldStyle}>\n            <span style={labelStyle}>Initial sort direction</span>\n            <select\n              data-testid=\"datatable-edit-sort-dir\"\n              value={initialSortDir}\n              onChange={(e) =>\n                setInitialSortDir(e.target.value as 'asc' | 'desc')\n              }\n              style={selectStyle}\n            >\n              <option value=\"asc\">asc</option>\n              <option value=\"desc\">desc</option>\n            </select>\n          </label>\n        </div>\n\n        <SourcesField sources={sources} onChange={setSources} />\n\n        {errors._root && <div style={errorTextStyle}>{errors._root}</div>}\n      </div>\n\n      <EditorFormSaveError message={saveError} />\n      <EditorFormFooter\n        saving={saving}\n        saveDisabled={!dirty}\n        onCancel={onCancel}\n        onSave={() => void handleSave()}\n        cancelTestId=\"datatable-edit-cancel\"\n        saveTestId=\"datatable-edit-save\"\n      />\n    </div>\n  );\n}\n","numLines":451,"startLine":1,"totalLines":451}}}
