on({ error: err.message }, { status: 400 });\n55\t    }\n56\t    throw err;\n57\t  }\n58\t\n59\t  const filePath = path.join(assetsDir, relPath);\n60\t  const resolved = path.resolve(filePath);\n61\t  const resolvedAssetsDir = path.resolve(assetsDir);\n62\t  if (!resolved.startsWith(resolvedAssetsDir + path.sep) && resolved !== resolvedAssetsDir) {\n63\t    return NextResponse.json({ error: 'Invalid asset path' }, { status: 400 });\n64\t  }\n65\t\n66\t  let buf: Buffer;\n67\t  try {\n68\t    buf = await fs.readFile(filePath);\n69\t  } catch (err) {\n70\t    if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n71\t      return NextResponse.json({ error: 'Asset not found' }, { status: 404 });\n72\t    }\n73\t    throw err;\n74\t  }\n75\t\n76\t  return new Response(new Uint8Array(buf), {\n77\t    status: 200,\n78\t    headers: {\n79\t      'Content-Type': contentTypeFor(relPath),\n80\t      'Content-Length': String(buf.length),\n81\t      'Cache-Control': 'no-cache',\n82\t    },\n83\t  });\n84\t}\n85\t\n86\texport async function PUT(req: Request, { params }: RouteCtx) {\n87\t  const { slug, path: relParts } = await params;\n88\t\n89\t  let assetsDir: string;\n90\t  let relPath: string;\n91\t  try {\n92\t    assertSafeSlug(slug);\n93\t    relPath = assertSafeAssetPath(relParts);\n94\t    assetsDir = path.join(courseDir(slug), 'assets');\n95\t  } catch (err) {\n96\t    if (err instanceof InvalidSlugError) {\n97\t      return NextResponse.json({ error: err.message }, { status: 400 });\n98\t    }\n99\t    throw err;\n100\t  }\n101\t\n102\t  const ext = path.extname(relPath).toLowerCase();\n103\t  if (!CONTENT_TYPES[ext]) {\n104\t    return NextResponse.json(\n105\t      { error: `Unsupported asset extension: ${ext || '(none)'}` },\n106\t      { status: 400 },\n107\t    );\n108\t  }\n109\t\n110\t  const filePath = path.join(assetsDir, relPath);\n111\t  const resolved = path.resolve(filePath);\n112\t  const resolvedAssetsDir = path.resolve(assetsDir);\n113\t  if (!resolved.startsWith(resolvedAssetsDir + path.sep) && resolved !== resolvedAssetsDir) {\n114\t    return NextResponse.json({ error: 'Invalid asset path' }, { status: 400 });\n115\t  }\n116\t\n117\t  const arrayBuf = await req.arrayBuffer();\n118\t  if (arrayBuf.byteLength === 0) {\n119\t    return NextResponse.json({ error: 'Empty body' }, { status: 400 });\n120\t  }\n121\t\n122\t  await fs.mkdir(path.dirname(filePath), { recursive: true });\n123\t  await fs.writeFile(filePath, Buffer.from(arrayBuf));\n124\t\n125\t  return NextResponse.json({\n126\t    src: `/api/courses/${encodeURIComponent(slug)}/assets/${relParts.map((p) => encodeURIComponent(p)).join('/')}`,\n127\t    bytes: arrayBuf.byteLength,\n128\t  });\n129\t}\n130\t"}]},"parent_tool_use_id":null,"session_id":"fb5c9adb-fc42-4b13-8a3c-82c2b6f512d6","uuid":"b4bd24dd-f616-48c6-b317-a40dfb33f7ae","timestamp":"2026-05-03T22:31:14.400Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-049/src/app/api/courses/[slug]/assets/[...path]/route.ts","content":"import { NextResponse } from 'next/server';\nimport { promises as fs } from 'node:fs';\nimport path from 'node:path';\n\nimport { InvalidSlugError, assertSafeSlug, courseDir } from '@/lib/server/paths';\n\nexport const dynamic = 'force-dynamic';\n\ntype RouteCtx = { params: Promise<{ slug: string; path: string[] }> };\n\nconst CONTENT_TYPES: Record<string, string> = {\n  '.png': 'image/png',\n  '.jpg': 'image/jpeg',\n  '.jpeg': 'image/jpeg',\n  '.svg': 'image/svg+xml',\n  '.webp': 'image/webp',\n  '.gif': 'image/gif',\n};\n\nfunction assertSafeAssetPath(parts: string[]): string {\n  if (!Array.isArray(parts) || parts.length === 0) {\n    throw new InvalidSlugError(String(parts));\n  }\n  for (const part of parts) {\n    if (typeof part !== 'string' || part.length === 0) {\n      throw new InvalidSlugError(String(part));\n    }\n    if (part.includes('/') || part.includes('\\\\') || part === '..' || part === '.') {\n      throw new InvalidSlugError(part);\n    }\n    if (part.includes('\\0')) {\n      throw new InvalidSlugError(part);\n    }\n  }\n  return parts.join('/');\n}\n\nfunction contentTypeFor(filename: string): string {\n  const ext = path.extname(filename).toLowerCase();\n  return CONTENT_TYPES[ext] ?? 'application/octet-stream';\n}\n\nexport async function GET(_req: Request, { params }: RouteCtx) {\n  const { slug, path: relParts } = await params;\n\n  let assetsDir: string;\n  let relPath: string;\n  try {\n    assertSafeSlug(slug);\n    relPath = assertSafeAssetPath(relParts);\n    assetsDir = path.join(courseDir(slug), 'assets');\n  } catch (err) {\n    if (err instanceof InvalidSlugError) {\n      return NextResponse.json({ error: err.message }, { status: 400 });\n    }\n    throw err;\n  }\n\n  const filePath = path.join(assetsDir, relPath);\n  const resolved = path.resolve(filePath);\n  const resolvedAssetsDir = path.resolve(assetsDir);\n  if (!resolved.startsWith(resolvedAssetsDir + path.sep) && resolved !== resolvedAssetsDir) {\n    return NextResponse.json({ error: 'Invalid asset path' }, { status: 400 });\n  }\n\n  let buf: Buffer;\n  try {\n    buf = await fs.readFile(filePath);\n  } catch (err) {\n    if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n      return NextResponse.json({ error: 'Asset not found' }, { status: 404 });\n    }\n    throw err;\n  }\n\n  return new Response(new Uint8Array(buf), {\n    status: 200,\n    headers: {\n      'Content-Type': contentTypeFor(relPath),\n      'Content-Length': String(buf.length),\n      'Cache-Control': 'no-cache',\n    },\n  });\n}\n\nexport async function PUT(req: Request, { params }: RouteCtx) {\n  const { slug, path: relParts } = await params;\n\n  let assetsDir: string;\n  let relPath: string;\n  try {\n    assertSafeSlug(slug);\n    relPath = assertSafeAssetPath(relParts);\n    assetsDir = path.join(courseDir(slug), 'assets');\n  } catch (err) {\n    if (err instanceof InvalidSlugError) {\n      return NextResponse.json({ error: err.message }, { status: 400 });\n    }\n    throw err;\n  }\n\n  const ext = path.extname(relPath).toLowerCase();\n  if (!CONTENT_TYPES[ext]) {\n    return NextResponse.json(\n      { error: `Unsupported asset extension: ${ext || '(none)'}` },\n      { status: 400 },\n    );\n  }\n\n  const filePath = path.join(assetsDir, relPath);\n  const resolved = path.resolve(filePath);\n  const resolvedAssetsDir = path.resolve(assetsDir);\n  if (!resolved.startsWith(resolvedAssetsDir + path.sep) && resolved !== resolvedAssetsDir) {\n    return NextResponse.json({ error: 'Invalid asset path' }, { status: 400 });\n  }\n\n  const arrayBuf = await req.arrayBuffer();\n  if (arrayBuf.byteLength === 0) {\n    return NextResponse.json({ error: 'Empty body' }, { status: 400 });\n  }\n\n  await fs.mkdir(path.dirname(filePath), { recursive: true });\n  await fs.writeFile(filePath, Buffer.from(arrayBuf));\n\n  return NextResponse.json({\n    src: `/api/courses/${encodeURIComponent(slug)}/assets/${relParts.map((p) => encodeURIComponent(p)).join('/')}`,\n    bytes: arrayBuf.byteLength,\n  });\n}\n","numLines":130,"startLine":1,"totalLines":130}}}
