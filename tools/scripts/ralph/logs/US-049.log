 () => {\n51\t    const broken: Partial<typeof minimal> = { ...minimal };\n52\t    delete broken.slug;\n53\t    expect(() => CourseSchema.parse(broken)).toThrow();\n54\t  });\n55\t\n56\t  it('defaults schemaVersion to 1 when missing', () => {\n57\t    const parsed = CourseSchema.parse(minimal);\n58\t    expect(parsed.schemaVersion).toBe(1);\n59\t  });\n60\t\n61\t  it('parses successfully when schemaVersion: 1 is present', () => {\n62\t    const parsed = CourseSchema.parse({ ...minimal, schemaVersion: 1 });\n63\t    expect(parsed.schemaVersion).toBe(1);\n64\t  });\n65\t});\n66\t\n67\tdescribe('LessonSchema + SectionSchema', () => {\n68\t  const lesson = {\n69\t    slug: 'lesson-1',\n70\t    courseSlug: 'algebra',\n71\t    moduleId: 'm1',\n72\t    title: 'First lesson',\n73\t    eyebrow: 'INTRO',\n74\t    description: 'A first lesson',\n75\t    estimatedMinutes: 10,\n76\t    sections: [\n77\t      { id: 's1', title: 'Read', type: 'theory', data: { markdown: '# hi' } },\n78\t    ],\n79\t  };\n80\t\n81\t  it('parses a minimal valid lesson', () => {\n82\t    expect(() => LessonSchema.parse(lesson)).not.toThrow();\n83\t  });\n84\t\n85\t  it('throws on missing required field (title)', () => {\n86\t    const broken: Partial<typeof lesson> = { ...lesson };\n87\t    delete broken.title;\n88\t    expect(() => LessonSchema.parse(broken)).toThrow();\n89\t  });\n90\t\n91\t  it('defaults schemaVersion to 1 when missing', () => {\n92\t    const parsed = LessonSchema.parse(lesson);\n93\t    expect(parsed.schemaVersion).toBe(1);\n94\t  });\n95\t\n96\t  it('parses successfully when schemaVersion: 1 is present', () => {\n97\t    const parsed = LessonSchema.parse({ ...lesson, schemaVersion: 1 });\n98\t    expect(parsed.schemaVersion).toBe(1);\n99\t  });\n100\t\n101\t  it('discriminated union accepts each known widget type', () => {\n102\t    const cases = [\n103\t      { id: 's1', title: 't', type: 'theory', data: { markdown: 'x' } },\n104\t      {\n105\t        id: 's2',\n106\t        