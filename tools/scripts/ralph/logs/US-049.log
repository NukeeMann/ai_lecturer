 const range =\n292\t                      (filters[col.key] as NumberRangeFilter | undefined) ?? {};\n293\t                    return (\n294\t                      <td key={col.key} style={filterCellStyle}>\n295\t                        <div style={numberFilterRowStyle}>\n296\t                          <input\n297\t                            type=\"number\"\n298\t                            placeholder=\"min\"\n299\t                            value={range.min ?? ''}\n300\t                            onChange={(e) =>\n301\t                              updateRangeFilter(col.key, 'min', e.target.value)\n302\t                            }\n303\t                            style={filterInputStyle}\n304\t                            data-testid={`datatable-filter-${col.key}-min`}\n305\t                            aria-label={`Filter ${col.label} minimum`}\n306\t                          />\n307\t                          <input\n308\t                            type=\"number\"\n309\t                            placeholder=\"max\"\n310\t                            value={range.max ?? ''}\n311\t                            onChange={(e) =>\n312\t                              updateRangeFilter(col.key, 'max', e.target.value)\n313\t                            }\n314\t                            style={filterInputStyle}\n315\t                            data-testid={`datatable-filter-${col.key}-max`}\n316\t                            aria-label={`Filter ${col.label} maximum`}\n317\t                          />\n318\t                        </div>\n319\t                      </td>\n320\t                    );\n321\t                  }\n322\t                  return (\n323\t                    <td key={col.key} style={filterCellStyle}>\n324\t                      <input\n325\t                        type=\"text\"\n326\t                        placeholder=\"Filter…\"\n327\t                        value={(filters[col.key] as string | undefined) ?? ''}\n328\t                     