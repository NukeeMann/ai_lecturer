{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dx3QknVUV6g7RcgAjG7Jpw","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport type { CSSProperties } from 'react';\n4\t\n5\timport { Callout } from './Callout';\n6\t\n7\tconst buttonBase: CSSProperties = {\n8\t  display: 'inline-flex',\n9\t  alignItems: 'center',\n10\t  gap: 6,\n11\t  height: 32,\n12\t  padding: '0 var(--space-4)',\n13\t  borderRadius: 'var(--radius-md)',\n14\t  fontSize: 'var(--fs-sm)',\n15\t  fontWeight: 500,\n16\t  cursor: 'pointer',\n17\t  transition: 'background-color 120ms, border-color 120ms, color 120ms',\n18\t};\n19\t\n20\tconst ghostButtonStyle: CSSProperties = {\n21\t  ...buttonBase,\n22\t  background: 'transparent',\n23\t  color: 'var(--text-secondary)',\n24\t  border: '1px solid transparent',\n25\t};\n26\t\n27\tfunction primaryButtonStyle(disabled: boolean): CSSProperties {\n28\t  return {\n29\t    ...buttonBase,\n30\t    background: disabled ? 'var(--bg-active)' : 'var(--accent)',\n31\t    color: disabled ? 'var(--text-tertiary)' : 'var(--text-on-accent)',\n32\t    border: '1px solid transparent',\n33\t    cursor: disabled ? 'not-allowed' : 'pointer',\n34\t    opacity: disabled ? 0.7 : 1,\n35\t  };\n36\t}\n37\t\n38\texport interface EditorFormFooterProps {\n39\t  saving: boolean;\n40\t  saveDisabled: boolean;\n41\t  onCancel: () => void;\n42\t  onSave: () => void;\n43\t  saveLabel?: string;\n44\t  cancelTestId?: string;\n45\t  saveTestId?: string;\n46\t}\n47\t\n48\texport function EditorFormFooter({\n49\t  saving,\n50\t  saveDisabled,\n51\t  onCancel,\n52\t  onSave,\n53\t  saveLabel = 'Save',\n54\t  cancelTestId = 'editor-cancel',\n55\t  saveTestId = 'editor-save',\n56\t}: EditorFormFooterProps) {\n57\t  return (\n58\t    <div\n59\t      data-editor-form-footer\n60\t      style={{\n61\t        display: 'flex',\n62\t        justifyContent: 'flex-end',\n63\t        alignItems: 'center',\n64\t        gap: 'var(--space-3)',\n65\t        padding: 'var(--sp