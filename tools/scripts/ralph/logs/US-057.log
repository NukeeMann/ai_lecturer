{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_01SdZwEMyuVLCdLcQsbAzKS4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01A37TkJkLAXhFvseL9aZCVM","name":"Write","input":{"file_path":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-057/src/widgets/Quiz/optionState.ts","content":"export type OptionState =\n  | 'idle'\n  | 'selected'\n  | 'correct'\n  | 'incorrect'\n  | 'dimmed';\n\nexport interface OptionStateInput {\n  submitted: boolean;\n  isSelected: boolean;\n  isCorrect: boolean;\n  multiSelect: boolean;\n}\n\nexport function getOptionState(input: OptionStateInput): OptionState {\n  const { submitted, isSelected, isCorrect, multiSelect } = input;\n  if (!submitted) return isSelected ? 'selected' : 'idle';\n  if (multiSelect) {\n    if (!isSelected) return 'dimmed';\n    return isCorrect ? 'correct' : 'incorrect';\n  }\n  if (isCorrect) return 'correct';\n  if (isSelected) return 'incorrect';\n  return 'dimmed';\n}\n\nexport function shouldShowCheck(input: OptionStateInput): boolean {\n  const { submitted, isSelected, isCorrect, multiSelect } = input;\n  if (!submitted || !isCorrect) return false;\n  if (multiSelect) return isSelected;\n  return true;\n}\n\nexport function shouldShowX(input: OptionStateInput): boolean {\n  const { submitted, isSelected, isCorrect } = input;\n  return submitted && isSelected && !isCorrect;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3094,"cache_read_input_tokens":70107,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3094},"output_tokens":41,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a67c3911-b062-408c-adef-83e9de9f7090","uuid":"bfb31222-e31d-466b-9a2f-ea53b7841cca"}
