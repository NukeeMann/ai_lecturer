{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VMgSDDo9XvPVHERSBvU1uK","type":"tool_result","content":"1\timport { EventEmitter } from 'node:events';\n2\timport { describe, expect, it, vi, afterEach } from 'vitest';\n3\timport {\n4\t  _resetConnectorCacheForTesting,\n5\t  agentSdkConnector,\n6\t  assemblePrompt,\n7\t  selectConnector,\n8\t  subprocessConnector,\n9\t  type Connector,\n10\t  type SpawnFn,\n11\t} from './connector';\n12\t\n13\t// ---------------------------------------------------------------------------\n14\t// Fake child_process.spawn — emits stdout chunks, then a `close` event.\n15\t// ---------------------------------------------------------------------------\n16\t\n17\tinterface FakeProcess extends EventEmitter {\n18\t  stdout: EventEmitter;\n19\t  stderr: EventEmitter;\n20\t  kill: ReturnType<typeof vi.fn>;\n21\t}\n22\t\n23\tinterface FakeProcessConfig {\n24\t  stdout?: string;\n25\t  stderr?: string;\n26\t  exitCode?: number | null;\n27\t  // If set, the process never closes on its own — caller must clean up via kill.\n28\t  hangs?: boolean;\n29\t}\n30\t\n31\tfunction makeFakeProcess(cfg: FakeProcessConfig): FakeProcess {\n32\t  const child = new EventEmitter() as FakeProcess;\n33\t  child.stdout = new EventEmitter();\n34\t  child.stderr = new EventEmitter();\n35\t  child.kill = vi.fn(() => {\n36\t    // Simulate that SIGTERM closes the process with a non-zero exit.\n37\t    if (cfg.hangs) {\n38\t      setImmediate(() => child.emit('close', 143));\n39\t    }\n40\t    return true;\n41\t  });\n42\t\n43\t  setImmediate(() => {\n44\t    if (cfg.stdout) child.stdout.emit('data', Buffer.from(cfg.stdout));\n45\t    if (cfg.stderr) child.stderr.emit('data', Buffer.from(cfg.stderr));\n46\t    if (!cfg.hangs) {\n47\t      child.emit('close', cfg.exitCode ?? 0);\n48\t    }\n49\t  });\n50\t\n51\t  return child;\n52\t}\n53\t\n54\tfunction spawnReturning(cfg: FakeProcessConfig): SpawnFn {\n55\t  return (() => makeFakeProcess(cfg)) as unknown as SpawnFn;\n56\t}\n57\t\n58\tafterEach(() => {\n59\t  _resetConnectorCacheForTesting();\n60\t  vi.restoreAllMocks();\n61\t});\n62\t\n63\tdescribe('assemblePrompt', () => {\n64\t  it('prefixes the user message with the tutor system instruction', () => {\n65\t    const out = assemblePrompt('What is gradient descent?');\n66\t    expect(out).toContain('You are an AI tutor');\n67\t    expect(out).toContain('Answer concisely');\n68\t    expect(out).toContain('What is gradient descent?');\n69\t    expect(out.endsWith('What is gradient descent?')).toBe(true);\n70\t  });\n71\t});\n72\t\n73\tdescribe('subprocessConnector', () => {\n74\t  it('parses the result field from JSON stdout', async () => {\n75\t    const fakeJson = JSON.stringify({\n76\t      type: 'result',\n77\t      subtype: 'success',\n78\t      is_error: false,\n79\t      result: 'Hello from the tutor.',\n80\t    });\n81\t    const connector = subprocessConnector({\n82\t      spawnFn: spawnReturning({ stdout: fakeJson, exitCode: 0 }),\n83\t    });\n84\t    const text = await connector.chat({ userMessage: 'hi' });\n85\t    expect(text).toBe('Hello from the tutor.');\n86\t  });\n87\t\n88\t  it('passes -p <prompt> --output-format json to the CLI', async () => {\n89\t    const calls: Array<{ command: string; args: readonly string[] }> = [];\n90\t    const fakeJson = JSON.stringify({ result: 'ok' });\n91\t    const spawnSpy = ((command: string, args: readonly string[]) => {\n92\t      calls.push({ command, args });\n93\t      return makeFakeProcess({ stdout: fakeJson });\n94\t    }) as unknown as SpawnFn;\n95\t    const connector = subprocessConnector({ spawnFn: spawnSpy, command: 'claude' });\n96\t    await connector.chat({ userMessage: 'why?' });\n97\t    expect(calls).toHaveLength(1);\n98\t    expect(calls[0].command).toBe('claude');\n99\t    expect(calls[0].args[0]).toBe('-p');\n100\t    expect(calls[0].args[1]).toContain('why?');\n101\t    expect(calls[0].args.slice(2)).toEqual(['--output-format', 'json']);\n102\t  });\n103\t\n104\t  it('rejects when claude exits non-zero', async () => {\n105\t    const connector = subprocessConnector({\n106\t      spawnFn: spawnReturning({\n107\t        stdout: '',\n108\t        stderr: 'authentication failed',\n109\t        exitCode: 2,\n110\t      }),\n111\t    });\n112\t    await expect(connector.chat({ userMessage: 'hi' })).rejects.toThrow(\n113\t      /claude exited 2.*authentication failed/,\n114\t    );\n115\t  });\n116\t\n117\t  it('rejects when stdout is not valid JSON', async () => {\n118\t    const connector = subprocessConnector({\n119\t      spawnFn: spawnReturning({ stdout: 'not json', exitCode: 0 }),\n120\t    });\n121\t    await expect(connector.chat({ userMessage: 'hi' })).rejects.toThrow(\n122\t      /failed to parse claude JSON/,\n123\t    );\n124\t  });\n125\t\n126\t  it('rejects when JSON is missing the result field', async () => {\n127\t    const connector = subprocessConnector({\n128\t      spawnFn: spawnReturning({\n129\t        stdout: JSON.stringify({ result: null }),\n130\t        exitCode: 0,\n131\t      }),\n132\t    });\n133\t    await expect(connector.chat({ userMessage: 'hi' })).rejects.toThrow(\n134\t      /missing string 'result'/,\n135\t    );\n136\t  });\n137\t\n138\t  it('rejects when JSON reports is_error=true', async () => {\n139\t    const connector = subprocessConnector({\n140\t      spawnFn: spawnReturning({\n141\t        stdout: JSON.stringify({ is_error: true, result: 'partial' }),\n142\t        exitCode: 0,\n143\t      }),\n144\t    });\n145\t    await expect(connector.chat({ userMessage: 'hi' })).rejects.toThrow(\n146\t      /is_error=true/,\n147\t    );\n148\t  });\n149\t\n150\t  it('kills the process and rejects with timeout when CLI hangs', async () => {\n151\t    let killed: NodeJS.Signals | undefined;\n152\t    const child = new EventEmitter() as FakeProcess;\n153\t    child.stdout = new EventEmitter();\n154\t    child.stderr = new EventEmitter();\n155\t    child.kill = vi.fn((sig?: NodeJS.Signals) => {\n156\t      killed = sig;\n157\t      // After SIGTERM, simulate the process actually exits (143 = SIGTERM).\n158\t      setImmediate(() => child.emit('close', 143));\n159\t      return true;\n160\t    });\n161\t    const spawnFn = (() => child) as unknown as SpawnFn;\n162\t\n163\t    const connector = subprocessConnector({\n164\t      spawnFn,\n165\t      timeoutMs: 20,\n166\t      killGraceMs: 50,\n167\t    });\n168\t    await expect(connector.chat({ userMessage: 'hi' })).rejects.toThrow(/timed out/);\n169\t    expect(killed).toBe('SIGTERM');\n170\t    expect(child.kill).toHaveBeenCalled();\n171\t  });\n172\t\n173\t  it('rejects when spawn throws synchronously', async () => {\n174\t    const spawnFn = (() => {\n175\t      throw new Error('ENOENT');\n176\t    }) as unknown as SpawnFn;\n177\t    const connector = subprocessConnector({ spawnFn });\n178\t    await expect(connector.chat({ userMessage: 'hi' })).rejects.toThrow(\n179\t      /spawn failed.*ENOENT/,\n180\t    );\n181\t  });\n182\t});\n183\t\n184\tdescribe('agentSdkConnector', () => {\n185\t  it('collects assistant text blocks from the SDK stream', async () => {\n186\t    async function* fakeStream() {\n187\t      yield {\n188\t        type: 'assistant',\n189\t        message: {\n190\t          content: [\n191\t            { type: 'text', text: 'Hello, ' },\n192\t            { type: 'text', text: 'world.' },\n193\t          ],\n194\t        },\n195\t      };\n196\t      yield { type: 'result', is_error: false, result: 'Hello, world.' };\n197\t    }\n198\t    const connector = await agentSdkConnector({\n199\t      sdk: { query: () => fakeStream() },\n200\t    });\n201\t    expect(connector.name).toBe('agent-sdk');\n202\t    const text = await connector.chat({ userMessage: 'hi' });\n203\t    expect(text).toBe('Hello, world.');\n204\t  });\n205\t\n206\t  it('falls back to the result field when no assistant blocks were yielded', async () => {\n207\t    async function* fakeStream() {\n208\t      yield { type: 'result', is_error: false, result: 'Just the result.' };\n209\t    }\n210\t    const connector = await agentSdkConnector({\n211\t      sdk: { query: () => fakeStream() },\n212\t    });\n213\t    expect(await connector.chat({ userMessage: 'hi' })).toBe('Just the result.');\n214\t  });\n215\t\n216\t  it('throws when the stream produces no text', async () => {\n217\t    async function* fakeStream() {\n218\t      yield { type: 'system' };\n219\t    }\n220\t    const connector = await agentSdkConnector({\n221\t      sdk: { query: () => fakeStream() },\n222\t    });\n223\t    await expect(connector.chat({ userMessage: 'hi' })).rejects.toThrow(\n224\t      /no assistant text/,\n225\t    );\n226\t  });\n227\t\n228\t  it('throws when the SDK reports is_error=true', async () => {\n229\t    async function* fakeStream() {\n230\t      yield { type: 'result', is_error: true };\n231\t    }\n232\t    const connector = await agentSdkConnector({\n233\t      sdk: { query: () => fakeStream() },\n234\t    });\n235\t    await expect(connector.chat({ userMessage: 'hi' })).rejects.toThrow(/is_error/);\n236\t  });\n237\t\n238\t  it('throws if loadSdk rejects (mimics package missing)', async () => {\n239\t    await expect(\n240\t      agentSdkConnector({\n241\t        loadSdk: async () => {\n242\t          throw new Error('Cannot find module');\n243\t        },\n244\t      }),\n245\t    ).rejects.toThrow(/Cannot find module/);\n246\t  });\n247\t});\n248\t\n249\tdescribe('selectConnector', () => {\n250\t  it('returns the SDK connector when the SDK loads', async () => {\n251\t    const fakeSdkConnector: Connector = {\n252\t      name: 'agent-sdk',\n253\t      chat: async () => 'ok',\n254\t    };\n255\t    const result = await selectConnector({\n256\t      forceReselect: true,\n257\t      agentSdk: async () => fakeSdkConnector,\n258\t      subprocess: () => {\n259\t        throw new Error('should not be called');\n260\t      },\n261\t      probeSubprocess: async () => {