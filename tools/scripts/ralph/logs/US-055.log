{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QWNggcaQJtzsCk992kgS7A","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport {\n4\t  useCallback,\n5\t  useEffect,\n6\t  useLayoutEffect,\n7\t  useMemo,\n8\t  useRef,\n9\t  useState,\n10\t  type CSSProperties,\n11\t  type KeyboardEvent as ReactKeyboardEvent,\n12\t} from 'react';\n13\timport { Square, X } from 'lucide-react';\n14\t\n15\tinterface ChatMessage {\n16\t  id: string;\n17\t  role: 'user' | 'assistant' | 'error';\n18\t  text: string;\n19\t  pending?: boolean;\n20\t}\n21\t\n22\tinterface LessonChatProps {\n23\t  open: boolean;\n24\t  courseSlug: string;\n25\t  lessonSlug: string;\n26\t  onClose: () => void;\n27\t}\n28\t\n29\tconst LINE_HEIGHT_PX = 20;\n30\tconst MIN_LINES = 1;\n31\tconst MAX_LINES = 6;\n32\tconst TEXTAREA_VERTICAL_PADDING = 16;\n33\tconst DRAFT_DEBOUNCE_MS = 200;\n34\t\n35\texport function draftStorageKey(courseSlug: string, lessonSlug: string): string {\n36\t  return `lessonChatDraft:${courseSlug}:${lessonSlug}`;\n37\t}\n38\t\n39\texport function LessonChat({\n40\t  open,\n41\t  courseSlug,\n42\t  lessonSlug,\n43\t  onClose,\n44\t}: LessonChatProps) {\n45\t  const [draft, setDraft] = useState('');\n46\t  const [messages, setMessages] = useState<ChatMessage[]>([]);\n47\t  const [sending, setSending] = useState(false);\n48\t  const [activeSectionId, setActiveSectionId] = useState<string | null>(null);\n49\t  const textareaRef = useRef<HTMLTextAreaElement | null>(null);\n50\t  const messagesRef = useRef<HTMLDivElement | null>(null);\n51\t  const debounceRef = useRef<number | null>(null);\n52\t  const draftKey = useMemo(\n53\t    () => draftStorageKey(courseSlug, lessonSlug),\n54\t    [courseSlug, lessonSlug],\n55\t  );\n56\t\n57\t  // Track the section currently nearest the top of the viewport via\n58\t  // IntersectionObserver — used to scope the AI tutor's prompt context\n59\t  // to the active section. Re-runs when the panel opens or the lesson\n60\t  // changes; queries `[data-section-id]` elements rendered by the lesson\n61\t  // page. Falls back gracefully (no observer) when nothing matches.\n62\t  useEffect(() => {\n63\t    if (!open) return;\n64\t    if (typeof IntersectionObserver === 'undefined') return;\n65\t\n66\t    // Map the section id → its DOM order index, so when several sections\n67\t    // straddle the \"active\" band at the top of the viewport, we pick the\n68\t    // last one (the one the learner has scrolled into).\n69\t    const orderById = new Map<string, number>();\n70\t    const visible = new Set<string>();\n71\t    const observed = new WeakSet<Element>();\n72\t\n73\t    const recompute = () => {\n74\t      let bestId: string | null = null;\n75\t      let bestOrder = -1;\n76\t      for (const id of visible) {\n77\t        const order = orderById.get(id) ?? -1;\n78\t        if (order > bestOrder) {\n79\t          bestOrder = order;\n80\t          bestId = id;\n81\t        }\n82\t      }\n83\t      if (bestId !== null) {\n84\t        setActiveSectionId(bestId);\n85\t      }\n86\t    };\n87\t\n88\t    const intersection = new IntersectionObserver(\n89\t      (entries) => {\n90\t        for (const entry of entries) {\n91\t          const id = (entry.target as HTMLElement).getAttribute(\n92\t            'data-section-id',\n93\t          );\n94\t          if (id === null) continue;\n95\t          if (entry.isIntersecting) {\n96\t            visible.add(id);\n97\t          } else {\n98\t            visible.delete(id);\n99\t          }\n100\t        }\n101\t        recompute();\n102\t      },\n103\t      // rootMargin biases intersection to a strip near the top of the\n104\t      // viewport so the active section is whatever is currently being\n105\t      // read, not whatever is biggest.\n106\t      { rootMargin: '0px 0px -75% 0px', threshold: 0 },\n107\t    );\n108\t\n109\t    const observeAllSections = () => {\n110\t      const targets = Array.from(\n111\t        document.querySelectorAll<HTMLElement>('[data-section-id]'),\n112\t      );\n113\t      for (const el of targets) {\n114\t        const id = el.getAttribute('data-section-id');\n115\t        if (id !== null && !orderById.has(id)) {\n116\t          orderById.set(id, orderById.size);\n117\t        }\n118\t        if (!observed.has(el)) {\n119\t          intersection.observe(el);\n120\t          observed.add(el);\n121\t        }\n122\t      }\n123\t      // Seed activeSectionId from the current scroll position so the very\n124\t      // first message has a sensible sectionId before IO fires.\n125\t      const main =\n126\t        document.querySelector<HTMLElement>('[data-testid=\"lesson-content\"]') ??\n127\t        null;\n128\t      if (main && targets.length > 0) {\n129\t        const mainTop = main.scrollTop;\n130\t        let seedId: string | null = null;\n131\t        for (const el of targets) {\n132\t          const id = el.getAttribute('data-section-id');\n133\t          if (id === null) continue;\n134\t          const offset =\n135\t            el.getBoundingClientRect().top -\n136\t            main.getBoundingClientRect().top +\n137\t            main.scrollTop;\n138\t          if (offset <= mainTop + 8) {\n139\t            seedId = id;\n140\t          }\n141\t        }\n142\t        if (seedId !== null) {\n143\t          setActiveSectionId(seedId);\n144\t        }\n145\t      }\n146\t    };\n147\t\n148\t    observeAllSections();\n149\t\n150\t    // Sections may not yet be in the DOM when the panel opens (e.g. the\n151\t    // lesson is still loading via fetch). Watch for added section elements\n152\t    // and observe them too.\n153\t    const mutation = new MutationObserver(() => {\n154\t      observeAllSections();\n155\t    });\n156\t    mutation.observe(document.body, { childList: true, subtree: true });\n157\t\n158\t    return () => {\n159\t      intersection.disconnect();\n160\t      mutation.disconnect();\n161\t    };\n162\t  }, [open, lessonSlug, courseSlug]);\n163\t\n164\t  // Restore draft on mount or when slug changes. New mount per panel toggle is\n165\t  // fine — `open=false` returns null below so the effect only fires when the\n166\t  // panel actually appears.\n167\t  useEffect(() => {\n168\t    try {\n169\t      const stored = window.localStorage.getItem(draftKey);\n170\t      // eslint-disable-next-line react-hooks/set-state-in-effect\n171\t      setDraft(stored ?? '');\n172\t    } catch {\n173\t      // localStorage unavailable — start with empty draft.\n174\t    }\n175\t  }, [draftKey]);\n176\t\n177\t  // Debounced write of the draft to localStorage.\n178\t  useEffect(() => {\n179\t    if (debounceRef.current !== null) {\n180\t      window.clearTimeout(debounceRef.current);\n181\t    }\n182\t    debounceRef.current = window.setTimeout(() => {\n183\t      try {\n184\t        if (draft.length === 0) {\n185\t          window.localStorage.removeItem(draftKey);\n186\t        } else {\n187\t          window.localStorage.setItem(draftKey, draft);\n188\t        }\n189\t      } catch {\n190\t        // Persistence unavailable; in-memory draft still works.\n191\t      }\n192\t    }, DRAFT_DEBOUNCE_MS);\n193\t    return () => {\n194\t      if (debounceRef.current !== null) {\n195\t        window.clearTimeout(debounceRef.current);\n196\t        debounceRef.current = null;\n197\t      }\n198\t    };\n199\t  }, [draft, draftKey]);\n200\t\n201\t  // Autoresize the textarea: measure scrollHeight, clamp to MAX_LINES.\n202\t  useLayoutEffect(() => {\n203\t    const el = textareaRef.current;\n204\t    if (!el) return;\n205\t    el.style.height = 'auto';\n206\t    const maxHeight = LINE_HEIGHT_PX * MAX_LINES + TEXTAREA_VERTICAL_PADDING;\n207\t    const minHeight = LINE_HEIGHT_PX * MIN_LINES + TEXTAREA_VERTICAL_PADDING;\n208\t    const next = Math.max(\n209\t      minHeight,\n210\t      Math.min(maxHeight, el.scrollHeight),\n211\t    );\n212\t    el.style.height = `${next}px`;\n213\t    el.style.overflowY = el.scrollHeight > maxHeight ? 'auto' : 'hidden';\n214\t  }, [draft]);\n215\t\n216\t  // Auto-scroll to bottom when new messages land.\n217\t  useEffect(() => {\n218\t    const el = messagesRef.current;\n219\t    if (!el) return;\n220\t    el.scrollTop = el.scrollHeight;\n221\t  }, [messages.length]);\n222\t\n223\t  const trimmedDraft = draft.trim();\n224\t  const canSend = trimmedDraft.length > 0 && !sending;\n225\t\n226\t  const handleSend = useCallback(() => {\n227\t    const text = draft.trim();\n228\t    if (text.length === 0 || sending) return;\n229\t    const stamp = Date.now();\n230\t    const userId = `m-${stamp}-u`;\n231\t    const pendingId = `m-${stamp}-p`;\n232\t    setMessages((prev) => [\n233\t      ...prev,\n234\t      { id: userId, role: 'user', text },\n235\t      { id: pendingId, role: 'assistant', text: '', pending: true },\n236\t    ]);\n237\t    setDraft('');\n238\t    setSending(true);\n239\t    try {\n240\t      window.localStorage.removeItem(draftKey);\n241\t    } catch {\n242\t      // ignore — draft already cleared from in-memory state\n243\t    }\n244\t\n245\t    const history = messages\n246\t      .filter((m) => m.role === 'user' || m.role === 'assistant')\n247\t      .filter((m) => !m.pending)\n248\t      .map((m) => ({ role: m.role as 'user' | 'assistant', content: m.text }));\n249\t\n250\t    void (async () => {\n251\t      try {\n252\t        const res = await fetch('/api/lesson-chat', {\n253\t          method: 'POST',\n254\t          headers: { 'Content-Type': 'application/json' },\n255\t          body: JSON.stringify({\n256\t            courseSlug,\n257\t            lessonSlug,\n258\t            sectionId: activeSectionId ?? undefined,\n259\t            message: text,\n260\t            history,\n261\t          }),\n262\t        });\n263\t        const json = (await res\n264\t          .json()\n265\t          .catch(() => ({}))) as { assistant?: string; error?: string };\n266\t        if (!res.ok) {\n267\t          const errText =\n268\t            json.error ?? `AI Tutor error (status ${res.status})`;\n269\t          setMessages((prev) =>\n270\t            prev.map((m) =>\n271\t              m.id === pendingId\n272\t                ? { id: pendingId, role: 'error', text: errText }\n273\t                : m,\n274\t            ),\n275\t          );\n276\t        } else {\n277\t          setMessages((prev) =>\n278\t            prev.map((m) =>\n279\t              m.id === pendingId\n280\t                ? {\n281\t                    id: pendingId,\n282\t                    role: 'assistant',\n283\t                    text: json.assistant ?? '',\n284\t                  }\n285\t                : m,\n286\t            ),\n287\t          );\n288\t        }\n289\t      } catch (err) {\n290\t        const errText = `AI Tutor error: ${(err as Error).message}`;\n291\t        setMessages((prev) =>\n292\t          prev.map((m) =>\n293\t            m.id === pendingId\n294\t              ? { id: pendingId, role: 'error', text: errText }\n295\t              : m,\n296\t          ),\n297\t        );\n298\t      } finally {\n299\t        setSending(false);\n300\t      }\n301\t    })();\n302\t  }, [activeSectionId, courseSlug, draft, draftKey, lessonSlug, messages, sending]);\n303\t\n304\t  const handleKeyDown = useCallback(\n305\t    (e: ReactKeyboardEvent<HTMLTextAreaElement>) => {\n306\t      const isMod = e.metaKey || e.ctrlKey;\n307\t      if (isMod && e.key === 'Enter') {\n308\t        e.preventDefault();\n309\t        handleSend();\n310\t      }\n311\t    },\n312\t    [handleSend],\n313\t  );\n314\t\n315\t  if (!open) {\n316\t    return (\n317\t      <aside\n318\t        data-testid=\"lesson-chat\"\n319\t        data-open=\"false\"\n320\t        aria-hidden\n321\t        style={asideHiddenStyle}\n322\t      />\n323\t    );\n324\t  }\n325\t\n326\t  return (\n327\t    <aside\n328\t      data-testid=\"lesson-chat\"\n329\t      data-open=\"true\"\n330\t      data-active-section-id={activeSectionId ?? ''}\n331\t      style={asideStyle}\n332\t    >\n333\t      <header style={headerStyle}>\n334\t        <h2 style={titleStyle}>AI Tutor</h2>\n335\t        <button\n336\t          type=\"button\"\n337\t          data-testid=\"lesson-chat-close\"\n338\t          aria-label=\"Close AI tutor panel\"\n339\t          onClick={onClose}\n340\t          style={closeBtnStyle}\n341\t        >\n342\t          <X size={16} strokeWidth={2} />\n343\t        </button>\n344\t      </header>\n345\t\n346\t      <div\n347\t        ref={messagesRef}\n348\t        data-testid=\"lesson-chat-messages\"\n349\t        style={messagesStyle}\n350\t      >\n351\t        {messages.length === 0 ? (\n352\t          <p data-testid=\"lesson-chat-empty\" style={emptyStyle}>\n353\t            Ask anything about this lesson — I have its content as context.\n354\t          </p>\n355\t        ) : (\n356\t          <ul style={messageListStyle}>\n357\t            {messages.map((m) => {\n358\t              const rowStyle =\n359\t                m.role === 'user' ? userBubbleRowStyle : assistantBubbleRowStyle;\n360\t              let bubbleStyle: CSSProperties = assistantBubbleStyle;\n361\t              if (m.role === 'user') bubbleStyle = userBubbleStyle;\n362\t              else if (m.role === 'error') bubbleStyle = errorBubbleStyle;\n363\t              return (\n364\t                <li\n365\t                  key={m.id}\n366\t                  data-role={m.role}\n367\t                  data-pending={m.pending ? 'true' : undefined}\n368\t                  style={rowStyle}\n369\t                >\n370\t                  <div style={bubbleStyle}>\n371\t                    {m.pending ? <TypingDots /> : m.text}\n372\t                  </div>\n373\t                </li>\n374\t              );\n375\t            })}\n376\t          </ul>\n377\t        )}\n378\t      </div>\n379\t\n380\t      <footer style={footerStyle}>\n381\t        <textarea\n382\t          ref={textareaRef}\n383\t          data-testid=\"lesson-chat-textarea\"\n384\t          aria-label=\"Message AI tutor\"\n385\t          placeholder=\"Ask about this lesson…\"\n386\t          value={draft}\n387\t          onChange={(e) => setDraft(e.target.value)}\n388\t          onKeyDown={handleKeyDown}\n389\t          rows={1}\n390\t          style={textareaStyle}\n391\t        />\n392\t        <div style={composerControlsStyle}>\n393\t          <span style={hintStyle}>⌘+Enter to send</span>\n394\t          <div style={btnGroupStyle}>\n395\t            <button\n396\t              type=\"button\"\n397\t              data-testid=\"lesson-chat-stop\"\n398\t              aria-label=\"Stop response\"\n399\t              disabled\n400\t              style={stopBtnStyle}\n401\t            >\n402\t              <Square size={12} strokeWidth={2} />\n403\t            </button>\n404\t            <button\n405\t              type=\"button\"\n406\t              data-testid=\"lesson-chat-send\"\n407\t              aria-label=\"Send message\"\n408\t              disabled={!canSend}\n409\t              onClick={handleSend}\n410\t              style={canSend ? sendBtnStyle : sendBtnDisabledStyle}\n411\t            >\n412\t              Send\n413\t            </button>\n414\t          </div>\n415\t        </div>\n416\t      </footer>\n417\t    </aside>\n418\t  );\n419\t}\n420\t\n421\tconst asideHiddenStyle: CSSProperties = {\n422\t  gridColumn: '3 / 4',\n423\t  gridRow: '2 / 3',\n424\t  display: 'none',\n425\t};\n426\t\n427\tconst asideStyle: CSSProperties = {\n428\t  gridColumn: '3 / 4',\n429\t  gridRow: '2 / 3',\n430\t  borderLeft: '1px solid var(--border)',\n431\t  background: 'var(--bg-elevated)',\n432\t  display: 'flex',\n433\t  flexDirection: 'column',\n434\t  minWidth: 0,\n435\t  overflow: 'hidden',\n436\t};\n437\t\n438\tconst headerStyle: CSSProperties = {\n439\t  display: 'flex',\n440\t  alignItems: 'center',\n441\t  justifyContent: 'space-between',\n442\t  gap: 'var(--space-3)',\n443\t  padding: 'var(--space-3) var(--space-4)',\n444\t  borderBottom: '1px solid var(--border)',\n445\t  flexShrink: 0,\n446\t  minHeight: 48,\n447\t};\n448\t\n449\tconst titleStyle: CSSProperties = {\n450\t  margin: 0,\n451\t  fontSize: 'var(--fs-md)',\n452\t  fontWeight: 600,\n453\t  color: 'var(--text)',\n454\t  lineHeight: 1.2,\n455\t};\n456\t\n457\tconst closeBtnStyle: CSSProperties = {\n458\t  width: 28,\n459\t  height: 28,\n460\t  display: 'inline-flex',\n461\t  alignItems: 'center',\n462\t  justifyContent: 'center',\n463\t  background: 'transparent',\n464\t  borderWidth: 1,\n465\t  borderStyle: 'solid',\n466\t  borderColor: 'transparent',\n467\t  borderRadius: 'var(--radius-sm)',\n468\t  color: 'var(--text-tertiary)',\n469\t  cursor: 'pointer',\n470\t};\n471\t\n472\tconst messagesStyle: CSSProperties = {\n473\t  flex: 1,\n474\t  minHeight: 0,\n475\t  overflowY: 'auto',\n476\t  padding: 'var(--space-4)',\n477\t  display: 'flex',\n478\t  flexDirection: 'column',\n479\t  gap: 'var(--space-3)',\n480\t};\n481\t\n482\tconst emptyStyle: CSSProperties = {\n483\t  margin: 'auto 0',\n484\t  textAlign: 'center',\n485\t  color: 'var(--text-tertiary)',\n486\t  fontSize: 'var(--fs-sm)',\n487\t  fontFamily: 'var(--font-prose)',\n488\t  lineHeight: 1.5,\n489\t  padding: '0 var(--space-3)',\n490\t};\n491\t\n492\tconst messageListStyle: CSSProperties = {\n493\t  listStyle: 'none',\n494\t  margin: 0,\n495\t  padding: 0,\n496\t  display: 'flex',\n497\t  flexDirection: 'column',\n498\t  gap: 'var(--space-3)',\n499\t};\n500\t\n501\tconst userBubbleRowStyle: CSSProperties = {\n502\t  display: 'flex',\n503\t  justifyContent: 'flex-end',\n504\t};\n505\t\n506\tconst assistantBubbleRowStyle: CSSProperties = {\n507\t  display: 'flex',\n508\t  justifyContent: 'flex-start',\n509\t};\n510\t\n511\tconst userBubbleStyle: CSSProperties = {\n512\t  maxWidth: '88%',\n513\t  padding: '8px 12px',\n514\t  background: 'var(--accent-subtle)',\n515\t  color: 'var(--accent-text)',\n516\t  borderRadius: '10px 10px 2px 10px',\n517\t  fontSize: 'var(--fs-sm)',\n518\t  lineHeight: 1.5,\n519\t  fontFamily: 'var(--font-prose)',\n520\t  whiteSpace: 'pre-wrap',\n521\t  wordBreak: 'break-word',\n522\t};\n523\t\n524\tconst assistantBubbleStyle: CSSProperties = {\n525\t  maxWidth: '94%',\n526\t  padding: '8px 12px',\n527\t  background: 'var(--bg-subtle)',\n528\t  color: 'var(--text)',\n529\t  borderRadius: '10px 10px 10px 2px',\n530\t  fontSize: 'var(--fs-sm)',\n531\t  lineHeight: 1.5,\n532\t  fontFamily: 'var(--font-prose)',\n533\t  whiteSpace: 'pre-wrap',\n534\t  wordBreak: 'break-word',\n535\t};\n536\t\n537\tconst errorBubbleStyle: CSSProperties = {\n538\t  maxWidth: '94%',\n539\t  padding: '8px 12px',\n540\t  background: 'var(--danger-subtle, #fee2e2)',\n541\t  color: 'var(--danger-text, #991b1b)',\n542\t  borderWidth: 1,\n543\t  borderStyle: 'solid',\n544\t  borderColor: 'var(--danger-border, #fecaca)',\n545\t  borderRadius: '10px 10px 10px 2px',\n546\t  fontSize: 'var(--fs-sm)',\n547\t  lineHeight: 1.5,\n548\t  fontFamily: 'var(--font-prose)',\n549\t  whiteSpace: 'pre-wrap',\n550\t  wordBreak: 'break-word',\n551\t};\n552\t\n553\tfunction TypingDots() {\n554\t  return (\n555\t    <span\n556\t      data-testid=\"lesson-chat-typing\"\n557\t      aria-label=\"AI tutor is typing\"\n558\t      style={typingDotsStyle}\n559\t    >\n560\t      <span style={{ ...typingDotStyle, animationDelay: '0ms' }} />\n561\t      <span style={{ ...typingDotStyle, animationDelay: '150ms' }} />\n562\t      <span style={{ ...typingDotStyle, animationDelay: '300ms' }} />\n563\t      <style>{typingKeyframes}</style>\n564\t    </span>\n565\t  );\n566\t}\n567\t\n568\tconst typingDotsStyle: CSSProperties = {\n569\t  display: 'inline-flex',\n570\t  gap: 4,\n571\t  alignItems: 'center',\n572\t  height: 12,\n573\t  paddingTop: 4,\n574\t  paddingBottom: 4,\n575\t};\n576\t\n577\tconst typingDotStyle: CSSProperties = {\n578\t  width: 6,\n579\t  height: 6,\n580\t  borderRadius: '50%',\n581\t  background: 'var(--text-tertiary)',\n582\t  display: 'inline-block',\n583\t  animation: 'lesson-chat-typing-bounce 1s infinite ease-in-out',\n584\t};\n585\t\n586\tconst typingKeyframes = `\n587\t@keyframes lesson-chat-typing-bounce {\n588\t  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }\n589\t  40% { transform: scale(1); opacity: 1; }\n590\t}\n591\t`;\n592\t\n593\tconst footerStyle: CSSProperties = {\n594\t  borderTop: '1px solid var(--border)',\n595\t  background: 'var(--bg-elevated)',\n596\t  padding: 'var(--space-3) var(--space-4)',\n597\t  display: 'flex',\n598\t  flexDirection: 'column',\n599\t  gap: 6,\n600\t  flexShrink: 0,\n601\t};\n602\t\n603\tconst textareaStyle: CSSProperties = {\n604\t  width: '100%',\n605\t  resize: 'none',\n606\t  borderWidth: 1,\n607\t  borderStyle: 'solid',\n608\t  borderColor: 'var(--border-strong)',\n609\t  borderRadius: 'var(--radius-md)',\n610\t  padding: '8px 10px',\n611\t  fontFamily: 'var(--font-prose)',\n612\t  fontSize: 'var(--fs-sm)',\n613\t  lineHeight: `${LINE_HEIGHT_PX}px`,\n614\t  color: 'var(--text)',\n615\t  background: 'var(--bg)',\n616\t  outline: 'none',\n617\t  boxSizing: 'border-box',\n618\t};\n619\t\n620\tconst composerControlsStyle: CSSProperties = {\n621\t  display: 'flex',\n622\t  alignItems: 'center',\n623\t  justifyContent: 'space-between',\n624\t  gap: 6,\n625\t};\n626\t\n627\tconst hintStyle: CSSProperties = {\n628\t  fontSize: '11px',\n629\t  color: 'var(--text-quaternary)',\n630\t  fontFamily: 'var(--font-mono)',\n631\t};\n632\t\n633\tconst btnGroupStyle: CSSProperties = {\n634\t  display: 'inline-flex',\n635\t  alignItems: 'center',\n636\t  gap: 6,\n637\t};\n638\t\n639\tconst stopBtnStyle: CSSProperties = {\n640\t  width: 28,\n641\t  height: 28,\n642\t  display: 'inline-flex',\n643\t  alignItems: 'center',\n644\t  justifyContent: 'center',\n645\t  borderWidth: 1,\n646\t  borderStyle: 'solid',\n647\t  borderColor: 'var(--border)',\n648\t  borderRadius: 'var(--radius-sm)',\n649\t  background: 'var(--bg-subtle)',\n650\t  color: 'var(--text-quaternary)',\n651\t  cursor: 'not-allowed',\n652\t  opacity: 0.6,\n653\t};\n654\t\n655\tconst sendBtnBase: CSSProperties = {\n656\t  height: 28,\n657\t  padding: '0 12px',\n658\t  borderWidth: 1,\n659\t  borderStyle: 'solid',\n660\t  borderRadius: 'var(--radius-sm)',\n661\t  fontSize: 'var(--fs-sm)',\n662\t  fontFamily: 'var(--font-sans)',\n663\t  fontWeight: 500,\n664\t};\n665\t\n666\tconst sendBtnStyle: CSSProperties = {\n667\t  ...sendBtnBase,\n668\t  borderColor: 'var(--accent)',\n669\t  background: 'var(--accent)',\n670\t  color: 'var(--accent-fg, #ffffff)',\n671\t  cursor: 'pointer',\n672\t};\n673\t\n674\tconst sendBtnDisabledStyle: CSSProperties = {\n675\t  ...sendBtnBase,\n676\t  borderColor: 'var(--border)',\n677\t  background: 'var(--bg-subtle)',\n678\t  color: 'var(--text-quaternary)',\n679\t  cursor: 'not-allowed',\n680\t};\n681\t"}]},"parent_tool_use_id":null,"session_id":"af09fd90-aa43-4e2e-8fd9-839962b1c817","uuid":"590f50db-1fe8-4874-80a6-49d68efb1c0d","timestamp":"2026-05-04T06:48:20.627Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-055/src/components/LessonChat.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useEffect,\n  useLayoutEffect,\n  useMemo,\n  useRef,\n  useState,\n  type CSSProperties,\n  type KeyboardEvent as ReactKeyboardEvent,\n} from 'react';\nimport { Square, X } from 'lucide-react';\n\ninterface ChatMessage {\n  id: string;\n  role: 'user' | 'assistant' | 'error';\n  text: string;\n  pending?: boolean;\n}\n\ninterface LessonChatProps {\n  open: boolean;\n  courseSlug: string;\n  lessonSlug: string;\n  onClose: () => void;\n}\n\nconst LINE_HEIGHT_PX = 20;\nconst MIN_LINES = 1;\nconst MAX_LINES = 6;\nconst TEXTAREA_VERTICAL_PADDING = 16;\nconst DRAFT_DEBOUNCE_MS = 200;\n\nexport function draftStorageKey(courseSlug: string, lessonSlug: string): string {\n  return `lessonChatDraft:${courseSlug}:${lessonSlug}`;\n}\n\nexport function LessonChat({\n  open,\n  courseSlug,\n  lessonSlug,\n  onClose,\n}: LessonChatProps) {\n  const [draft, setDraft] = useState('');\n  const [messages, setMessages] = useState<ChatMessage[]>([]);\n  const [sending, setSending] = useState(false);\n  const [activeSectionId, setActiveSectionId] = useState<string | null>(null);\n  const textareaRef = useRef<HTMLTextAreaElement | null>(null);\n  const messagesRef = useRef<HTMLDivElement | null>(null);\n  const debounceRef = useRef<number | null>(null);\n  const draftKey = useMemo(\n    () => draftStorageKey(courseSlug, lessonSlug),\n    [courseSlug, lessonSlug],\n  );\n\n  // Track the section currently nearest the top of the viewport via\n  // IntersectionObserver — used to scope the AI tutor's prompt context\n  // to the active section. Re-runs when the panel opens or the lesson\n  // changes; queries `[data-section-id]` elements rendered by the lesson\n  // page. Falls back gracefully (no observer) when nothing matches.\n  useEffect(() => {\n    if (!open) return;\n    if (typeof IntersectionObserver === 'undefined') return;\n\n    // Map the section id → its DOM order index, so when several sections\n    // straddle the \"active\" band at the top of the viewport, we pick the\n    // last one (the one the learner has scrolled into).\n    const orderById = new Map<string, number>();\n    const visible = new Set<string>();\n    const observed = new WeakSet<Element>();\n\n    const recompute = () => {\n      let bestId: string | null = null;\n      let bestOrder = -1;\n      for (const id of visible) {\n        const order = orderById.get(id) ?? -1;\n        if (order > bestOrder) {\n          bestOrder = order;\n          bestId = id;\n        }\n      }\n      if (bestId !== null) {\n        setActiveSectionId(bestId);\n      }\n    };\n\n    const intersection = new IntersectionObserver(\n      (entries) => {\n        for (const entry of entries) {\n          const id = (entry.target as HTMLElement).getAttribute(\n            'data-section-id',\n          );\n          if (id === null) continue;\n          if (entry.isIntersecting) {\n            visible.add(id);\n          } else {\n            visible.delete(id);\n          }\n        }\n        recompute();\n      },\n      // rootMargin biases intersection to a strip near the top of the\n      // viewport so the active section is whatever is currently being\n      // read, not whatever is biggest.\n      { rootMargin: '0px 0px -75% 0px', threshold: 0 },\n    );\n\n    const observeAllSections = () => {\n      const targets = Array.from(\n        document.querySelectorAll<HTMLElement>('[data-section-id]'),\n      );\n      for (const el of targets) {\n        const id = el.getAttribute('data-section-id');\n        if (id !== null && !orderById.has(id)) {\n          orderById.set(id, orderById.size);\n        }\n        if (!observed.has(el)) {\n          intersection.observe(el);\n          observed.add(el);\n        }\n      }\n      // Seed activeSectionId from the current scroll position so the very\n      // first message has a sensible sectionId before IO fires.\n      const main =\n        document.querySelector<HTMLElement>('[data-testid=\"lesson-content\"]') ??\n        null;\n      if (main && targets.length > 0) {\n        const mainTop = main.scrollTop;\n        let seedId: string | null = null;\n        for (const el of targets) {\n          const id = el.getAttribute('data-section-id');\n          if (id === null) continue;\n          const offset =\n            el.getBoundingClientRect().top -\n            main.getBoundingClientRect().top +\n            main.scrollTop;\n          if (offset <= mainTop + 8) {\n            seedId = id;\n          }\n        }\n        if (seedId !== null) {\n          setActiveSectionId(seedId);\n        }\n      }\n    };\n\n    observeAllSections();\n\n    // Sections may not yet be in the DOM when the panel opens (e.g. the\n    // lesson is still loading via fetch). Watch for added section elements\n    // and observe them too.\n    const mutation = new MutationObserver(() => {\n      observeAllSections();\n    });\n    mutation.observe(document.body, { childList: true, subtree: true });\n\n    return () => {\n      intersection.disconnect();\n      mutation.disconnect();\n    };\n  }, [open, lessonSlug, courseSlug]);\n\n  // Restore draft on mount or when slug changes. New mount per panel toggle is\n  // fine — `open=false` returns null below so the effect only fires when the\n  // panel actually appears.\n  useEffect(() => {\n    try {\n      const stored = window.localStorage.getItem(draftKey);\n      // eslint-disable-next-line react-hooks/set-state-in-effect\n      setDraft(stored ?? '');\n    } catch {\n      // localStorage unavailable — start with empty draft.\n    }\n  }, [draftKey]);\n\n  // Debounced write of the draft to localStorage.\n  useEffect(() => {\n    if (debounceRef.current !== null) {\n      window.clearTimeout(debounceRef.current);\n    }\n    debounceRef.current = window.setTimeout(() => {\n      try {\n        if (draft.length === 0) {\n          window.localStorage.removeItem(draftKey);\n        } else {\n          window.localStorage.setItem(draftKey, draft);\n        }\n      } catch {\n        // Persistence unavailable; in-memory draft still works.\n      }\n    }, DRAFT_DEBOUNCE_MS);\n    return () => {\n      if (debounceRef.current !== null) {\n        window.clearTimeout(debounceRef.current);\n        debounceRef.current = null;\n      }\n    };\n  }, [draft, draftKey]);\n\n  // Autoresize the textarea: measure scrollHeight, clamp to MAX_LINES.\n  useLayoutEffect(() => {\n    const el = textareaRef.current;\n    if (!el) return;\n    el.style.height = 'auto';\n    const maxHeight = LINE_HEIGHT_PX * MAX_LINES + TEXTAREA_VERTICAL_PADDING;\n    const minHeight = LINE_HEIGHT_PX * MIN_LINES + TEXTAREA_VERTICAL_PADDING;\n    const next = Math.max(\n      minHeight,\n      Math.min(maxHeight, el.scrollHeight),\n    );\n    el.style.height = `${next}px`;\n    el.style.overflowY = el.scrollHeight > maxHeight ? 'auto' : 'hidden';\n  }, [draft]);\n\n  // Auto-scroll to bottom when new messages land.\n  useEffect(() => {\n    const el = messagesRef.current;\n    if (!el) return;\n    el.scrollTop = el.scrollHeight;\n  }, [messages.length]);\n\n  const trimmedDraft = draft.trim();\n  const canSend = trimmedDraft.length > 0 && !sending;\n\n  const handleSend = useCallback(() => {\n    const text = draft.trim();\n    if (text.length === 0 || sending) return;\n    const stamp = Date.now();\n    const userId = `m-${stamp}-u`;\n    const pendingId = `m-${stamp}-p`;\n    setMessages((prev) => [\n      ...prev,\n      { id: userId, role: 'user', text },\n      { id: pendingId, role: 'assistant', text: '', pending: true },\n    ]);\n    setDraft('');\n    setSending(true);\n    try {\n      window.localStorage.removeItem(draftKey);\n    } catch {\n      // ignore — draft already cleared from in-memory state\n    }\n\n    const history = messages\n      .filter((m) => m.role === 'user' || m.role === 'assistant')\n      .filter((m) => !m.pending)\n      .map((m) => ({ role: m.role as 'user' | 'assistant', content: m.text }));\n\n    void (async () => {\n      try {\n        const res = await fetch('/api/lesson-chat', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n            courseSlug,\n            lessonSlug,\n            sectionId: activeSectionId ?? undefined,\n            message: text,\n            history,\n          }),\n        });\n        const json = (await res\n          .json()\n          .catch(() => ({}))) as { assistant?: string; error?: string };\n        if (!res.ok) {\n          const errText =\n            json.error ?? `AI Tutor error (status ${res.status})`;\n          setMessages((prev) =>\n            prev.map((m) =>\n              m.id === pendingId\n                ? { id: pendingId, role: 'error', text: errText }\n                : m,\n            ),\n          );\n        } else {\n          setMessages((prev) =>\n            prev.map((m) =>\n              m.id === pendingId\n                ? {\n                    id: pendingId,\n                    role: 'assistant',\n                    text: json.assistant ?? '',\n                  }\n                : m,\n            ),\n          );\n        }\n      } catch (err) {\n        const errText = `AI Tutor error: ${(err as Error).message}`;\n        setMessages((prev) =>\n          prev.map((m) =>\n            m.id === pendingId\n              ? { id: pendingId, role: 'error', text: errText }\n              : m,\n          ),\n        );\n      } finally {\n        setSending(false);\n      }\n    })();\n  }, [activeSectionId, courseSlug, draft, draftKey, lessonSlug, messages, sending]);\n\n  const handleKeyDown = useCallback(\n    (e: ReactKeyboardEvent<HTMLTextAreaElement>) => {\n      const isMod = e.metaKey || e.ctrlKey;\n      if (isMod && e.key === 'Enter') {\n        e.preventDefault();\n        handleSend();\n      }\n    },\n    [handleSend],\n  );\n\n  if (!open) {\n    return (\n      <aside\n        data-testid=\"lesson-chat\"\n        data-open=\"false\"\n        aria-hidden\n        style={asideHiddenStyle}\n      />\n    );\n  }\n\n  return (\n    <aside\n      data-testid=\"lesson-chat\"\n      data-open=\"true\"\n      data-active-section-id={activeSectionId ?? ''}\n      style={asideStyle}\n    >\n      <header style={headerStyle}>\n        <h2 style={titleStyle}>AI Tutor</h2>\n        <button\n          type=\"button\"\n          data-testid=\"lesson-chat-close\"\n          aria-label=\"Close AI tutor panel\"\n          onClick={onClose}\n          style={closeBtnStyle}\n        >\n          <X size={16} strokeWidth={2} />\n        </button>\n      </header>\n\n      <div\n        ref={messagesRef}\n        data-testid=\"lesson-chat-messages\"\n        style={messagesStyle}\n      >\n        {messages.length === 0 ? (\n          <p data-testid=\"lesson-chat-empty\" style={emptyStyle}>\n            Ask anything about this lesson — I have its content as context.\n          </p>\n        ) : (\n          <ul style={messageListStyle}>\n            {messages.map((m) => {\n              const rowStyle =\n                m.role === 'user' ? userBubbleRowStyle : assistantBubbleRowStyle;\n              let bubbleStyle: CSSProperties = assistantBubbleStyle;\n              if (m.role === 'user') bubbleStyle = userBubbleStyle;\n              else if (m.role === 'error') bubbleStyle = errorBubbleStyle;\n              return (\n                <li\n                  key={m.id}\n                  data-role={m.role}\n                  data-pending={m.pending ? 'true' : undefined}\n                  style={rowStyle}\n                >\n                  <div style={bubbleStyle}>\n                    {m.pending ? <TypingDots /> : m.text}\n                  </div>\n                </li>\n              );\n            })}\n          </ul>\n        )}\n      </div>\n\n      <footer style={footerStyle}>\n        <textarea\n          ref={textareaRef}\n          data-testid=\"lesson-chat-textarea\"\n          aria-label=\"Message AI tutor\"\n          placeholder=\"Ask about this lesson…\"\n          value={draft}\n          onChange={(e) => setDraft(e.target.value)}\n          onKeyDown={handleKeyDown}\n          rows={1}\n          style={textareaStyle}\n        />\n        <div style={composerControlsStyle}>\n          <span style={hintStyle}>⌘+Enter to send</span>\n          <div style={btnGroupStyle}>\n            <button\n              type=\"button\"\n              data-testid=\"lesson-chat-stop\"\n              aria-label=\"Stop response\"\n              disabled\n              style={stopBtnStyle}\n            >\n              <Square size={12} strokeWidth={2} />\n            </button>\n            <button\n              type=\"button\"\n              data-testid=\"lesson-chat-send\"\n              aria-label=\"Send message\"\n              disabled={!canSend}\n              onClick={handleSend}\n              style={canSend ? sendBtnStyle : sendBtnDisabledStyle}\n            >\n              Send\n            </button>\n          </div>\n        </div>\n      </footer>\n    </aside>\n  );\n}\n\nconst asideHiddenStyle: CSSProperties = {\n  gridColumn: '3 / 4',\n  gridRow: '2 / 3',\n  display: 'none',\n};\n\nconst asideStyle: CSSProperties = {\n  gridColumn: '3 / 4',\n  gridRow: '2 / 3',\n  borderLeft: '1px solid var(--border)',\n  background: 'var(--bg-elevated)',\n  display: 'flex',\n  flexDirection: 'column',\n  minWidth: 0,\n  overflow: 'hidden',\n};\n\nconst headerStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  justifyContent: 'space-between',\n  gap: 'var(--space-3)',\n  padding: 'var(--space-3) var(--space-4)',\n  borderBottom: '1px solid var(--border)',\n  flexShrink: 0,\n  minHeight: 48,\n};\n\nconst titleStyle: CSSProperties = {\n  margin: 0,\n  fontSize: 'var(--fs-md)',\n  fontWeight: 600,\n  color: 'var(--text)',\n  lineHeight: 1.2,\n};\n\nconst closeBtnStyle: CSSProperties = {\n  width: 28,\n  height: 28,\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  background: 'transparent',\n  borderWidth: 1,\n  borderStyle: 'solid',\n  borderColor: 'transparent',\n  borderRadius: 'var(--radius-sm)',\n  color: 'var(--text-tertiary)',\n  cursor: 'pointer',\n};\n\nconst messagesStyle: CSSProperties = {\n  flex: 1,\n  minHeight: 0,\n  overflowY: 'auto',\n  padding: 'var(--space-4)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-3)',\n};\n\nconst emptyStyle: CSSProperties = {\n  margin: 'auto 0',\n  textAlign: 'center',\n  color: 'var(--text-tertiary)',\n  fontSize: 'var(--fs-sm)',\n  fontFamily: 'var(--font-prose)',\n  lineHeight: 1.5,\n  padding: '0 var(--space-3)',\n};\n\nconst messageListStyle: CSSProperties = {\n  listStyle: 'none',\n  margin: 0,\n  padding: 0,\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-3)',\n};\n\nconst userBubbleRowStyle: CSSProperties = {\n  display: 'flex',\n  justifyContent: 'flex-end',\n};\n\nconst assistantBubbleRowStyle: CSSProperties = {\n  display: 'flex',\n  justifyContent: 'flex-start',\n};\n\nconst userBubbleStyle: CSSProperties = {\n  maxWidth: '88%',\n  padding: '8px 12px',\n  background: 'var(--accent-subtle)',\n  color: 'var(--accent-text)',\n  borderRadius: '10px 10px 2px 10px',\n  fontSize: 'var(--fs-sm)',\n  lineHeight: 1.5,\n  fontFamily: 'var(--font-prose)',\n  whiteSpace: 'pre-wrap',\n  wordBreak: 'break-word',\n};\n\nconst assistantBubbleStyle: CSSProperties = {\n  maxWidth: '94%',\n  padding: '8px 12px',\n  background: 'var(--bg-subtle)',\n  color: 'var(--text)',\n  borderRadius: '10px 10px 10px 2px',\n  fontSize: 'var(--fs-sm)',\n  lineHeight: 1.5,\n  fontFamily: 'var(--font-prose)',\n  whiteSpace: 'pre-wrap',\n  wordBreak: 'break-word',\n};\n\nconst errorBubbleStyle: CSSProperties = {\n  maxWidth: '94%',\n  padding: '8px 12px',\n  background: 'var(--danger-subtle, #fee2e2)',\n  color: 'var(--danger-text, #991b1b)',\n  borderWidth: 1,\n  borderStyle: 'solid',\n  borderColor: 'var(--danger-border, #fecaca)',\n  borderRadius: '10px 10px 10px 2px',\n  fontSize: 'var(--fs-sm)',\n  lineHeight: 1.5,\n  fontFamily: 'var(--font-prose)',\n  whiteSpace: 'pre-wrap',\n  wordBreak: 'break-word',\n};\n\nfunction TypingDots() {\n  return (\n    <span\n      data-testid=\"lesson-chat-typing\"\n      aria-label=\"AI tutor is typing\"\n      style={typingDotsStyle}\n    >\n      <span style={{ ...typingDotStyle, animationDelay: '0ms' }} />\n      <span style={{ ...typingDotStyle, animationDelay: '150ms' }} />\n      <span style={{ ...typingDotStyle, animationDelay: '300ms' }} />\n      <style>{typingKeyframes}</style>\n    </span>\n  );\n}\n\nconst typingDotsStyle: CSSProperties = {\n  display: 'inline-flex',\n  gap: 4,\n  alignItems: 'center',\n  height: 12,\n  paddingTop: 4,\n  paddingBottom: 4,\n};\n\nconst typingDotStyle: CSSProperties = {\n  width: 6,\n  height: 6,\n  borderRadius: '50%',\n  background: 'var(--text-tertiary)',\n  display: 'inline-block',\n  animation: 'lesson-chat-typing-bounce 1s infinite ease-in-out',\n};\n\nconst typingKeyframes = `\n@keyframes lesson-chat-typing-bounce {\n  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }\n  40% { transform: scale(1); opacity: 1; }\n}\n`;\n\nconst footerStyle: CSSProperties = {\n  borderTop: '1px solid var(--border)',\n  background: 'var(--bg-elevated)',\n  padding: 'var(--space-3) var(--space-4)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 6,\n  flexShrink: 0,\n};\n\nconst textareaStyle: CSSProperties = {\n  width: '100%',\n  resize: 'none',\n  borderWidth: 1,\n  borderStyle: 'solid',\n  borderColor: 'var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  padding: '8px 10px',\n  fontFamily: 'var(--font-prose)',\n  fontSize: 'var(--fs-sm)',\n  lineHeight: `${LINE_HEIGHT_PX}px`,\n  color: 'var(--text)',\n  background: 'var(--bg)',\n  outline: 'none',\n  boxSizing: 'border-box',\n};\n\nconst composerControlsStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  justifyContent: 'space-between',\n  gap: 6,\n};\n\nconst hintStyle: CSSProperties = {\n  fontSize: '11px',\n  color: 'var(--text-quaternary)',\n  fontFamily: 'var(--font-mono)',\n};\n\nconst btnGroupStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 6,\n};\n\nconst stopBtnStyle: CSSProperties = {\n  width: 28,\n  height: 28,\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  borderWidth: 1,\n  borderStyle: 'solid',\n  borderColor: 'var(--border)',\n  borderRadius: 'var(--radius-sm)',\n  background: 'var(--bg-subtle)',\n  color: 'var(--text-quaternary)',\n  cursor: 'not-allowed',\n  opacity: 0.6,\n};\n\nconst sendBtnBase: CSSProperties = {\n  height: 28,\n  padding: '0 12px',\n  borderWidth: 1,\n  borderStyle: 'solid',\n  borderRadius: 'var(--radius-sm)',\n  fontSize: 'var(--fs-sm)',\n  fontFamily: 'var(--font-sans)',\n  fontWeight: 500,\n};\n\nconst sendBtnStyle: CSSProperties = {\n  ...sendBtnBase,\n  borderColor: 'var(--accent)',\n  background: 'var(--accent)',\n  color: 'var(--accent-fg, #ffffff)',\n  cursor: 'pointer',\n};\n\nconst sendBtnDisabledStyle: CSSProperties = {\n  ...sendBtnBase,\n  borderColor: 'var(--border)',\n  background: 'var(--bg-subtle)',\n  color: 'var(--text-quaternary)',\n  cursor: 'not-allowed',\n};\n","numLines":681,"startLine":1,"totalLines":681}}}
