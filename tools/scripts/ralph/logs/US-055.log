{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016VLevCVKkA5cCv9nT4ZjHX","type":"tool_result","content":"1\t/**\n2\t * LessonChat connector — bridges the API route to a backing Claude implementation.\n3\t *\n4\t * Two implementations are tried in order at first use, then cached for the lifetime\n5\t * of the server process:\n6\t *   1. Agent SDK (`@anthropic-ai/claude-agent-sdk`) — uses the user's local Claude\n7\t *      Code subscription. No API key.\n8\t *   2. Subprocess — spawns `claude -p \"<prompt>\" --output-format json` and parses\n9\t *      the resulting JSON.\n10\t *\n11\t * If neither works, `selectConnector()` returns `null` and the API surfaces a 503.\n12\t *\n13\t * Prompt assembly is intentionally minimal — full lesson-context wiring is US-054.\n14\t */\n15\timport { spawn, type ChildProcess } from 'node:child_process';\n16\t\n17\texport interface ChatMessage {\n18\t  role: 'user' | 'assistant';\n19\t  content: string;\n20\t}\n21\t\n22\texport interface ConnectorRequest {\n23\t  /** System prompt — instructions for the assistant. Optional. */\n24\t  systemPrompt?: string;\n25\t  /** User-facing message body (typically lesson context + question). */\n26\t  userMessage: string;\n27\t  history?: ChatMessage[];\n28\t}\n29\t\n30\texport type ConnectorName = 'agent-sdk' | 'subprocess';\n31\t\n32\texport interface Connector {\n33\t  readonly name: ConnectorName;\n34\t  chat(req: ConnectorRequest): Promise<string>;\n35\t}\n36\t\n37\tconst DEFAULT_SYSTEM_PROMPT =\n38\t  'You are an AI tutor for an interactive course. Answer concisely.';\n39\t\n40\texport function assemblePrompt(\n41\t  userMessage: string,\n42\t  systemPrompt: string = DEFAULT_SYSTEM_PROMPT,\n43\t): string {\n44\t  return `${systemPrompt}\\n\\n${userMessage}`;\n45\t}\n46\t\n47\t// ---------------------------------------------------------------------------\n48\t// Subprocess connector\n49\t// ---------------------------------------------------------------------------\n50\t\n51\tconst SUBPROCESS_TIMEOUT_MS = 60_000;\n52\tconst SUBPROCESS_KILL_GRACE_MS = 5_000;\n53\t\n54\texport type SpawnFn = typeof spawn;\n55\t\n56\texport interface SubprocessConnectorOptions {\n57\t  command?: string;\n58\t  spawnFn?: SpawnFn;\n59\t  timeoutMs?: number;\n60\t  killGraceMs?: number;\n61\t}\n62\t\n63\texport function subprocessConnector(\n64\t  opts: SubprocessConnectorOptions = {},\n65\t): Connector {\n66\t  const command = opts.command ?? 'claude';\n67\t  const spawnFn = opts.spawnFn ?? spawn;\n68\t  const timeoutMs = opts.timeoutMs ?? SUBPROCESS_TIMEOUT_MS;\n69\t  const killGraceMs = opts.killGraceMs ?? SUBPROCESS_KILL_GRACE_MS;\n70\t\n71\t  return {\n72\t    name: 'subprocess',\n73\t    chat(req) {\n74\t      const prompt = assemblePrompt(req.userMessage, req.systemPrompt);\n75\t      return runClaudeCli(spawnFn, command, prompt, timeoutMs, killGraceMs);\n76\t    },\n77\t  };\n78\t}\n79\t\n80\tfunction runClaudeCli(\n81\t  spawnFn: SpawnFn,\n82\t  command: string,\n83\t  prompt: string,\n84\t  timeoutMs: number,\n85\t  killGraceMs: number,\n86\t): Promise<string> {\n87\t  return new Promise((resolve, reject) => {\n88\t    let child: ChildProcess;\n89\t    try {\n90\t      child = spawnFn(command, ['-p', prompt, '--output-format', 'json']);\n91\t    } catch (err) {\n92\t      reject(new Error(`claude spawn failed: ${(err as Error).message}`));\n93\t      return;\n94\t    }\n95\t\n96\t    let stdoutBuf = '';\n97\t    let stderrBuf = '';\n98\t    let timedOut = false;\n99\t    let settled = false;\n100\t    let killTimer: NodeJS.Timeout | null = null;\n101\t\n102\t    const settle = (fn: () => void) => {\n103\t      if (settled) return;\n104\t      settled = true;\n105\t      if (killTimer !== null) {\n106\t        clearTimeout(killTimer);\n107\t        killTimer = null;\n108\t      }\n109\t      fn();\n110\t    };\n111\t\n112\t    const timer = setTimeout(() => {\n113\t      timedOut = true;\n114\t      try {\n115\t        child.kill('SIGTERM');\n116\t      } catch {\n117\t        // ignore — handled by close/error below\n118\t      }\n119\t      killTimer = setTimeout(() => {\n120\t        try {\n121\t          child.kill('SIGKILL');\n122\t        } catch {\n123\t          // ignore\n124\t        }\n125\t      }, killGraceMs);\n126\t    }, timeoutMs);\n127\t\n128\t    child.stdout?.on('data', (chunk: Buffer | string) => {\n129\t      stdoutBuf += chunk.toString();\n130\t    });\n131\t    child.stderr?.on('data', (chunk: Buffer | string) => {\n132\t      stderrBuf += chunk.toString();\n133\t    });\n134\t    child.on('error', (err: Error) => {\n135\t      clearTimeout(timer);\n136\t      settle(() => reject(new Error(`claude spawn failed: ${err.message}`)));\n137\t    });\n138\t    child.on('close', (code: number | null) => {\n139\t      clearTimeout(timer);\n140\t      if (timedOut) {\n141\t        settle(() =>\n142\t          reject(new Error(`claude CLI timed out after ${timeoutMs}ms`)),\n143\t        );\n144\t        return;\n145\t      }\n146\t      if (code !== 0) {\n147\t        const msg = stderrBuf.trim() || stdoutBuf.trim() || `exit code ${code}`;\n148\t        settle(() =>\n149\t          reject(new Error(`claude exited ${code}: ${msg}`)),\n150\t        );\n151\t        return;\n152\t      }\n153\t      let parsed: unknown;\n154\t      try {\n155\t        parsed = JSON.parse(stdoutBuf);\n156\t      } catch (err) {\n157\t        settle(() =>\n158\t          reject(\n159\t            new Error(\n160\t              `failed to parse claude JSON output: ${(err as Error).message}`,\n161\t            ),\n162\t          ),\n163\t        );\n164\t        return;\n165\t      }\n166\t      if (!parsed || typeof parsed !== 'object') {\n167\t        settle(() => reject(new Error('claude JSON output not an object')));\n168\t        return;\n169\t      }\n170\t      const obj = parsed as { result?: unknown; is_error?: unknown };\n171\t      if (obj.is_error === true) {\n172\t        settle(() =>\n173\t          reject(new Error(`claude returned is_error=true: ${stdoutBuf}`)),\n174\t        );\n175\t        return;\n176\t      }\n177\t      if (typeof obj.result !== 'string') {\n178\t        settle(() =>\n179\t          reject(new Error(\"claude JSON output missing string 'result' field\")),\n180\t        );\n181\t        return;\n182\t      }\n183\t      settle(() => resolve(obj.result as string));\n184\t    });\n185\t  });\n186\t}\n187\t\n188\t// ---------------------------------------------------------------------------\n189\t// Agent SDK connector\n190\t// ---------------------------------------------------------------------------\n191\t\n192\tinterface AgentSdkLike {\n193\t  query: (args: { prompt: string }) => AsyncIterable<unknown>;\n194\t}\n195\t\n196\texport interface AgentSdkConnectorOptions {\n197\t  // Allow tests to inject a fake SDK; production path leaves it undefined and\n198\t  // the connector dynamically imports the real package.\n199\t  sdk?: AgentSdkLike;\n200\t  loadSdk?: () => Promise<AgentSdkLike>;\n201\t}\n202\t\n203\texport async function agentSdkConnector(\n204\t  opts: AgentSdkConnectorOptions = {},\n205\t): Promise<Connector> {\n206\t  let sdk: AgentSdkLike;\n207\t  if (opts.sdk) {\n208\t    sdk = opts.sdk;\n209\t  } else {\n210\t    const loader =\n211\t      opts.loadSdk ??\n212\t      (async () => {\n213\t        // Dynamic import so a missing package raises here and the caller can\n214\t        // fall back to subprocess. The string literal is hidden behind a\n215\t        // variable to discourage Next/webpack from trying to bundle it\n216\t        // statically.\n217\t        const mod = '@anthropic-ai/claude-agent-sdk';\n218\t        return (await import(/* webpackIgnore: true */ mod)) as AgentSdkLike;\n219\t      });\n220\t    sdk = await loader();\n221\t  }\n222\t\n223\t  if (typeof sdk.query !== 'function') {\n224\t    throw new Error('Agent SDK has unexpected shape: query() not found');\n225\t  }\n226\t\n227\t  return {\n228\t    name: 'agent-sdk',\n229\t    async chat(req) {\n230\t      const prompt = assemblePrompt(req.userMessage, req.systemPrompt);\n231\t      let assistantText = '';\n232\t      let resultFallback = '';\n233\t      const stream = sdk.query({ prompt });\n234\t      for await (const raw of stream) {\n235\t        if (!raw || typeof raw !== 'object') continue;\n236\t        const msg = raw as {\n237\t          type?: string;\n238\t          message?: { content?: Array<{ type?: string; text?: string }> };\n239\t          result?: string;\n240\t          is_error?: boolean;\n241\t        };\n242\t        if (msg.type === 'assistant') {\n243\t          for (const block of msg.message?.content ?? []) {\n244\t            if (block?.type === 'text' && typeof block.text === 'string') {\n245\t              assistantText += block.text;\n246\t            }\n247\t          }\n248\t        } else if (msg.type === 'result') {\n249\t          if (msg.is_error) {\n250\t            throw new Error('Agent SDK returned is_error=true');\n251\t          }\n252\t          if (typeof msg.result === 'string') {\n253\t            resultFallback = msg.result;\n254\t          }\n255\t        }\n256\t      }\n257\t      const text = assistantText || resultFallback;\n258\t      if (!text) {\n259\t        throw new Error('Agent SDK stream produced no assistant text');\n260\t      }\n261\t      return text;\n262\t    },\n263\t  };\n264\t}\n265\t\n266\t// ---------------------------------------------------------------------------\n267\t// Selection — try SDK first, fall back to subprocess. Cached per process.\n268\t// ---------------------------------------------------------------------------\n269\t\n270\tinterface SelectConnectorOptions {\n271\t  forceReselect?: boolean;\n272\t  agentSdk?: () => Promise<Connector>;\n273\t  subprocess?: () => Connector;\n274\t  probeSubprocess?: () => Promise<void>;\n275\t  log?: (line: string) => void;\n276\t}\n277\t\n278\tlet cachedConnector: Connector | null | undefined;\n279\t\n280\texport async function selectConnector(\n281\t  opts: SelectConnectorOptions = {},\n282\t): Promise<Connector | null> {\n283\t  if (!opts.forceReselect && cachedConnector !== undefined) {\n284\t    return cachedConnector;\n285\t  }\n286\t\n287\t  const log = opts.log ?? ((line: string) => console.log(line));\n288\t  const buildAgentSdk = opts.agentSdk ?? (() => agentSdkConnector());\n289\t  const buildSubprocess = opts.subprocess ?? (() => subprocessConnector());\n290\t  const probe = opts.probeSubprocess ?? probeClaudeCli;\n291\t\n292\t  try {\n293\t    cachedConnector = await buildAgentSdk();\n294\t    log('[lesson-chat] using Agent SDK connector');\n295\t    return cachedConnector;\n296\t  } catch (err) {\n297\t    log(\n298\t      `[lesson-chat] Agent SDK unavailable, trying subprocess: ${\n299\t        (err as Error).message\n300\t      }`,\n301\t    );\n302\t  }\n303\t\n304\t  try {\n305\t    await probe();\n306\t    cachedConnector = buildSubprocess();\n307\t    log('[lesson-chat] using subprocess connector');\n308\t    return cachedConnector;\n309\t  } catch (err) {\n310\t    log(\n311\t      `[lesson-chat] subprocess unavailable: ${(err as Error).message}`,\n312\t    );\n313\t    cachedConnector = null;\n314\t    return null;\n315\t  }\n316\t}\n317\t\n318\tfunction probeClaudeCli(): Promise<void> {\n319\t  return new Promise((resolve, reject) => {\n320\t    let child: ChildProcess;\n321\t    try {\n322\t      child = spawn('claude', ['--version']);\n323\t    } catch (err) {\n324\t      reject(err as Error);\n325\t      return;\n326\t    }\n327\t    let settled = false;\n328\t    const settle = (fn: () => void) => {\n329\t      if (settled) return;\n330\t      settled = true;\n331\t      fn();\n332\t    };\n333\t    const timer = setTimeout(() => {\n334\t      try {\n335\t        child.kill('SIGTERM');\n336\t      } catch {\n337\t        // ignore\n338\t      }\n339\t      settle(() => reject(new Error('claude --version timed out')));\n340\t    }, 5_000);\n341\t    child.on('error', (err: Error) => {\n342\t      clearTimeout(timer);\n343\t      settle(() => reject(err));\n344\t    });\n345\t    child.on('close', (code: number | null) => {\n346\t      clearTimeout(timer);\n347\t      if (code === 0) settle(() => resolve());\n348\t      else settle(() => reject(new Error(`claude --version exited ${code}`)));\n349\t    });\n350\t  });\n351\t}\n352\t\n353\texport function _resetConnectorCacheForTesting(): void {\n354\t  cachedConnector = undefined;\n355\t}\n356\t"}]},"parent_tool_use_id":null,"session_id":"af09fd90-aa43-4e2e-8fd9-839962b1c817","uuid":"f905714f-1a37-450b-8185-e9395a510ce8","timestamp":"2026-05-04T06:48:13.986Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-055/src/lib/lessonChat/connector.ts","content":"/**\n * LessonChat connector — bridges the API route to a backing Claude implementation.\n *\n * Two implementations are tried in order at first use, then cached for the lifetime\n * of the server process:\n *   1. Agent SDK (`@anthropic-ai/claude-agent-sdk`) — uses the user's local Claude\n *      Code subscription. No API key.\n *   2. Subprocess — spawns `claude -p \"<prompt>\" --output-format json` and parses\n *      the resulting JSON.\n *\n * If neither works, `selectConnector()` returns `null` and the API surfaces a 503.\n *\n * Prompt assembly is intentionally minimal — full lesson-context wiring is US-054.\n */\nimport { spawn, type ChildProcess } from 'node:child_process';\n\nexport interface ChatMessage {\n  role: 'user' | 'assistant';\n  content: string;\n}\n\nexport interface ConnectorRequest {\n  /** System prompt — instructions for the assistant. Optional. */\n  systemPrompt?: string;\n  /** User-facing message body (typically lesson context + question). */\n  userMessage: string;\n  history?: ChatMessage[];\n}\n\nexport type ConnectorName = 'agent-sdk' | 'subprocess';\n\nexport interface Connector {\n  readonly name: ConnectorName;\n  chat(req: ConnectorRequest): Promise<string>;\n}\n\nconst DEFAULT_SYSTEM_PROMPT =\n  'You are an AI tutor for an interactive course. Answer concisely.';\n\nexport function assemblePrompt(\n  userMessage: string,\n  systemPrompt: string = DEFAULT_SYSTEM_PROMPT,\n): string {\n  return `${systemPrompt}\\n\\n${userMessage}`;\n}\n\n// ---------------------------------------------------------------------------\n// Subprocess connector\n// ---------------------------------------------------------------------------\n\nconst SUBPROCESS_TIMEOUT_MS = 60_000;\nconst SUBPROCESS_KILL_GRACE_MS = 5_000;\n\nexport type SpawnFn = typeof spawn;\n\nexport interface SubprocessConnectorOptions {\n  command?: string;\n  spawnFn?: SpawnFn;\n  timeoutMs?: number;\n  killGraceMs?: number;\n}\n\nexport function subprocessConnector(\n  opts: SubprocessConnectorOptions = {},\n): Connector {\n  const command = opts.command ?? 'claude';\n  const spawnFn = opts.spawnFn ?? spawn;\n  const timeoutMs = opts.timeoutMs ?? SUBPROCESS_TIMEOUT_MS;\n  const killGraceMs = opts.killGraceMs ?? SUBPROCESS_KILL_GRACE_MS;\n\n  return {\n    name: 'subprocess',\n    chat(req) {\n      const prompt = assemblePrompt(req.userMessage, req.systemPrompt);\n      return runClaudeCli(spawnFn, command, prompt, timeoutMs, killGraceMs);\n    },\n  };\n}\n\nfunction runClaudeCli(\n  spawnFn: SpawnFn,\n  command: string,\n  prompt: string,\n  timeoutMs: number,\n  killGraceMs: number,\n): Promise<string> {\n  return new Promise((resolve, reject) => {\n    let child: ChildProcess;\n    try {\n      child = spawnFn(command, ['-p', prompt, '--output-format', 'json']);\n    } catch (err) {\n      reject(new Error(`claude spawn failed: ${(err as Error).message}`));\n      return;\n    }\n\n    let stdoutBuf = '';\n    let stderrBuf = '';\n    let timedOut = false;\n    let settled = false;\n    let killTimer: NodeJS.Timeout | null = null;\n\n    const settle = (fn: () => void) => {\n      if (settled) return;\n      settled = true;\n      if (killTimer !== null) {\n        clearTimeout(killTimer);\n        killTimer = null;\n      }\n      fn();\n    };\n\n    const timer = setTimeout(() => {\n      timedOut = true;\n      try {\n        child.kill('SIGTERM');\n      } catch {\n        // ignore — handled by close/error below\n      }\n      killTimer = setTimeout(() => {\n        try {\n          child.kill('SIGKILL');\n        } catch {\n          // ignore\n        }\n      }, killGraceMs);\n    }, timeoutMs);\n\n    child.stdout?.on('data', (chunk: Buffer | string) => {\n      stdoutBuf += chunk.toString();\n    });\n    child.stderr?.on('data', (chunk: Buffer | string) => {\n      stderrBuf += chunk.toString();\n    });\n    child.on('error', (err: Error) => {\n      clearTimeout(timer);\n      settle(() => reject(new Error(`claude spawn failed: ${err.message}`)));\n    });\n    child.on('close', (code: number | null) => {\n      clearTimeout(timer);\n      if (timedOut) {\n        settle(() =>\n          reject(new Error(`claude CLI timed out after ${timeoutMs}ms`)),\n        );\n        return;\n      }\n      if (code !== 0) {\n        const msg = stderrBuf.trim() || stdoutBuf.trim() || `exit code ${code}`;\n        settle(() =>\n          reject(new Error(`claude exited ${code}: ${msg}`)),\n        );\n        return;\n      }\n      let parsed: unknown;\n      try {\n        parsed = JSON.parse(stdoutBuf);\n      } catch (err) {\n        settle(() =>\n          reject(\n            new Error(\n              `failed to parse claude JSON output: ${(err as Error).message}`,\n            ),\n          ),\n        );\n        return;\n      }\n      if (!parsed || typeof parsed !== 'object') {\n        settle(() => reject(new Error('claude JSON output not an object')));\n        return;\n      }\n      const obj = parsed as { result?: unknown; is_error?: unknown };\n      if (obj.is_error === true) {\n        settle(() =>\n          reject(new Error(`claude returned is_error=true: ${stdoutBuf}`)),\n        );\n        return;\n      }\n      if (typeof obj.result !== 'string') {\n        settle(() =>\n          reject(new Error(\"claude JSON output missing string 'result' field\")),\n        );\n        return;\n      }\n      settle(() => resolve(obj.result as string));\n    });\n  });\n}\n\n// ---------------------------------------------------------------------------\n// Agent SDK connector\n// ---------------------------------------------------------------------------\n\ninterface AgentSdkLike {\n  query: (args: { prompt: string }) => AsyncIterable<unknown>;\n}\n\nexport interface AgentSdkConnectorOptions {\n  // Allow tests to inject a fake SDK; production path leaves it undefined and\n  // the connector dynamically imports the real package.\n  sdk?: AgentSdkLike;\n  loadSdk?: () => Promise<AgentSdkLike>;\n}\n\nexport async function agentSdkConnector(\n  opts: AgentSdkConnectorOptions = {},\n): Promise<Connector> {\n  let sdk: AgentSdkLike;\n  if (opts.sdk) {\n    sdk = opts.sdk;\n  } else {\n    const loader =\n      opts.loadSdk ??\n      (async () => {\n        // Dynamic import so a missing package raises here and the caller can\n        // fall back to subprocess. The string literal is hidden behind a\n        // variable to discourage Next/webpack from trying to bundle it\n        // statically.\n        const mod = '@anthropic-ai/claude-agent-sdk';\n        return (await import(/* webpackIgnore: true */ mod)) as AgentSdkLike;\n      });\n    sdk = await loader();\n  }\n\n  if (typeof sdk.query !== 'function') {\n    throw new Error('Agent SDK has unexpected shape: query() not found');\n  }\n\n  return {\n    name: 'agent-sdk',\n    async chat(req) {\n      const prompt = assemblePrompt(req.userMessage, req.systemPrompt);\n      let assistantText = '';\n      let resultFallback = '';\n      const stream = sdk.query({ prompt });\n      for await (const raw of stream) {\n        if (!raw || typeof raw !== 'object') continue;\n        const msg = raw as {\n          type?: string;\n          message?: { content?: Array<{ type?: string; text?: string }> };\n          result?: string;\n          is_error?: boolean;\n        };\n        if (msg.type === 'assistant') {\n          for (const block of msg.message?.content ?? []) {\n            if (block?.type === 'text' && typeof block.text === 'string') {\n              assistantText += block.text;\n            }\n          }\n        } else if (msg.type === 'result') {\n          if (msg.is_error) {\n            throw new Error('Agent SDK returned is_error=true');\n          }\n          if (typeof msg.result === 'string') {\n            resultFallback = msg.result;\n          }\n        }\n      }\n      const text = assistantText || resultFallback;\n      if (!text) {\n        throw new Error('Agent SDK stream produced no assistant text');\n      }\n      return text;\n    },\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Selection — try SDK first, fall back to subprocess. Cached per process.\n// ---------------------------------------------------------------------------\n\ninterface SelectConnectorOptions {\n  forceReselect?: boolean;\n  agentSdk?: () => Promise<Connector>;\n  subprocess?: () => Connector;\n  probeSubprocess?: () => Promise<void>;\n  log?: (line: string) => void;\n}\n\nlet cachedConnector: Connector | null | undefined;\n\nexport async function selectConnector(\n  opts: SelectConnectorOptions = {},\n): Promise<Connector | null> {\n  if (!opts.forceReselect && cachedConnector !== undefined) {\n    return cachedConnector;\n  }\n\n  const log = opts.log ?? ((line: string) => console.log(line));\n  const buildAgentSdk = opts.agentSdk ?? (() => agentSdkConnector());\n  const buildSubprocess = opts.subprocess ?? (() => subprocessConnector());\n  const probe = opts.probeSubprocess ?? probeClaudeCli;\n\n  try {\n    cachedConnector = await buildAgentSdk();\n    log('[lesson-chat] using Agent SDK connector');\n    return cachedConnector;\n  } catch (err) {\n    log(\n      `[lesson-chat] Agent SDK unavailable, trying subprocess: ${\n        (err as Error).message\n      }`,\n    );\n  }\n\n  try {\n    await probe();\n    cachedConnector = buildSubprocess();\n    log('[lesson-chat] using subprocess connector');\n    return cachedConnector;\n  } catch (err) {\n    log(\n      `[lesson-chat] subprocess unavailable: ${(err as Error).message}`,\n    );\n    cachedConnector = null;\n    return null;\n  }\n}\n\nfunction probeClaudeCli(): Promise<void> {\n  return new Promise((resolve, reject) => {\n    let child: ChildProcess;\n    try {\n      child = spawn('claude', ['--version']);\n    } catch (err) {\n      reject(err as Error);\n      return;\n    }\n    let settled = false;\n    const settle = (fn: () => void) => {\n      if (settled) return;\n      settled = true;\n      fn();\n    };\n    const timer = setTimeout(() => {\n      try {\n        child.kill('SIGTERM');\n      } catch {\n        // ignore\n      }\n      settle(() => reject(new Error('claude --version timed out')));\n    }, 5_000);\n    child.on('error', (err: Error) => {\n      clearTimeout(timer);\n      settle(() => reject(err));\n    });\n    child.on('close', (code: number | null) => {\n      clearTimeout(timer);\n      if (code === 0) settle(() => resolve());\n      else settle(() => reject(new Error(`claude --version exited ${code}`)));\n    });\n  });\n}\n\nexport function _resetConnectorCacheForTesting(): void {\n  cachedConnector = undefined;\n}\n","numLines":356,"startLine":1,"totalLines":356}}}
