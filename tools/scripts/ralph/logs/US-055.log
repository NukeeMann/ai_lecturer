            if (msg.is_error) {\n              yield { type: 'error', message: 'Agent SDK returned is_error=true' };\n              return;\n            }\n            if (typeof msg.result === 'string') {\n              resultFallback = msg.result;\n            }\n          }\n        }\n      } catch (err) {\n        if (signal.aborted) return;\n        yield { type: 'error', message: (err as Error).message };\n        return;\n      }\n      if (!yieldedAny && resultFallback.length > 0) {\n        yield { type: 'token', text: resultFallback };\n        yieldedAny = true;\n      }\n      if (!yieldedAny) {\n        yield { type: 'error', message: 'Agent SDK stream produced no assistant text' };\n        return;\n      }\n      yield { type: 'done' };\n    },\n  };\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2005,"cache_read_input_tokens":91524,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2005},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"af09fd90-aa43-4e2e-8fd9-839962b1c817","uuid":"ab523a95-dbac-42a4-b0c8-fc7423794d87"}
