{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CRENaYdkdmioxENNWXMXMB","type":"tool_result","content":"1\t/**\n2\t * LessonChat prompt context builder.\n3\t *\n4\t * Given a lesson and (optionally) the active section the learner is reading,\n5\t * produces a small, focused context block + system prompt that the connector\n6\t * passes to Claude. We deliberately ship only the active section's body\n7\t * (theory markdown / quiz question+options / code task / etc.) rather than\n8\t * the full lesson, so prompts stay small and answers stay relevant.\n9\t *\n10\t * Total context is capped at ~CONTEXT_CHAR_LIMIT chars; if exceeded we\n11\t * truncate the active section's serialized body first and append\n12\t * '… [truncated]'.\n13\t */\n14\timport type { Lesson, Section } from '@/lib/schemas/lesson';\n15\t\n16\texport interface BuildPromptContextInput {\n17\t  lesson: Lesson;\n18\t  currentSectionId?: string;\n19\t}\n20\t\n21\texport interface BuildPromptContextResult {\n22\t  systemPrompt: string;\n23\t  contextBlock: string;\n24\t}\n25\t\n26\texport const SYSTEM_PROMPT =\n27\t  'You are an AI tutor for an interactive online course. Answer concisely (≤200 words unless code is needed). Stay focused on the lesson topic. If asked off-topic, redirect politely.';\n28\t\n29\texport const CONTEXT_CHAR_LIMIT = 4000;\n30\tconst TRUNCATION_SUFFIX = '… [truncated]';\n31\t\n32\texport function buildPromptContext(\n33\t  input: BuildPromptContextInput,\n34\t): BuildPromptContextResult {\n35\t  const { lesson, currentSectionId } = input;\n36\t\n37\t  const header = renderLessonHeader(lesson);\n38\t\n39\t  const activeSection =\n40\t    currentSectionId !== undefined\n41\t      ? lesson.sections.find((s) => s.id === currentSectionId) ?? null\n42\t      : null;\n43\t\n44\t  let body: string;\n45\t  if (activeSection) {\n46\t    body = renderActiveSection(activeSection);\n47\t  } else {\n48\t    body = renderLessonOutline(lesson);\n49\t  }\n50\t\n51\t  const assembled = `${header}\\n\\n${body}`;\n52\t  const contextBlock =\n53\t    assembled.length <= CONTEXT_CHAR_LIMIT\n54\t      ? assembled\n55\t      : truncateBody(header, body);\n56\t\n57\t  return { systemPrompt: SYSTEM_PROMPT, contextBlock };\n58\t}\n59\t\n60\tfunction renderLessonHeader(lesson: Lesson): string {\n61\t  const lines: string[] = [];\n62\t  lines.push(`Lesson title: ${lesson.title}`);\n63\t  lines.push(`Eyebrow: ${lesson.eyebrow}`);\n64\t  lines.push(`Description: ${lesson.description}`);\n65\t  lines.push(`Estimated minutes: ${lesson.estimatedMinutes}`);\n66\t  return lines.join('\\n');\n67\t}\n68\t\n69\tfunction renderLessonOutline(lesson: Lesson): string {\n70\t  const lines: string[] = ['Lesson outline:'];\n71\t  for (const s of lesson.sections) {\n72\t    lines.push(`- [${s.type}] ${s.title}`);\n73\t  }\n74\t  return lines.join('\\n');\n75\t}\n76\t\n77\tfunction renderActiveSection(section: Section): string {\n78\t  const head = `Active section (${section.type}): ${section.title}`;\n79\t  const body = serializeSectionBody(section);\n80\t  return body.length > 0 ? `${head}\\n${body}` : head;\n81\t}\n82\t\n83\tfunction serializeSectionBody(section: Section): string {\n84\t  switch (section.type) {\n85\t    case 'theory':\n86\t      return section.data.markdown;\n87\t    case 'quiz': {\n88\t      const options = section.data.options\n89\t        .map((opt, i) => `${i + 1}. ${opt}`)\n90\t        .join('\\n');\n91\t      return `Question: ${section.data.question}\\nOptions:\\n${options}`;\n92\t    }\n93\t    case 'code': {\n94\t      const parts: string[] = [];\n95\t      parts.push(`Task:\\n${section.data.taskMarkdown}`);\n96\t      if (section.data.starterCode) {\n97\t        parts.push(`Starter code:\\n${section.data.starterCode}`);\n98\t      }\n99\t      return parts.join('\\n\\n');\n100\t    }\n101\t    case 'codeCloze': {\n102\t      const parts: string[] = [];\n103\t      if (section.data.taskMarkdown) {\n104\t        parts.push(`Task:\\n${section.data.taskMarkdown}`);\n105\t      }\n106\t      parts.push(`Template:\\n${section.data.template}`);\n107\t      return parts.join('\\n\\n');\n108\t    }\n109\t    case 'sandbox':\n110\t      return `Starter code:\\n${section.data.starterCode}\\n\\nEncouragement: ${section.data.encouragement}`;\n111\t    case 'demo':\n112\t      return `Demo: ${section.data.demoType}`;\n113\t    case 'histogram':\n114\t      return `Histogram: ${section.data.counts.length} bins`;\n115\t    case 'plotImage': {\n116\t      const parts: string[] = [`Image: ${section.data.alt}`];\n117\t      if (section.data.caption) parts.push(`Caption: ${section.data.caption}`);\n118\t      return parts.join('\\n');\n119\t    }\n120\t    case 'parametricExplorer': {\n121\t      const params = section.data.params\n122\t        .map((p) => `- ${p.name} (${p.type})`)\n123\t        .join('\\n');\n124\t      return `Parametric explorer params:\\n${params}`;\n125\t    }\n126\t    case 'dragMatch': {\n127\t      const items = section.data.items.map((i) => `- ${i.label}`).join('\\n');\n128\t      const zones = section.data.zones.map((z) => `- ${z.label}`).join('\\n');\n129\t      return `Prompt: ${section.data.prompt}\\nItems:\\n${items}\\nZones:\\n${zones}`;\n130\t    }\n131\t    case 'dataTable': {\n132\t      const cols = section.data.columns.map((c) => c.label).join(', ');\n133\t      return `Columns: ${cols}\\nRows: ${section.data.rows.length}`;\n134\t    }\n135\t    case 'video': {\n136\t      const parts: string[] = [`Video (${section.data.kind}): ${section.data.src}`];\n137\t      if (section.data.title) parts.push(`Title: ${section.data.title}`);\n138\t      return parts.join('\\n');\n139\t    }\n140\t    case 'custom':\n141\t      return `Custom widget: ${JSON.stringify(section.data)}`;\n142\t    default: {\n143\t      const _exhaustive: never = section;\n144\t      void _exhaustive;\n145\t      return '';\n146\t    }\n147\t  }\n148\t}\n149\t\n150\tfunction truncateBody(header: string, body: string): string {\n151\t  const overhead = header.length + 2; // 2 = '\\n\\n'\n152\t  const suffixLen = TRUNCATION_SUFFIX.length;\n153\t  const budget = CONTEXT_CHAR_LIMIT - overhead - suffixLen;\n154\t  if (budget <= 0) {\n155\t    // Header alone already exceeds the cap; return header capped + suffix.\n156\t    const headerBudget = Math.max(0, CONTEXT_CHAR_LIMIT - suffixLen);\n157\t    return `${header.slice(0, headerBudget)}${TRUNCATION_SUFFIX}`;\n158\t  }\n159\t  const truncatedBody = body.slice(0, budget);\n160\t  return `${header}\\n\\n${truncatedBody}${TRUNCATION_SUFFIX}`;\n161\t}\n162\t"}]},"parent_tool_use_id":null,"session_id":"af09fd90-aa43-4e2e-8fd9-839962b1c817","uuid":"5479a8a0-99f8-4c95-aae5-19357bba8dc9","timestamp":"2026-05-04T06:49:45.653Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-055/src/lib/lessonChat/context.ts","content":"/**\n * LessonChat prompt context builder.\n *\n * Given a lesson and (optionally) the active section the learner is reading,\n * produces a small, focused context block + system prompt that the connector\n * passes to Claude. We deliberately ship only the active section's body\n * (theory markdown / quiz question+options / code task / etc.) rather than\n * the full lesson, so prompts stay small and answers stay relevant.\n *\n * Total context is capped at ~CONTEXT_CHAR_LIMIT chars; if exceeded we\n * truncate the active section's serialized body first and append\n * '… [truncated]'.\n */\nimport type { Lesson, Section } from '@/lib/schemas/lesson';\n\nexport interface BuildPromptContextInput {\n  lesson: Lesson;\n  currentSectionId?: string;\n}\n\nexport interface BuildPromptContextResult {\n  systemPrompt: string;\n  contextBlock: string;\n}\n\nexport const SYSTEM_PROMPT =\n  'You are an AI tutor for an interactive online course. Answer concisely (≤200 words unless code is needed). Stay focused on the lesson topic. If asked off-topic, redirect politely.';\n\nexport const CONTEXT_CHAR_LIMIT = 4000;\nconst TRUNCATION_SUFFIX = '… [truncated]';\n\nexport function buildPromptContext(\n  input: BuildPromptContextInput,\n): BuildPromptContextResult {\n  const { lesson, currentSectionId } = input;\n\n  const header = renderLessonHeader(lesson);\n\n  const activeSection =\n    currentSectionId !== undefined\n      ? lesson.sections.find((s) => s.id === currentSectionId) ?? null\n      : null;\n\n  let body: string;\n  if (activeSection) {\n    body = renderActiveSection(activeSection);\n  } else {\n    body = renderLessonOutline(lesson);\n  }\n\n  const assembled = `${header}\\n\\n${body}`;\n  const contextBlock =\n    assembled.length <= CONTEXT_CHAR_LIMIT\n      ? assembled\n      : truncateBody(header, body);\n\n  return { systemPrompt: SYSTEM_PROMPT, contextBlock };\n}\n\nfunction renderLessonHeader(lesson: Lesson): string {\n  const lines: string[] = [];\n  lines.push(`Lesson title: ${lesson.title}`);\n  lines.push(`Eyebrow: ${lesson.eyebrow}`);\n  lines.push(`Description: ${lesson.description}`);\n  lines.push(`Estimated minutes: ${lesson.estimatedMinutes}`);\n  return lines.join('\\n');\n}\n\nfunction renderLessonOutline(lesson: Lesson): string {\n  const lines: string[] = ['Lesson outline:'];\n  for (const s of lesson.sections) {\n    lines.push(`- [${s.type}] ${s.title}`);\n  }\n  return lines.join('\\n');\n}\n\nfunction renderActiveSection(section: Section): string {\n  const head = `Active section (${section.type}): ${section.title}`;\n  const body = serializeSectionBody(section);\n  return body.length > 0 ? `${head}\\n${body}` : head;\n}\n\nfunction serializeSectionBody(section: Section): string {\n  switch (section.type) {\n    case 'theory':\n      return section.data.markdown;\n    case 'quiz': {\n      const options = section.data.options\n        .map((opt, i) => `${i + 1}. ${opt}`)\n        .join('\\n');\n      return `Question: ${section.data.question}\\nOptions:\\n${options}`;\n    }\n    case 'code': {\n      const parts: string[] = [];\n      parts.push(`Task:\\n${section.data.taskMarkdown}`);\n      if (section.data.starterCode) {\n        parts.push(`Starter code:\\n${section.data.starterCode}`);\n      }\n      return parts.join('\\n\\n');\n    }\n    case 'codeCloze': {\n      const parts: string[] = [];\n      if (section.data.taskMarkdown) {\n        parts.push(`Task:\\n${section.data.taskMarkdown}`);\n      }\n      parts.push(`Template:\\n${section.data.template}`);\n      return parts.join('\\n\\n');\n    }\n    case 'sandbox':\n      return `Starter code:\\n${section.data.starterCode}\\n\\nEncouragement: ${section.data.encouragement}`;\n    case 'demo':\n      return `Demo: ${section.data.demoType}`;\n    case 'histogram':\n      return `Histogram: ${section.data.counts.length} bins`;\n    case 'plotImage': {\n      const parts: string[] = [`Image: ${section.data.alt}`];\n      if (section.data.caption) parts.push(`Caption: ${section.data.caption}`);\n      return parts.join('\\n');\n    }\n    case 'parametricExplorer': {\n      const params = section.data.params\n        .map((p) => `- ${p.name} (${p.type})`)\n        .join('\\n');\n      return `Parametric explorer params:\\n${params}`;\n    }\n    case 'dragMatch': {\n      const items = section.data.items.map((i) => `- ${i.label}`).join('\\n');\n      const zones = section.data.zones.map((z) => `- ${z.label}`).join('\\n');\n      return `Prompt: ${section.data.prompt}\\nItems:\\n${items}\\nZones:\\n${zones}`;\n    }\n    case 'dataTable': {\n      const cols = section.data.columns.map((c) => c.label).join(', ');\n      return `Columns: ${cols}\\nRows: ${section.data.rows.length}`;\n    }\n    case 'video': {\n      const parts: string[] = [`Video (${section.data.kind}): ${section.data.src}`];\n      if (section.data.title) parts.push(`Title: ${section.data.title}`);\n      return parts.join('\\n');\n    }\n    case 'custom':\n      return `Custom widget: ${JSON.stringify(section.data)}`;\n    default: {\n      const _exhaustive: never = section;\n      void _exhaustive;\n      return '';\n    }\n  }\n}\n\nfunction truncateBody(header: string, body: string): string {\n  const overhead = header.length + 2; // 2 = '\\n\\n'\n  const suffixLen = TRUNCATION_SUFFIX.length;\n  const budget = CONTEXT_CHAR_LIMIT - overhead - suffixLen;\n  if (budget <= 0) {\n    // Header alone already exceeds the cap; return header capped + suffix.\n    const headerBudget = Math.max(0, CONTEXT_CHAR_LIMIT - suffixLen);\n    return `${header.slice(0, headerBudget)}${TRUNCATION_SUFFIX}`;\n  }\n  const truncatedBody = body.slice(0, budget);\n  return `${header}\\n\\n${truncatedBody}${TRUNCATION_SUFFIX}`;\n}\n","numLines":162,"startLine":1,"totalLines":162}}}
