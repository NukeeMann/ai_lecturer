62\t      // eslint-disable-next-line react-hooks/set-state-in-effect\n63\t      setDraft(stored ?? '');\n64\t    } catch {\n65\t      // localStorage unavailable — start with empty draft.\n66\t    }\n67\t  }, [draftKey]);\n68\t\n69\t  // Debounced write of the draft to localStorage.\n70\t  useEffect(() => {\n71\t    if (debounceRef.current !== null) {\n72\t      window.clearTimeout(debounceRef.current);\n73\t    }\n74\t    debounceRef.current = window.setTimeout(() => {\n75\t      try {\n76\t        if (draft.length === 0) {\n77\t          window.localStorage.removeItem(draftKey);\n78\t        } else {\n79\t          window.localStorage.setItem(draftKey, draft);\n80\t        }\n81\t      } catch {\n82\t        // Persistence unavailable; in-memory draft still works.\n83\t      }\n84\t    }, DRAFT_DEBOUNCE_MS);\n85\t    return () => {\n86\t      if (debounceRef.current !== null) {\n87\t        window.clearTimeout(debounceRef.current);\n88\t        debounceRef.current = null;\n89\t      }\n90\t    };\n91\t  }, [draft, draftKey]);\n92\t\n93\t  // Autoresize the textarea: measure scrollHeight, clamp to MAX_LINES.\n94\t  useLayoutEffect(() => {\n95\t    const el = textareaRef.current;\n96\t    if (!el) return;\n97\t    el.style.height = 'auto';\n98\t    const maxHeight = LINE_HEIGHT_PX * MAX_LINES + TEXTAREA_VERTICAL_PADDING;\n99\t    const minHeight = LINE_HEIGHT_PX * MIN_LINES + TEXTAREA_VERTICAL_PADDING;\n100\t    const next = Math.max(\n101\t      minHeight,\n102\t      Math.min(maxHeight, el.scrollHeight),\n103\t    );\n104\t    el.style.height = `${next}px`;\n105\t    el.style.overflowY = el.scrollHeight > maxHeight ? 'auto' : 'hidden';\n106\t  }, [draft]);\n107\t\n108\t  // Auto-scroll to bottom when new messages land.\n109\t  useEffect(() => {\n110\t    const el = messagesRef.current;\n111\t    if (!el) return;\n112\t    el.scrollTop = el.scrollHeight;\n113\t  }, [messages.length]);\n114\t\n115\t  const trimmedDraft = draft.trim();\n116\t  const canSend = trimmedDraft.length > 0;\n117\t\n118\t  const handleSend = useCallback(() => {\n119\t    const text = draft.trim();\n120\t    if (text.length === 0) return;\n121\t    const userId = `m-${Date.now()}-u`;\n122\t    const assistantId = `m-${Date.now()}-a`;\n123\t    setMessages((prev) => [\n124\t      ...prev,\n125\t      { id: userId, role: 'user', text },\n126\t      { id: assistantId, role: 'assistant', text: PLACEHOLDER_ASSISTANT_TEXT },\n127\t    ]);\n128\t    setDraft('');\n129\t    try {\n130\t      window.localStorage.removeItem(draftKey);\n131\t    } catch {\n132\t      // ignore — draft already cleared from in-memory state\n133\t    }\n134\t  }, [draft, draftKey]);\n135\t\n136\t  const handleKeyDown = useCallback(\n137\t    (e: ReactKeyboardEvent<HTMLTextAreaElement>) => {\n138\t      const isMod = e.metaKey || e.ctrlKey;\n139\t      if (isMod && e.key === 'Enter') {\n140\t        e.preventDefault();\n141\t        handleSend();\n142\t      }\n143\t    },\n144\t    [handleSend],\n145\t  );\n146\t\n147\t  if (!open) {\n148\t    return (\n149\t      <aside\n150\t        data-testid=\"lesson-chat\"\n151\t        data-open=\"false\"\n152\t        aria-hidden\n153\t        style={asideHiddenStyle}\n154\t      />\n155\t    );\n156\t  }\n157\t\n158\t  return (\n159\t    <aside\n160\t      data-testid=\"lesson-chat\"\n161\t      data-open=\"true\"\n162\t      style={asideStyle}\n163\t    >\n164\t      <header style={headerStyle}>\n165\t        <h2 style={titleStyle}>AI Tutor</h2>\n166\t        <button\n167\t          type=\"button\"\n168\t          data-testid=\"lesson-chat-close\"\n169\t          aria-label=\"Close AI tutor panel\"\n170\t          onClick={onClose}\n171\t          style={closeBtnStyle}\n172\t        >\n173\t          <X size={16} strokeWidth={2} />\n174\t        </button>\n175\t      </header>\n176\t\n177\t      <div\n178\t        ref={messagesRef}\n179\t        data-testid=\"lesson-chat-messages\"\n180\t        style={messagesStyle}\n181\t      >\n182\t  