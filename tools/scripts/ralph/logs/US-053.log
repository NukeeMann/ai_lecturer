{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JSNzt7hcxDRoujRqd1RGtk","type":"tool_result","content":"1\timport { NextResponse } from 'next/server';\n2\timport { promises as fs } from 'node:fs';\n3\timport path from 'node:path';\n4\timport { CourseSchema } from '@/lib/schemas/course';\n5\timport { CourseSpecSchema } from '@/lib/schemas/courseSpec';\n6\timport { atomicWriteJson } from '@/lib/server/atomic';\n7\timport {\n8\t  InvalidSlugError,\n9\t  assertSafeSlug,\n10\t  courseDir,\n11\t  courseSpecFile,\n12\t  coursesRoot,\n13\t  slugify,\n14\t} from '@/lib/server/paths';\n15\t\n16\texport const dynamic = 'force-dynamic';\n17\t\n18\texport async function GET() {\n19\t  const root = coursesRoot();\n20\t  let entries: import('node:fs').Dirent[];\n21\t  try {\n22\t    entries = await fs.readdir(root, { withFileTypes: true });\n23\t  } catch (err) {\n24\t    if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n25\t      return NextResponse.json([]);\n26\t    }\n27\t    throw err;\n28\t  }\n29\t\n30\t  const courses = [];\n31\t  for (const entry of entries) {\n32\t    if (!entry.isDirectory()) continue;\n33\t    const file = path.join(root, entry.name, 'course.json');\n34\t    let raw: string;\n35\t    try {\n36\t      raw = await fs.readFile(file, 'utf8');\n37\t    } catch (err) {\n38\t      if ((err as NodeJS.ErrnoException).code === 'ENOENT') continue;\n39\t      console.warn(`Skipping course \"${entry.name}\": cannot read course.json`, err);\n40\t      continue;\n41\t    }\n42\t    try {\n43\t      const json: unknown = JSON.parse(raw);\n44\t      const parsed = CourseSchema.parse(json);\n45\t      courses.push(parsed);\n46\t    } catch (err) {\n47\t      console.warn(`Skipping invalid course \"${entry.name}\":`, err);\n48\t    }\n49\t  }\n50\t  return NextResponse.json(courses);\n51\t}\n52\t\n53\texport async function POST(req: Request) {\n54\t  let body: unknown;\n55\t  try {\n56\t    body = await req.json();\n57\t  } catch {\n58\t    return NextResponse.json({ error: 'Invalid JSON body' }, { status: 400 });\n59\t  }\n60\t\n61\t  const parsed = CourseSpecSchema.safeParse(body);\n62\t  if (!parsed.success) {\n63\t    return NextResponse.json(\n64\t      { error: 'Invalid CourseSpec', issues: parsed.error.issues },\n65\t      { status: 400 },\n66\t    );\n67\t  }\n68\t\n69\t  const slug = slugify(parsed.data.draftStructure.courseTitle);\n70\t  if (slug.length === 0) {\n71\t    return NextResponse.json(\n72\t      { error: 'Could not derive a slug from courseTitle' },\n73\t      { status: 400 },\n74\t    );\n75\t  }\n76\t\n77\t  let dir: string;\n78\t  try {\n79\t    assertSafeSlug(slug);\n80\t    dir = courseDir(slug);\n81\t  } catch (err) {\n82\t    if (err instanceof InvalidSlugError) {\n83\t      return NextResponse.json({ error: err.message }, { status: 400 });\n84\t    }\n85\t    throw err;\n86\t  }\n87\t\n88\t  try {\n89\t    await fs.access(dir);\n90\t    return NextResponse.json(\n91\t      { error: `Course slug \"${slug}\" already exists`, slug },\n92\t      { status: 409 },\n93\t    );\n94\t  } catch (err) {\n95\t    if ((err as NodeJS.ErrnoException).code !== 'ENOENT') throw err;\n96\t  }\n97\t\n98\t  await atomicWriteJson(courseSpecFile(slug), parsed.data);\n99\t  return NextResponse.json({ slug }, { status: 201 });\n100\t}\n101\t"}]},"parent_tool_use_id":null,"session_id":"f840741e-83c8-4e69-b8c8-f79977095ddb","uuid":"478b0c73-38ac-4e61-93d8-f4d21354eda6","timestamp":"2026-05-04T06:21:07.761Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-053/src/app/api/courses/route.ts","content":"import { NextResponse } from 'next/server';\nimport { promises as fs } from 'node:fs';\nimport path from 'node:path';\nimport { CourseSchema } from '@/lib/schemas/course';\nimport { CourseSpecSchema } from '@/lib/schemas/courseSpec';\nimport { atomicWriteJson } from '@/lib/server/atomic';\nimport {\n  InvalidSlugError,\n  assertSafeSlug,\n  courseDir,\n  courseSpecFile,\n  coursesRoot,\n  slugify,\n} from '@/lib/server/paths';\n\nexport const dynamic = 'force-dynamic';\n\nexport async function GET() {\n  const root = coursesRoot();\n  let entries: import('node:fs').Dirent[];\n  try {\n    entries = await fs.readdir(root, { withFileTypes: true });\n  } catch (err) {\n    if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n      return NextResponse.json([]);\n    }\n    throw err;\n  }\n\n  const courses = [];\n  for (const entry of entries) {\n    if (!entry.isDirectory()) continue;\n    const file = path.join(root, entry.name, 'course.json');\n    let raw: string;\n    try {\n      raw = await fs.readFile(file, 'utf8');\n    } catch (err) {\n      if ((err as NodeJS.ErrnoException).code === 'ENOENT') continue;\n      console.warn(`Skipping course \"${entry.name}\": cannot read course.json`, err);\n      continue;\n    }\n    try {\n      const json: unknown = JSON.parse(raw);\n      const parsed = CourseSchema.parse(json);\n      courses.push(parsed);\n    } catch (err) {\n      console.warn(`Skipping invalid course \"${entry.name}\":`, err);\n    }\n  }\n  return NextResponse.json(courses);\n}\n\nexport async function POST(req: Request) {\n  let body: unknown;\n  try {\n    body = await req.json();\n  } catch {\n    return NextResponse.json({ error: 'Invalid JSON body' }, { status: 400 });\n  }\n\n  const parsed = CourseSpecSchema.safeParse(body);\n  if (!parsed.success) {\n    return NextResponse.json(\n      { error: 'Invalid CourseSpec', issues: parsed.error.issues },\n      { status: 400 },\n    );\n  }\n\n  const slug = slugify(parsed.data.draftStructure.courseTitle);\n  if (slug.length === 0) {\n    return NextResponse.json(\n      { error: 'Could not derive a slug from courseTitle' },\n      { status: 400 },\n    );\n  }\n\n  let dir: string;\n  try {\n    assertSafeSlug(slug);\n    dir = courseDir(slug);\n  } catch (err) {\n    if (err instanceof InvalidSlugError) {\n      return NextResponse.json({ error: err.message }, { status: 400 });\n    }\n    throw err;\n  }\n\n  try {\n    await fs.access(dir);\n    return NextResponse.json(\n      { error: `Course slug \"${slug}\" already exists`, slug },\n      { status: 409 },\n    );\n  } catch (err) {\n    if ((err as NodeJS.ErrnoException).code !== 'ENOENT') throw err;\n  }\n\n  await atomicWriteJson(courseSpecFile(slug), parsed.data);\n  return NextResponse.json({ slug }, { status: 201 });\n}\n","numLines":101,"startLine":1,"totalLines":101}}}
