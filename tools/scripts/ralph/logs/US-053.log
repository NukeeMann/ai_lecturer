{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V4nj6Hi5XxVNANrhzVZujk","type":"tool_result","content":"1\timport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n2\timport { promises as fs } from 'node:fs';\n3\timport path from 'node:path';\n4\timport { tmpdir } from 'node:os';\n5\t\n6\timport { GET as listCourses, POST as postCourse } from '@/app/api/courses/route';\n7\timport {\n8\t  GET as getCourse,\n9\t  PUT as putCourse,\n10\t} from '@/app/api/courses/[slug]/route';\n11\timport {\n12\t  GET as getLesson,\n13\t  PUT as putLesson,\n14\t} from '@/app/api/courses/[slug]/lessons/[lessonSlug]/route';\n15\timport {\n16\t  GET as getAsset,\n17\t  PUT as putAsset,\n18\t} from '@/app/api/courses/[slug]/assets/[...path]/route';\n19\timport { atomicWriteJson } from '@/lib/server/atomic';\n20\timport { slugify } from '@/lib/server/paths';\n21\t\n22\tlet coursesRoot: string;\n23\t\n24\tconst sampleCourse = (slug: string) => ({\n25\t  slug,\n26\t  title: `Course ${slug}`,\n27\t  description: 'desc',\n28\t  accentColor: 'indigo' as const,\n29\t  icon: 'sigma',\n30\t  modules: [],\n31\t  createdAt: '2026-04-30T00:00:00Z',\n32\t  updatedAt: '2026-04-30T00:00:00Z',\n33\t});\n34\t\n35\tconst sampleLesson = (courseSlug: string, slug: string) => ({\n36\t  slug,\n37\t  courseSlug,\n38\t  moduleId: 'm1',\n39\t  title: 'Lesson',\n40\t  eyebrow: 'INTRO',\n41\t  description: 'd',\n42\t  estimatedMinutes: 5,\n43\t  sections: [\n44\t    { id: 's1', title: 'Read', type: 'theory' as const, data: { markdown: '# hi' } },\n45\t  ],\n46\t});\n47\t\n48\tconst sampleSpec = (title: string) => ({\n49\t  topic: 'whatever',\n50\t  level: 'beginner' as const,\n51\t  durationTarget: '1h' as const,\n52\t  theoryPracticeRatio: 0.5,\n53\t  draftStructure: {\n54\t    courseTitle: title,\n55\t    courseDescription: 'd',\n56\t    modules: [\n57\t      {\n58\t        title: 'M',\n59\t        lessons: [{ title: 'L', summary: 's', estimatedMinutes: 10 }],\n60\t      },\n61\t    ],\n62\t  },\n63\t  createdAt: '2026-04-30T00:00:00Z',\n64\t});\n65\t\n66\tconst writeCourseFile = async (slug: string, payload: unknown) => {\n67\t  const dir = path.join(coursesRoot, slug);\n68\t  await fs.mkdir(dir, { recursive: true });\n69\t  await fs.writeFile(path.join(dir, 'course.json'), JSON.stringify(payload), 'utf8');\n70\t};\n71\t\n72\tbeforeEach(async () => {\n73\t  coursesRoot = await fs.mkdtemp(path.join(tmpdir(), 'ai-lecturer-test-'));\n74\t  process.env.COURSES_ROOT_OVERRIDE = coursesRoot;\n75\t});\n76\t\n77\tafterEach(async () => {\n78\t  delete process.env.COURSES_ROOT_OVERRIDE;\n79\t  await fs.rm(coursesRoot, { recursive: true, force: true });\n80\t  vi.restoreAllMocks();\n81\t});\n82\t\n83\tdescribe('slugify', () => {\n84\t  it('lowercases and dasherizes', () => {\n85\t    expect(slugify('Hello World')).toBe('hello-world');\n86\t  });\n87\t  it('strips diacritics and special chars', () => {\n88\t    expect(slugify('Algebra Liniowa: część 1')).toBe('algebra-liniowa-czesc-1');\n89\t  });\n90\t  it('collapses repeated separators', () => {\n91\t    expect(slugify('  --foo___bar--  ')).toBe('foo-bar');\n92\t  });\n93\t});\n94\t\n95\tdescribe('GET /api/courses', () => {\n96\t  it('returns [] when courses dir does not exist', async () => {\n97\t    await fs.rm(coursesRoot, { recursive: true, force: true });\n98\t    const res = await listCourses();\n99\t    expect(res.status).toBe(200);\n100\t    expect(await res.json()).toEqual([]);\n101\t  });\n102\t\n103\t  it('returns [] when courses dir is empty', async () => {\n104\t    const res = await listCourses();\n105\t    expect(res.status).toBe(200);\n106\t    expect(await res.json()).toEqual([]);\n107\t  });\n108\t\n109\t  it('returns one course when exactly one exists', async () => {\n110\t    await writeCourseFile('algebra', sampleCourse('algebra'));\n111\t    const res = await listCourses();\n112\t    expect(res.status).toBe(200);\n113\t    const body = (await res.json()) as Array<{ slug: string }>;\n114\t    expect(body).toHaveLength(1);\n115\t    expect(body[0].slug).toBe('algebra');\n116\t  });\n117\t\n118\t  it('returns many courses when several exist', async () => {\n119\t    await writeCourseFile('a', sampleCourse('a'));\n120\t    await writeCourseFile('b', sampleCourse('b'));\n121\t    await writeCourseFile('c', sampleCourse('c'));\n122\t    const res = await listCourses();\n123\t    const body = (await res.json()) as Array<{ slug: string }>;\n124\t    expect(body.map((c) => c.slug).sort()).toEqual(['a', 'b', 'c']);\n125\t  });\n126\t\n127\t  it('skips invalid course.json with console.warn', async () => {\n128\t    const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});\n129\t    await writeCourseFile('good', sampleCourse('good'));\n130\t    await writeCourseFile('bad', { not: 'a course' });\n131\t    const res = await listCourses();\n132\t    const body = (await res.json()) as Array<{ slug: string }>;\n133\t    expect(body.map((c) => c.slug)).toEqual(['good']);\n134\t    expect(warn).toHaveBeenCalled();\n135\t  });\n136\t});\n137\t\n138\tdescribe('GET /api/courses/[slug]', () => {\n139\t  it('404 when missing', async () => {\n140\t    const res = await getCourse(new Request('http://x/api/courses/nope'), {\n141\t      params: Promise.resolve({ slug: 'nope' }),\n142\t    });\n143\t    expect(res.status).toBe(404);\n144\t  });\n145\t\n146\t  it('returns course when present', async () => {\n147\t    await writeCourseFile('algebra', sampleCourse('algebra'));\n148\t    const res = await getCourse(new Request('http://x/api/courses/algebra'), {\n149\t      params: Promise.resolve({ slug: 'algebra' }),\n150\t    });\n151\t    expect(res.status).toBe(200);\n152\t    expect(((await res.json()) as { slug: string }).slug).toBe('algebra');\n153\t  });\n154\t\n155\t  it('rejects path traversal in slug', async () => {\n156\t    const res = await getCourse(new Request('http://x/api/courses/..'), {\n157\t      params: Promise.resolve({ slug: '..' }),\n158\t    });\n159\t    expect(res.status).toBe(400);\n160\t    const res2 = await getCourse(new Request('http://x/api/courses/foo'), {\n161\t      params: Promise.resolve({ slug: 'foo/bar' }),\n162\t    });\n163\t    expect(res2.status).toBe(400);\n164\t  });\n165\t});\n166\t\n167\tdescribe('PUT /api/courses/[slug]', () => {\n168\t  it('writes a valid course atomically (no .tmp left on success)', async () => {\n169\t    const course = sampleCourse('algebra');\n170\t    const req = new Request('http://x/api/courses/algebra', {\n171\t      method: 'PUT',\n172\t      body: JSON.stringify(course),\n173\t      headers: { 'Content-Type': 'application/json' },\n174\t    });\n175\t    const res = await putCourse(req, { params: Promise.resolve({ slug: 'algebra' }) });\n176\t    expect(res.status).toBe(200);\n177\t\n178\t    const dir = path.join(coursesRoot, 'algebra');\n179\t    const files = await fs.readdir(dir);\n180\t    expect(files).toContain('course.json');\n181\t    expect(files.some((f) => f.endsWith('.tmp'))).toBe(false);\n182\t\n183\t    const written = JSON.parse(await fs.readFile(path.join(dir, 'course.json'), 'utf8')) as {\n184\t      slug: string;\n185\t    };\n186\t    expect(written.slug).toBe('algebra');\n187\t  });\n188\t\n189\t  it('returns 400 with Zod issues on schema rejection', async () => {\n190\t    const broken = { ...sampleCourse('algebra') } as Record<string, unknown>;\n191\t    delete broken.slug;\n192\t    const req = new Request('http://x/api/courses/algebra', {\n193\t      method: 'PUT',\n194\t      body: JSON.stringify(broken),\n195\t      headers: { 'Content-Type': 'application/json' },\n196\t    });\n197\t    const res = await putCourse(req, { params: Promise.resolve({ slug: 'algebra' }) });\n198\t    expect(res.status).toBe(400);\n199\t    const body = (await res.json()) as { issues: unknown[] };\n200\t    expect(Array.isArray(body.issues)).toBe(true);\n201\t    expect(body.issues.length).toBeGreaterThan(0);\n202\t  });\n203\t\n204\t  it('returns 400 when slug contains path-traversal chars', async () => {\n205\t    const req = new Request('http://x/api/courses/..', {\n206\t      method: 'PUT',\n207\t      body: JSON.stringify(sampleCourse('whatever')),\n208\t      headers: { 'Content-Type': 'application/json' },\n209\t    });\n210\t    const res = await putCourse(req, { params: Promise.resolve({ slug: '..' }) });\n211\t    expect(res.status).toBe(400);\n212\t  });\n213\t\n214\t  it('returns 400 on invalid JSON body', async () => {\n215\t    const req = new Request('http://x/api/courses/algebra', {\n216\t      method: 'PUT',\n217\t      body: '{not json',\n218\t      headers: { 'Content-Type': 'application/json' },\n219\t    });\n220\t    const res = await putCourse(req, { params: Promise.resolve({ slug: 'algebra' }) });\n221\t    expect(res.status).toBe(400);\n222\t  });\n223\t});\n224\t\n225\tdescribe('POST /api/courses', () => {\n226\t  it('creates a new course-spec.json under derived slug, 201', async () => {\n227\t    const req = new Request('http://x/api/courses', {\n228\t      method: 'POST',\n229\t      body: JSON.stringify(sampleSpec('My New Course')),\n230\t      headers: { 'Content-Type': 'application/json' },\n231\t    });\n232\t    const res = await postCourse(req);\n233\t    expect(res.status).toBe(201);\n234\t    const body = (await res.json()) as { slug: string };\n235\t    expect(body.slug).toBe('my-new-course');\n236\t    const file = path.join(coursesRoot, 'my-new-course', 'course-spec.json');\n237\t    const persisted = JSON.parse(await fs.readFile(file, 'utf8')) as {\n238\t      draftStructure: { courseTitle: string };\n239\t    };\n240\t    expect(persisted.draftStructure.courseTitle).toBe('My New Course');\n241\t  });\n242\t\n243\t  it('returns 409 on slug collision', async () => {\n244\t    await fs.mkdir(path.join(coursesRoot, 'taken'), { recursive: true });\n245\t    const req = new Request('http://x/api/courses', {\n246\t      method: 'POST',\n247\t      body: JSON.stringify(sampleSpec('Taken')),\n248\t      headers: { 'Content-Type': 'application/json' },\n249\t    });\n250\t    const res = await postCourse(req);\n251\t    expect(res.status).toBe(409);\n252\t  });\n253\t\n254\t  it('returns 400 on invalid CourseSpec', async () => {\n255\t    const req = new Request('http://x/api/courses', {\n256\t      method: 'POST',\n257\t      body: JSON.stringify({ not: 'a spec' }),\n258\t      headers: { 'Content-Type': 'application/json' },\n259\t    });\n260\t    const res = await postCourse(req);\n261\t    expect(res.status).toBe(400);\n262\t    const body = (await res.json()) as { issues: unknown[] };\n263\t    expect(Array.isArray(body.issues)).toBe(true);\n264\t  });\n265\t\n266\t  it('returns 400 when courseTitle slugifies to empty', async () => {\n267\t    const spec = sampleSpec('!@#$%^&*()');\n268\t    const req = new Request('http://x/api/courses', {\n269\t      method: 'POST',\n270\t      body: JSON.stringify(spec),\n271\t      headers: { 'Content-Type': 'application/json' },\n272\t    });\n273\t    const res = await postCourse(req);\n274\t    expect(res.status).toBe(400);\n275\t  });\n276\t});\n277\t\n278\tdescribe('GET /api/courses/[slug]/lessons/[lessonSlug]', () => {\n279\t  it('404 when missing', async () => {\n280\t    const res = await getLesson(\n281\t      new Request('http://x/api/courses/algebra/lessons/intro'),\n282\t      { params: Promise.resolve({ slug: 'algebra', lessonSlug: 'intro' }) },\n283\t    );\n284\t    expect(res.status).toBe(404);\n285\t  });\n286\t\n287\t  it('returns lesson when present', async () => {\n288\t    const lesson = sampleLesson('algebra', 'intro');\n289\t    await atomicWriteJson(\n290\t      path.join(coursesRoot, 'algebra', 'lessons', 'intro.json'),\n291\t      lesson,\n292\t    );\n293\t    const res = await getLesson(\n294\t      new Request('http://x/api/courses/algebra/lessons/intro'),\n295\t      { params: Promise.resolve({ slug: 'algebra', lessonSlug: 'intro' }) },\n296\t    );\n297\t    expect(res.status).toBe(200);\n298\t    expect(((await res.json()) as { slug: string }).slug).toBe('intro');\n299\t  });\n300\t\n301\t  it('rejects path traversal on either slug', async () => {\n302\t    const res1 = await getLesson(new Request('http://x/api/courses/../lessons/a'), {\n303\t      params: Promise.resolve({ slug: '..', lessonSlug: 'a' }),\n304\t    });\n305\t    expect(res1.status).toBe(400);\n306\t    const res2 = await getLesson(new Request('http://x/api/courses/a/lessons/..'), {\n307\t      params: Promise.resolve({ slug: 'a', lessonSlug: '..' }),\n308\t    });\n309\t    expect(res2.status).toBe(400);\n310\t    const res3 = await getLesson(new Request('http://x/api/courses/a/lessons/x'), {\n311\t      params: Promise.resolve({ slug: 'a', lessonSlug: 'b/c' }),\n312\t    });\n313\t    expect(res3.status).toBe(400);\n314\t  });\n315\t});\n316\t\n317\tdescribe('PUT /api/courses/[slug]/lessons/[lessonSlug]', () => {\n318\t  it('writes a valid lesson atomically (no .tmp left on success)', async () => {\n319\t    const lesson = sampleLesson('algebra', 'intro');\n320\t    const req = new Request('http://x/api/courses/algebra/lessons/intro', {\n321\t      method: 'PUT',\n322\t      body: JSON.stringify(lesson),\n323\t      headers: { 'Content-Type': 'application/json' },\n324\t    });\n325\t    const res = await putLesson(req, {\n326\t      params: Promise.resolve({ slug: 'algebra', lessonSlug: 'intro' }),\n327\t    });\n328\t    expect(res.status).toBe(200);\n329\t\n330\t    const dir = path.join(coursesRoot, 'algebra', 'lessons');\n331\t    const files = await fs.readdir(dir);\n332\t    expect(files).toContain('intro.json');\n333\t    expect(files.some((f) => f.endsWith('.tmp'))).toBe(false);\n334\t  });\n335\t\n336\t  it('returns 400 on schema rejection', async () => {\n337\t    const broken = { ...sampleLesson('algebra', 'intro') } as Record<string, unknown>;\n338\t    delete broken.title;\n339\t    const req = new Request('http://x/api/courses/algebra/lessons/intro', {\n340\t      method: 'PUT',\n341\t      body: JSON.stringify(broken),\n342\t      headers: { 'Content-Type': 'application/json' },\n343\t    });\n344\t    const res = await putLesson(req, {\n345\t      params: Promise.resolve({ slug: 'algebra', lessonSlug: 'intro' }),\n346\t    });\n347\t    expect(res.status).toBe(400);\n348\t  });\n349\t});\n350\t\n351\tdescribe('GET /api/courses/[slug]/assets/[...path]', () => {\n352\t  it('serves a png with the right Content-Type', async () => {\n353\t    const dir = path.join(coursesRoot, 'algebra', 'assets', 'plots');\n354\t    await fs.mkdir(dir, { recursive: true });\n355\t    // Minimal 1x1 PNG.\n356\t    const pngBytes = Buffer.from(\n357\t      '89504E470D0A1A0A0000000D49484452000000010000000108060000001F15C4890000000A49444154789C6300010000000500010D0A2DB40000000049454E44AE426082',\n358\t      'hex',\n359\t    );\n360\t    await fs.writeFile(path.join(dir, 'fig.png'), pngBytes);\n361\t\n362\t    const res = await getAsset(\n363\t      new Request('http://x/api/courses/algebra/assets/plots/fig.png'),\n364\t      { params: Promise.resolve({ slug: 'algebra', path: ['plots', 'fig.png'] }) },\n365\t    );\n366\t    expect(res.status).toBe(200);\n367\t    expect(res.headers.get('Content-Type')).toBe('image/png');\n368\t  });\n369\t\n370\t  it('returns 404 for a missing asset', async () => {\n371\t    const res = await getAsset(\n372\t      new Request('http://x/api/courses/algebra/assets/missing.png'),\n373\t      { params: Promise.resolve({ slug: 'algebra', path: ['missing.png'] }) },\n374\t    );\n375\t    expect(res.status).toBe(404);\n376\t  });\n377\t\n378\t  it('rejects ../ traversal in the asset path', async () => {\n379\t    const res = await getAsset(\n380\t      new Request('http://x/api/courses/algebra/assets/..'),\n381\t      { params: Promise.resolve({ slug: 'algebra', path: ['..'] }) },\n382\t    );\n383\t    expect(res.status).toBe(400);\n384\t\n385\t    const res2 = await getAsset(\n386\t      new Request('http://x/api/courses/algebra/assets/plots/..'),\n387\t      { params: Promise.resolve({ slug: 'algebra', path: ['plots', '..', 'secret.png'] }) },\n388\t    );\n389\t    expect(res2.status).toBe(400);\n390\t  });\n391\t\n392\t  it('rejects ../ traversal in the slug', async () => {\n393\t    const res = await getAsset(\n394\t      new Request('http://x/api/courses/../assets/x.png'),\n395\t      { params: Promise.resolve({ slug: '..', path: ['x.png'] }) },\n396\t    );\n397\t    expect(res.status).toBe(400);\n398\t  });\n399\t\n400\t  it('rejects path segments containing slashes', async () => {\n401\t    const res = await getAsset(\n402\t      new Request('http://x/api/courses/algebra/assets/foo'),\n403\t      { params: Promise.resolve({ slug: 'algebra', path: ['foo/bar'] }) },\n404\t    );\n405\t    expect(res.status).toBe(400);\n406\t  });\n407\t\n408\t  it('returns the right Content-Type for svg', async () => {\n409\t    const dir = path.join(coursesRoot, 'algebra', 'assets');\n410\t    await fs.mkdir(dir, { recursive: true });\n411\t    await fs.writeFile(path.join(dir, 'icon.svg'), '<svg/>', 'utf8');\n412\t    const res = await getAsset(\n413\t      new Request('http://x/api/courses/algebra/assets/icon.svg'),\n414\t      { params: Promise.resolve({ slug: 'algebra', path: ['icon.svg'] }) },\n415\t    );\n416\t    expect(res.status).toBe(200);\n417\t    expect(res.headers.get('Content-Type')).toBe('image/svg+xml');\n418\t  });\n419\t});\n420\t\n421\tdescribe('PUT /api/courses/[slug]/assets/[...path]', () => {\n422\t  it('writes an uploaded png under courses/<slug>/assets/...', async () => {\n423\t    const body = Buffer.from([0x89, 0x50, 0x4e, 0x47]);\n424\t    const req = new Request(\n425\t      'http://x/api/courses/algebra/assets/plots/up.png',\n426\t      { method: 'PUT', body, headers: { 'Content-Type': 'image/png' } },\n427\t    );\n428\t    const res = await putAsset(req, {\n429\t      params: Promise.resolve({ slug: 'algebra', path: ['plots', 'up.png'] }),\n430\t    });\n431\t    expect(res.status).toBe(200);\n432\t    const json = (await res.json()) as { src: string };\n433\t    expect(json.src).toBe('/api/courses/algebra/assets/plots/up.png');\n434\t\n435\t    const written = await fs.readFile(\n436\t      path.join(coursesRoot, 'algebra', 'assets', 'plots', 'up.png'),\n437\t    );\n438\t    expect(written.equals(body)).toBe(true);\n439\t  });\n440\t\n441\t  it('rejects unsupported extensions on PUT', async () => {\n442\t    const req = new Request(\n443\t      'http://x/api/courses/algebra/assets/plots/bad.exe',\n444\t      { method: 'PUT', body: Buffer.from('x') },\n445\t    );\n446\t    const res = await putAsset(req, {\n447\t      params: Promise.resolve({ slug: 'algebra', path: ['plots', 'bad.exe'] }),\n448\t    });\n449\t    expect(res.status).toBe(400);\n450\t  });\n451\t\n452\t  it('rejects ../ traversal on PUT', async () => {\n453\t    const req = new Request(\n454\t      'http://x/api/courses/algebra/assets/..',\n455\t      { method: 'PUT', body: Buffer.from('x'), headers: { 'Content-Type': 'image/png' } },\n456\t    );\n457\t    const res = await putAsset(req, {\n458\t      params: Promise.resolve({ slug: 'algebra', path: ['..', 'secret.png'] }),\n459\t    });\n460\t    expect(res.status).toBe(400);\n461\t  });\n462\t});\n463\t"}]},"parent_tool_use_id":null,"session_id":"f840741e-83c8-4e69-b8c8-f79977095ddb","uuid":"a4ae9ec4-4be8-4c21-9c3e-8e5353fb4845","timestamp":"2026-05-04T06:20:58.470Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-053/src/lib/server/api.test.ts","content":"import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\nimport { promises as fs } from 'node:fs';\nimport path from 'node:path';\nimport { tmpdir } from 'node:os';\n\nimport { GET as listCourses, POST as postCourse } from '@/app/api/courses/route';\nimport {\n  GET as getCourse,\n  PUT as putCourse,\n} from '@/app/api/courses/[slug]/route';\nimport {\n  GET as getLesson,\n  PUT as putLesson,\n} from '@/app/api/courses/[slug]/lessons/[lessonSlug]/route';\nimport {\n  GET as getAsset,\n  PUT as putAsset,\n} from '@/app/api/courses/[slug]/assets/[...path]/route';\nimport { atomicWriteJson } from '@/lib/server/atomic';\nimport { slugify } from '@/lib/server/paths';\n\nlet coursesRoot: string;\n\nconst sampleCourse = (slug: string) => ({\n  slug,\n  title: `Course ${slug}`,\n  description: 'desc',\n  accentColor: 'indigo' as const,\n  icon: 'sigma',\n  modules: [],\n  createdAt: '2026-04-30T00:00:00Z',\n  updatedAt: '2026-04-30T00:00:00Z',\n});\n\nconst sampleLesson = (courseSlug: string, slug: string) => ({\n  slug,\n  courseSlug,\n  moduleId: 'm1',\n  title: 'Lesson',\n  eyebrow: 'INTRO',\n  description: 'd',\n  estimatedMinutes: 5,\n  sections: [\n    { id: 's1', title: 'Read', type: 'theory' as const, data: { markdown: '# hi' } },\n  ],\n});\n\nconst sampleSpec = (title: string) => ({\n  topic: 'whatever',\n  level: 'beginner' as const,\n  durationTarget: '1h' as const,\n  theoryPracticeRatio: 0.5,\n  draftStructure: {\n    courseTitle: title,\n    courseDescription: 'd',\n    modules: [\n      {\n        title: 'M',\n        lessons: [{ title: 'L', summary: 's', estimatedMinutes: 10 }],\n      },\n    ],\n  },\n  createdAt: '2026-04-30T00:00:00Z',\n});\n\nconst writeCourseFile = async (slug: string, payload: unknown) => {\n  const dir = path.join(coursesRoot, slug);\n  await fs.mkdir(dir, { recursive: true });\n  await fs.writeFile(path.join(dir, 'course.json'), JSON.stringify(payload), 'utf8');\n};\n\nbeforeEach(async () => {\n  coursesRoot = await fs.mkdtemp(path.join(tmpdir(), 'ai-lecturer-test-'));\n  process.env.COURSES_ROOT_OVERRIDE = coursesRoot;\n});\n\nafterEach(async () => {\n  delete process.env.COURSES_ROOT_OVERRIDE;\n  await fs.rm(coursesRoot, { recursive: true, force: true });\n  vi.restoreAllMocks();\n});\n\ndescribe('slugify', () => {\n  it('lowercases and dasherizes', () => {\n    expect(slugify('Hello World')).toBe('hello-world');\n  });\n  it('strips diacritics and special chars', () => {\n    expect(slugify('Algebra Liniowa: część 1')).toBe('algebra-liniowa-czesc-1');\n  });\n  it('collapses repeated separators', () => {\n    expect(slugify('  --foo___bar--  ')).toBe('foo-bar');\n  });\n});\n\ndescribe('GET /api/courses', () => {\n  it('returns [] when courses dir does not exist', async () => {\n    await fs.rm(coursesRoot, { recursive: true, force: true });\n    const res = await listCourses();\n    expect(res.status).toBe(200);\n    expect(await res.json()).toEqual([]);\n  });\n\n  it('returns [] when courses dir is empty', async () => {\n    const res = await listCourses();\n    expect(res.status).toBe(200);\n    expect(await res.json()).toEqual([]);\n  });\n\n  it('returns one course when exactly one exists', async () => {\n    await writeCourseFile('algebra', sampleCourse('algebra'));\n    const res = await listCourses();\n    expect(res.status).toBe(200);\n    const body = (await res.json()) as Array<{ slug: string }>;\n    expect(body).toHaveLength(1);\n    expect(body[0].slug).toBe('algebra');\n  });\n\n  it('returns many courses when several exist', async () => {\n    await writeCourseFile('a', sampleCourse('a'));\n    await writeCourseFile('b', sampleCourse('b'));\n    await writeCourseFile('c', sampleCourse('c'));\n    const res = await listCourses();\n    const body = (await res.json()) as Array<{ slug: string }>;\n    expect(body.map((c) => c.slug).sort()).toEqual(['a', 'b', 'c']);\n  });\n\n  it('skips invalid course.json with console.warn', async () => {\n    const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});\n    await writeCourseFile('good', sampleCourse('good'));\n    await writeCourseFile('bad', { not: 'a course' });\n    const res = await listCourses();\n    const body = (await res.json()) as Array<{ slug: string }>;\n    expect(body.map((c) => c.slug)).toEqual(['good']);\n    expect(warn).toHaveBeenCalled();\n  });\n});\n\ndescribe('GET /api/courses/[slug]', () => {\n  it('404 when missing', async () => {\n    const res = await getCourse(new Request('http://x/api/courses/nope'), {\n      params: Promise.resolve({ slug: 'nope' }),\n    });\n    expect(res.status).toBe(404);\n  });\n\n  it('returns course when present', async () => {\n    await writeCourseFile('algebra', sampleCourse('algebra'));\n    const res = await getCourse(new Request('http://x/api/courses/algebra'), {\n      params: Promise.resolve({ slug: 'algebra' }),\n    });\n    expect(res.status).toBe(200);\n    expect(((await res.json()) as { slug: string }).slug).toBe('algebra');\n  });\n\n  it('rejects path traversal in slug', async () => {\n    const res = await getCourse(new Request('http://x/api/courses/..'), {\n      params: Promise.resolve({ slug: '..' }),\n    });\n    expect(res.status).toBe(400);\n    const res2 = await getCourse(new Request('http://x/api/courses/foo'), {\n      params: Promise.resolve({ slug: 'foo/bar' }),\n    });\n    expect(res2.status).toBe(400);\n  });\n});\n\ndescribe('PUT /api/courses/[slug]', () => {\n  it('writes a valid course atomically (no .tmp left on success)', async () => {\n    const course = sampleCourse('algebra');\n    const req = new Request('http://x/api/courses/algebra', {\n      method: 'PUT',\n      body: JSON.stringify(course),\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await putCourse(req, { params: Promise.resolve({ slug: 'algebra' }) });\n    expect(res.status).toBe(200);\n\n    const dir = path.join(coursesRoot, 'algebra');\n    const files = await fs.readdir(dir);\n    expect(files).toContain('course.json');\n    expect(files.some((f) => f.endsWith('.tmp'))).toBe(false);\n\n    const written = JSON.parse(await fs.readFile(path.join(dir, 'course.json'), 'utf8')) as {\n      slug: string;\n    };\n    expect(written.slug).toBe('algebra');\n  });\n\n  it('returns 400 with Zod issues on schema rejection', async () => {\n    const broken = { ...sampleCourse('algebra') } as Record<string, unknown>;\n    delete broken.slug;\n    const req = new Request('http://x/api/courses/algebra', {\n      method: 'PUT',\n      body: JSON.stringify(broken),\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await putCourse(req, { params: Promise.resolve({ slug: 'algebra' }) });\n    expect(res.status).toBe(400);\n    const body = (await res.json()) as { issues: unknown[] };\n    expect(Array.isArray(body.issues)).toBe(true);\n    expect(body.issues.length).toBeGreaterThan(0);\n  });\n\n  it('returns 400 when slug contains path-traversal chars', async () => {\n    const req = new Request('http://x/api/courses/..', {\n      method: 'PUT',\n      body: JSON.stringify(sampleCourse('whatever')),\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await putCourse(req, { params: Promise.resolve({ slug: '..' }) });\n    expect(res.status).toBe(400);\n  });\n\n  it('returns 400 on invalid JSON body', async () => {\n    const req = new Request('http://x/api/courses/algebra', {\n      method: 'PUT',\n      body: '{not json',\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await putCourse(req, { params: Promise.resolve({ slug: 'algebra' }) });\n    expect(res.status).toBe(400);\n  });\n});\n\ndescribe('POST /api/courses', () => {\n  it('creates a new course-spec.json under derived slug, 201', async () => {\n    const req = new Request('http://x/api/courses', {\n      method: 'POST',\n      body: JSON.stringify(sampleSpec('My New Course')),\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await postCourse(req);\n    expect(res.status).toBe(201);\n    const body = (await res.json()) as { slug: string };\n    expect(body.slug).toBe('my-new-course');\n    const file = path.join(coursesRoot, 'my-new-course', 'course-spec.json');\n    const persisted = JSON.parse(await fs.readFile(file, 'utf8')) as {\n      draftStructure: { courseTitle: string };\n    };\n    expect(persisted.draftStructure.courseTitle).toBe('My New Course');\n  });\n\n  it('returns 409 on slug collision', async () => {\n    await fs.mkdir(path.join(coursesRoot, 'taken'), { recursive: true });\n    const req = new Request('http://x/api/courses', {\n      method: 'POST',\n      body: JSON.stringify(sampleSpec('Taken')),\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await postCourse(req);\n    expect(res.status).toBe(409);\n  });\n\n  it('returns 400 on invalid CourseSpec', async () => {\n    const req = new Request('http://x/api/courses', {\n      method: 'POST',\n      body: JSON.stringify({ not: 'a spec' }),\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await postCourse(req);\n    expect(res.status).toBe(400);\n    const body = (await res.json()) as { issues: unknown[] };\n    expect(Array.isArray(body.issues)).toBe(true);\n  });\n\n  it('returns 400 when courseTitle slugifies to empty', async () => {\n    const spec = sampleSpec('!@#$%^&*()');\n    const req = new Request('http://x/api/courses', {\n      method: 'POST',\n      body: JSON.stringify(spec),\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await postCourse(req);\n    expect(res.status).toBe(400);\n  });\n});\n\ndescribe('GET /api/courses/[slug]/lessons/[lessonSlug]', () => {\n  it('404 when missing', async () => {\n    const res = await getLesson(\n      new Request('http://x/api/courses/algebra/lessons/intro'),\n      { params: Promise.resolve({ slug: 'algebra', lessonSlug: 'intro' }) },\n    );\n    expect(res.status).toBe(404);\n  });\n\n  it('returns lesson when present', async () => {\n    const lesson = sampleLesson('algebra', 'intro');\n    await atomicWriteJson(\n      path.join(coursesRoot, 'algebra', 'lessons', 'intro.json'),\n      lesson,\n    );\n    const res = await getLesson(\n      new Request('http://x/api/courses/algebra/lessons/intro'),\n      { params: Promise.resolve({ slug: 'algebra', lessonSlug: 'intro' }) },\n    );\n    expect(res.status).toBe(200);\n    expect(((await res.json()) as { slug: string }).slug).toBe('intro');\n  });\n\n  it('rejects path traversal on either slug', async () => {\n    const res1 = await getLesson(new Request('http://x/api/courses/../lessons/a'), {\n      params: Promise.resolve({ slug: '..', lessonSlug: 'a' }),\n    });\n    expect(res1.status).toBe(400);\n    const res2 = await getLesson(new Request('http://x/api/courses/a/lessons/..'), {\n      params: Promise.resolve({ slug: 'a', lessonSlug: '..' }),\n    });\n    expect(res2.status).toBe(400);\n    const res3 = await getLesson(new Request('http://x/api/courses/a/lessons/x'), {\n      params: Promise.resolve({ slug: 'a', lessonSlug: 'b/c' }),\n    });\n    expect(res3.status).toBe(400);\n  });\n});\n\ndescribe('PUT /api/courses/[slug]/lessons/[lessonSlug]', () => {\n  it('writes a valid lesson atomically (no .tmp left on success)', async () => {\n    const lesson = sampleLesson('algebra', 'intro');\n    const req = new Request('http://x/api/courses/algebra/lessons/intro', {\n      method: 'PUT',\n      body: JSON.stringify(lesson),\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await putLesson(req, {\n      params: Promise.resolve({ slug: 'algebra', lessonSlug: 'intro' }),\n    });\n    expect(res.status).toBe(200);\n\n    const dir = path.join(coursesRoot, 'algebra', 'lessons');\n    const files = await fs.readdir(dir);\n    expect(files).toContain('intro.json');\n    expect(files.some((f) => f.endsWith('.tmp'))).toBe(false);\n  });\n\n  it('returns 400 on schema rejection', async () => {\n    const broken = { ...sampleLesson('algebra', 'intro') } as Record<string, unknown>;\n    delete broken.title;\n    const req = new Request('http://x/api/courses/algebra/lessons/intro', {\n      method: 'PUT',\n      body: JSON.stringify(broken),\n      headers: { 'Content-Type': 'application/json' },\n    });\n    const res = await putLesson(req, {\n      params: Promise.resolve({ slug: 'algebra', lessonSlug: 'intro' }),\n    });\n    expect(res.status).toBe(400);\n  });\n});\n\ndescribe('GET /api/courses/[slug]/assets/[...path]', () => {\n  it('serves a png with the right Content-Type', async () => {\n    const dir = path.join(coursesRoot, 'algebra', 'assets', 'plots');\n    await fs.mkdir(dir, { recursive: true });\n    // Minimal 1x1 PNG.\n    const pngBytes = Buffer.from(\n      '89504E470D0A1A0A0000000D49484452000000010000000108060000001F15C4890000000A49444154789C6300010000000500010D0A2DB40000000049454E44AE426082',\n      'hex',\n    );\n    await fs.writeFile(path.join(dir, 'fig.png'), pngBytes);\n\n    const res = await getAsset(\n      new Request('http://x/api/courses/algebra/assets/plots/fig.png'),\n      { params: Promise.resolve({ slug: 'algebra', path: ['plots', 'fig.png'] }) },\n    );\n    expect(res.status).toBe(200);\n    expect(res.headers.get('Content-Type')).toBe('image/png');\n  });\n\n  it('returns 404 for a missing asset', async () => {\n    const res = await getAsset(\n      new Request('http://x/api/courses/algebra/assets/missing.png'),\n      { params: Promise.resolve({ slug: 'algebra', path: ['missing.png'] }) },\n    );\n    expect(res.status).toBe(404);\n  });\n\n  it('rejects ../ traversal in the asset path', async () => {\n    const res = await getAsset(\n      new Request('http://x/api/courses/algebra/assets/..'),\n      { params: Promise.resolve({ slug: 'algebra', path: ['..'] }) },\n    );\n    expect(res.status).toBe(400);\n\n    const res2 = await getAsset(\n      new Request('http://x/api/courses/algebra/assets/plots/..'),\n      { params: Promise.resolve({ slug: 'algebra', path: ['plots', '..', 'secret.png'] }) },\n    );\n    expect(res2.status).toBe(400);\n  });\n\n  it('rejects ../ traversal in the slug', async () => {\n    const res = await getAsset(\n      new Request('http://x/api/courses/../assets/x.png'),\n      { params: Promise.resolve({ slug: '..', path: ['x.png'] }) },\n    );\n    expect(res.status).toBe(400);\n  });\n\n  it('rejects path segments containing slashes', async () => {\n    const res = await getAsset(\n      new Request('http://x/api/courses/algebra/assets/foo'),\n      { params: Promise.resolve({ slug: 'algebra', path: ['foo/bar'] }) },\n    );\n    expect(res.status).toBe(400);\n  });\n\n  it('returns the right Content-Type for svg', async () => {\n    const dir = path.join(coursesRoot, 'algebra', 'assets');\n    await fs.mkdir(dir, { recursive: true });\n    await fs.writeFile(path.join(dir, 'icon.svg'), '<svg/>', 'utf8');\n    const res = await getAsset(\n      new Request('http://x/api/courses/algebra/assets/icon.svg'),\n      { params: Promise.resolve({ slug: 'algebra', path: ['icon.svg'] }) },\n    );\n    expect(res.status).toBe(200);\n    expect(res.headers.get('Content-Type')).toBe('image/svg+xml');\n  });\n});\n\ndescribe('PUT /api/courses/[slug]/assets/[...path]', () => {\n  it('writes an uploaded png under courses/<slug>/assets/...', async () => {\n    const body = Buffer.from([0x89, 0x50, 0x4e, 0x47]);\n    const req = new Request(\n      'http://x/api/courses/algebra/assets/plots/up.png',\n      { method: 'PUT', body, headers: { 'Content-Type': 'image/png' } },\n    );\n    const res = await putAsset(req, {\n      params: Promise.resolve({ slug: 'algebra', path: ['plots', 'up.png'] }),\n    });\n    expect(res.status).toBe(200);\n    const json = (await res.json()) as { src: string };\n    expect(json.src).toBe('/api/courses/algebra/assets/plots/up.png');\n\n    const written = await fs.readFile(\n      path.join(coursesRoot, 'algebra', 'assets', 'plots', 'up.png'),\n    );\n    expect(written.equals(body)).toBe(true);\n  });\n\n  it('rejects unsupported extensions on PUT', async () => {\n    const req = new Request(\n      'http://x/api/courses/algebra/assets/plots/bad.exe',\n      { method: 'PUT', body: Buffer.from('x') },\n    );\n    const res = await putAsset(req, {\n      params: Promise.resolve({ slug: 'algebra', path: ['plots', 'bad.exe'] }),\n    });\n    expect(res.status).toBe(400);\n  });\n\n  it('rejects ../ traversal on PUT', async () => {\n    const req = new Request(\n      'http://x/api/courses/algebra/assets/..',\n      { method: 'PUT', body: Buffer.from('x'), headers: { 'Content-Type': 'image/png' } },\n    );\n    const res = await putAsset(req, {\n      params: Promise.resolve({ slug: 'algebra', path: ['..', 'secret.png'] }),\n    });\n    expect(res.status).toBe(400);\n  });\n});\n","numLines":463,"startLine":1,"totalLines":463}}}
