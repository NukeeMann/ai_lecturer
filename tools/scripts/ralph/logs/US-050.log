{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jt1YHxWnvA6QWb59UeETUL","type":"tool_result","content":"1\timport { describe, expect, it } from 'vitest';\n2\t\n3\timport { CourseSchema } from '@/lib/schemas/course';\n4\timport { LessonSchema, SectionSchema } from '@/lib/schemas/lesson';\n5\timport { ProgressSchema } from '@/lib/schemas/progress';\n6\timport { CourseSpecSchema } from '@/lib/schemas/courseSpec';\n7\timport { TheoryDataSchema } from '@/widgets/Theory/schema';\n8\timport { QuizDataSchema } from '@/widgets/Quiz/schema';\n9\timport { CodeDataSchema } from '@/widgets/Code/schema';\n10\timport {\n11\t  CodeClozeDataSchema,\n12\t  validateSlotValue,\n13\t} from '@/widgets/CodeCloze/schema';\n14\timport { DemoDataSchema } from '@/widgets/Demo/schema';\n15\timport {\n16\t  DataTableDataSchema,\n17\t  filterRows,\n18\t  sortRows,\n19\t  type DataTableRow,\n20\t} from '@/widgets/DataTable/schema';\n21\timport {\n22\t  DragMatchDataSchema,\n23\t  validateDragMatch,\n24\t  type DragMatchData,\n25\t} from '@/widgets/DragMatch/schema';\n26\timport { SandboxDataSchema } from '@/widgets/Sandbox/schema';\n27\timport { ParametricExplorerDataSchema } from '@/widgets/ParametricExplorer/schema';\n28\timport { PlotImageDataSchema } from '@/widgets/PlotImage/schema';\n29\timport {\n30\t  VideoDataSchema,\n31\t  extractYouTubeId,\n32\t} from '@/widgets/Video/schema';\n33\t\n34\tdescribe('CourseSchema', () => {\n35\t  const minimal = {\n36\t    slug: 'algebra',\n37\t    title: 'Algebra',\n38\t    description: 'Intro to algebra',\n39\t    accentColor: 'indigo',\n40\t    icon: 'sigma',\n41\t    modules: [],\n42\t    createdAt: '2026-04-30T00:00:00Z',\n43\t    updatedAt: '2026-04-30T00:00:00Z',\n44\t  };\n45\t\n46\t  it('parses a minimal valid course', () => {\n47\t    expect(() => CourseSchema.parse(minimal)).not.toThrow();\n48\t  });\n49\t\n50\t  it('rejects an unknown accentColor', () => {\n51\t    expect(() => CourseSchema.parse({ ...minimal, accentColor: 'magenta' })).toThrow();\n52\t  });\n53\t\n54\t  it('throws on missing required field (slug)', () => {\n55\t    const broken: Partial<typeof minimal> = { ...minimal };\n56\t    delete broken.slug;\n57\t    expect(() => CourseSchema.parse(broken)).toThrow();\n58\t  });\n59\t\n60\t  it('defaults schemaVersion to 1 when missing', () => {\n61\t    const parsed = CourseSchema.parse(minimal);\n62\t    expect(parsed.schemaVersion).toBe(1);\n63\t  });\n64\t\n65\t  it('parses successfully when schemaVersion: 1 is present', () => {\n66\t    const parsed = CourseSchema.parse({ ...minimal, schemaVersion: 1 });\n67\t    expect(parsed.schemaVersion).toBe(1);\n68\t  });\n69\t});\n70\t\n71\tdescribe('LessonSchema + SectionSchema', () => {\n72\t  const lesson = {\n73\t    slug: 'lesson-1',\n74\t    courseSlug: 'algebra',\n75\t    moduleId: 'm1',\n76\t    title: 'First lesson',\n77\t    eyebrow: 'INTRO',\n78\t    description: 'A first lesson',\n79\t    estimatedMinutes: 10,\n80\t    sections: [\n81\t      { id: 's1', title: 'Read', type: 'theory', data: { markdown: '# hi' } },\n82\t    ],\n83\t  };\n84\t\n85\t  it('parses a minimal valid lesson', () => {\n86\t    expect(() => LessonSchema.parse(lesson)).not.toThrow();\n87\t  });\n88\t\n89\t  it('throws on missing required field (title)', () => {\n90\t    const broken: Partial<typeof lesson> = { ...lesson };\n91\t    delete broken.title;\n92\t    expect(() => LessonSchema.parse(broken)).toThrow();\n93\t  });\n94\t\n95\t  it('defaults schemaVersion to 1 when missing', () => {\n96\t    const parsed = LessonSchema.parse(lesson);\n97\t    expect(parsed.schemaVersion).toBe(1);\n98\t  });\n99\t\n100\t  it('parses successfully when schemaVersion: 1 is present', () => {\n101\t    const parsed = LessonSchema.parse({ ...lesson, schemaVersion: 1 });\n102\t    expect(parsed.schemaVersion).toBe(1);\n103\t  });\n104\t\n105\t  it('discriminated union accepts each known widget type', () => {\n106\t    const cases = [\n107\t      { id: 's1', title: 't', type: 'theory', data: { markdown: 'x' } },\n108\t      {\n109\t        id: 's2',\n110\t        title: 't',\n111\t        type: 'quiz',\n112\t        data: {\n113\t          question: 'q',\n114\t          options: ['a', 'b'],\n115\t          correct: [0],\n116\t          explanation: 'e',\n117\t          multiSelect: false,\n118\t        },\n119\t      },\n120\t      {\n121\t        id: 's3',\n122\t        title: 't',\n123\t        type: 'code',\n124\t        data: {\n125\t          taskMarkdown: 'do x',\n126\t          starterCode: 'pass',\n127\t          tests: [{ name: 't1', body: 'assert True' }],\n128\t        },\n129\t      },\n130\t      {\n131\t        id: 's4',\n132\t        title: 't',\n133\t        type: 'demo',\n134\t        data: {\n135\t          demoType: 'gauss',\n136\t          imageSrc: '/x.png',\n137\t          params: { sigmaMin: 0, sigmaMax: 5, sigmaDefault: 1 },\n138\t        },\n139\t      },\n140\t      {\n141\t        id: 's5',\n142\t        title: 't',\n143\t        type: 'sandbox',\n144\t        data: { starterCode: 'x = 1', encouragement: 'play' },\n145\t      },\n146\t      {\n147\t        id: 's6',\n148\t        title: 't',\n149\t        type: 'custom',\n150\t        data: { whatever: 1 },\n151\t      },\n152\t      {\n153\t        id: 's-cc',\n154\t        title: 't',\n155\t        type: 'codeCloze',\n156\t        data: {\n157\t          template: 'def f(): return {{x}}',\n158\t          slots: [\n159\t            { id: 'x', validation: { kind: 'exact', value: '42' } },\n160\t          ],\n161\t        },\n162\t      },\n163\t      {\n164\t        id: 's7',\n165\t        title: 't',\n166\t        type: 'parametricExplorer',\n167\t        data: {\n168\t          setupCode: '',\n169\t          renderCode: 'plt.plot([0, freq])',\n170\t          params: [\n171\t            {\n172\t              name: 'freq',\n173\t              label: 'Freq',\n174\t              type: 'slider',\n175\t              min: 0,\n176\t              max: 5,\n177\t              step: 0.1,\n178\t              default: 1,\n179\t            },\n180\t          ],\n181\t          outputType: 'plot',\n182\t        },\n183\t      },\n184\t      {\n185\t        id: 's-dm',\n186\t        title: 't',\n187\t        type: 'dragMatch',\n188\t        data: {\n189\t          prompt: 'Match each item.',\n190\t          items: [{ id: 'a', label: 'A' }],\n191\t          zones: [{ id: 'z', label: 'Z', accepts: ['a'] }],\n192\t        },\n193\t      },\n194\t      {\n195\t        id: 's-dt',\n196\t        title: 't',\n197\t        type: 'dataTable',\n198\t        data: {\n199\t          columns: [{ key: 'name', label: 'Name' }],\n200\t          rows: [{ name: 'Ada' }],\n201\t        },\n202\t      },\n203\t      {\n204\t        id: 's-vid',\n205\t        title: 't',\n206\t        type: 'video',\n207\t        data: { kind: 'youtube', src: 'aircAruvnKk' },\n208\t      },\n209\t    ];\n210\t    for (const section of cases) {\n211\t      expect(() => SectionSchema.parse(section)).not.toThrow();\n212\t    }\n213\t  });\n214\t\n215\t  it('discriminated union rejects an unknown widget type', () => {\n216\t    expect(() =>\n217\t      SectionSchema.parse({ id: 's', title: 't', type: 'mystery', data: {} }),\n218\t    ).toThrow();\n219\t  });\n220\t\n221\t  it('accepts lesson-level + section-level sources', () => {\n222\t    const lessonWithSources = {\n223\t      ...lesson,\n224\t      sources: [\n225\t        {\n226\t          url: 'https://example.com/a',\n227\t          title: 'A',\n228\t          kind: 'paper',\n229\t          author: 'A. Author',\n230\t          year: 2024,\n231\t        },\n232\t      ],\n233\t      sections: [\n234\t        {\n235\t          id: 's1',\n236\t          title: 'Read',\n237\t          type: 'theory',\n238\t          data: { markdown: '# hi' },\n239\t          sources: [\n240\t            { url: 'https://example.com/v', title: 'Vid', kind: 'video' },\n241\t          ],\n242\t        },\n243\t      ],\n244\t    };\n245\t    const parsed = LessonSchema.parse(lessonWithSources);\n246\t    expect(parsed.sources?.[0].kind).toBe('paper');\n247\t    expect(parsed.sections[0].sources?.[0].kind).toBe('video');\n248\t  });\n249\t\n250\t  it('rejects sources with an unknown kind', () => {\n251\t    const bad = {\n252\t      ...lesson,\n253\t      sources: [{ url: 'https://example.com', title: 'T', kind: 'tweet' }],\n254\t    };\n255\t    expect(() => LessonSchema.parse(bad)).toThrow();\n256\t  });\n257\t});\n258\t\n259\tdescribe('Per-widget data schemas', () => {\n260\t  it('TheoryData: parses minimal, rejects missing markdown', () => {\n261\t    expect(() => TheoryDataSchema.parse({ markdown: 'hi' })).not.toThrow();\n262\t    expect(() => TheoryDataSchema.parse({})).toThrow();\n263\t  });\n264\t\n265\t  it('QuizData: parses minimal, rejects missing question', () => {\n266\t    const ok = {\n267\t      question: 'q?',\n268\t      options: ['a', 'b'],\n269\t      correct: [0],\n270\t      explanation: 'because',\n271\t      multiSelect: false,\n272\t    };\n273\t    expect(() => QuizDataSchema.parse(ok)).not.toThrow();\n274\t    const broken: Partial<typeof ok> = { ...ok };\n275\t    delete broken.question;\n276\t    expect(() => QuizDataSchema.parse(broken)).toThrow();\n277\t  });\n278\t\n279\t  it('CodeData: defaults test.hidden to true when omitted', () => {\n280\t    const parsed = CodeDataSchema.parse({\n281\t      taskMarkdown: 'do x',\n282\t      starterCode: '',\n283\t      tests: [{ name: 't1', body: 'pass' }],\n284\t    });\n285\t    expect(parsed.tests[0].hidden).toBe(true);\n286\t  });\n287\t\n288\t  it('CodeData: rejects missing tests', () => {\n289\t    expect(() =>\n290\t      CodeDataSchema.parse({ taskMarkdown: 'm', starterCode: '' }),\n291\t    ).toThrow();\n292\t  });\n293\t\n294\t  it('DemoData: parses minimal, rejects missing imageSrc', () => {\n295\t    const ok = {\n296\t      demoType: 'gauss',\n297\t      imageSrc: '/x.png',\n298\t      params: { sigmaMin: 0, sigmaMax: 5, sigmaDefault: 1 },\n299\t    };\n300\t    expect(() => DemoDataSchema.parse(ok)).not.toThrow();\n301\t    const broken: Partial<typeof ok> = { ...ok };\n302\t    delete broken.imageSrc;\n303\t    expect(() => DemoDataSchema.parse(broken)).toThrow();\n304\t  });\n305\t\n306\t  it('SandboxData: parses minimal, rejects missing encouragement', () => {\n307\t    expect(() =>\n308\t      SandboxDataSchema.parse({ starterCode: 'x', encouragement: 'go' }),\n309\t    ).not.toThrow();\n310\t    expect(() => SandboxDataSchema.parse({ starterCode: 'x' })).toThrow();\n311\t  });\n312\t\n313\t  it('PlotImageData: parses a minimal valid object', () => {\n314\t    const ok = { src: '/foo.png', alt: 'A plot' };\n315\t    expect(() => PlotImageDataSchema.parse(ok)).not.toThrow();\n316\t  });\n317\t\n318\t  it('PlotImageData: parses with all optional fields', () => {\n319\t    const full = {\n320\t      src: '/x.png',\n321\t      alt: 'desc',\n322\t      caption: 'cap',\n323\t      sourceCode: 'plt.show()',\n324\t      sourceLanguage: 'python' as const,\n325\t    };\n326\t    const parsed = PlotImageDataSchema.parse(full);\n327\t    expect(parsed.sourceLanguage).toBe('python');\n328\t  });\n329\t\n330\t  it('PlotImageData: rejects missing src', () => {\n331\t    const broken = { alt: 'A plot' } as Record<string, unknown>;\n332\t    expect(() => PlotImageDataSchema.parse(broken)).toThrow();\n333\t  });\n334\t\n335\t  it('PlotImageData: rejects missing alt', () => {\n336\t    const broken = { src: '/foo.png' } as Record<string, unknown>;\n337\t    expect(() => PlotImageDataSchema.parse(broken)).toThrow();\n338\t  });\n339\t\n340\t  it('PlotImageData: rejects empty alt', () => {\n341\t    expect(() =>\n342\t      PlotImageDataSchema.parse({ src: '/foo.png', alt: '' }),\n343\t    ).toThrow();\n344\t  });\n345\t\n346\t  it('PlotImageData: rejects sourceLanguage outside the enum', () => {\n347\t    expect(() =>\n348\t      PlotImageDataSchema.parse({ src: '/x.png', alt: 'a', sourceLanguage: 'js' }),\n349\t    ).toThrow();\n350\t  });\n351\t\n352\t  it('VideoData: parses a minimal valid YouTube object', () => {\n353\t    const ok = { kind: 'youtube', src: 'aircAruvnKk' };\n354\t    const parsed = VideoDataSchema.parse(ok);\n355\t    expect(parsed.kind).toBe('youtube');\n356\t    expect(parsed.autoplay).toBe(false);\n357\t  });\n358\t\n359\t  it('VideoData: parses a minimal valid MP4 object', () => {\n360\t    const ok = { kind: 'mp4', src: '/api/courses/abc/assets/intro.mp4' };\n361\t    const parsed = VideoDataSchema.parse(ok);\n362\t    expect(parsed.kind).toBe('mp4');\n363\t    expect(parsed.autoplay).toBe(false);\n364\t  });\n365\t\n366\t  it('VideoData: parses with full transcript and optional fields', () => {\n367\t    const full = {\n368\t      kind: 'youtube',\n369\t      src: 'https://youtu.be/aircAruvnKk',\n370\t      title: 'Hello',\n371\t      durationSeconds: 600,\n372\t      autoplay: true,\n373\t      startAt: 30,\n374\t      transcript: [\n375\t        { tStart: 0, tEnd: 5, text: 'Intro', speaker: 'Grant' },\n376\t        { tStart: 5, text: 'Continuation' },\n377\t      ],\n378\t    };\n379\t    const parsed = VideoDataSchema.parse(full);\n380\t    expect(parsed.transcript).toHaveLength(2);\n381\t    expect(parsed.transcript?.[0].speaker).toBe('Grant');\n382\t    expect(parsed.transcript?.[1].tEnd).toBeUndefined();\n383\t  });\n384\t\n385\t  it('VideoData: rejects unknown kind', () => {\n386\t    expect(() =>\n387\t      VideoDataSchema.parse({ kind: 'webm', src: '/x.webm' }),\n388\t    ).toThrow();\n389\t  });\n390\t\n391\t  it('VideoData: rejects empty src', () => {\n392\t    expect(() =>\n393\t      VideoDataSchema.parse({ kind: 'mp4', src: '' }),\n394\t    ).toThrow();\n395\t  });\n396\t\n397\t  it('VideoData: rejects empty transcript text', () => {\n398\t    expect(() =>\n399\t      VideoDataSchema.parse({\n400\t        kind: 'mp4',\n401\t        src: '/x.mp4',\n402\t        transcript: [{ tStart: 0, text: '' }],\n403\t      }),\n404\t    ).toThrow();\n405\t  });\n406\t\n407\t  it('VideoData: rejects negative tStart', () => {\n408\t    expect(() =>\n409\t      VideoDataSchema.parse({\n410\t        kind: 'mp4',\n411\t        src: '/x.mp4',\n412\t        transcript: [{ tStart: -1, text: 'oops' }],\n413\t      }),\n414\t    ).toThrow();\n415\t  });\n416\t\n417\t  it('extractYouTubeId: returns the bare 11-char id unchanged', () => {\n418\t    expect(extractYouTubeId('aircAruvnKk')).toBe('aircAruvnKk');\n419\t    expect(extractYouTubeId('  aircAruvnKk  ')).toBe('aircAruvnKk');\n420\t  });\n421\t\n422\t  it('extractYouTubeId: parses youtu.be short links', () => {\n423\t    expect(extractYouTubeId('https://youtu.be/aircAruvnKk')).toBe('aircAruvnKk');\n424\t    expect(extractYouTubeId('https://youtu.be/aircAruvnKk?t=42')).toBe(\n425\t      'aircAruvnKk',\n426\t    );\n427\t  });\n428\t\n429\t  it('extractYouTubeId: parses watch?v= URLs', () => {\n430\t    expect(\n431\t      extractYouTubeId('https://www.youtube.com/watch?v=aircAruvnKk'),\n432\t    ).toBe('aircAruvnKk');\n433\t    expect(\n434\t      extractYouTubeId('https://m.youtube.com/watch?v=aircAruvnKk&t=10s'),\n435\t    ).toBe('aircAruvnKk');\n436\t  });\n437\t\n438\t  it('extractYouTubeId: parses /embed/ and /shorts/ URLs', () => {\n439\t    expect(\n440\t      extractYouTubeId('https://www.youtube.com/embed/aircAruvnKk'),\n441\t    ).toBe('aircAruvnKk');\n442\t    expect(\n443\t      extractYouTubeId('https://www.youtube.com/shorts/aircAruvnKk'),\n444\t    ).toBe('aircAruvnKk');\n445\t    expect(\n446\t      extractYouTubeId('https://www.youtube-nocookie.com/embed/aircAruvnKk'),\n447\t    ).toBe('aircAruvnKk');\n448\t  });\n449\t\n450\t  it('extractYouTubeId: returns null for non-YouTube URLs and bad input', () => {\n451\t    expect(extractYouTubeId('https://vimeo.com/123456')).toBeNull();\n452\t    expect(extractYouTubeId('not a url')).toBeNull();\n453\t    expect(extractYouTubeId('')).toBeNull();\n454\t    expect(extractYouTubeId('https://www.youtube.com/watch?v=tooShort')).toBeNull();\n455\t  });\n456\t\n457\t  it('ParametricExplorerData: parses a minimal valid object', () => {\n458\t    const ok = {\n459\t      setupCode: '',\n460\t      renderCode: 'plt.plot([0, freq])',\n461\t      params: [\n462\t        {\n463\t          name: 'freq',\n464\t          label: 'Freq',\n465\t          type: 'slider',\n466\t          min: 0,\n467\t          max: 5,\n468\t          step: 0.1,\n469\t          default: 1,\n470\t        },\n471\t      ],\n472\t      outputType: 'plot',\n473\t    };\n474\t    expect(() => ParametricExplorerDataSchema.parse(ok)).not.toThrow();\n475\t  });\n476\t\n477\t  it('ParametricExplorerData: parses select + toggle params', () => {\n478\t    const ok = {\n479\t      setupCode: '',\n480\t      renderCode: '',\n481\t      params: [\n482\t        { name: 'mode', label: 'Mode', type: 'select', options: ['a', 'b'], default: 'a' },\n483\t        { name: 'flag', label: 'Flag', type: 'toggle', default: true },\n484\t      ],\n485\t      outputType: 'value',\n486\t    };\n487\t    expect(() => ParametricExplorerDataSchema.parse(ok)).not.toThrow();\n488\t  });\n489\t\n490\t  it('ParametricExplorerData: rejects unknown outputType', () => {\n491\t    expect(() =>\n492\t      ParametricExplorerDataSchema.parse({\n493\t        setupCode: '',\n494\t        renderCode: '',\n495\t        params: [],\n496\t        outputType: 'png',\n497\t      }),\n498\t    ).toThrow();\n499\t  });\n500\t\n501\t  it('ParametricExplorerData: accepts optional debounceMs', () => {\n502\t    const parsed = ParametricExplorerDataSchema.parse({\n503\t      setupCode: '',\n504\t      renderCode: '',\n505\t      params: [],\n506\t      outputType: 'plot',\n507\t      debounceMs: 250,\n508\t    });\n509\t    expect(parsed.debounceMs).toBe(250);\n510\t  });\n511\t\n512\t  it('CodeClozeData: parses a minimal valid object', () => {\n513\t    const ok = {\n514\t      template: 'return {{x}}',\n515\t      slots: [{ id: 'x', validation: { kind: 'exact', value: '1' } }],\n516\t    };\n517\t    expect(() => CodeClozeDataSchema.parse(ok)).not.toThrow();\n518\t  });\n519\t\n520\t  it('CodeClozeData: parses with finalTests, hints, and per-slot hint', () => {\n521\t    const parsed = CodeClozeDataSchema.parse({\n522\t      taskMarkdown: 'Fill the blanks.',\n523\t      template: 'a = {{a}}; b = {{b}}',\n524\t      slots: [\n525\t        {\n526\t          id: 'a',\n527\t          hint: 'pick 1',\n528\t          validation: { kind: 'oneOf', values: ['1', 'one'] },\n529\t        },\n530\t        {\n531\t          id: 'b',\n532\t          validation: { kind: 'regex', pattern: '\\\\d+' },\n533\t        },\n534\t      ],\n535\t      finalTests: [{ name: 't', body: 'assert True' }],\n536\t      hints: [{ revealAfterAttempts: 2, markdown: 'try harder' }],\n537\t    });\n538\t    expect(parsed.finalTests?.[0].hidden).toBe(true);\n539\t    expect(parsed.slots[0].validation).toEqual({\n540\t      kind: 'oneOf',\n541\t      values: ['1', 'one'],\n542\t    });\n543\t  });\n544\t\n545\t  it('CodeClozeData: rejects unknown validation kind', () => {\n546\t    expect(() =>\n547\t      CodeClozeDataSchema.parse({\n548\t        template: '{{x}}',\n549\t        slots: [\n550\t          {\n551\t            id: 'x',\n552\t            validation: { kind: 'startsWith', value: 'a' },\n553\t          },\n554\t        ],\n555\t      }),\n556\t    ).toThrow();\n557\t  });\n558\t\n559\t  it('CodeClozeData: rejects oneOf with empty values array', () => {\n560\t    expect(() =>\n561\t      CodeClozeDataSchema.parse({\n562\t        template: '{{x}}',\n563\t        slots: [{ id: 'x', validation: { kind: 'oneOf', values: [] } }],\n564\t      }),\n565\t    ).toThrow();\n566\t  });\n567\t\n568\t  it('DragMatchData: parses a minimal valid object and defaults multipleItemsPerZone', () => {\n569\t    const ok = {\n570\t      prompt: 'Match each.',\n571\t      items: [{ id: 'a', label: 'A' }],\n572\t      zones: [{ id: 'z', label: 'Zone', accepts: ['a'] }],\n573\t    };\n574\t    const parsed = DragMatchDataSchema.parse(ok);\n575\t    expect(parsed.multipleItemsPerZone).toBe(false);\n576\t  });\n577\t\n578\t  it('DragMatchData: parses with explanation and multipleItemsPerZone=true', () => {\n579\t    const parsed = DragMatchDataSchema.parse({\n580\t      prompt: 'Order steps.',\n581\t      items: [\n582\t        { id: 'a', label: 'first' },\n583\t        { id: 'b', label: 'second' },\n584\t      ],\n585\t      zones: [{ id: 'order', label: 'Order', accepts: ['a', 'b'] }],\n586\t      multipleItemsPerZone: true,\n587\t      explanation: 'Steps in order.',\n588\t    });\n589\t    expect(parsed.multipleItemsPerZone).toBe(true);\n590\t    expect(parsed.explanation).toBe('Steps in order.');\n591\t  });\n592\t\n593\t  it('DragMatchData: rejects empty items array', () => {\n594\t    expect(() =>\n595\t      DragMatchDataSchema.parse({\n596\t        prompt: 'p',\n597\t        items: [],\n598\t        zones: [{ id: 'z', label: 'Z', accepts: [] }],\n599\t      }),\n600\t    ).toThrow();\n601\t  });\n602\t\n603\t  it('DragMatchData: rejects empty zones array', () => {\n604\t    expect(() =>\n605\t      DragMatchDataSchema.parse({\n606\t        prompt: 'p',\n607\t        items: [{ id: 'a', label: 'A' }],\n608\t        zones: [],\n609\t      }),\n610\t    ).toThrow();\n611\t  });\n612\t\n613\t  it('DragMatchData: rejects items with empty id or label', () => {\n614\t    expect(() =>\n615\t      DragMatchDataSchema.parse({\n616\t        prompt: 'p',\n617\t        items: [{ id: '', label: 'A' }],\n618\t        zones: [{ id: 'z', label: 'Z', accepts: [] }],\n619\t      }),\n620\t    ).toThrow();\n621\t  });\n622\t});\n623\t\n624\tdescribe('CodeCloze validateSlotValue', () => {\n625\t  it('exact: requires byte-for-byte equality', () => {\n626\t    expect(\n627\t      validateSlotValue({ kind: 'exact', value: 'sum' }, 'sum'),\n628\t    ).toBe(true);\n629\t    expect(\n630\t      validateSlotValue({ kind: 'exact', value: 'sum' }, 'Sum'),\n631\t    ).toBe(false);\n632\t    expect(\n633\t      validateSlotValue({ kind: 'exact', value: 'sum' }, ' sum'),\n634\t    ).toBe(false);\n635\t  });\n636\t\n637\t  it('oneOf: accepts any listed value', () => {\n638\t    const v = {\n639\t      kind: 'oneOf' as const,\n640\t      values: ['len(values)', '3'],\n641\t    };\n642\t    expect(validateSlotValue(v, 'len(values)')).toBe(true);\n643\t    expect(validateSlotValue(v, '3')).toBe(true);\n644\t    expect(validateSlotValue(v, '4')).toBe(false);\n645\t  });\n646\t\n647\t  it('regex: anchors implicitly (full match)', () => {\n648\t    const v = { kind: 'regex' as const, pattern: '\\\\d+' };\n649\t    expect(validateSlotValue(v, '123')).toBe(true);\n650\t    expect(validateSlotValue(v, '12a')).toBe(false);\n651\t    expect(validateSlotValue(v, '')).toBe(false);\n652\t  });\n653\t\n654\t  it('regex: invalid pattern returns false instead of throwing', () => {\n655\t    const v = { kind: 'regex' as const, pattern: '(' };\n656\t    expect(validateSlotValue(v, 'x')).toBe(false);\n657\t  });\n658\t});\n659\t\n660\tdescribe('DragMatch validateDragMatch', () => {\n661\t  const singleZoneData: DragMatchData = {\n662\t    prompt: 'Match each programming term.',\n663\t    items: [\n664\t      { id: 'i-var', label: 'Variable' },\n665\t      { id: 'i-fn', label: 'Function' },\n666\t      { id: 'i-loop', label: 'Loop' },\n667\t    ],\n668\t    zones: [\n669\t      { id: 'z-var', label: 'Storage', accepts: ['i-var'] },\n670\t      { id: 'z-fn', label: 'Reusable code', accepts: ['i-fn'] },\n671\t      { id: 'z-loop', label: 'Repeats', accepts: ['i-loop'] },\n672\t    ],\n673\t    multipleItemsPerZone: false,\n674\t  };\n675\t\n676\t  it('single-zone: all items in correct zones is allCorrect', () => {\n677\t    const result = validateDragMatch(singleZoneData, {\n678\t      'z-var': ['i-var'],\n679\t      'z-fn': ['i-fn'],\n680\t      'z-loop': ['i-loop'],\n681\t      __bank__: [],\n682\t    });\n683\t    expect(result.allCorrect).toBe(true);\n684\t    expect(result.zoneCorrect['z-var']).toBe(true);\n685\t    expect(result.misplacedItemIds.size).toBe(0);\n686\t  });\n687\t\n688\t  it('single-zone: one swapped pair flags exactly two misplaced items', () => {\n689\t    const result = validateDragMatch(singleZoneData, {\n690\t      'z-var': ['i-fn'],\n691\t      'z-fn': ['i-var'],\n692\t      'z-loop': ['i-loop'],\n693\t      __bank__: [],\n694\t    });\n695\t    expect(result.allCorrect).toBe(false);\n696\t    expect(result.zoneCorrect['z-var']).toBe(false);\n697\t    expect(result.zoneCorrect['z-fn']).toBe(false);\n698\t    expect(result.zoneCorrect['z-loop']).toBe(true);\n699\t    expect(result.misplacedItemIds.has('i-var')).toBe(true);\n700\t    expect(result.misplacedItemIds.has('i-fn')).toBe(true);\n701\t    expect(result.misplacedItemIds.has('i-loop')).toBe(false);\n702\t  });\n703\t\n704\t  it('single-zone: item left in bank is misplaced and zone is empty/incorrect', () => {\n705\t    const result = validateDragMatch(singleZoneData, {\n706\t      'z-var': ['i-var'],\n707\t      'z-fn': ['i-fn'],\n708\t      'z-loop': [],\n709\t      __bank__: ['i-loop'],\n710\t    });\n711\t    expect(result.allCorrect).toBe(false);\n712\t    expect(result.zoneCorrect['z-loop']).toBe(false);\n713\t    expect(result.misplacedItemIds.has('i-loop')).toBe(true);\n714\t  });\n715\t\n716\t  const multiZoneData: DragMatchData = {\n717\t    prompt: 'Group fruits and vegetables.',\n718\t    items: [\n719\t      { id: 'apple', label: 'Apple' },\n720\t      { id: 'banana', label: 'Banana' },\n721\t      { id: 'carrot', label: 'Carrot' },\n722\t    ],\n723\t    zones: [\n724\t      { id: 'fruit', label: 'Fruit', accepts: ['apple', 'banana'] },\n725\t      { id: 'veg', label: 'Vegetable', accepts: ['carrot'] },\n726\t    ],\n727\t    multipleItemsPerZone: true,\n728\t  };\n729\t\n730\t  it('multi-zone (ordered): exact accepts order is correct', () => {\n731\t    const result = validateDragMatch(multiZoneData, {\n732\t      fruit: ['apple', 'banana'],\n733\t      veg: ['carrot'],\n734\t      __bank__: [],\n735\t    });\n736\t    expect(result.allCorrect).toBe(true);\n737\t  });\n738\t\n739\t  it('multi-zone (ordered): wrong order in zone is incorrect', () => {\n740\t    const result = validateDragMatch(multiZoneData, {\n741\t      fruit: ['banana', 'apple'],\n742\t      veg: ['carrot'],\n743\t      __bank__: [],\n744\t    });\n745\t    expect(result.allCorrect).toBe(false);\n746\t    expect(result.zoneCorrect['fruit']).toBe(false);\n747\t    expect(result.zoneCorrect['veg']).toBe(true);\n748\t  });\n749\t\n750\t  it('multi-zone (ordered): missing one item in zone is incorrect', () => {\n751\t    const result = validateDragMatch(multiZoneData, {\n752\t      fruit: ['apple'],\n753\t      veg: ['carrot'],\n754\t      __bank__: ['banana'],\n755\t    });\n756\t    expect(result.allCorrect).toBe(false);\n757\t    expect(result.zoneCorrect['fruit']).toBe(false);\n758\t    expect(result.misplacedItemIds.has('banana')).toBe(true);\n759\t  });\n760\t\n761\t  it('multi-zone (unordered, multipleItemsPerZone=false): set equality wins', () => {\n762\t    const data: DragMatchData = { ...multiZoneData, multipleItemsPerZone: false };\n763\t    const result = validateDragMatch(data, {\n764\t      fruit: ['banana', 'apple'],\n765\t      veg: ['carrot'],\n766\t      __bank__: [],\n767\t    });\n768\t    expect(result.allCorrect).toBe(true);\n769\t  });\n770\t});\n771\t\n772\tdescribe('DataTableData schema', () => {\n773\t  it('parses a minimal valid object and applies pageSize default', () => {\n774\t    const parsed = DataTableDataSchema.parse({\n775\t      columns: [{ key: 'name', label: 'Name' }],\n776\t      rows: [{ name: 'Ada' }],\n777\t    });\n778\t    expect(parsed.pageSize).toBe(25);\n779\t    expect(parsed.columns[0].type).toBe('string');\n780\t    expect(parsed.columns[0].sortable).toBe(true);\n781\t    expect(parsed.columns[0].filterable).toBe(false);\n782\t  });\n783\t\n784\t  it('rejects empty columns array', () => {\n785\t    expect(() =>\n786\t      DataTableDataSchema.parse({ columns: [], rows: [] }),\n787\t    ).toThrow();\n788\t  });\n789\t\n790\t  it('rejects non-positive pageSize', () => {\n791\t    expect(() =>\n792\t      DataTableDataSchema.parse({\n793\t        columns: [{ key: 'a', label: 'A' }],\n794\t        rows: [],\n795\t        pageSize: 0,\n796\t      }),\n797\t    ).toThrow();\n798\t  });\n799\t\n800\t  it('accepts initialSort with key + dir', () => {\n801\t    const parsed = DataTableDataSchema.parse({\n802\t      columns: [{ key: 'a', label: 'A' }],\n803\t      rows: [],\n804\t      initialSort: { key: 'a', dir: 'desc' },\n805\t    });\n806\t    expect(parsed.initialSort?.dir).toBe('desc');\n807\t  });\n808\t\n809\t  it('rejects initialSort with unknown direction', () => {\n810\t    expect(() =>\n811\t      DataTableDataSchema.parse({\n812\t        columns: [{ key: 'a', label: 'A' }],\n813\t        rows: [],\n814\t        initialSort: { key: 'a', dir: 'sideways' },\n815\t      }),\n816\t    ).toThrow();\n817\t  });\n818\t\n819\t  it('accepts row cells of mixed primitive types and null', () => {\n820\t    const parsed = DataTableDataSchema.parse({\n821\t      columns: [\n822\t        { key: 'name', label: 'Name', type: 'string' },\n823\t        { key: 'score', label: 'Score', type: 'number' },\n824\t        { key: 'passed', label: 'Passed', type: 'boolean' },\n825\t      ],\n826\t      rows: [\n827\t        { name: 'Ada', score: 92, passed: true },\n828\t        { name: 'Linus', score: null, passed: false },\n829\t      ],\n830\t    });\n831\t    expect(parsed.rows.length).toBe(2);\n832\t  });\n833\t});\n834\t\n835\tdescribe('DataTable sortRows', () => {\n836\t  const columns = [\n837\t    { key: 'name', label: 'Name', type: 'string' as const, sortable: true, filterable: false },\n838\t    { key: 'score', label: 'Score', type: 'number' as const, sortable: true, filterable: false },\n839\t  ];\n840\t  const rows: DataTableRow[] = [\n841\t    { name: 'Bob', score: 10 },\n842\t    { name: 'Alice', score: 30 },\n843\t    { name: 'Cara', score: 20 },\n844\t  ];\n845\t\n846\t  it('returns rows in original order when sort is null', () => {\n847\t    const result = sortRows({ rows, sort: null, columns });\n848\t    expect(result.map((r) => r.name)).toEqual(['Bob', 'Alice', 'Cara']);\n849\t  });\n850\t\n851\t  it('sorts ascending by string', () => {\n852\t    const result = sortRows({ rows, sort: { key: 'name', dir: 'asc' }, columns });\n853\t    expect(result.map((r) => r.name)).toEqual(['Alice', 'Bob', 'Cara']);\n854\t  });\n855\t\n856\t  it('sorts descending by number', () => {\n857\t    const result = sortRows({ rows, sort: { key: 'score', dir: 'desc' }, columns });\n858\t    expect(result.map((r) => r.score)).toEqual([30, 20, 10]);\n859\t  });\n860\t\n861\t  it('sorts ascending by number', () => {\n862\t    const result = sortRows({ rows, sort: { key: 'score', dir: 'asc' }, columns });\n863\t    expect(result.map((r) => r.score)).toEqual([10, 20, 30]);\n864\t  });\n865\t\n866\t  it('null/undefined cells sort to the end', () => {\n867\t    const sparse: DataTableRow[] = [\n868\t      { name: 'A', score: 10 },\n869\t      { name: 'B', score: null },\n870\t      { name: 'C', score: 5 },\n871\t    ];\n872\t    const asc = sortRows({ rows: sparse, sort: { key: 'score', dir: 'asc' }, columns });\n873\t    expect(asc.map((r) => r.name)).toEqual(['C', 'A', 'B']);\n874\t  });\n875\t\n876\t  it('does not mutate the input array', () => {\n877\t    const original = rows.slice();\n878\t    sortRows({ rows, sort: { key: 'name', dir: 'desc' }, columns });\n879\t    expect(rows).toEqual(original);\n880\t  });\n881\t});\n882\t\n883\tdescribe('DataTable filterRows', () => {\n884\t  const columns = [\n885\t    { key: 'name', label: 'Name', type: 'string' as const, sortable: true, filterable: true },\n886\t    { key: 'score', label: 'Score', type: 'number' as const, sortable: true, filterable: true },\n887\t    { key: 'tag', label: 'Tag', type: 'string' as const, sortable: true, filterable: false },\n888\t  ];\n889\t  const rows: DataTableRow[] = [\n890\t    { name: 'Alice', score: 80, tag: 'gold' },\n891\t    { name: 'Bob', score: 60, tag: 'silver' },\n892\t    { name: 'Bobby', score: 95, tag: 'gold' },\n893\t    { name: 'Cara', score: 40, tag: 'bronze' },\n894\t  ];\n895\t\n896\t  it('string contains filter is case-insensitive', () => {\n897\t    const result = filterRows({\n898\t      rows,\n899\t      filters: { name: 'bob' },\n900\t      columns,\n901\t    });\n902\t    expect(result.map((r) => r.name)).toEqual(['Bob', 'Bobby']);\n903\t  });\n904\t\n905\t  it('number range filter respects both bounds', () => {\n906\t    const result = filterRows({\n907\t      rows,\n908\t      filters: { score: { min: 50, max: 90 } },\n909\t      columns,\n910\t    });\n911\t    expect(result.map((r) => r.name)).toEqual(['Alice', 'Bob']);\n912\t  });\n913\t\n914\t  it('number range filter accepts only min', () => {\n915\t    const result = filterRows({\n916\t      rows,\n917\t      filters: { score: { min: 70 } },\n918\t      columns,\n919\t    });\n920\t    expect(result.map((r) => r.name)).toEqual(['Alice', 'Bobby']);\n921\t  });\n922\t\n923\t  it('number range filter accepts only max', () => {\n924\t    const result = filterRows({\n925\t      rows,\n926\t      filters: { score: { max: 60 } },\n927\t      columns,\n928\t    });\n929\t    expect(result.map((r) => r.name)).toEqual(['Bob', 'Cara']);\n930\t  });\n931\t\n932\t  it('combines multiple column filters with AND', () => {\n933\t    const result = filterRows({\n934\t      rows,\n935\t      filters: { name: 'bob', score: { min: 70 } },\n936\t      columns,\n937\t    });\n938\t    expect(result.map((r) => r.name)).toEqual(['Bobby']);\n939\t  });\n940\t\n941\t  it('ignores filters on non-filterable columns', () => {\n942\t    const result = filterRows({\n943\t      rows,\n944\t      filters: { tag: 'gold' },\n945\t      columns,\n946\t    });\n947\t    expect(result.length).toBe(rows.length);\n948\t  });\n949\t\n950\t  it('empty/undefined filter values pass through every row', () => {\n951\t    const result = filterRows({\n952\t      rows,\n953\t      filters: { name: '', score: {} },\n954\t      columns,\n955\t    });\n956\t    expect(result.length).toBe(rows.length);\n957\t  });\n958\t});\n959\t\n960\tdescribe('ParametricExplorer param value serialization', () => {\n961\t  // Param values are passed to Pyodide as a plain JS object — Pyodide's\n962\t  // automatic JS↔Python conversion turns:\n963\t  //   number → float, boolean → bool, string → str\n964\t  // These tests pin the serialized shape that the worker forwards to Python\n965\t  // so a future refactor doesn't silently change types under the user's code.\n966\t  it('slider param serializes as a JS number (→ Python float)', () => {\n967\t    const params: Record<string, number | string | boolean> = { freq: 1.5 };\n968\t    expect(typeof params.freq).toBe('number');\n969\t    expect(Number.isFinite(params.freq as number)).toBe(true);\n970\t  });\n971\t\n972\t  it('toggle param serializes as a JS boolean (→ Python bool)', () => {\n973\t    const params: Record<string, number | string | boolean> = { on: true };\n974\t    expect(typeof params.on).toBe('boolean');\n975\t    expect(params.on).toBe(true);\n976\t  });\n977\t\n978\t  it('select param serializes as a JS string (→ Python str)', () => {\n979\t    const params: Record<string, number | string | boolean> = { mode: 'fast' };\n980\t    expect(typeof params.mode).toBe('string');\n981\t    expect(params.mode).toBe('fast');\n982\t  });\n983\t\n984\t  it('mixed params object preserves each per-param type', () => {\n985\t    const params: Record<string, number | string | boolean> = {\n986\t      freq: 2,\n987\t      mode: 'fast',\n988\t      on: false,\n989\t    };\n990\t    expect(typeof params.freq).toBe('number');\n991\t    expect(typeof params.mode).toBe('string');\n992\t    expect(typeof params.on).toBe('boolean');\n993\t  });\n994\t});\n995\t\n996\tdescribe('ProgressSchema', () => {\n997\t  const minimal = { courses: {} };\n998\t\n999\t  it('parses an empty progress object', () => {\n1000\t    expect(() => ProgressSchema.parse(minimal)).not.toThrow();\n1001\t  });\n1002\t\n1003\t  it('parses nested course/lesson progress', () => {\n1004\t    const ok = {\n1005\t      courses: {\n1006\t        algebra: {\n1007\t          lastVisitedLessonSlug: 'lesson-1',\n1008\t          lastVisitedAt: '2026-04-30T00:00:00Z',\n1009\t          lessons: {\n1010\t            'lesson-1': {\n1011\t              status: 'started',\n1012\t              startedAt: '2026-04-30T00:00:00Z',\n1013\t              sectionState: {\n1014\t                's1': { userCode: 'x = 1' },\n1015\t              },\n1016\t            },\n1017\t          },\n1018\t        },\n1019\t      },\n1020\t    };\n1021\t    expect(() => ProgressSchema.parse(ok)).not.toThrow();\n1022\t  });\n1023\t\n1024\t  it('throws on missing required field (courses)', () => {\n1025\t    expect(() => ProgressSchema.parse({})).toThrow();\n1026\t  });\n1027\t\n1028\t  it('rejects an unknown lesson status', () => {\n1029\t    expect(() =>\n1030\t      ProgressSchema.parse({\n1031\t        courses: {\n1032\t          algebra: { lessons: { 'l1': { status: 'paused' } } },\n1033\t        },\n1034\t      }),\n1035\t    ).toThrow();\n1036\t  });\n1037\t});\n1038\t\n1039\tdescribe('CourseSpecSchema', () => {\n1040\t  const minimal = {\n1041\t    topic: 'Linear algebra',\n1042\t    level: 'beginner',\n1043\t    durationTarget: '1h',\n1044\t    theoryPracticeRatio: 0.5,\n1045\t    draftStructure: {\n1046\t      courseTitle: 'LA 101',\n1047\t      courseDescription: 'Intro',\n1048\t      modules: [\n1049\t        {\n1050\t          title: 'Vectors',\n1051\t          lessons: [{ title: 'What is a vector?', summary: '...', estimatedMinutes: 10 }],\n1052\t        },\n1053\t      ],\n1054\t    },\n1055\t    createdAt: '2026-04-30T00:00:00Z',\n1056\t  };\n1057\t\n1058\t  it('parses a minimal valid spec', () => {\n1059\t    expect(() => CourseSpecSchema.parse(minimal)).not.toThrow();\n1060\t  });\n1061\t\n1062\t  it('throws on missing required field (topic)', () => {\n1063\t    const broken: Partial<typeof minimal> = { ...minimal };\n1064\t    delete broken.topic;\n1065\t    expect(() => CourseSpecSchema.parse(broken)).toThrow();\n1066\t  });\n1067\t\n1068\t  it('rejects an unknown level', () => {\n1069\t    expect(() => CourseSpecSchema.parse({ ...minimal, level: 'expert' })).toThrow();\n1070\t  });\n1071\t\n1072\t  it('parses each new durationTarget enum value', () => {\n1073\t    for (const dt of ['short', 'standard', 'extensive', 'comprehensive'] as const) {\n1074\t      const parsed = CourseSpecSchema.parse({ ...minimal, durationTarget: dt });\n1075\t      expect(parsed.durationTarget).toBe(dt);\n1076\t    }\n1077\t  });\n1078\t\n1079\t  it('maps legacy durationTarget values to the new enum', () => {\n1080\t    const cases: { input: string; expected: 'short' | 'standard' | 'extensive' }[] = [\n1081\t      { input: '30min', expected: 'short' },\n1082\t      { input: '1h', expected: 'standard' },\n1083\t      { input: 'weekend', expected: 'extensive' },\n1084\t    ];\n1085\t    for (const { input, expected } of cases) {\n1086\t      const parsed = CourseSpecSchema.parse({ ...minimal, durationTarget: input });\n1087\t      expect(parsed.durationTarget).toBe(expected);\n1088\t    }\n1089\t  });\n1090\t\n1091\t  it('rejects an out-of-enum durationTarget value', () => {\n1092\t    expect(() => CourseSpecSchema.parse({ ...minimal, durationTarget: 'forever' })).toThrow();\n1093\t  });\n1094\t});\n1095\t"}]},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"f67ad6f1-2443-4bab-9e7a-f2d104e73cb5","timestamp":"2026-05-04T00:40:19.171Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/lib/schemas/schemas.test.ts","content":"import { describe, expect, it } from 'vitest';\n\nimport { CourseSchema } from '@/lib/schemas/course';\nimport { LessonSchema, SectionSchema } from '@/lib/schemas/lesson';\nimport { ProgressSchema } from '@/lib/schemas/progress';\nimport { CourseSpecSchema } from '@/lib/schemas/courseSpec';\nimport { TheoryDataSchema } from '@/widgets/Theory/schema';\nimport { QuizDataSchema } from '@/widgets/Quiz/schema';\nimport { CodeDataSchema } from '@/widgets/Code/schema';\nimport {\n  CodeClozeDataSchema,\n  validateSlotValue,\n} from '@/widgets/CodeCloze/schema';\nimport { DemoDataSchema } from '@/widgets/Demo/schema';\nimport {\n  DataTableDataSchema,\n  filterRows,\n  sortRows,\n  type DataTableRow,\n} from '@/widgets/DataTable/schema';\nimport {\n  DragMatchDataSchema,\n  validateDragMatch,\n  type DragMatchData,\n} from '@/widgets/DragMatch/schema';\nimport { SandboxDataSchema } from '@/widgets/Sandbox/schema';\nimport { ParametricExplorerDataSchema } from '@/widgets/ParametricExplorer/schema';\nimport { PlotImageDataSchema } from '@/widgets/PlotImage/schema';\nimport {\n  VideoDataSchema,\n  extractYouTubeId,\n} from '@/widgets/Video/schema';\n\ndescribe('CourseSchema', () => {\n  const minimal = {\n    slug: 'algebra',\n    title: 'Algebra',\n    description: 'Intro to algebra',\n    accentColor: 'indigo',\n    icon: 'sigma',\n    modules: [],\n    createdAt: '2026-04-30T00:00:00Z',\n    updatedAt: '2026-04-30T00:00:00Z',\n  };\n\n  it('parses a minimal valid course', () => {\n    expect(() => CourseSchema.parse(minimal)).not.toThrow();\n  });\n\n  it('rejects an unknown accentColor', () => {\n    expect(() => CourseSchema.parse({ ...minimal, accentColor: 'magenta' })).toThrow();\n  });\n\n  it('throws on missing required field (slug)', () => {\n    const broken: Partial<typeof minimal> = { ...minimal };\n    delete broken.slug;\n    expect(() => CourseSchema.parse(broken)).toThrow();\n  });\n\n  it('defaults schemaVersion to 1 when missing', () => {\n    const parsed = CourseSchema.parse(minimal);\n    expect(parsed.schemaVersion).toBe(1);\n  });\n\n  it('parses successfully when schemaVersion: 1 is present', () => {\n    const parsed = CourseSchema.parse({ ...minimal, schemaVersion: 1 });\n    expect(parsed.schemaVersion).toBe(1);\n  });\n});\n\ndescribe('LessonSchema + SectionSchema', () => {\n  const lesson = {\n    slug: 'lesson-1',\n    courseSlug: 'algebra',\n    moduleId: 'm1',\n    title: 'First lesson',\n    eyebrow: 'INTRO',\n    description: 'A first lesson',\n    estimatedMinutes: 10,\n    sections: [\n      { id: 's1', title: 'Read', type: 'theory', data: { markdown: '# hi' } },\n    ],\n  };\n\n  it('parses a minimal valid lesson', () => {\n    expect(() => LessonSchema.parse(lesson)).not.toThrow();\n  });\n\n  it('throws on missing required field (title)', () => {\n    const broken: Partial<typeof lesson> = { ...lesson };\n    delete broken.title;\n    expect(() => LessonSchema.parse(broken)).toThrow();\n  });\n\n  it('defaults schemaVersion to 1 when missing', () => {\n    const parsed = LessonSchema.parse(lesson);\n    expect(parsed.schemaVersion).toBe(1);\n  });\n\n  it('parses successfully when schemaVersion: 1 is present', () => {\n    const parsed = LessonSchema.parse({ ...lesson, schemaVersion: 1 });\n    expect(parsed.schemaVersion).toBe(1);\n  });\n\n  it('discriminated union accepts each known widget type', () => {\n    const cases = [\n      { id: 's1', title: 't', type: 'theory', data: { markdown: 'x' } },\n      {\n        id: 's2',\n        title: 't',\n        type: 'quiz',\n        data: {\n          question: 'q',\n          options: ['a', 'b'],\n          correct: [0],\n          explanation: 'e',\n          multiSelect: false,\n        },\n      },\n      {\n        id: 's3',\n        title: 't',\n        type: 'code',\n        data: {\n          taskMarkdown: 'do x',\n          starterCode: 'pass',\n          tests: [{ name: 't1', body: 'assert True' }],\n        },\n      },\n      {\n        id: 's4',\n        title: 't',\n        type: 'demo',\n        data: {\n          demoType: 'gauss',\n          imageSrc: '/x.png',\n          params: { sigmaMin: 0, sigmaMax: 5, sigmaDefault: 1 },\n        },\n      },\n      {\n        id: 's5',\n        title: 't',\n        type: 'sandbox',\n        data: { starterCode: 'x = 1', encouragement: 'play' },\n      },\n      {\n        id: 's6',\n        title: 't',\n        type: 'custom',\n        data: { whatever: 1 },\n      },\n      {\n        id: 's-cc',\n        title: 't',\n        type: 'codeCloze',\n        data: {\n          template: 'def f(): return {{x}}',\n          slots: [\n            { id: 'x', validation: { kind: 'exact', value: '42' } },\n          ],\n        },\n      },\n      {\n        id: 's7',\n        title: 't',\n        type: 'parametricExplorer',\n        data: {\n          setupCode: '',\n          renderCode: 'plt.plot([0, freq])',\n          params: [\n            {\n              name: 'freq',\n              label: 'Freq',\n              type: 'slider',\n              min: 0,\n              max: 5,\n              step: 0.1,\n              default: 1,\n            },\n          ],\n          outputType: 'plot',\n        },\n      },\n      {\n        id: 's-dm',\n        title: 't',\n        type: 'dragMatch',\n        data: {\n          prompt: 'Match each item.',\n          items: [{ id: 'a', label: 'A' }],\n          zones: [{ id: 'z', label: 'Z', accepts: ['a'] }],\n        },\n      },\n      {\n        id: 's-dt',\n        title: 't',\n        type: 'dataTable',\n        data: {\n          columns: [{ key: 'name', label: 'Name' }],\n          rows: [{ name: 'Ada' }],\n        },\n      },\n      {\n        id: 's-vid',\n        title: 't',\n        type: 'video',\n        data: { kind: 'youtube', src: 'aircAruvnKk' },\n      },\n    ];\n    for (const section of cases) {\n      expect(() => SectionSchema.parse(section)).not.toThrow();\n    }\n  });\n\n  it('discriminated union rejects an unknown widget type', () => {\n    expect(() =>\n      SectionSchema.parse({ id: 's', title: 't', type: 'mystery', data: {} }),\n    ).toThrow();\n  });\n\n  it('accepts lesson-level + section-level sources', () => {\n    const lessonWithSources = {\n      ...lesson,\n      sources: [\n        {\n          url: 'https://example.com/a',\n          title: 'A',\n          kind: 'paper',\n          author: 'A. Author',\n          year: 2024,\n        },\n      ],\n      sections: [\n        {\n          id: 's1',\n          title: 'Read',\n          type: 'theory',\n          data: { markdown: '# hi' },\n          sources: [\n            { url: 'https://example.com/v', title: 'Vid', kind: 'video' },\n          ],\n        },\n      ],\n    };\n    const parsed = LessonSchema.parse(lessonWithSources);\n    expect(parsed.sources?.[0].kind).toBe('paper');\n    expect(parsed.sections[0].sources?.[0].kind).toBe('video');\n  });\n\n  it('rejects sources with an unknown kind', () => {\n    const bad = {\n      ...lesson,\n      sources: [{ url: 'https://example.com', title: 'T', kind: 'tweet' }],\n    };\n    expect(() => LessonSchema.parse(bad)).toThrow();\n  });\n});\n\ndescribe('Per-widget data schemas', () => {\n  it('TheoryData: parses minimal, rejects missing markdown', () => {\n    expect(() => TheoryDataSchema.parse({ markdown: 'hi' })).not.toThrow();\n    expect(() => TheoryDataSchema.parse({})).toThrow();\n  });\n\n  it('QuizData: parses minimal, rejects missing question', () => {\n    const ok = {\n      question: 'q?',\n      options: ['a', 'b'],\n      correct: [0],\n      explanation: 'because',\n      multiSelect: false,\n    };\n    expect(() => QuizDataSchema.parse(ok)).not.toThrow();\n    const broken: Partial<typeof ok> = { ...ok };\n    delete broken.question;\n    expect(() => QuizDataSchema.parse(broken)).toThrow();\n  });\n\n  it('CodeData: defaults test.hidden to true when omitted', () => {\n    const parsed = CodeDataSchema.parse({\n      taskMarkdown: 'do x',\n      starterCode: '',\n      tests: [{ name: 't1', body: 'pass' }],\n    });\n    expect(parsed.tests[0].hidden).toBe(true);\n  });\n\n  it('CodeData: rejects missing tests', () => {\n    expect(() =>\n      CodeDataSchema.parse({ taskMarkdown: 'm', starterCode: '' }),\n    ).toThrow();\n  });\n\n  it('DemoData: parses minimal, rejects missing imageSrc', () => {\n    const ok = {\n      demoType: 'gauss',\n      imageSrc: '/x.png',\n      params: { sigmaMin: 0, sigmaMax: 5, sigmaDefault: 1 },\n    };\n    expect(() => DemoDataSchema.parse(ok)).not.toThrow();\n    const broken: Partial<typeof ok> = { ...ok };\n    delete broken.imageSrc;\n    expect(() => DemoDataSchema.parse(broken)).toThrow();\n  });\n\n  it('SandboxData: parses minimal, rejects missing encouragement', () => {\n    expect(() =>\n      SandboxDataSchema.parse({ starterCode: 'x', encouragement: 'go' }),\n    ).not.toThrow();\n    expect(() => SandboxDataSchema.parse({ starterCode: 'x' })).toThrow();\n  });\n\n  it('PlotImageData: parses a minimal valid object', () => {\n    const ok = { src: '/foo.png', alt: 'A plot' };\n    expect(() => PlotImageDataSchema.parse(ok)).not.toThrow();\n  });\n\n  it('PlotImageData: parses with all optional fields', () => {\n    const full = {\n      src: '/x.png',\n      alt: 'desc',\n      caption: 'cap',\n      sourceCode: 'plt.show()',\n      sourceLanguage: 'python' as const,\n    };\n    const parsed = PlotImageDataSchema.parse(full);\n    expect(parsed.sourceLanguage).toBe('python');\n  });\n\n  it('PlotImageData: rejects missing src', () => {\n    const broken = { alt: 'A plot' } as Record<string, unknown>;\n    expect(() => PlotImageDataSchema.parse(broken)).toThrow();\n  });\n\n  it('PlotImageData: rejects missing alt', () => {\n    const broken = { src: '/foo.png' } as Record<string, unknown>;\n    expect(() => PlotImageDataSchema.parse(broken)).toThrow();\n  });\n\n  it('PlotImageData: rejects empty alt', () => {\n    expect(() =>\n      PlotImageDataSchema.parse({ src: '/foo.png', alt: '' }),\n    ).toThrow();\n  });\n\n  it('PlotImageData: rejects sourceLanguage outside the enum', () => {\n    expect(() =>\n      PlotImageDataSchema.parse({ src: '/x.png', alt: 'a', sourceLanguage: 'js' }),\n    ).toThrow();\n  });\n\n  it('VideoData: parses a minimal valid YouTube object', () => {\n    const ok = { kind: 'youtube', src: 'aircAruvnKk' };\n    const parsed = VideoDataSchema.parse(ok);\n    expect(parsed.kind).toBe('youtube');\n    expect(parsed.autoplay).toBe(false);\n  });\n\n  it('VideoData: parses a minimal valid MP4 object', () => {\n    const ok = { kind: 'mp4', src: '/api/courses/abc/assets/intro.mp4' };\n    const parsed = VideoDataSchema.parse(ok);\n    expect(parsed.kind).toBe('mp4');\n    expect(parsed.autoplay).toBe(false);\n  });\n\n  it('VideoData: parses with full transcript and optional fields', () => {\n    const full = {\n      kind: 'youtube',\n      src: 'https://youtu.be/aircAruvnKk',\n      title: 'Hello',\n      durationSeconds: 600,\n      autoplay: true,\n      startAt: 30,\n      transcript: [\n        { tStart: 0, tEnd: 5, text: 'Intro', speaker: 'Grant' },\n        { tStart: 5, text: 'Continuation' },\n      ],\n    };\n    const parsed = VideoDataSchema.parse(full);\n    expect(parsed.transcript).toHaveLength(2);\n    expect(parsed.transcript?.[0].speaker).toBe('Grant');\n    expect(parsed.transcript?.[1].tEnd).toBeUndefined();\n  });\n\n  it('VideoData: rejects unknown kind', () => {\n    expect(() =>\n      VideoDataSchema.parse({ kind: 'webm', src: '/x.webm' }),\n    ).toThrow();\n  });\n\n  it('VideoData: rejects empty src', () => {\n    expect(() =>\n      VideoDataSchema.parse({ kind: 'mp4', src: '' }),\n    ).toThrow();\n  });\n\n  it('VideoData: rejects empty transcript text', () => {\n    expect(() =>\n      VideoDataSchema.parse({\n        kind: 'mp4',\n        src: '/x.mp4',\n        transcript: [{ tStart: 0, text: '' }],\n      }),\n    ).toThrow();\n  });\n\n  it('VideoData: rejects negative tStart', () => {\n    expect(() =>\n      VideoDataSchema.parse({\n        kind: 'mp4',\n        src: '/x.mp4',\n        transcript: [{ tStart: -1, text: 'oops' }],\n      }),\n    ).toThrow();\n  });\n\n  it('extractYouTubeId: returns the bare 11-char id unchanged', () => {\n    expect(extractYouTubeId('aircAruvnKk')).toBe('aircAruvnKk');\n    expect(extractYouTubeId('  aircAruvnKk  ')).toBe('aircAruvnKk');\n  });\n\n  it('extractYouTubeId: parses youtu.be short links', () => {\n    expect(extractYouTubeId('https://youtu.be/aircAruvnKk')).toBe('aircAruvnKk');\n    expect(extractYouTubeId('https://youtu.be/aircAruvnKk?t=42')).toBe(\n      'aircAruvnKk',\n    );\n  });\n\n  it('extractYouTubeId: parses watch?v= URLs', () => {\n    expect(\n      extractYouTubeId('https://www.youtube.com/watch?v=aircAruvnKk'),\n    ).toBe('aircAruvnKk');\n    expect(\n      extractYouTubeId('https://m.youtube.com/watch?v=aircAruvnKk&t=10s'),\n    ).toBe('aircAruvnKk');\n  });\n\n  it('extractYouTubeId: parses /embed/ and /shorts/ URLs', () => {\n    expect(\n      extractYouTubeId('https://www.youtube.com/embed/aircAruvnKk'),\n    ).toBe('aircAruvnKk');\n    expect(\n      extractYouTubeId('https://www.youtube.com/shorts/aircAruvnKk'),\n    ).toBe('aircAruvnKk');\n    expect(\n      extractYouTubeId('https://www.youtube-nocookie.com/embed/aircAruvnKk'),\n    ).toBe('aircAruvnKk');\n  });\n\n  it('extractYouTubeId: returns null for non-YouTube URLs and bad input', () => {\n    expect(extractYouTubeId('https://vimeo.com/123456')).toBeNull();\n    expect(extractYouTubeId('not a url')).toBeNull();\n    expect(extractYouTubeId('')).toBeNull();\n    expect(extractYouTubeId('https://www.youtube.com/watch?v=tooShort')).toBeNull();\n  });\n\n  it('ParametricExplorerData: parses a minimal valid object', () => {\n    const ok = {\n      setupCode: '',\n      renderCode: 'plt.plot([0, freq])',\n      params: [\n        {\n          name: 'freq',\n          label: 'Freq',\n          type: 'slider',\n          min: 0,\n          max: 5,\n          step: 0.1,\n          default: 1,\n        },\n      ],\n      outputType: 'plot',\n    };\n    expect(() => ParametricExplorerDataSchema.parse(ok)).not.toThrow();\n  });\n\n  it('ParametricExplorerData: parses select + toggle params', () => {\n    const ok = {\n      setupCode: '',\n      renderCode: '',\n      params: [\n        { name: 'mode', label: 'Mode', type: 'select', options: ['a', 'b'], default: 'a' },\n        { name: 'flag', label: 'Flag', type: 'toggle', default: true },\n      ],\n      outputType: 'value',\n    };\n    expect(() => ParametricExplorerDataSchema.parse(ok)).not.toThrow();\n  });\n\n  it('ParametricExplorerData: rejects unknown outputType', () => {\n    expect(() =>\n      ParametricExplorerDataSchema.parse({\n        setupCode: '',\n        renderCode: '',\n        params: [],\n        outputType: 'png',\n      }),\n    ).toThrow();\n  });\n\n  it('ParametricExplorerData: accepts optional debounceMs', () => {\n    const parsed = ParametricExplorerDataSchema.parse({\n      setupCode: '',\n      renderCode: '',\n      params: [],\n      outputType: 'plot',\n      debounceMs: 250,\n    });\n    expect(parsed.debounceMs).toBe(250);\n  });\n\n  it('CodeClozeData: parses a minimal valid object', () => {\n    const ok = {\n      template: 'return {{x}}',\n      slots: [{ id: 'x', validation: { kind: 'exact', value: '1' } }],\n    };\n    expect(() => CodeClozeDataSchema.parse(ok)).not.toThrow();\n  });\n\n  it('CodeClozeData: parses with finalTests, hints, and per-slot hint', () => {\n    const parsed = CodeClozeDataSchema.parse({\n      taskMarkdown: 'Fill the blanks.',\n      template: 'a = {{a}}; b = {{b}}',\n      slots: [\n        {\n          id: 'a',\n          hint: 'pick 1',\n          validation: { kind: 'oneOf', values: ['1', 'one'] },\n        },\n        {\n          id: 'b',\n          validation: { kind: 'regex', pattern: '\\\\d+' },\n        },\n      ],\n      finalTests: [{ name: 't', body: 'assert True' }],\n      hints: [{ revealAfterAttempts: 2, markdown: 'try harder' }],\n    });\n    expect(parsed.finalTests?.[0].hidden).toBe(true);\n    expect(parsed.slots[0].validation).toEqual({\n      kind: 'oneOf',\n      values: ['1', 'one'],\n    });\n  });\n\n  it('CodeClozeData: rejects unknown validation kind', () => {\n    expect(() =>\n      CodeClozeDataSchema.parse({\n        template: '{{x}}',\n        slots: [\n          {\n            id: 'x',\n            validation: { kind: 'startsWith', value: 'a' },\n          },\n        ],\n      }),\n    ).toThrow();\n  });\n\n  it('CodeClozeData: rejects oneOf with empty values array', () => {\n    expect(() =>\n      CodeClozeDataSchema.parse({\n        template: '{{x}}',\n        slots: [{ id: 'x', validation: { kind: 'oneOf', values: [] } }],\n      }),\n    ).toThrow();\n  });\n\n  it('DragMatchData: parses a minimal valid object and defaults multipleItemsPerZone', () => {\n    const ok = {\n      prompt: 'Match each.',\n      items: [{ id: 'a', label: 'A' }],\n      zones: [{ id: 'z', label: 'Zone', accepts: ['a'] }],\n    };\n    const parsed = DragMatchDataSchema.parse(ok);\n    expect(parsed.multipleItemsPerZone).toBe(false);\n  });\n\n  it('DragMatchData: parses with explanation and multipleItemsPerZone=true', () => {\n    const parsed = DragMatchDataSchema.parse({\n      prompt: 'Order steps.',\n      items: [\n        { id: 'a', label: 'first' },\n        { id: 'b', label: 'second' },\n      ],\n      zones: [{ id: 'order', label: 'Order', accepts: ['a', 'b'] }],\n      multipleItemsPerZone: true,\n      explanation: 'Steps in order.',\n    });\n    expect(parsed.multipleItemsPerZone).toBe(true);\n    expect(parsed.explanation).toBe('Steps in order.');\n  });\n\n  it('DragMatchData: rejects empty items array', () => {\n    expect(() =>\n      DragMatchDataSchema.parse({\n        prompt: 'p',\n        items: [],\n        zones: [{ id: 'z', label: 'Z', accepts: [] }],\n      }),\n    ).toThrow();\n  });\n\n  it('DragMatchData: rejects empty zones array', () => {\n    expect(() =>\n      DragMatchDataSchema.parse({\n        prompt: 'p',\n        items: [{ id: 'a', label: 'A' }],\n        zones: [],\n      }),\n    ).toThrow();\n  });\n\n  it('DragMatchData: rejects items with empty id or label', () => {\n    expect(() =>\n      DragMatchDataSchema.parse({\n        prompt: 'p',\n        items: [{ id: '', label: 'A' }],\n        zones: [{ id: 'z', label: 'Z', accepts: [] }],\n      }),\n    ).toThrow();\n  });\n});\n\ndescribe('CodeCloze validateSlotValue', () => {\n  it('exact: requires byte-for-byte equality', () => {\n    expect(\n      validateSlotValue({ kind: 'exact', value: 'sum' }, 'sum'),\n    ).toBe(true);\n    expect(\n      validateSlotValue({ kind: 'exact', value: 'sum' }, 'Sum'),\n    ).toBe(false);\n    expect(\n      validateSlotValue({ kind: 'exact', value: 'sum' }, ' sum'),\n    ).toBe(false);\n  });\n\n  it('oneOf: accepts any listed value', () => {\n    const v = {\n      kind: 'oneOf' as const,\n      values: ['len(values)', '3'],\n    };\n    expect(validateSlotValue(v, 'len(values)')).toBe(true);\n    expect(validateSlotValue(v, '3')).toBe(true);\n    expect(validateSlotValue(v, '4')).toBe(false);\n  });\n\n  it('regex: anchors implicitly (full match)', () => {\n    const v = { kind: 'regex' as const, pattern: '\\\\d+' };\n    expect(validateSlotValue(v, '123')).toBe(true);\n    expect(validateSlotValue(v, '12a')).toBe(false);\n    expect(validateSlotValue(v, '')).toBe(false);\n  });\n\n  it('regex: invalid pattern returns false instead of throwing', () => {\n    const v = { kind: 'regex' as const, pattern: '(' };\n    expect(validateSlotValue(v, 'x')).toBe(false);\n  });\n});\n\ndescribe('DragMatch validateDragMatch', () => {\n  const singleZoneData: DragMatchData = {\n    prompt: 'Match each programming term.',\n    items: [\n      { id: 'i-var', label: 'Variable' },\n      { id: 'i-fn', label: 'Function' },\n      { id: 'i-loop', label: 'Loop' },\n    ],\n    zones: [\n      { id: 'z-var', label: 'Storage', accepts: ['i-var'] },\n      { id: 'z-fn', label: 'Reusable code', accepts: ['i-fn'] },\n      { id: 'z-loop', label: 'Repeats', accepts: ['i-loop'] },\n    ],\n    multipleItemsPerZone: false,\n  };\n\n  it('single-zone: all items in correct zones is allCorrect', () => {\n    const result = validateDragMatch(singleZoneData, {\n      'z-var': ['i-var'],\n      'z-fn': ['i-fn'],\n      'z-loop': ['i-loop'],\n      __bank__: [],\n    });\n    expect(result.allCorrect).toBe(true);\n    expect(result.zoneCorrect['z-var']).toBe(true);\n    expect(result.misplacedItemIds.size).toBe(0);\n  });\n\n  it('single-zone: one swapped pair flags exactly two misplaced items', () => {\n    const result = validateDragMatch(singleZoneData, {\n      'z-var': ['i-fn'],\n      'z-fn': ['i-var'],\n      'z-loop': ['i-loop'],\n      __bank__: [],\n    });\n    expect(result.allCorrect).toBe(false);\n    expect(result.zoneCorrect['z-var']).toBe(false);\n    expect(result.zoneCorrect['z-fn']).toBe(false);\n    expect(result.zoneCorrect['z-loop']).toBe(true);\n    expect(result.misplacedItemIds.has('i-var')).toBe(true);\n    expect(result.misplacedItemIds.has('i-fn')).toBe(true);\n    expect(result.misplacedItemIds.has('i-loop')).toBe(false);\n  });\n\n  it('single-zone: item left in bank is misplaced and zone is empty/incorrect', () => {\n    const result = validateDragMatch(singleZoneData, {\n      'z-var': ['i-var'],\n      'z-fn': ['i-fn'],\n      'z-loop': [],\n      __bank__: ['i-loop'],\n    });\n    expect(result.allCorrect).toBe(false);\n    expect(result.zoneCorrect['z-loop']).toBe(false);\n    expect(result.misplacedItemIds.has('i-loop')).toBe(true);\n  });\n\n  const multiZoneData: DragMatchData = {\n    prompt: 'Group fruits and vegetables.',\n    items: [\n      { id: 'apple', label: 'Apple' },\n      { id: 'banana', label: 'Banana' },\n      { id: 'carrot', label: 'Carrot' },\n    ],\n    zones: [\n      { id: 'fruit', label: 'Fruit', accepts: ['apple', 'banana'] },\n      { id: 'veg', label: 'Vegetable', accepts: ['carrot'] },\n    ],\n    multipleItemsPerZone: true,\n  };\n\n  it('multi-zone (ordered): exact accepts order is correct', () => {\n    const result = validateDragMatch(multiZoneData, {\n      fruit: ['apple', 'banana'],\n      veg: ['carrot'],\n      __bank__: [],\n    });\n    expect(result.allCorrect).toBe(true);\n  });\n\n  it('multi-zone (ordered): wrong order in zone is incorrect', () => {\n    const result = validateDragMatch(multiZoneData, {\n      fruit: ['banana', 'apple'],\n      veg: ['carrot'],\n      __bank__: [],\n    });\n    expect(result.allCorrect).toBe(false);\n    expect(result.zoneCorrect['fruit']).toBe(false);\n    expect(result.zoneCorrect['veg']).toBe(true);\n  });\n\n  it('multi-zone (ordered): missing one item in zone is incorrect', () => {\n    const result = validateDragMatch(multiZoneData, {\n      fruit: ['apple'],\n      veg: ['carrot'],\n      __bank__: ['banana'],\n    });\n    expect(result.allCorrect).toBe(false);\n    expect(result.zoneCorrect['fruit']).toBe(false);\n    expect(result.misplacedItemIds.has('banana')).toBe(true);\n  });\n\n  it('multi-zone (unordered, multipleItemsPerZone=false): set equality wins', () => {\n    const data: DragMatchData = { ...multiZoneData, multipleItemsPerZone: false };\n    const result = validateDragMatch(data, {\n      fruit: ['banana', 'apple'],\n      veg: ['carrot'],\n      __bank__: [],\n    });\n    expect(result.allCorrect).toBe(true);\n  });\n});\n\ndescribe('DataTableData schema', () => {\n  it('parses a minimal valid object and applies pageSize default', () => {\n    const parsed = DataTableDataSchema.parse({\n      columns: [{ key: 'name', label: 'Name' }],\n      rows: [{ name: 'Ada' }],\n    });\n    expect(parsed.pageSize).toBe(25);\n    expect(parsed.columns[0].type).toBe('string');\n    expect(parsed.columns[0].sortable).toBe(true);\n    expect(parsed.columns[0].filterable).toBe(false);\n  });\n\n  it('rejects empty columns array', () => {\n    expect(() =>\n      DataTableDataSchema.parse({ columns: [], rows: [] }),\n    ).toThrow();\n  });\n\n  it('rejects non-positive pageSize', () => {\n    expect(() =>\n      DataTableDataSchema.parse({\n        columns: [{ key: 'a', label: 'A' }],\n        rows: [],\n        pageSize: 0,\n      }),\n    ).toThrow();\n  });\n\n  it('accepts initialSort with key + dir', () => {\n    const parsed = DataTableDataSchema.parse({\n      columns: [{ key: 'a', label: 'A' }],\n      rows: [],\n      initialSort: { key: 'a', dir: 'desc' },\n    });\n    expect(parsed.initialSort?.dir).toBe('desc');\n  });\n\n  it('rejects initialSort with unknown direction', () => {\n    expect(() =>\n      DataTableDataSchema.parse({\n        columns: [{ key: 'a', label: 'A' }],\n        rows: [],\n        initialSort: { key: 'a', dir: 'sideways' },\n      }),\n    ).toThrow();\n  });\n\n  it('accepts row cells of mixed primitive types and null', () => {\n    const parsed = DataTableDataSchema.parse({\n      columns: [\n        { key: 'name', label: 'Name', type: 'string' },\n        { key: 'score', label: 'Score', type: 'number' },\n        { key: 'passed', label: 'Passed', type: 'boolean' },\n      ],\n      rows: [\n        { name: 'Ada', score: 92, passed: true },\n        { name: 'Linus', score: null, passed: false },\n      ],\n    });\n    expect(parsed.rows.length).toBe(2);\n  });\n});\n\ndescribe('DataTable sortRows', () => {\n  const columns = [\n    { key: 'name', label: 'Name', type: 'string' as const, sortable: true, filterable: false },\n    { key: 'score', label: 'Score', type: 'number' as const, sortable: true, filterable: false },\n  ];\n  const rows: DataTableRow[] = [\n    { name: 'Bob', score: 10 },\n    { name: 'Alice', score: 30 },\n    { name: 'Cara', score: 20 },\n  ];\n\n  it('returns rows in original order when sort is null', () => {\n    const result = sortRows({ rows, sort: null, columns });\n    expect(result.map((r) => r.name)).toEqual(['Bob', 'Alice', 'Cara']);\n  });\n\n  it('sorts ascending by string', () => {\n    const result = sortRows({ rows, sort: { key: 'name', dir: 'asc' }, columns });\n    expect(result.map((r) => r.name)).toEqual(['Alice', 'Bob', 'Cara']);\n  });\n\n  it('sorts descending by number', () => {\n    const result = sortRows({ rows, sort: { key: 'score', dir: 'desc' }, columns });\n    expect(result.map((r) => r.score)).toEqual([30, 20, 10]);\n  });\n\n  it('sorts ascending by number', () => {\n    const result = sortRows({ rows, sort: { key: 'score', dir: 'asc' }, columns });\n    expect(result.map((r) => r.score)).toEqual([10, 20, 30]);\n  });\n\n  it('null/undefined cells sort to the end', () => {\n    const sparse: DataTableRow[] = [\n      { name: 'A', score: 10 },\n      { name: 'B', score: null },\n      { name: 'C', score: 5 },\n    ];\n    const asc = sortRows({ rows: sparse, sort: { key: 'score', dir: 'asc' }, columns });\n    expect(asc.map((r) => r.name)).toEqual(['C', 'A', 'B']);\n  });\n\n  it('does not mutate the input array', () => {\n    const original = rows.slice();\n    sortRows({ rows, sort: { key: 'name', dir: 'desc' }, columns });\n    expect(rows).toEqual(original);\n  });\n});\n\ndescribe('DataTable filterRows', () => {\n  const columns = [\n    { key: 'name', label: 'Name', type: 'string' as const, sortable: true, filterable: true },\n    { key: 'score', label: 'Score', type: 'number' as const, sortable: true, filterable: true },\n    { key: 'tag', label: 'Tag', type: 'string' as const, sortable: true, filterable: false },\n  ];\n  const rows: DataTableRow[] = [\n    { name: 'Alice', score: 80, tag: 'gold' },\n    { name: 'Bob', score: 60, tag: 'silver' },\n    { name: 'Bobby', score: 95, tag: 'gold' },\n    { name: 'Cara', score: 40, tag: 'bronze' },\n  ];\n\n  it('string contains filter is case-insensitive', () => {\n    const result = filterRows({\n      rows,\n      filters: { name: 'bob' },\n      columns,\n    });\n    expect(result.map((r) => r.name)).toEqual(['Bob', 'Bobby']);\n  });\n\n  it('number range filter respects both bounds', () => {\n    const result = filterRows({\n      rows,\n      filters: { score: { min: 50, max: 90 } },\n      columns,\n    });\n    expect(result.map((r) => r.name)).toEqual(['Alice', 'Bob']);\n  });\n\n  it('number range filter accepts only min', () => {\n    const result = filterRows({\n      rows,\n      filters: { score: { min: 70 } },\n      columns,\n    });\n    expect(result.map((r) => r.name)).toEqual(['Alice', 'Bobby']);\n  });\n\n  it('number range filter accepts only max', () => {\n    const result = filterRows({\n      rows,\n      filters: { score: { max: 60 } },\n      columns,\n    });\n    expect(result.map((r) => r.name)).toEqual(['Bob', 'Cara']);\n  });\n\n  it('combines multiple column filters with AND', () => {\n    const result = filterRows({\n      rows,\n      filters: { name: 'bob', score: { min: 70 } },\n      columns,\n    });\n    expect(result.map((r) => r.name)).toEqual(['Bobby']);\n  });\n\n  it('ignores filters on non-filterable columns', () => {\n    const result = filterRows({\n      rows,\n      filters: { tag: 'gold' },\n      columns,\n    });\n    expect(result.length).toBe(rows.length);\n  });\n\n  it('empty/undefined filter values pass through every row', () => {\n    const result = filterRows({\n      rows,\n      filters: { name: '', score: {} },\n      columns,\n    });\n    expect(result.length).toBe(rows.length);\n  });\n});\n\ndescribe('ParametricExplorer param value serialization', () => {\n  // Param values are passed to Pyodide as a plain JS object — Pyodide's\n  // automatic JS↔Python conversion turns:\n  //   number → float, boolean → bool, string → str\n  // These tests pin the serialized shape that the worker forwards to Python\n  // so a future refactor doesn't silently change types under the user's code.\n  it('slider param serializes as a JS number (→ Python float)', () => {\n    const params: Record<string, number | string | boolean> = { freq: 1.5 };\n    expect(typeof params.freq).toBe('number');\n    expect(Number.isFinite(params.freq as number)).toBe(true);\n  });\n\n  it('toggle param serializes as a JS boolean (→ Python bool)', () => {\n    const params: Record<string, number | string | boolean> = { on: true };\n    expect(typeof params.on).toBe('boolean');\n    expect(params.on).toBe(true);\n  });\n\n  it('select param serializes as a JS string (→ Python str)', () => {\n    const params: Record<string, number | string | boolean> = { mode: 'fast' };\n    expect(typeof params.mode).toBe('string');\n    expect(params.mode).toBe('fast');\n  });\n\n  it('mixed params object preserves each per-param type', () => {\n    const params: Record<string, number | string | boolean> = {\n      freq: 2,\n      mode: 'fast',\n      on: false,\n    };\n    expect(typeof params.freq).toBe('number');\n    expect(typeof params.mode).toBe('string');\n    expect(typeof params.on).toBe('boolean');\n  });\n});\n\ndescribe('ProgressSchema', () => {\n  const minimal = { courses: {} };\n\n  it('parses an empty progress object', () => {\n    expect(() => ProgressSchema.parse(minimal)).not.toThrow();\n  });\n\n  it('parses nested course/lesson progress', () => {\n    const ok = {\n      courses: {\n        algebra: {\n          lastVisitedLessonSlug: 'lesson-1',\n          lastVisitedAt: '2026-04-30T00:00:00Z',\n          lessons: {\n            'lesson-1': {\n              status: 'started',\n              startedAt: '2026-04-30T00:00:00Z',\n              sectionState: {\n                's1': { userCode: 'x = 1' },\n              },\n            },\n          },\n        },\n      },\n    };\n    expect(() => ProgressSchema.parse(ok)).not.toThrow();\n  });\n\n  it('throws on missing required field (courses)', () => {\n    expect(() => ProgressSchema.parse({})).toThrow();\n  });\n\n  it('rejects an unknown lesson status', () => {\n    expect(() =>\n      ProgressSchema.parse({\n        courses: {\n          algebra: { lessons: { 'l1': { status: 'paused' } } },\n        },\n      }),\n    ).toThrow();\n  });\n});\n\ndescribe('CourseSpecSchema', () => {\n  const minimal = {\n    topic: 'Linear algebra',\n    level: 'beginner',\n    durationTarget: '1h',\n    theoryPracticeRatio: 0.5,\n    draftStructure: {\n      courseTitle: 'LA 101',\n      courseDescription: 'Intro',\n      modules: [\n        {\n          title: 'Vectors',\n          lessons: [{ title: 'What is a vector?', summary: '...', estimatedMinutes: 10 }],\n        },\n      ],\n    },\n    createdAt: '2026-04-30T00:00:00Z',\n  };\n\n  it('parses a minimal valid spec', () => {\n    expect(() => CourseSpecSchema.parse(minimal)).not.toThrow();\n  });\n\n  it('throws on missing required field (topic)', () => {\n    const broken: Partial<typeof minimal> = { ...minimal };\n    delete broken.topic;\n    expect(() => CourseSpecSchema.parse(broken)).toThrow();\n  });\n\n  it('rejects an unknown level', () => {\n    expect(() => CourseSpecSchema.parse({ ...minimal, level: 'expert' })).toThrow();\n  });\n\n  it('parses each new durationTarget enum value', () => {\n    for (const dt of ['short', 'standard', 'extensive', 'comprehensive'] as const) {\n      const parsed = CourseSpecSchema.parse({ ...minimal, durationTarget: dt });\n      expect(parsed.durationTarget).toBe(dt);\n    }\n  });\n\n  it('maps legacy durationTarget values to the new enum', () => {\n    const cases: { input: string; expected: 'short' | 'standard' | 'extensive' }[] = [\n      { input: '30min', expected: 'short' },\n      { input: '1h', expected: 'standard' },\n      { input: 'weekend', expected: 'extensive' },\n    ];\n    for (const { input, expected } of cases) {\n      const parsed = CourseSpecSchema.parse({ ...minimal, durationTarget: input });\n      expect(parsed.durationTarget).toBe(expected);\n    }\n  });\n\n  it('rejects an out-of-enum durationTarget value', () => {\n    expect(() => CourseSpecSchema.parse({ ...minimal, durationTarget: 'forever' })).toThrow();\n  });\n});\n","numLines":1095,"startLine":1,"totalLines":1095}}}
