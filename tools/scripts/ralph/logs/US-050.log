 fs.mkdtemp(path.join(os.tmpdir(), 'us050-prefetch-'));\n  process.env.COURSES_ROOT_OVERRIDE = tmpRoot;\n});\n\nafterEach(async () => {\n  delete process.env.COURSES_ROOT_OVERRIDE;\n  await fs.rm(tmpRoot, { recursive: true, force: true });\n});\n\ndescribe('hashUrlToFilename', () => {\n  it('produces a 16-hex-char + ext filename', () => {\n    const out = hashUrlToFilename('https://example.com/x.png', '.png');\n    expect(out).toMatch(/^[0-9a-f]{16}\\.png$/);\n  });\n\n  it('is deterministic — same URL hashes to same name', () => {\n    const a = hashUrlToFilename('https://example.com/x.png', '.png');\n    const b = hashUrlToFilename('https://example.com/x.png', '.png');\n    expect(a).toBe(b);\n  });\n\n  it('different URLs produce different filenames', () => {\n    const a = hashUrlToFilename('https://example.com/x.png', '.png');\n    const b = hashUrlToFilename('https://example.com/y.png', '.png');\n    expect(a).not.toBe(b);\n  });\n\n  it('preserves the supplied extension', () => {\n    expect(hashUrlToFilename('https://e.com/p', '.jpg')).toMatch(/\\.jpg$/);\n    expect(hashUrlToFilename('https://e.com/p', '.svg')).toMatch(/\\.svg$/);\n  });\n});\n\ndescribe('inferExtFromUrl', () => {\n  it('returns the extension when supported', () => {\n    expect(inferExtFromUrl('https://e.com/x.png')).toBe('.png');\n    expect(inferExtFromUrl('https://e.com/x.JPG')).toBe('.jpg');\n    expect(inferExtFromUrl('https://e.com/path/to/x.webp?v=1')).toBe('.webp');\n  });\n\n  it('returns null when extension is missing or unsupported', () => {\n    expect(inferExtFromUrl('https://e.com/x')).toBeNull();\n    expect(inferExtFromUrl('https://e.com/x.tiff')).toBeNull();\n    expect(inferExtFromUrl('not a url')).toBeNull();\n  });\n});\n\ndescribe('inferExtFromContentType', () => {\n  it('maps image/* to ext', () => {\n    expect(inferExtFromContentType('image/png')).toBe('.png');\n    expect(inferExtFromContentType('image/jpeg')).toBe('.jpg');\n    expect(inferExtFromContentType('image/svg+xml')).toBe('.svg');\n    expect(inferExtFromContentType('image/webp')).toBe('.webp');\n  });\n\n  it('strips the charset suffix', () => {\n    expect(inferExtFromContentType('image/png; charset=binary')).toBe('.png');\n  });\n\n  it('returns null for unknown or missing content type', () => {\n    expect(inferExtFromContentType(null)).toBeNull();\n    expect(inferExtFromContentType('text/html')).toBeNull();\n  });\n});\n\ndescribe('prefetchImageToCourse', () => {\n  it('downloads the image, names it by sha256, and reports a local URL', async () => {\n    const url = 'https://example.com/photo.png';\n    const fetchImpl = makeFakeFetch(() => new Response(new Uint8Array(PNG_BYTES), {\n      headers: { 'content-type': 'image/png' },\n    }));\n    const result = await prefetchImageToCourse('demo', url, { fetchImpl });\n    expect(result).not.toBeNull();\n    const expectedFilename = hashUrlToFilename(url, '.png');\n    expect(result?.localSrc).toBe(`/api/courses/demo/assets/images/${expectedFilename}`);\n    expect(result?.fetched).toBe(true);\n    const written = await fs.readFile(result!.filePath);\n    expect(written.length).toBe(PNG_BYTES.length);\n  });\n\n  it('is idempotent — second call with the same URL hits cache and skips fetch', async () => {\n    const url = 'https://example.com/photo.png';\n    const fetchImpl = makeFakeFetch(() => new Response(new Uint8Array(PNG_BYTES), {\n      headers: { 'content-type': 'image/png' },\n    }));\n    const a = await prefetchImageToCourse('demo', url, { fetchImpl });\n    expect(a?.fetched).toBe(true);\n    expect(fetchImpl.calls).toBe(1);\n    const b = await prefetchImageToCourse('demo', url, { fetchImpl });\n    expect(b?.fetched).toBe(false);\n    expect(b?.localSrc).toBe(a?.localSrc);\n    expect(fetchImpl.calls).toBe(1);\n  });\n\n  it('returns null on network failure', async () => {\n    const fetchImpl = makeFakeFetch(() => null);\n    const result = await prefetchImageToCourse(\n      'demo',\n      'https://example.com/photo.png',\n      { fetchImpl },\n    );\n    expect(result).toBeNull();\n  });\n\n  it('returns null on non-OK response', async () => {\n    const fetchImpl = makeFakeFetch(() => new Response('not found', { status: 404 }));\n    const result = await prefetchImageToCourse(\n      'demo',\n      'https://example.com/missing.png',\n      { fetchImpl },\n    );\n    expect(result).toBeNull();\n  });\n\n  it('falls back to content-type for files with no URL extension', async () => {\n    const url = 'https://example.com/render?id=42';\n    const fetchImpl = makeFakeFetch(() => new Response(new Uint8Array(PNG_BYTES), {\n      headers: { 'content-type': 'image/png' },\n    }));\n    const result = await prefetchImageToCourse('demo', url, { fetchImpl });\n    expect(result?.localSrc).toMatch(/\\.png$/);\n  });\n\n  it('returns null when neither URL nor content-type yield a known extension', async () => {\n    const fetchImpl = makeFakeFetch(() => new Response('binary garbage', {\n      headers: { 'content-type': 'application/octet-stream' },\n    }));\n    const result = await prefetchImageToCourse(\n      'demo',\n      'https://example.com/blob',\n      { fetchImpl },\n    );\n    expect(result).toBeNull();\n  });\n\n  it('returns null when bytes exceed the maxBytes limit', async () => {\n    const fetchImpl = makeFakeFetch(() => new Response(new Uint8Array(PNG_BYTES), {\n      headers: { 'content-type': 'image/png' },\n    }));\n    const result = await prefetchImageToCourse(\n      'demo',\n      'https://example.com/x.png',\n      { fetchImpl, maxBytes: 4 },\n    );\n    expect(result).toBeNull();\n  });\n});\n\ndescribe('prefetchLessonImages', () => {\n  const baseLesson: Lesson = {\n    schemaVersion: 1,\n    slug: 'l1',\n    courseSlug: 'demo',\n    moduleId: 'm1',\n    title: 'L',\n    eyebrow: 'INTRO',\n    description: 'd',\n    estimatedMinutes: 10,\n    sections: [],\n  };\n\n  it('rewrites Image sections with external URLs to local paths', async () => {\n    const url = 'https://example.com/photo.png';\n    const fetchImpl = makeFakeFetch(() => new Response(new Uint8Array(PNG_BYTES), {\n      headers: { 'content-type': 'image/png' },\n    }));\n    const lesson: Lesson = {\n      ...baseLesson,\n      sections: [\n        {\n          id: 's-img',\n          title: 'Photo',\n          type: 'image',\n          data: { src: url, alt: 'A photo', maxWidth: '100%' },\n        },\n      ],\n    };\n    const { lesson: out, failures } = await prefetchLessonImages('demo', lesson, { fetchImpl });\n    expect(failures).toEqual([]);\n    const section = out.sections[0];\n    if (section.type !== 'image') throw new Error('expected image section');\n    expect(section.data.src).toBe(\n      `/api/courses/demo/assets/images/${hashUrlToFilename(url, '.png')}`,\n    );\n    // Non-image fields preserved.\n    expect(section.data.alt).toBe('A photo');\n    expect(section.id).toBe('s-img');\n  });\n\n  it('leaves local paths untouched (no fetch)', async () => {\n    const fetchImpl = makeFakeFetch(() => new Response('should not be called'));\n    const lesson: Lesson = {\n      ...baseLesson,\n      sections: [\n        {\n          id: 's-img',\n          title: 'Local',\n          type: 'image',\n          data: { src: '/api/courses/demo/assets/images/abc.png', alt: 'A', maxWidth: '100%' },\n        },\n      ],\n    };\n    const { lesson: out, failures } = await prefetchLessonImages('demo', lesson, { fetchImpl });\n    expect(failures).toEqual([]);\n    const section = out.sections[0];\n    if (section.type !== 'image') throw new Error('expected image section');\n    expect(section.data.src).toBe('/api/courses/demo/assets/images/abc.png');\n    expect(fetchImpl.calls).toBe(0);\n  });\n\n  it('records a failure but keeps original URL when fetch fails (graceful degradation)', async () => {\n    const url = 'https://example.com/down.png';\n    const fetchImpl = makeFakeFetch(() => new Response('boom', { status: 500 }));\n    const lesson: Lesson = {\n      ...baseLesson,\n      sections: [\n        {\n          id: 's-img',\n          title: 'Photo',\n          type: 'image',\n          data: { src: url, alt: 'A photo', maxWidth: '100%' },\n        },\n      ],\n    };\n    const { lesson: out, failures } = await prefetchLessonImages('demo', lesson, { fetchImpl });\n    expect(failures).toHaveLength(1);\n    expect(failures[0].url).toBe(url);\n    const section = out.sections[0];\n    if (section.type !== 'image') throw new Error('expected image section');\n    expect(section.data.src).toBe(url);\n  });\n\n  it('ignores non-image sections', async () => {\n    const fetchImpl = makeFakeFetch(() => new Response('should not be called'));\n    const lesson: Lesson = {\n      ...baseLesson,\n      sections: [\n        {\n          id: 's-th',\n          title: 'Read',\n          type: 'theory',\n          data: { markdown: '# hi' },\n        },\n      ],\n    };\n    const { lesson: out, failures } = await prefetchLessonImages('demo', lesson, { fetchImpl });\n    expect(failures).toEqual([]);\n    expect(out.sections[0].type).toBe('theory');\n    expect(fetchImpl.calls).toBe(0);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
