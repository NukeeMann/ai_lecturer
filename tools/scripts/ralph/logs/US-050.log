{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_015vev2XTtmJpbGv5KGhS6cP","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PYqrbHxXXVCz8bGP4PKyWo","name":"Write","input":{"file_path":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/widgets/Image/ImageWidget.tsx","content":"'use client';\n\nimport type { CSSProperties } from 'react';\n\nimport { ImageDataSchema, type ImageData } from './schema';\n\nexport interface ImageWidgetProps {\n  data: ImageData;\n}\n\nconst wrapStyle: CSSProperties = {\n  display: 'flex',\n  flexDirection: 'column',\n};\n\nconst figureStyle: CSSProperties = {\n  margin: 0,\n  padding: 'var(--space-4) var(--space-5)',\n  background: 'var(--bg-subtle)',\n  display: 'flex',\n  flexDirection: 'column',\n  alignItems: 'center',\n  gap: 'var(--space-3)',\n};\n\nconst imgStyle: CSSProperties = {\n  display: 'block',\n  width: '100%',\n  height: 'auto',\n  objectFit: 'contain',\n  borderRadius: 'var(--radius-md)',\n  border: '1px solid var(--border)',\n  background: 'var(--bg-elevated)',\n};\n\nconst captionStyle: CSSProperties = {\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text-secondary)',\n  textAlign: 'center',\n  lineHeight: 1.5,\n};\n\nconst attributionStyle: CSSProperties = {\n  fontSize: 'var(--fs-xs)',\n  color: 'var(--text-tertiary)',\n  marginLeft: 6,\n};\n\nconst attributionLinkStyle: CSSProperties = {\n  ...attributionStyle,\n  textDecoration: 'underline',\n};\n\nexport function ImageWidget({ data: rawData }: ImageWidgetProps) {\n  const data = ImageDataSchema.parse(rawData);\n  const { src, alt, caption, attribution, maxWidth } = data;\n\n  return (\n    <div data-image-widget style={wrapStyle}>\n      <figure data-image-figure style={figureStyle}>\n        <div style={{ width: '100%', maxWidth, display: 'flex', justifyContent: 'center' }}>\n          {/* eslint-disable-next-line @next/next/no-img-element */}\n          <img\n            data-testid=\"image-widget-img\"\n            src={src}\n            alt={alt}\n            style={imgStyle}\n          />\n        </div>\n        {(caption || attribution) && (\n          <figcaption data-testid=\"image-widget-figcaption\" style={captionStyle}>\n            {caption && <span data-testid=\"image-widget-caption\">{caption}</span>}\n            {attribution && (\n              attribution.url ? (\n                <a\n                  href={attribution.url}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  data-testid=\"image-widget-attribution-link\"\n                  style={attributionLinkStyle}\n                >\n                  {attribution.text}\n                </a>\n              ) : (\n                <span\n                  data-testid=\"image-widget-attribution-text\"\n                  style={attributionStyle}\n                >\n                  {attribution.text}\n                </span>\n              )\n            )}\n          </figcaption>\n        )}\n      </figure>\n    </div>\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":445,"cache_read_input_tokens":117146,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":445},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"29a06e66-8421-4065-a9de-e789a4f35716"}
