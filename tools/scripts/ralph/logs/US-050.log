{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_014XYN94mVumhMiEhGPpyw1h","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01S8uUM9i73F16qxU9Ddibca","name":"Write","input":{"file_path":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/widgets/Image/ImageEditor.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useMemo,\n  useState,\n  type CSSProperties,\n} from 'react';\nimport type { z } from 'zod';\n\nimport {\n  EditorFormFooter,\n  EditorFormSaveError,\n  errorTextStyle,\n  fieldStyle,\n  formBodyStyle,\n  inputStyle,\n  labelStyle,\n  textareaStyle,\n  type FieldErrors,\n} from '@/components/EditorForm';\nimport { SourcesField } from '@/components/Sources';\nimport type { Source } from '@/lib/schemas/lesson';\n\nimport { ImageDataSchema, type ImageData } from './schema';\n\nexport interface ImageEditorProps {\n  initial: ImageData;\n  initialSources?: Source[];\n  onCancel: () => void;\n  onSave: (next: ImageData, sources?: Source[]) => Promise<void>;\n}\n\nfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n  const out: FieldErrors = {};\n  for (const issue of error.issues) {\n    const path = issue.path.join('.') || '_root';\n    if (!out[path]) out[path] = issue.message;\n  }\n  return out;\n}\n\nconst inlineRowStyle: CSSProperties = {\n  display: 'flex',\n  flexWrap: 'wrap',\n  gap: 'var(--space-3)',\n  alignItems: 'flex-start',\n};\n\nexport function ImageEditor({\n  initial,\n  initialSources,\n  onCancel,\n  onSave,\n}: ImageEditorProps) {\n  const [src, setSrc] = useState(initial.src);\n  const [alt, setAlt] = useState(initial.alt);\n  const [caption, setCaption] = useState(initial.caption ?? '');\n  const [attributionText, setAttributionText] = useState(initial.attribution?.text ?? '');\n  const [attributionUrl, setAttributionUrl] = useState(initial.attribution?.url ?? '');\n  const [maxWidth, setMaxWidth] = useState(initial.maxWidth ?? '100%');\n  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n  const [errors, setErrors] = useState<FieldErrors>({});\n  const [saving, setSaving] = useState(false);\n  const [saveError, setSaveError] = useState<string | null>(null);\n\n  const current: ImageData = useMemo(() => {\n    const obj: ImageData = {\n      src,\n      alt,\n      maxWidth: maxWidth.trim() || '100%',\n    };\n    if (caption.trim()) obj.caption = caption;\n    if (attributionText.trim()) {\n      obj.attribution = { text: attributionText.trim() };\n      if (attributionUrl.trim()) obj.attribution.url = attributionUrl.trim();\n    }\n    return obj;\n  }, [src, alt, caption, attributionText, attributionUrl, maxWidth]);\n\n  const dirty = useMemo(() => {\n    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n  }, [current, initial, sources, initialSources]);\n\n  const handleSave = useCallback(async () => {\n    if (!dirty || saving) return;\n    const result = ImageDataSchema.safeParse(current);\n    if (!result.success) {\n      setErrors(flattenIssues(result.error));\n      return;\n    }\n    setErrors({});\n    setSaveError(null);\n    setSaving(true);\n    try {\n      await onSave(result.data, sources);\n      setSaving(false);\n    } catch (err) {\n      setSaveError(err instanceof Error ? err.message : String(err));\n      setSaving(false);\n    }\n  }, [current, dirty, onSave, saving, sources]);\n\n  const srcError = errors.src;\n  const altError = errors.alt;\n  const attrTextError = errors['attribution.text'];\n  const attrUrlError = errors['attribution.url'];\n\n  return (\n    <div\n      data-testid=\"image-editor\"\n      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n    >\n      <div style={formBodyStyle}>\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Image src (URL or asset path)</span>\n          <input\n            type=\"text\"\n            data-testid=\"image-edit-src\"\n            value={src}\n            onChange={(e) => setSrc(e.target.value)}\n            spellCheck={false}\n            placeholder=\"https://example.com/photo.jpg\"\n            style={{\n              ...inputStyle,\n              fontFamily: 'var(--font-mono)',\n              borderColor: srcError ? 'var(--danger-border)' : undefined,\n            }}\n          />\n          {srcError && (\n            <div data-testid=\"image-edit-src-error\" style={errorTextStyle}>\n              {srcError}\n            </div>\n          )}\n        </label>\n\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Alt text (required)</span>\n          <input\n            type=\"text\"\n            data-testid=\"image-edit-alt\"\n            value={alt}\n            onChange={(e) => setAlt(e.target.value)}\n            style={{\n              ...inputStyle,\n              borderColor: altError ? 'var(--danger-border)' : undefined,\n            }}\n          />\n          {altError && (\n            <div data-testid=\"image-edit-alt-error\" style={errorTextStyle}>\n              {altError}\n            </div>\n          )}\n        </label>\n\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Caption (optional)</span>\n          <textarea\n            data-testid=\"image-edit-caption\"\n            value={caption}\n            onChange={(e) => setCaption(e.target.value)}\n            style={{ ...textareaStyle, minHeight: 60 }}\n          />\n        </label>\n\n        <div style={inlineRowStyle}>\n          <label style={{ ...fieldStyle, flex: 1, minWidth: 160 }}>\n            <span style={labelStyle}>Attribution text (optional)</span>\n            <input\n              type=\"text\"\n              data-testid=\"image-edit-attribution-text\"\n              value={attributionText}\n              onChange={(e) => setAttributionText(e.target.value)}\n              placeholder=\"Photo by Jane Doe\"\n              style={{\n                ...inputStyle,\n                borderColor: attrTextError ? 'var(--danger-border)' : undefined,\n              }}\n            />\n            {attrTextError && (\n              <div style={errorTextStyle}>{attrTextError}</div>\n            )}\n          </label>\n          <label style={{ ...fieldStyle, flex: 1, minWidth: 160 }}>\n            <span style={labelStyle}>Attribution URL (optional)</span>\n            <input\n              type=\"text\"\n              data-testid=\"image-edit-attribution-url\"\n              value={attributionUrl}\n              onChange={(e) => setAttributionUrl(e.target.value)}\n              placeholder=\"https://source.example/page\"\n              style={{\n                ...inputStyle,\n                fontFamily: 'var(--font-mono)',\n                borderColor: attrUrlError ? 'var(--danger-border)' : undefined,\n              }}\n            />\n            {attrUrlError && (\n              <div style={errorTextStyle}>{attrUrlError}</div>\n            )}\n          </label>\n        </div>\n\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Max width (px or %, default 100%)</span>\n          <input\n            type=\"text\"\n            data-testid=\"image-edit-max-width\"\n            value={maxWidth}\n            onChange={(e) => setMaxWidth(e.target.value)}\n            placeholder=\"100%\"\n            style={{ ...inputStyle, width: 160 }}\n          />\n        </label>\n\n        <SourcesField sources={sources} onChange={setSources} />\n      </div>\n\n      <EditorFormSaveError message={saveError} />\n      <EditorFormFooter\n        saving={saving}\n        saveDisabled={!dirty}\n        onCancel={onCancel}\n        onSave={() => void handleSave()}\n        cancelTestId=\"image-edit-cancel\"\n        saveTestId=\"image-edit-save\"\n      />\n    </div>\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1228,"cache_read_input_tokens":117591,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1228},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"53008248-2595-4d64-ba5a-6909b410bf75"}
