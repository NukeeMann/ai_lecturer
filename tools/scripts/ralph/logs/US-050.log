{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TZv4jwW1bGvVBLximM1nzy","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport {\n4\t  useCallback,\n5\t  useEffect,\n6\t  useMemo,\n7\t  useRef,\n8\t  useState,\n9\t  type CSSProperties,\n10\t} from 'react';\n11\timport { Upload } from 'lucide-react';\n12\timport { EditorState } from '@codemirror/state';\n13\timport { EditorView, keymap, lineNumbers } from '@codemirror/view';\n14\timport {\n15\t  defaultKeymap,\n16\t  history,\n17\t  historyKeymap,\n18\t  indentWithTab,\n19\t} from '@codemirror/commands';\n20\timport {\n21\t  bracketMatching,\n22\t  indentOnInput,\n23\t  syntaxHighlighting,\n24\t} from '@codemirror/language';\n25\timport { python } from '@codemirror/lang-python';\n26\timport type { z } from 'zod';\n27\t\n28\timport {\n29\t  EditorFormFooter,\n30\t  EditorFormSaveError,\n31\t  errorTextStyle,\n32\t  fieldStyle,\n33\t  formBodyStyle,\n34\t  inputStyle,\n35\t  labelStyle,\n36\t  textareaStyle,\n37\t  type FieldErrors,\n38\t} from '@/components/EditorForm';\n39\timport { SourcesField } from '@/components/Sources';\n40\timport type { Source } from '@/lib/schemas/lesson';\n41\t\n42\timport {\n43\t  codeRunnerEditorTheme,\n44\t  codeRunnerHighlightStyle,\n45\t} from '../Code/CodeRunner';\n46\timport { PlotImageDataSchema, type PlotImageData } from './schema';\n47\t\n48\texport interface PlotImageEditorProps {\n49\t  initial: PlotImageData;\n50\t  initialSources?: Source[];\n51\t  courseSlug: string;\n52\t  onCancel: () => void;\n53\t  onSave: (next: PlotImageData, sources?: Source[]) => Promise<void>;\n54\t}\n55\t\n56\tfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n57\t  const out: FieldErrors = {};\n58\t  for (const issue of error.issues) {\n59\t    const path = issue.path.join('.') || '_root';\n60\t    if (!out[path]) out[path] = issue.message;\n61\t  }\n62\t  return out;\n63\t}\n64\t\n65\tconst cmContainerStyle: CSSProperties = {\n66\t  background: 'var(--code-bg)',\n67\t  border: '1px solid var(--border-strong)',\n68\t  borderRadius: 'var(--radius-md)',\n69\t  overflow: 'hidden',\n70\t};\n71\t\n72\tconst uploadButtonStyle: CSSProperties = {\n73\t  display: 'inline-flex',\n74\t  alignItems: 'center',\n75\t  gap: 6,\n76\t  padding: '6px 10px',\n77\t  background: 'transparent',\n78\t  border: '1px dashed var(--border-strong)',\n79\t  borderRadius: 'var(--radius-md)',\n80\t  color: 'var(--text-secondary)',\n81\t  fontSize: 'var(--fs-xs)',\n82\t  fontWeight: 500,\n83\t  cursor: 'pointer',\n84\t  marginTop: 6,\n85\t};\n86\t\n87\tconst segmentedRowStyle: CSSProperties = {\n88\t  display: 'inline-flex',\n89\t  border: '1px solid var(--border-strong)',\n90\t  borderRadius: 'var(--radius-md)',\n91\t  overflow: 'hidden',\n92\t};\n93\t\n94\tfunction segmentedButtonStyle(active: boolean): CSSProperties {\n95\t  return {\n96\t    padding: '4px 12px',\n97\t    fontSize: 'var(--fs-xs)',\n98\t    fontWeight: 500,\n99\t    background: active ? 'var(--accent-subtle)' : 'transparent',\n100\t    color: active ? 'var(--accent-text)' : 'var(--text-secondary)',\n101\t    border: 'none',\n102\t    cursor: 'pointer',\n103\t  };\n104\t}\n105\t\n106\tinterface SourceCodeEditorProps {\n107\t  initial: string;\n108\t  language: 'python' | 'r';\n109\t  onChange: (value: string) => void;\n110\t}\n111\t\n112\tfunction SourceCodeEditor({ initial, language, onChange }: SourceCodeEditorProps) {\n113\t  const parentRef = useRef<HTMLDivElement | null>(null);\n114\t  const onChangeRef = useRef(onChange);\n115\t\n116\t  useEffect(() => {\n117\t    onChangeRef.current = onChange;\n118\t  }, [onChange]);\n119\t\n120\t  useEffect(() => {\n121\t    if (!parentRef.current) return;\n122\t    const langExtensions = language === 'python' ? [python()] : [];\n123\t    const updateListener = EditorView.updateListener.of((update) => {\n124\t      if (update.docChanged) {\n125\t        onChangeRef.current(update.state.doc.toString());\n126\t      }\n127\t    });\n128\t    const view = new EditorView({\n129\t      parent: parentRef.current,\n130\t      state: EditorState.create({\n131\t        doc: initial,\n132\t        extensions: [\n133\t          lineNumbers(),\n134\t          history(),\n135\t          indentOnInput(),\n136\t          bracketMatching(),\n137\t          ...langExtensions,\n138\t          syntaxHighlighting(codeRunnerHighlightStyle),\n139\t          codeRunnerEditorTheme,\n140\t          keymap.of([...defaultKeymap, ...historyKeymap, indentWithTab]),\n141\t          updateListener,\n142\t        ],\n143\t      }),\n144\t    });\n145\t    return () => {\n146\t      view.destroy();\n147\t    };\n148\t    // Re-mount when language changes so the python() extension is added/removed.\n149\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n150\t  }, [language]);\n151\t\n152\t  return <div ref={parentRef} data-testid=\"plotimage-edit-source-code\" style={cmContainerStyle} />;\n153\t}\n154\t\n155\texport function PlotImageEditor({\n156\t  initial,\n157\t  initialSources,\n158\t  courseSlug,\n159\t  onCancel,\n160\t  onSave,\n161\t}: PlotImageEditorProps) {\n162\t  const [src, setSrc] = useState(initial.src);\n163\t  const [alt, setAlt] = useState(initial.alt);\n164\t  const [caption, setCaption] = useState(initial.caption ?? '');\n165\t  const [sourceCode, setSourceCode] = useState<string>(initial.sourceCode ?? '');\n166\t  const [sourceLanguage, setSourceLanguage] = useState<'python' | 'r'>(\n167\t    initial.sourceLanguage ?? 'python',\n168\t  );\n169\t  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n170\t  const [errors, setErrors] = useState<FieldErrors>({});\n171\t  const [saving, setSaving] = useState(false);\n172\t  const [saveError, setSaveError] = useState<string | null>(null);\n173\t  const [uploading, setUploading] = useState(false);\n174\t  const [uploadError, setUploadError] = useState<string | null>(null);\n175\t  const fileInputRef = useRef<HTMLInputElement | null>(null);\n176\t\n177\t  const current: PlotImageData = useMemo(() => {\n178\t    const obj: PlotImageData = { src, alt };\n179\t    if (caption.trim()) obj.caption = caption;\n180\t    if (sourceCode.trim()) {\n181\t      obj.sourceCode = sourceCode;\n182\t      obj.sourceLanguage = sourceLanguage;\n183\t    }\n184\t    return obj;\n185\t  }, [src, alt, caption, sourceCode, sourceLanguage]);\n186\t\n187\t  const dirty = useMemo(() => {\n188\t    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n189\t    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n190\t  }, [current, initial, sources, initialSources]);\n191\t\n192\t  const handleSave = useCallback(async () => {\n193\t    if (!dirty || saving) return;\n194\t    const result = PlotImageDataSchema.safeParse(current);\n195\t    if (!result.success) {\n196\t      setErrors(flattenIssues(result.error));\n197\t      return;\n198\t    }\n199\t    setErrors({});\n200\t    setSaveError(null);\n201\t    setSaving(true);\n202\t    try {\n203\t      await onSave(result.data, sources);\n204\t      setSaving(false);\n205\t    } catch (err) {\n206\t      setSaveError(err instanceof Error ? err.message : String(err));\n207\t      setSaving(false);\n208\t    }\n209\t  }, [current, dirty, onSave, saving, sources]);\n210\t\n211\t  const handleFileChange = useCallback(\n212\t    async (event: React.ChangeEvent<HTMLInputElement>) => {\n213\t      const file = event.target.files?.[0];\n214\t      if (!file) return;\n215\t      setUploadError(null);\n216\t      setUploading(true);\n217\t      try {\n218\t        const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '-');\n219\t        const url = `/api/courses/${encodeURIComponent(courseSlug)}/assets/plots/${encodeURIComponent(safeName)}`;\n220\t        const res = await fetch(url, {\n221\t          method: 'PUT',\n222\t          headers: { 'Content-Type': file.type || 'application/octet-stream' },\n223\t          body: file,\n224\t        });\n225\t        if (!res.ok) {\n226\t          const detail = await res.text().catch(() => '');\n227\t          throw new Error(`Upload failed (${res.status}) ${detail}`);\n228\t        }\n229\t        const body = (await res.json()) as { src: string };\n230\t        setSrc(body.src);\n231\t      } catch (err) {\n232\t        setUploadError(err instanceof Error ? err.message : String(err));\n233\t      } finally {\n234\t        setUploading(false);\n235\t        if (fileInputRef.current) fileInputRef.current.value = '';\n236\t      }\n237\t    },\n238\t    [courseSlug],\n239\t  );\n240\t\n241\t  const srcError = errors.src;\n242\t  const altError = errors.alt;\n243\t\n244\t  return (\n245\t    <div\n246\t      data-testid=\"plotimage-editor\"\n247\t      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n248\t    >\n249\t      <div style={formBodyStyle}>\n250\t        <label style={fieldStyle}>\n251\t          <span style={labelStyle}>Image src (URL or asset path)</span>\n252\t          <input\n253\t            type=\"text\"\n254\t            data-testid=\"plotimage-edit-src\"\n255\t            value={src}\n256\t            onChange={(e) => setSrc(e.target.value)}\n257\t            spellCheck={false}\n258\t            style={{\n259\t              ...inputStyle,\n260\t              fontFamily: 'var(--font-mono)',\n261\t              borderColor: srcError ? 'var(--danger-border)' : undefined,\n262\t            }}\n263\t          />\n264\t          {srcError && (\n265\t            <div data-testid=\"plotimage-edit-src-error\" style={errorTextStyle}>\n266\t              {srcError}\n267\t            </div>\n268\t          )}\n269\t          <div>\n270\t            <input\n271\t              ref={fileInputRef}\n272\t              type=\"file\"\n273\t              accept=\"image/png,image/jpeg,image/svg+xml\"\n274\t              onChange={(e) => void handleFileChange(e)}\n275\t              style={{ display: 'none' }}\n276\t              data-testid=\"plotimage-edit-file-input\"\n277\t            />\n278\t            <button\n279\t              type=\"button\"\n280\t              onClick={() => fileInputRef.current?.click()}\n281\t              disabled={uploading}\n282\t              data-testid=\"plotimage-edit-upload\"\n283\t              style={{\n284\t                ...uploadButtonStyle,\n285\t                cursor: uploading ? 'not-allowed' : 'pointer',\n286\t                opacity: uploading ? 0.7 : 1,\n287\t              }}\n288\t            >\n289\t              <Upload size={12} aria-hidden />\n290\t              {uploading ? 'Uploading…' : 'Upload image'}\n291\t            </button>\n292\t            {uploadError && (\n293\t              <div data-testid=\"plotimage-edit-upload-error\" style={errorTextStyle}>\n294\t                {uploadError}\n295\t              </div>\n296\t            )}\n297\t          </div>\n298\t        </label>\n299\t\n300\t        <label style={fieldStyle}>\n301\t          <span style={labelStyle}>Alt text (required)</span>\n302\t          <input\n303\t            type=\"text\"\n304\t            data-testid=\"plotimage-edit-alt\"\n305\t            value={alt}\n306\t            onChange={(e) => setAlt(e.target.value)}\n307\t            style={{\n308\t              ...inputStyle,\n309\t              borderColor: altError ? 'var(--danger-border)' : undefined,\n310\t            }}\n311\t          />\n312\t          {altError && (\n313\t            <div data-testid=\"plotimage-edit-alt-error\" style={errorTextStyle}>\n314\t              {altError}\n315\t            </div>\n316\t          )}\n317\t        </label>\n318\t\n319\t        <label style={fieldStyle}>\n320\t          <span style={labelStyle}>Caption (optional)</span>\n321\t          <textarea\n322\t            data-testid=\"plotimage-edit-caption\"\n323\t            value={caption}\n324\t            onChange={(e) => setCaption(e.target.value)}\n325\t            style={{ ...textareaStyle, minHeight: 60 }}\n326\t          />\n327\t        </label>\n328\t\n329\t        <div style={fieldStyle}>\n330\t          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 6 }}>\n331\t            <span style={{ ...labelStyle, marginBottom: 0 }}>Source code (optional)</span>\n332\t            <div style={segmentedRowStyle} role=\"tablist\" aria-label=\"Source language\">\n333\t              <button\n334\t                type=\"button\"\n335\t                role=\"tab\"\n336\t                aria-selected={sourceLanguage === 'python'}\n337\t                data-testid=\"plotimage-edit-lang-python\"\n338\t                onClick={() => setSourceLanguage('python')}\n339\t                style={segmentedButtonStyle(sourceLanguage === 'python')}\n340\t              >\n341\t                Python\n342\t              </button>\n343\t              <button\n344\t                type=\"button\"\n345\t                role=\"tab\"\n346\t                aria-selected={sourceLanguage === 'r'}\n347\t                data-testid=\"plotimage-edit-lang-r\"\n348\t                onClick={() => setSourceLanguage('r')}\n349\t                style={segmentedButtonStyle(sourceLanguage === 'r')}\n350\t              >\n351\t                R\n352\t              </button>\n353\t            </div>\n354\t          </div>\n355\t          <SourceCodeEditor\n356\t            key={sourceLanguage}\n357\t            initial={sourceCode}\n358\t            language={sourceLanguage}\n359\t            onChange={setSourceCode}\n360\t          />\n361\t        </div>\n362\t\n363\t        <SourcesField sources={sources} onChange={setSources} />\n364\t      </div>\n365\t\n366\t      <EditorFormSaveError message={saveError} />\n367\t      <EditorFormFooter\n368\t        saving={saving}\n369\t        saveDisabled={!dirty}\n370\t        onCancel={onCancel}\n371\t        onSave={() => void handleSave()}\n372\t        cancelTestId=\"plotimage-edit-cancel\"\n373\t        saveTestId=\"plotimage-edit-save\"\n374\t      />\n375\t    </div>\n376\t  );\n377\t}\n378\t"}]},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"49f4b27c-8147-48b9-9c3d-b81fc04b45a5","timestamp":"2026-05-04T00:40:23.413Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/widgets/PlotImage/PlotImageEditor.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useEffect,\n  useMemo,\n  useRef,\n  useState,\n  type CSSProperties,\n} from 'react';\nimport { Upload } from 'lucide-react';\nimport { EditorState } from '@codemirror/state';\nimport { EditorView, keymap, lineNumbers } from '@codemirror/view';\nimport {\n  defaultKeymap,\n  history,\n  historyKeymap,\n  indentWithTab,\n} from '@codemirror/commands';\nimport {\n  bracketMatching,\n  indentOnInput,\n  syntaxHighlighting,\n} from '@codemirror/language';\nimport { python } from '@codemirror/lang-python';\nimport type { z } from 'zod';\n\nimport {\n  EditorFormFooter,\n  EditorFormSaveError,\n  errorTextStyle,\n  fieldStyle,\n  formBodyStyle,\n  inputStyle,\n  labelStyle,\n  textareaStyle,\n  type FieldErrors,\n} from '@/components/EditorForm';\nimport { SourcesField } from '@/components/Sources';\nimport type { Source } from '@/lib/schemas/lesson';\n\nimport {\n  codeRunnerEditorTheme,\n  codeRunnerHighlightStyle,\n} from '../Code/CodeRunner';\nimport { PlotImageDataSchema, type PlotImageData } from './schema';\n\nexport interface PlotImageEditorProps {\n  initial: PlotImageData;\n  initialSources?: Source[];\n  courseSlug: string;\n  onCancel: () => void;\n  onSave: (next: PlotImageData, sources?: Source[]) => Promise<void>;\n}\n\nfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n  const out: FieldErrors = {};\n  for (const issue of error.issues) {\n    const path = issue.path.join('.') || '_root';\n    if (!out[path]) out[path] = issue.message;\n  }\n  return out;\n}\n\nconst cmContainerStyle: CSSProperties = {\n  background: 'var(--code-bg)',\n  border: '1px solid var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  overflow: 'hidden',\n};\n\nconst uploadButtonStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 6,\n  padding: '6px 10px',\n  background: 'transparent',\n  border: '1px dashed var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  color: 'var(--text-secondary)',\n  fontSize: 'var(--fs-xs)',\n  fontWeight: 500,\n  cursor: 'pointer',\n  marginTop: 6,\n};\n\nconst segmentedRowStyle: CSSProperties = {\n  display: 'inline-flex',\n  border: '1px solid var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  overflow: 'hidden',\n};\n\nfunction segmentedButtonStyle(active: boolean): CSSProperties {\n  return {\n    padding: '4px 12px',\n    fontSize: 'var(--fs-xs)',\n    fontWeight: 500,\n    background: active ? 'var(--accent-subtle)' : 'transparent',\n    color: active ? 'var(--accent-text)' : 'var(--text-secondary)',\n    border: 'none',\n    cursor: 'pointer',\n  };\n}\n\ninterface SourceCodeEditorProps {\n  initial: string;\n  language: 'python' | 'r';\n  onChange: (value: string) => void;\n}\n\nfunction SourceCodeEditor({ initial, language, onChange }: SourceCodeEditorProps) {\n  const parentRef = useRef<HTMLDivElement | null>(null);\n  const onChangeRef = useRef(onChange);\n\n  useEffect(() => {\n    onChangeRef.current = onChange;\n  }, [onChange]);\n\n  useEffect(() => {\n    if (!parentRef.current) return;\n    const langExtensions = language === 'python' ? [python()] : [];\n    const updateListener = EditorView.updateListener.of((update) => {\n      if (update.docChanged) {\n        onChangeRef.current(update.state.doc.toString());\n      }\n    });\n    const view = new EditorView({\n      parent: parentRef.current,\n      state: EditorState.create({\n        doc: initial,\n        extensions: [\n          lineNumbers(),\n          history(),\n          indentOnInput(),\n          bracketMatching(),\n          ...langExtensions,\n          syntaxHighlighting(codeRunnerHighlightStyle),\n          codeRunnerEditorTheme,\n          keymap.of([...defaultKeymap, ...historyKeymap, indentWithTab]),\n          updateListener,\n        ],\n      }),\n    });\n    return () => {\n      view.destroy();\n    };\n    // Re-mount when language changes so the python() extension is added/removed.\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [language]);\n\n  return <div ref={parentRef} data-testid=\"plotimage-edit-source-code\" style={cmContainerStyle} />;\n}\n\nexport function PlotImageEditor({\n  initial,\n  initialSources,\n  courseSlug,\n  onCancel,\n  onSave,\n}: PlotImageEditorProps) {\n  const [src, setSrc] = useState(initial.src);\n  const [alt, setAlt] = useState(initial.alt);\n  const [caption, setCaption] = useState(initial.caption ?? '');\n  const [sourceCode, setSourceCode] = useState<string>(initial.sourceCode ?? '');\n  const [sourceLanguage, setSourceLanguage] = useState<'python' | 'r'>(\n    initial.sourceLanguage ?? 'python',\n  );\n  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n  const [errors, setErrors] = useState<FieldErrors>({});\n  const [saving, setSaving] = useState(false);\n  const [saveError, setSaveError] = useState<string | null>(null);\n  const [uploading, setUploading] = useState(false);\n  const [uploadError, setUploadError] = useState<string | null>(null);\n  const fileInputRef = useRef<HTMLInputElement | null>(null);\n\n  const current: PlotImageData = useMemo(() => {\n    const obj: PlotImageData = { src, alt };\n    if (caption.trim()) obj.caption = caption;\n    if (sourceCode.trim()) {\n      obj.sourceCode = sourceCode;\n      obj.sourceLanguage = sourceLanguage;\n    }\n    return obj;\n  }, [src, alt, caption, sourceCode, sourceLanguage]);\n\n  const dirty = useMemo(() => {\n    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n  }, [current, initial, sources, initialSources]);\n\n  const handleSave = useCallback(async () => {\n    if (!dirty || saving) return;\n    const result = PlotImageDataSchema.safeParse(current);\n    if (!result.success) {\n      setErrors(flattenIssues(result.error));\n      return;\n    }\n    setErrors({});\n    setSaveError(null);\n    setSaving(true);\n    try {\n      await onSave(result.data, sources);\n      setSaving(false);\n    } catch (err) {\n      setSaveError(err instanceof Error ? err.message : String(err));\n      setSaving(false);\n    }\n  }, [current, dirty, onSave, saving, sources]);\n\n  const handleFileChange = useCallback(\n    async (event: React.ChangeEvent<HTMLInputElement>) => {\n      const file = event.target.files?.[0];\n      if (!file) return;\n      setUploadError(null);\n      setUploading(true);\n      try {\n        const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '-');\n        const url = `/api/courses/${encodeURIComponent(courseSlug)}/assets/plots/${encodeURIComponent(safeName)}`;\n        const res = await fetch(url, {\n          method: 'PUT',\n          headers: { 'Content-Type': file.type || 'application/octet-stream' },\n          body: file,\n        });\n        if (!res.ok) {\n          const detail = await res.text().catch(() => '');\n          throw new Error(`Upload failed (${res.status}) ${detail}`);\n        }\n        const body = (await res.json()) as { src: string };\n        setSrc(body.src);\n      } catch (err) {\n        setUploadError(err instanceof Error ? err.message : String(err));\n      } finally {\n        setUploading(false);\n        if (fileInputRef.current) fileInputRef.current.value = '';\n      }\n    },\n    [courseSlug],\n  );\n\n  const srcError = errors.src;\n  const altError = errors.alt;\n\n  return (\n    <div\n      data-testid=\"plotimage-editor\"\n      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n    >\n      <div style={formBodyStyle}>\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Image src (URL or asset path)</span>\n          <input\n            type=\"text\"\n            data-testid=\"plotimage-edit-src\"\n            value={src}\n            onChange={(e) => setSrc(e.target.value)}\n            spellCheck={false}\n            style={{\n              ...inputStyle,\n              fontFamily: 'var(--font-mono)',\n              borderColor: srcError ? 'var(--danger-border)' : undefined,\n            }}\n          />\n          {srcError && (\n            <div data-testid=\"plotimage-edit-src-error\" style={errorTextStyle}>\n              {srcError}\n            </div>\n          )}\n          <div>\n            <input\n              ref={fileInputRef}\n              type=\"file\"\n              accept=\"image/png,image/jpeg,image/svg+xml\"\n              onChange={(e) => void handleFileChange(e)}\n              style={{ display: 'none' }}\n              data-testid=\"plotimage-edit-file-input\"\n            />\n            <button\n              type=\"button\"\n              onClick={() => fileInputRef.current?.click()}\n              disabled={uploading}\n              data-testid=\"plotimage-edit-upload\"\n              style={{\n                ...uploadButtonStyle,\n                cursor: uploading ? 'not-allowed' : 'pointer',\n                opacity: uploading ? 0.7 : 1,\n              }}\n            >\n              <Upload size={12} aria-hidden />\n              {uploading ? 'Uploading…' : 'Upload image'}\n            </button>\n            {uploadError && (\n              <div data-testid=\"plotimage-edit-upload-error\" style={errorTextStyle}>\n                {uploadError}\n              </div>\n            )}\n          </div>\n        </label>\n\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Alt text (required)</span>\n          <input\n            type=\"text\"\n            data-testid=\"plotimage-edit-alt\"\n            value={alt}\n            onChange={(e) => setAlt(e.target.value)}\n            style={{\n              ...inputStyle,\n              borderColor: altError ? 'var(--danger-border)' : undefined,\n            }}\n          />\n          {altError && (\n            <div data-testid=\"plotimage-edit-alt-error\" style={errorTextStyle}>\n              {altError}\n            </div>\n          )}\n        </label>\n\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Caption (optional)</span>\n          <textarea\n            data-testid=\"plotimage-edit-caption\"\n            value={caption}\n            onChange={(e) => setCaption(e.target.value)}\n            style={{ ...textareaStyle, minHeight: 60 }}\n          />\n        </label>\n\n        <div style={fieldStyle}>\n          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 6 }}>\n            <span style={{ ...labelStyle, marginBottom: 0 }}>Source code (optional)</span>\n            <div style={segmentedRowStyle} role=\"tablist\" aria-label=\"Source language\">\n              <button\n                type=\"button\"\n                role=\"tab\"\n                aria-selected={sourceLanguage === 'python'}\n                data-testid=\"plotimage-edit-lang-python\"\n                onClick={() => setSourceLanguage('python')}\n                style={segmentedButtonStyle(sourceLanguage === 'python')}\n              >\n                Python\n              </button>\n              <button\n                type=\"button\"\n                role=\"tab\"\n                aria-selected={sourceLanguage === 'r'}\n                data-testid=\"plotimage-edit-lang-r\"\n                onClick={() => setSourceLanguage('r')}\n                style={segmentedButtonStyle(sourceLanguage === 'r')}\n              >\n                R\n              </button>\n            </div>\n          </div>\n          <SourceCodeEditor\n            key={sourceLanguage}\n            initial={sourceCode}\n            language={sourceLanguage}\n            onChange={setSourceCode}\n          />\n        </div>\n\n        <SourcesField sources={sources} onChange={setSources} />\n      </div>\n\n      <EditorFormSaveError message={saveError} />\n      <EditorFormFooter\n        saving={saving}\n        saveDisabled={!dirty}\n        onCancel={onCancel}\n        onSave={() => void handleSave()}\n        cancelTestId=\"plotimage-edit-cancel\"\n        saveTestId=\"plotimage-edit-save\"\n      />\n    </div>\n  );\n}\n","numLines":378,"startLine":1,"totalLines":378}}}
