ith text only (no URL)', () => {\n    const parsed = ImageDataSchema.parse({\n      src: '/x.png',\n      alt: 'A',\n      attribution: { text: 'Public domain' },\n    });\n    expect(parsed.attribution?.url).toBeUndefined();\n  });\n\n  it('ImageData: rejects empty alt', () => {\n    expect(() =>\n      ImageDataSchema.parse({ src: '/x.png', alt: '' }),\n    ).toThrow();\n  });\n\n  it('ImageData: rejects missing alt', () => {\n    expect(() =>\n      ImageDataSchema.parse({ src: '/x.png' } as Record<string, unknown>),\n    ).toThrow();\n  });\n\n  it('ImageData: rejects empty src', () => {\n    expect(() => ImageDataSchema.parse({ src: '', alt: 'A' })).toThrow();\n  });\n\n  it('ImageData: rejects attribution.url that is not a URL', () => {\n    expect(() =>\n      ImageDataSchema.parse({\n        src: '/x.png',\n        alt: 'A',\n        attribution: { text: 't', url: 'not a url' },\n      }),\n    ).toThrow();\n  });\n\n  it('ImageData: rejects empty attribution.text', () => {\n    expect(() =>\n      ImageDataSchema.parse({\n        src: '/x.png',\n        alt: 'A',\n        attribution: { text: '' },\n      }),\n    ).toThrow();\n  });\n\n  it('isExternalImageUrl: true for http/https, false for relative paths and unsupported protocols', () => {\n    expect(isExternalImageUrl('https://example.com/x.png')).toBe(true);\n    expect(isExternalImageUrl('http://example.com/x.png')).toBe(true);\n    expect(isExternalImageUrl('/api/courses/foo/assets/images/x.png')).toBe(false);\n    expect(isExternalImageUrl('/local.png')).toBe(false);\n    expect(isExternalImageUrl('')).toBe(false);\n    expect(isExternalImageUrl('data:image/png;base64,iVBOR')).toBe(false);\n    expect(isExternalImageUrl('file:///etc/passwd')).toBe(false);\n  });"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":815,"cache_read_input_tokens":138252,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemer