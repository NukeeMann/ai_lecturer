ns/local-image', {","+          method: 'PUT',","+          headers: { 'Content-Type': 'application/json' },","+          body: JSON.stringify(original),","+        });","+      });","+","+      await context.close();","+","+      if (!result.ok) throw new Error(`PUT failed: ${JSON.stringify(result)}`);","+      // Either the prefetch succeeded → src starts with /api/.../assets/images/","+      // OR fetch failed → src unchanged AND warning surfaced.","+      if (","+        result.newSectionSrc &&","+        result.newSectionSrc.startsWith('/api/courses/image-test/assets/images/')","+      ) {","+        console.log('Prefetch happy path verified — src rewritten to local cache.');","+      } else if (result.hasWarning) {","+        console.log(","+          'Prefetch graceful-degradation path verified — warning returned, original URL kept.',","+        );","+      } else {","+        throw new Error(","+          `PUT response did not match either expected outcome: ${JSON.stringify(result)}`,","+        );","+      }","+    }","+","     if (errors.length) {","       console.error('\\nERRORS:');","       for (const e of errors) console.error('  ', e);","       throw new Error(`${errors.length} JS error(s) occurred`);","     }"," ","-    console.log('\\nUS-050 image widget smoke test passed (light + dark)');","+    console.log('\\nUS-050 image widget smoke test passed (light + dark + prefetch)');","   } finally {","     await browser.close();","   }"]}],"originalFile":"// US-050 Image widget browser smoke test\nconst TARGET_URL = 'http://localhost:3050/courses/us050-image/lessons/figure';\n\nasync function run() {\n  const { chromium } = require('playwright');\n  const browser = await chromium.launch({ headless: true });\n  const errors = [];\n\n  try {\n    for (const theme of ['light', 'dark']) {\n      const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n      const page = await context.newPage();\n      page.on('pageerror', (err) => errors.push(`pageerror[${theme}]: ${err.message}`));\n      page.on('console', (m) => {\n        if (m.type() === 'error') errors.push(`console.error[${theme}]: ${m.text()}`);\n      });\n\n      await page.goto(TARGET_URL, { waitUntil: 'networkidle' });\n      await page.evaluate((t) => {\n        document.documentElement.setAttribute('data-theme', t);\n      }, theme);\n\n      await page.waitForSelector('[data-testid=\"image-figure\"]', { timeout: 10000 });\n      const figure = await page.$('[data-testid=\"image-figure\"]');\n      if (!figure) throw new Error(`[${theme}] figure not found`);\n\n      const img = await page.$('[data-testid=\"image-img\"]');\n      if (!img) throw new Error(`[${theme}] img not found`);\n      const src = await img.getAttribute('src');\n      const alt = await img.getAttribute('alt');\n      console.log(`[${theme}] img src=${src} alt=\"${alt}\"`);\n      if (!src || !src.includes('/api/courses/us050-image/assets/images/smoke.png')) {\n        throw new Error(`[${theme}] unexpected img src: ${src}`);\n      }\n      if (!alt || alt.length === 0) {\n        throw new Error(`[${theme}] alt is empty`);\n      }\n\n      const loaded = await img.evaluate((el) => ({\n        complete: el.complete,\n        naturalWidth: el.naturalWidth,\n        naturalHeight: el.naturalHeight,\n      }));\n      console.log(`[${theme}] img loaded:`, JSON.stringify(loaded));\n      if (!loaded.complete || loaded.naturalWidth === 0) {\n        throw new Error(`[${theme}] image failed to load: ${JSON.stringify(loaded)}`);\n      }\n\n      const captionText = await page.$eval(\n        '[data-testid=\"image-caption-text\"]',\n        (el) => el.textContent || '',\n      );\n      console.log(`[${theme}] caption: ${captionText}`);\n      if (!captionText.includes('smoke-test')) {\n        throw new Error(`[${theme}] caption text mismatch: ${captionText}`);\n      }\n\n      const attrLink = await page.$('[data-testid=\"image-attribution-link\"]');\n      if (!attrLink) throw new Error(`[${theme}] attribution link missing`);\n      const attrHref = await attrLink.getAttribute('href');\n      const attrTarget = await attrLink.getAttribute('target');\n      const attrRel = await attrLink.getAttribute('rel');\n      console.log(`[${theme}] attribution href=${attrHref} target=${attrTarget} rel=${attrRel}`);\n      if (attrHref !== 'https://example.com/us-050' || attrTarget !== '_blank') {\n        throw new Error(`[${theme}] attribution link attrs unexpected`);\n      }\n      if (!attrRel || !attrRel.includes('noopener') || !attrRel.includes('noreferrer')) {\n        throw new Error(`[${theme}] attribution link missing rel=noopener+noreferrer`);\n      }\n\n      const maxW = await img.evaluate((el) => el.style.maxWidth || getComputedStyle(el).maxWidth);\n      console.log(`[${theme}] img maxWidth=${maxW}`);\n      if (!maxW.includes('240')) {\n        throw new Error(`[${theme}] maxWidth not applied; got ${maxW}`);\n      }\n\n      const screenshotPath = `/tmp/us-050-${theme}.png`;\n      await page.screenshot({ path: screenshotPath, fullPage: true });\n      console.log(`[${theme}] screenshot saved at ${screenshotPath}`);\n\n      await context.close();\n    }\n\n    if (errors.length) {\n      console.error('\\nERRORS:');\n      for (const e of errors) console.error('  ', e);\n      throw new Error(`${errors.length} JS error(s) occurred`);\n    }\n\n    console.log('\\nUS-050 image widget smoke test passed (light + dark)');\n  } finally {\n    await browser.close();\n  }\n}\n\nrun().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\n","userModified":false}}
