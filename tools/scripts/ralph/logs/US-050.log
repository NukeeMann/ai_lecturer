{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_01LFLkWuA9JJsFszVaCDvCSb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012NXa1bAPvMmMKzEUrkqhiL","name":"Write","input":{"file_path":"/tmp/playwright-test-us-050.js","content":"// US-050 Image widget browser smoke test\nconst TARGET_URL = 'http://localhost:3050/courses/image-test/lessons/local-image';\n\nasync function run() {\n  const { chromium } = require('playwright');\n  const browser = await chromium.launch({ headless: true });\n  const errors = [];\n\n  try {\n    // ---- Pass 1: render the lesson in light + dark with a local /api/.../assets/images/sample.png ----\n    for (const theme of ['light', 'dark']) {\n      const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n      const page = await context.newPage();\n      page.on('pageerror', (err) => errors.push(`pageerror[${theme}]: ${err.message}`));\n      page.on('console', (m) => {\n        if (m.type() === 'error') errors.push(`console.error[${theme}]: ${m.text()}`);\n      });\n\n      await page.goto(TARGET_URL, { waitUntil: 'networkidle' });\n      await page.evaluate((t) => {\n        document.documentElement.setAttribute('data-theme', t);\n      }, theme);\n\n      await page.waitForSelector('[data-image-widget]', { timeout: 10000 });\n      const figure = await page.$('[data-image-figure]');\n      if (!figure) throw new Error(`[${theme}] figure not found`);\n\n      const img = await page.$('[data-testid=\"image-widget-img\"]');\n      if (!img) throw new Error(`[${theme}] img not found`);\n      const src = await img.getAttribute('src');\n      const alt = await img.getAttribute('alt');\n      console.log(`[${theme}] img src=${src} alt=\"${alt}\"`);\n      if (!src || !src.includes('/api/courses/image-test/assets/images/sample.png')) {\n        throw new Error(`[${theme}] unexpected img src: ${src}`);\n      }\n      if (!alt || alt.length === 0) {\n        throw new Error(`[${theme}] alt is empty`);\n      }\n\n      const loaded = await img.evaluate((el) => ({\n        complete: el.complete,\n        naturalWidth: el.naturalWidth,\n        naturalHeight: el.naturalHeight,\n      }));\n      console.log(`[${theme}] img loaded:`, JSON.stringify(loaded));\n      if (!loaded.complete || loaded.naturalWidth === 0) {\n        throw new Error(`[${theme}] image failed to load: ${JSON.stringify(loaded)}`);\n      }\n\n      const captionText = await page.$eval(\n        '[data-testid=\"image-widget-caption\"]',\n        (el) => el.textContent || '',\n      );\n      console.log(`[${theme}] caption: ${captionText}`);\n      if (!captionText.includes('Locally cached sample')) {\n        throw new Error(`[${theme}] caption text mismatch: ${captionText}`);\n      }\n\n      const attrLink = await page.$('[data-testid=\"image-widget-attribution-link\"]');\n      if (!attrLink) throw new Error(`[${theme}] attribution link missing`);\n      const attrHref = await attrLink.getAttribute('href');\n      const attrTarget = await attrLink.getAttribute('target');\n      const attrRel = await attrLink.getAttribute('rel');\n      console.log(`[${theme}] attribution href=${attrHref} target=${attrTarget} rel=${attrRel}`);\n      if (attrHref !== 'https://example.com/us-050' || attrTarget !== '_blank') {\n        throw new Error(`[${theme}] attribution link attrs unexpected`);\n      }\n      if (!attrRel || !attrRel.includes('noopener') || !attrRel.includes('noreferrer')) {\n        throw new Error(`[${theme}] attribution link missing rel=noopener+noreferrer`);\n      }\n\n      // The widget applies maxWidth on a wrapper <div> inside <figure>, not on the <img>.\n      const wrapperMaxW = await page.$eval(\n        '[data-image-figure] div[style*=\"max-width\"]',\n        (el) => el.style.maxWidth,\n      ).catch(() => null);\n      console.log(`[${theme}] wrapper maxWidth=${wrapperMaxW}`);\n      if (wrapperMaxW !== '320px') {\n        throw new Error(`[${theme}] wrapper maxWidth not applied; got ${wrapperMaxW}`);\n      }\n\n      const screenshotPath = `/tmp/us-050-${theme}.png`;\n      await page.screenshot({ path: screenshotPath, fullPage: true });\n      console.log(`[${theme}] screenshot saved at ${screenshotPath}`);\n\n      await context.close();\n    }\n\n    // ---- Pass 2: end-to-end prefetch via PUT — add an Image section with an external URL,\n    // verify the saved JSON has been rewritten to a local /api/.../assets/images/<hash>.<ext> path. ----\n    {\n      const context = await browser.newContext();\n      const page = await context.newPage();\n      await page.goto(TARGET_URL, { waitUntil: 'networkidle' });\n\n      const externalUrl =\n        'https://upload.wikimedia.org/wikipedia/commons/4/47/PNG_transparency_demonstration_1.png';\n      const result = await page.evaluate(async (url) => {\n        const get = await fetch('/api/courses/image-test/lessons/local-image');\n        if (!get.ok) return { stage: 'get', status: get.status };\n        const lesson = await get.json();\n        const draft = {\n          ...lesson,\n          sections: [\n            ...lesson.sections,\n            {\n              id: 's-img-ext',\n              title: 'External URL prefetch',\n              type: 'image',\n              data: { src: url, alt: 'Wikimedia transparency demo', maxWidth: '100%' },\n            },\n          ],\n        };\n        const put = await fetch('/api/courses/image-test/lessons/local-image', {\n          method: 'PUT',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify(draft),\n        });\n        const body = await put.json();\n        return {\n          stage: 'put',\n          status: put.status,\n          ok: put.ok,\n          newSectionSrc: body?.sections?.find?.((s) => s.id === 's-img-ext')?.data?.src,\n          hasWarning: !!body?.warning,\n          warnings: body?.warning?.imagePrefetchFailures ?? null,\n        };\n      }, externalUrl);\n      console.log('PUT result:', JSON.stringify(result, null, 2));\n\n      // Restore the lesson to its single-section form for repeatability.\n      await page.evaluate(async () => {\n        const original = {\n          schemaVersion: 1,\n          slug: 'local-image',\n          courseSlug: 'image-test',\n          moduleId: 'm1',\n          title: 'Local cached image',\n          eyebrow: 'DEMO',\n          description:\n            'An image referenced via a local /api/courses/.../assets/images/ path.',\n          estimatedMinutes: 5,\n          sections: [\n            {\n              id: 's-img-1',\n              title: 'Sample image',\n              type: 'image',\n              data: {\n                src: '/api/courses/image-test/assets/images/sample.png',\n                alt:\n                  'Tiny 16x16 demo PNG used to verify cached-image rendering.',\n                caption: 'Locally cached sample (16x16 PNG).',\n                attribution: {\n                  text: 'Generated for US-050 smoke test',\n                  url: 'https://example.com/us-050',\n                },\n                maxWidth: '320px',\n              },\n            },\n          ],\n        };\n        await fetch('/api/courses/image-test/lessons/local-image', {\n          method: 'PUT',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify(original),\n        });\n      });\n\n      await context.close();\n\n      if (!result.ok) throw new Error(`PUT failed: ${JSON.stringify(result)}`);\n      // Either the prefetch succeeded → src starts with /api/.../assets/images/\n      // OR fetch failed → src unchanged AND warning surfaced.\n      if (\n        result.newSectionSrc &&\n        result.newSectionSrc.startsWith('/api/courses/image-test/assets/images/')\n      ) {\n        console.log('Prefetch happy path verified — src rewritten to local cache.');\n      } else if (result.hasWarning) {\n        console.log(\n          'Prefetch graceful-degradation path verified — warning returned, original URL kept.',\n        );\n      } else {\n        throw new Error(\n          `PUT response did not match either expected outcome: ${JSON.stringify(result)}`,\n        );\n      }\n    }\n\n    if (errors.length) {\n      console.error('\\nERRORS:');\n      for (const e of errors) console.error('  ', e);\n      throw new Error(`${errors.length} JS error(s) occurred`);\n    }\n\n    console.log('\\nUS-050 image widget smoke test passed (light + dark + prefetch)');\n  } finally {\n    await browser.close();\n  }\n}\n\nrun().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1930,"cache_read_input_tokens":159465,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1930},"output_tokens":31,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"26f94f5f-8b24-4729-9ba0-a29ae0cfc428"}
