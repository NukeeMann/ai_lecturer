: #3d3da8;\n  --accent-subtle: #eeeefb;\n  --accent-subtle-hover: #dfdff7;\n  --accent-border: #c8c8ee;\n  --accent-text: #4a4ac3;\n}\n:root[data-theme=\"dark\"][data-accent=\"indigo\"] {\n  --accent: #8989f0;\n  --accent-hover: #a0a0f5;\n  --accent-active: #7373eb;\n  --accent-subtle: #21213a;\n  --accent-subtle-hover: #292946;\n  --accent-border: #3a3a5e;\n  --accent-text: #b0b0f5;\n}\n\n:root[data-accent=\"terracotta\"] {\n  --accent: #d97757;\n  --accent-hover: #c8654a;\n  --accent-active: #b45736;\n  --accent-subtle: #fbeee7;\n  --accent-subtle-hover: #f7dccf;\n  --accent-border: #efbfa8;\n  --accent-text: #b45736;\n}\n:root[data-theme=\"dark\"][data-accent=\"terracotta\"] {\n  --accent: #e89172;\n  --accent-hover: #f0a589;\n  --accent-active: #d97757;\n  --accent-subtle: #2e1d15;\n  --accent-subtle-hover: #3a261c;\n  --accent-border: #56382a;\n  --accent-text: #f0a589;\n}\n\n:root[data-accent=\"emerald\"] {\n  --accent: #0d7a5f;\n  --accent-hover: #0a6b53;\n  --accent-active: #075a45;\n  --accent-subtle: #e3f3ec;\n  --accent-subtle-hover: #cfe9dc;\n  --accent-border: #a8d6bf;\n  --accent-text: #0a6b53;\n}\n:root[data-theme=\"dark\"][data-accent=\"emerald\"] {\n  --accent: #4ec79a;\n  --accent-hover: #6dd2ad;\n  --accent-active: #3eb888;\n  --accent-subtle: #142b22;\n  --accent-subtle-hover: #1c3d30;\n  --accent-border: #285a47;\n  --accent-text: #6dd2ad;\n}\n\n/* Density modes — affect spacing scale globally */\n:root,\n:root[data-density=\"comfortable\"] {\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-7: 32px;\n  --space-8: 40px;\n  --space-9: 56px;\n  --space-10: 80px;\n  --space-section: 48px;\n  --line-height-prose: 1.7;\n}\n\n:root[data-density=\"compact\"] {\n  --space-1: 3px;\n  --space-2: 6px;\n  --space-3: 9px;\n  --space-4: 12px;\n  --space-5: 16px;\n  --space-6: 20px;\n  --space-7: 24px;\n  --space-8: 32px;\n  --space-9: 44px;\n  --space-10: 64px;\n  --space-section: 32px;\n  --line-height-prose: 1.6;\n}\n\n:root[data-density=\"spacious\"] {\n  --space-1: 4px;\n  --space-2: 10px;\n  --space-3: 14px;\n  --space-4: 20px;\n  --space-5: 26px;\n  --space-6: 32px;\n  --space-7: 44px;\n  --space-8: 56px;\n  --space-9: 72px;\n  --space-10: 96px;\n  --space-section: 64px;\n  --line-height-prose: 1.8;\n}\n\n:root {\n  /* Info tone aliases — info ≡ accent in this design system (per claude/design/source/components.jsx) */\n  --info: var(--accent);\n  --info-subtle: var(--accent-subtle);\n  --info-border: var(--accent-border);\n\n  /* Border radii */\n  --radius-xs: 3px;\n  --radius-sm: 5px;\n  --radius-md: 7px;\n  --radius-lg: 10px;\n  --radius-xl: 14px;\n  --radius-2xl: 20px;\n  --radius-full: 9999px;\n\n  /* Type scale */\n  --fs-xs: 11px;\n  --fs-sm: 13px;\n  --fs-base: 14.5px;\n  --fs-md: 16px;\n  --fs-lg: 18px;\n  --fs-xl: 22px;\n  --fs-2xl: 28px;\n  --fs-3xl: 36px;\n  --fs-4xl: 48px;\n  --fs-5xl: 64px;\n\n  /* Fonts — wired by next/font in layout.tsx via --font-geist-sans / --font-geist-mono */\n  --font-sans: var(--font-geist-sans), -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n  --font-mono: var(--font-geist-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  --font-prose: var(--font-geist-sans), -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n  --font-display: var(--font-geist-sans), -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n\n  /* Easings / transitions */\n  --t-fast: 120ms cubic-bezier(0.16, 1, 0.3, 1);\n  --t-base: 180ms cubic-bezier(0.16, 1, 0.3, 1);\n  --t-slow: 280ms cubic-bezier(0.16, 1, 0.3, 1);\n}\n","structuredPatch":[{"oldStart":137,"oldLines":6,"newStart":137,"newLines":7,"lines":["   --widget-drag-match: #d094b3;","   --widget-data-table: #94b3d0;","   --widget-video: #e08aa8;","+  --widget-image: #b3d094;"," ","   --code-bg: #131215;","   --code-text: #f0ede7;"]}],"userModified":false,"replaceAll":false}}
