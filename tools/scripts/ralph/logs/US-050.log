{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_01UtYVFG4ozvZoXAKWEhJ9gw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011mpcD5vVpoXdBnFgD82FWk","name":"Write","input":{"file_path":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/lib/server/imagePrefetch.ts","content":"import { createHash } from 'node:crypto';\nimport { promises as fs } from 'node:fs';\nimport path from 'node:path';\n\nimport { courseDir } from '@/lib/server/paths';\nimport type { Lesson } from '@/lib/schemas/lesson';\nimport { isExternalImageUrl } from '@/widgets/Image/schema';\n\nconst SUPPORTED_EXTS = new Set(['.png', '.jpg', '.jpeg', '.svg', '.webp', '.gif']);\nconst CONTENT_TYPE_TO_EXT: Record<string, string> = {\n  'image/png': '.png',\n  'image/jpeg': '.jpg',\n  'image/svg+xml': '.svg',\n  'image/webp': '.webp',\n  'image/gif': '.gif',\n};\n\nconst FETCH_TIMEOUT_MS = 15_000;\nconst MAX_BYTES = 25 * 1024 * 1024;\n\nexport function hashUrlToFilename(url: string, ext: string): string {\n  const hash = createHash('sha256').update(url).digest('hex').slice(0, 16);\n  return `${hash}${ext}`;\n}\n\nexport function inferExtFromUrl(url: string): string | null {\n  try {\n    const u = new URL(url);\n    const ext = path.extname(u.pathname).toLowerCase();\n    if (SUPPORTED_EXTS.has(ext)) return ext;\n  } catch {\n    return null;\n  }\n  return null;\n}\n\nexport function inferExtFromContentType(contentType: string | null): string | null {\n  if (!contentType) return null;\n  const head = contentType.split(';')[0]?.trim().toLowerCase() ?? '';\n  return CONTENT_TYPE_TO_EXT[head] ?? null;\n}\n\nexport interface ImagePrefetchResult {\n  /** Local relative URL to use in the saved JSON: /api/courses/<slug>/assets/images/<filename> */\n  localSrc: string;\n  /** Absolute filesystem path of the cached file. */\n  filePath: string;\n  /** Whether bytes were just fetched (false = was already cached). */\n  fetched: boolean;\n}\n\nexport interface ImagePrefetchFailure {\n  url: string;\n  reason: string;\n}\n\ninterface PrefetchOpts {\n  fetchImpl?: typeof fetch;\n  timeoutMs?: number;\n  maxBytes?: number;\n}\n\n/**\n * Download an external image into the course's assets/images/ folder.\n * Filename derived from sha256(url).slice(0,16). Idempotent — returns the\n * cached file without re-downloading if it already exists. Returns null on\n * fetch failure (caller logs a warning and keeps the original URL).\n */\nexport async function prefetchImageToCourse(\n  courseSlug: string,\n  url: string,\n  opts: PrefetchOpts = {},\n): Promise<ImagePrefetchResult | null> {\n  const fetchImpl = opts.fetchImpl ?? fetch;\n  const timeoutMs = opts.timeoutMs ?? FETCH_TIMEOUT_MS;\n  const maxBytes = opts.maxBytes ?? MAX_BYTES;\n\n  const dir = path.join(courseDir(courseSlug), 'assets', 'images');\n  const urlExt = inferExtFromUrl(url);\n\n  // If the URL extension is recognised, we can short-circuit when the file\n  // already exists on disk (no network call needed).\n  if (urlExt) {\n    const candidate = hashUrlToFilename(url, urlExt);\n    const candidatePath = path.join(dir, candidate);\n    try {\n      await fs.access(candidatePath);\n      return {\n        localSrc: `/api/courses/${encodeURIComponent(courseSlug)}/assets/images/${encodeURIComponent(candidate)}`,\n        filePath: candidatePath,\n        fetched: false,\n      };\n    } catch {\n      // not cached; continue to fetch.\n    }\n  }\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(), timeoutMs);\n  let res: Response;\n  try {\n    res = await fetchImpl(url, { signal: controller.signal, redirect: 'follow' });\n  } catch {\n    clearTimeout(timer);\n    return null;\n  }\n  clearTimeout(timer);\n\n  if (!res.ok) return null;\n\n  const ctExt = inferExtFromContentType(res.headers.get('content-type'));\n  const ext = urlExt ?? ctExt;\n  if (!ext) return null;\n\n  let buf: ArrayBuffer;\n  try {\n    buf = await res.arrayBuffer();\n  } catch {\n    return null;\n  }\n  if (buf.byteLength === 0 || buf.byteLength > maxBytes) return null;\n\n  const filename = hashUrlToFilename(url, ext);\n  const filePath = path.join(dir, filename);\n\n  // Re-check after fetch in case URL ext was unknown but content-type filled it in\n  // and a previous run produced the same hash+ext.\n  try {\n    await fs.access(filePath);\n    return {\n      localSrc: `/api/courses/${encodeURIComponent(courseSlug)}/assets/images/${encodeURIComponent(filename)}`,\n      filePath,\n      fetched: false,\n    };\n  } catch {\n    // not cached; write below.\n  }\n\n  await fs.mkdir(dir, { recursive: true });\n  await fs.writeFile(filePath, Buffer.from(buf));\n\n  return {\n    localSrc: `/api/courses/${encodeURIComponent(courseSlug)}/assets/images/${encodeURIComponent(filename)}`,\n    filePath,\n    fetched: true,\n  };\n}\n\nexport interface PrefetchLessonImagesResult {\n  lesson: Lesson;\n  failures: ImagePrefetchFailure[];\n}\n\n/**\n * Walk a Lesson, find every Image section with an external URL src, prefetch\n * it into the course's assets/images/ folder, and rewrite the src to the local\n * path. Returns the (possibly mutated) lesson plus a list of failures so the\n * route handler can surface a warning.\n */\nexport async function prefetchLessonImages(\n  courseSlug: string,\n  lesson: Lesson,\n  opts: PrefetchOpts = {},\n): Promise<PrefetchLessonImagesResult> {\n  const failures: ImagePrefetchFailure[] = [];\n  const sections = lesson.sections;\n  for (let i = 0; i < sections.length; i++) {\n    const section = sections[i];\n    if (section.type !== 'image') continue;\n    const src = section.data.src;\n    if (!isExternalImageUrl(src)) continue;\n    let result: ImagePrefetchResult | null;\n    try {\n      result = await prefetchImageToCourse(courseSlug, src, opts);\n    } catch (err) {\n      failures.push({ url: src, reason: err instanceof Error ? err.message : String(err) });\n      continue;\n    }\n    if (!result) {\n      failures.push({ url: src, reason: 'fetch failed' });\n      continue;\n    }\n    sections[i] = {\n      ...section,\n      data: { ...section.data, src: result.localSrc },\n    };\n  }\n  return { lesson: { ...lesson, sections }, failures };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":539,"cache_read_input_tokens":131654,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":539},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"eb4908a4-6ba7-488c-8fc6-365a62609e42"}
