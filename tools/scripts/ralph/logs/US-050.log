{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WPyPEvrUWM2YihNe94nKH1","type":"tool_result","content":"1\timport { z } from 'zod';\n2\t\n3\texport const VideoKindSchema = z.enum(['youtube', 'mp4']);\n4\t\n5\texport const VideoTranscriptSegmentSchema = z.object({\n6\t  tStart: z.number().min(0),\n7\t  tEnd: z.number().min(0).optional(),\n8\t  text: z.string().min(1),\n9\t  speaker: z.string().optional(),\n10\t});\n11\t\n12\texport const VideoDataSchema = z.object({\n13\t  kind: VideoKindSchema,\n14\t  src: z.string().min(1),\n15\t  title: z.string().optional(),\n16\t  durationSeconds: z.number().nonnegative().optional(),\n17\t  transcript: z.array(VideoTranscriptSegmentSchema).optional(),\n18\t  autoplay: z.boolean().default(false),\n19\t  startAt: z.number().nonnegative().optional(),\n20\t});\n21\t\n22\texport type VideoKind = z.infer<typeof VideoKindSchema>;\n23\texport type VideoTranscriptSegment = z.infer<typeof VideoTranscriptSegmentSchema>;\n24\texport type VideoData = z.infer<typeof VideoDataSchema>;\n25\t\n26\tconst YT_ID_RE = /^[A-Za-z0-9_-]{11}$/;\n27\t\n28\texport function extractYouTubeId(input: string): string | null {\n29\t  if (!input) return null;\n30\t  const trimmed = input.trim();\n31\t  if (YT_ID_RE.test(trimmed)) return trimmed;\n32\t\n33\t  let url: URL;\n34\t  try {\n35\t    url = new URL(trimmed);\n36\t  } catch {\n37\t    return null;\n38\t  }\n39\t\n40\t  const host = url.hostname.replace(/^www\\./, '');\n41\t\n42\t  if (host === 'youtu.be') {\n43\t    const id = url.pathname.replace(/^\\//, '').split('/')[0] ?? '';\n44\t    return YT_ID_RE.test(id) ? id : null;\n45\t  }\n46\t\n47\t  if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtube-nocookie.com') {\n48\t    const v = url.searchParams.get('v');\n49\t    if (v && YT_ID_RE.test(v)) return v;\n50\t\n51\t    const parts = url.pathname.split('/').filter(Boolean);\n52\t    if (parts.length >= 2 && (parts[0] === 'embed' || parts[0] === 'shorts' || parts[0] === 'v')) {\n53\t      const id = parts[1];\n54\t      if (YT_ID_RE.test(id)) return id;\n55\t    }\n56\t  }\n57\t\n58\t  return null;\n59\t}\n60\t"}]},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"f6412659-12f6-4ebc-a0dc-984783ebaec0","timestamp":"2026-05-04T00:39:15.577Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/widgets/Video/schema.ts","content":"import { z } from 'zod';\n\nexport const VideoKindSchema = z.enum(['youtube', 'mp4']);\n\nexport const VideoTranscriptSegmentSchema = z.object({\n  tStart: z.number().min(0),\n  tEnd: z.number().min(0).optional(),\n  text: z.string().min(1),\n  speaker: z.string().optional(),\n});\n\nexport const VideoDataSchema = z.object({\n  kind: VideoKindSchema,\n  src: z.string().min(1),\n  title: z.string().optional(),\n  durationSeconds: z.number().nonnegative().optional(),\n  transcript: z.array(VideoTranscriptSegmentSchema).optional(),\n  autoplay: z.boolean().default(false),\n  startAt: z.number().nonnegative().optional(),\n});\n\nexport type VideoKind = z.infer<typeof VideoKindSchema>;\nexport type VideoTranscriptSegment = z.infer<typeof VideoTranscriptSegmentSchema>;\nexport type VideoData = z.infer<typeof VideoDataSchema>;\n\nconst YT_ID_RE = /^[A-Za-z0-9_-]{11}$/;\n\nexport function extractYouTubeId(input: string): string | null {\n  if (!input) return null;\n  const trimmed = input.trim();\n  if (YT_ID_RE.test(trimmed)) return trimmed;\n\n  let url: URL;\n  try {\n    url = new URL(trimmed);\n  } catch {\n    return null;\n  }\n\n  const host = url.hostname.replace(/^www\\./, '');\n\n  if (host === 'youtu.be') {\n    const id = url.pathname.replace(/^\\//, '').split('/')[0] ?? '';\n    return YT_ID_RE.test(id) ? id : null;\n  }\n\n  if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtube-nocookie.com') {\n    const v = url.searchParams.get('v');\n    if (v && YT_ID_RE.test(v)) return v;\n\n    const parts = url.pathname.split('/').filter(Boolean);\n    if (parts.length >= 2 && (parts[0] === 'embed' || parts[0] === 'shorts' || parts[0] === 'v')) {\n      const id = parts[1];\n      if (YT_ID_RE.test(id)) return id;\n    }\n  }\n\n  return null;\n}\n","numLines":60,"startLine":1,"totalLines":60}}}
