{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QwvTr43Zi6sCexp7r2d8zr","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport {\n4\t  useCallback,\n5\t  useEffect,\n6\t  useId,\n7\t  useRef,\n8\t  useState,\n9\t  type CSSProperties,\n10\t} from 'react';\n11\timport { ChevronDown, ChevronRight } from 'lucide-react';\n12\timport { EditorState } from '@codemirror/state';\n13\timport { EditorView, lineNumbers } from '@codemirror/view';\n14\timport {\n15\t  bracketMatching,\n16\t  syntaxHighlighting,\n17\t} from '@codemirror/language';\n18\timport { python } from '@codemirror/lang-python';\n19\t\n20\timport {\n21\t  codeRunnerEditorTheme,\n22\t  codeRunnerHighlightStyle,\n23\t} from '../Code/CodeRunner';\n24\t\n25\timport type { PlotImageData } from './schema';\n26\t\n27\texport interface PlotImageWidgetProps {\n28\t  data: PlotImageData;\n29\t}\n30\t\n31\tconst wrapStyle: CSSProperties = {\n32\t  display: 'flex',\n33\t  flexDirection: 'column',\n34\t};\n35\t\n36\tconst figureStyle: CSSProperties = {\n37\t  margin: 0,\n38\t  padding: 'var(--space-4) var(--space-5)',\n39\t  background: 'var(--bg-subtle)',\n40\t  display: 'flex',\n41\t  flexDirection: 'column',\n42\t  alignItems: 'center',\n43\t  gap: 'var(--space-3)',\n44\t};\n45\t\n46\tconst imgStyle: CSSProperties = {\n47\t  display: 'block',\n48\t  maxWidth: '100%',\n49\t  height: 'auto',\n50\t  objectFit: 'contain',\n51\t  borderRadius: 'var(--radius-md)',\n52\t  border: '1px solid var(--border)',\n53\t  background: 'var(--bg-elevated)',\n54\t};\n55\t\n56\tconst captionStyle: CSSProperties = {\n57\t  fontSize: 'var(--fs-sm)',\n58\t  color: 'var(--text-secondary)',\n59\t  textAlign: 'center',\n60\t  lineHeight: 1.5,\n61\t};\n62\t\n63\tconst sourceWrapStyle: CSSProperties = {\n64\t  borderTop: '1px solid var(--border)',\n65\t  background: 'var(--bg-elevated)',\n66\t};\n67\t\n68\tconst toggleButtonStyle: CSSProperties = {\n69\t  display: 'inline-flex',\n70\t  alignItems: 'center',\n71\t  gap: 6,\n72\t  padding: '8px 14px',\n73\t  background: 'transparent',\n74\t  border: 'none',\n75\t  color: 'var(--text-secondary)',\n76\t  fontSize: 'var(--fs-sm)',\n77\t  fontWeight: 500,\n78\t  cursor: 'pointer',\n79\t  width: '100%',\n80\t  textAlign: 'left',\n81\t};\n82\t\n83\tconst codeContainerStyle: CSSProperties = {\n84\t  background: 'var(--code-bg)',\n85\t  borderTop: '1px solid var(--border)',\n86\t  overflow: 'hidden',\n87\t};\n88\t\n89\texport function PlotImageWidget({ data }: PlotImageWidgetProps) {\n90\t  const { src, alt, caption, sourceCode, sourceLanguage } = data;\n91\t  const reactId = useId();\n92\t  const panelId = `plotimage-source-${reactId}`;\n93\t  const [open, setOpen] = useState(false);\n94\t\n95\t  return (\n96\t    <div data-plotimage-widget style={wrapStyle}>\n97\t      <figure data-plotimage-figure style={figureStyle}>\n98\t        {/* eslint-disable-next-line @next/next/no-img-element */}\n99\t        <img\n100\t          data-plotimage-img\n101\t          src={src}\n102\t          alt={alt}\n103\t          style={imgStyle}\n104\t        />\n105\t        {caption && (\n106\t          <figcaption data-plotimage-caption style={captionStyle}>\n107\t            {caption}\n108\t          </figcaption>\n109\t        )}\n110\t      </figure>\n111\t      {sourceCode && (\n112\t        <div style={sourceWrapStyle}>\n113\t          <button\n114\t            type=\"button\"\n115\t            data-testid=\"plotimage-toggle-source\"\n116\t            aria-expanded={open}\n117\t            aria-controls={panelId}\n118\t            onClick={() => setOpen((v) => !v)}\n119\t            style={toggleButtonStyle}\n120\t          >\n121\t            {open ? (\n122\t              <ChevronDown size={14} aria-hidden />\n123\t            ) : (\n124\t              <ChevronRight size={14} aria-hidden />\n125\t            )}\n126\t            {open ? 'Hide source' : 'Show source'}\n127\t          </button>\n128\t          {open && (\n129\t            <div\n130\t              id={panelId}\n131\t              data-testid=\"plotimage-source-panel\"\n132\t              style={codeContainerStyle}\n133\t            >\n134\t              <ReadOnlyCodeView\n135\t                code={sourceCode}\n136\t                language={sourceLanguage ?? 'python'}\n137\t              />\n138\t            </div>\n139\t          )}\n140\t        </div>\n141\t      )}\n142\t    </div>\n143\t  );\n144\t}\n145\t\n146\tinterface ReadOnlyCodeViewProps {\n147\t  code: string;\n148\t  language: 'python' | 'r';\n149\t}\n150\t\n151\tfunction ReadOnlyCodeView({ code, language }: ReadOnlyCodeViewProps) {\n152\t  const parentRef = useRef<HTMLDivElement | null>(null);\n153\t\n154\t  useEffect(() => {\n155\t    if (!parentRef.current) return;\n156\t    const langExtensions = language === 'python' ? [python()] : [];\n157\t    const view = new EditorView({\n158\t      parent: parentRef.current,\n159\t      state: EditorState.create({\n160\t        doc: code,\n161\t        extensions: [\n162\t          lineNumbers(),\n163\t          bracketMatching(),\n164\t          ...langExtensions,\n165\t          syntaxHighlighting(codeRunnerHighlightStyle),\n166\t          codeRunnerEditorTheme,\n167\t          EditorState.readOnly.of(true),\n168\t          EditorView.editable.of(false),\n169\t        ],\n170\t      }),\n171\t    });\n172\t    return () => {\n173\t      view.destroy();\n174\t    };\n175\t    // Mount once with the given code/language; parent re-mounts via key when these change.\n176\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n177\t  }, []);\n178\t\n179\t  const handleCopy = useCallback(() => {\n180\t    if (typeof navigator !== 'undefined' && navigator.clipboard) {\n181\t      void navigator.clipboard.writeText(code);\n182\t    }\n183\t  }, [code]);\n184\t\n185\t  return (\n186\t    <div data-plotimage-source-lang={language}>\n187\t      <div ref={parentRef} />\n188\t      <div\n189\t        style={{\n190\t          display: 'flex',\n191\t          justifyContent: 'flex-end',\n192\t          padding: '6px 10px',\n193\t          borderTop: '1px solid var(--border)',\n194\t        }}\n195\t      >\n196\t        <button\n197\t          type=\"button\"\n198\t          onClick={handleCopy}\n199\t          data-testid=\"plotimage-copy-source\"\n200\t          style={{\n201\t            background: 'transparent',\n202\t            border: '1px solid var(--border)',\n203\t            borderRadius: 'var(--radius-sm)',\n204\t            padding: '4px 10px',\n205\t            fontSize: 'var(--fs-xs)',\n206\t            color: 'var(--text-secondary)',\n207\t            cursor: 'pointer',\n208\t          }}\n209\t        >\n210\t          Copy\n211\t        </button>\n212\t      </div>\n213\t    </div>\n214\t  );\n215\t}\n216\t"}]},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"c20caccf-44a5-488c-a1c3-cbeb786be111","timestamp":"2026-05-04T00:40:26.645Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/widgets/PlotImage/PlotImageWidget.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useEffect,\n  useId,\n  useRef,\n  useState,\n  type CSSProperties,\n} from 'react';\nimport { ChevronDown, ChevronRight } from 'lucide-react';\nimport { EditorState } from '@codemirror/state';\nimport { EditorView, lineNumbers } from '@codemirror/view';\nimport {\n  bracketMatching,\n  syntaxHighlighting,\n} from '@codemirror/language';\nimport { python } from '@codemirror/lang-python';\n\nimport {\n  codeRunnerEditorTheme,\n  codeRunnerHighlightStyle,\n} from '../Code/CodeRunner';\n\nimport type { PlotImageData } from './schema';\n\nexport interface PlotImageWidgetProps {\n  data: PlotImageData;\n}\n\nconst wrapStyle: CSSProperties = {\n  display: 'flex',\n  flexDirection: 'column',\n};\n\nconst figureStyle: CSSProperties = {\n  margin: 0,\n  padding: 'var(--space-4) var(--space-5)',\n  background: 'var(--bg-subtle)',\n  display: 'flex',\n  flexDirection: 'column',\n  alignItems: 'center',\n  gap: 'var(--space-3)',\n};\n\nconst imgStyle: CSSProperties = {\n  display: 'block',\n  maxWidth: '100%',\n  height: 'auto',\n  objectFit: 'contain',\n  borderRadius: 'var(--radius-md)',\n  border: '1px solid var(--border)',\n  background: 'var(--bg-elevated)',\n};\n\nconst captionStyle: CSSProperties = {\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text-secondary)',\n  textAlign: 'center',\n  lineHeight: 1.5,\n};\n\nconst sourceWrapStyle: CSSProperties = {\n  borderTop: '1px solid var(--border)',\n  background: 'var(--bg-elevated)',\n};\n\nconst toggleButtonStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 6,\n  padding: '8px 14px',\n  background: 'transparent',\n  border: 'none',\n  color: 'var(--text-secondary)',\n  fontSize: 'var(--fs-sm)',\n  fontWeight: 500,\n  cursor: 'pointer',\n  width: '100%',\n  textAlign: 'left',\n};\n\nconst codeContainerStyle: CSSProperties = {\n  background: 'var(--code-bg)',\n  borderTop: '1px solid var(--border)',\n  overflow: 'hidden',\n};\n\nexport function PlotImageWidget({ data }: PlotImageWidgetProps) {\n  const { src, alt, caption, sourceCode, sourceLanguage } = data;\n  const reactId = useId();\n  const panelId = `plotimage-source-${reactId}`;\n  const [open, setOpen] = useState(false);\n\n  return (\n    <div data-plotimage-widget style={wrapStyle}>\n      <figure data-plotimage-figure style={figureStyle}>\n        {/* eslint-disable-next-line @next/next/no-img-element */}\n        <img\n          data-plotimage-img\n          src={src}\n          alt={alt}\n          style={imgStyle}\n        />\n        {caption && (\n          <figcaption data-plotimage-caption style={captionStyle}>\n            {caption}\n          </figcaption>\n        )}\n      </figure>\n      {sourceCode && (\n        <div style={sourceWrapStyle}>\n          <button\n            type=\"button\"\n            data-testid=\"plotimage-toggle-source\"\n            aria-expanded={open}\n            aria-controls={panelId}\n            onClick={() => setOpen((v) => !v)}\n            style={toggleButtonStyle}\n          >\n            {open ? (\n              <ChevronDown size={14} aria-hidden />\n            ) : (\n              <ChevronRight size={14} aria-hidden />\n            )}\n            {open ? 'Hide source' : 'Show source'}\n          </button>\n          {open && (\n            <div\n              id={panelId}\n              data-testid=\"plotimage-source-panel\"\n              style={codeContainerStyle}\n            >\n              <ReadOnlyCodeView\n                code={sourceCode}\n                language={sourceLanguage ?? 'python'}\n              />\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n\ninterface ReadOnlyCodeViewProps {\n  code: string;\n  language: 'python' | 'r';\n}\n\nfunction ReadOnlyCodeView({ code, language }: ReadOnlyCodeViewProps) {\n  const parentRef = useRef<HTMLDivElement | null>(null);\n\n  useEffect(() => {\n    if (!parentRef.current) return;\n    const langExtensions = language === 'python' ? [python()] : [];\n    const view = new EditorView({\n      parent: parentRef.current,\n      state: EditorState.create({\n        doc: code,\n        extensions: [\n          lineNumbers(),\n          bracketMatching(),\n          ...langExtensions,\n          syntaxHighlighting(codeRunnerHighlightStyle),\n          codeRunnerEditorTheme,\n          EditorState.readOnly.of(true),\n          EditorView.editable.of(false),\n        ],\n      }),\n    });\n    return () => {\n      view.destroy();\n    };\n    // Mount once with the given code/language; parent re-mounts via key when these change.\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  const handleCopy = useCallback(() => {\n    if (typeof navigator !== 'undefined' && navigator.clipboard) {\n      void navigator.clipboard.writeText(code);\n    }\n  }, [code]);\n\n  return (\n    <div data-plotimage-source-lang={language}>\n      <div ref={parentRef} />\n      <div\n        style={{\n          display: 'flex',\n          justifyContent: 'flex-end',\n          padding: '6px 10px',\n          borderTop: '1px solid var(--border)',\n        }}\n      >\n        <button\n          type=\"button\"\n          onClick={handleCopy}\n          data-testid=\"plotimage-copy-source\"\n          style={{\n            background: 'transparent',\n            border: '1px solid var(--border)',\n            borderRadius: 'var(--radius-sm)',\n            padding: '4px 10px',\n            fontSize: 'var(--fs-xs)',\n            color: 'var(--text-secondary)',\n            cursor: 'pointer',\n          }}\n        >\n          Copy\n        </button>\n      </div>\n    </div>\n  );\n}\n","numLines":216,"startLine":1,"totalLines":216}}}
