{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016ETydrYs2MtoMrQuzgnQ3x","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport {\n4\t  useCallback,\n5\t  useEffect,\n6\t  useId,\n7\t  useMemo,\n8\t  useRef,\n9\t  useState,\n10\t  type CSSProperties,\n11\t} from 'react';\n12\timport { ChevronDown, ChevronRight } from 'lucide-react';\n13\t\n14\timport {\n15\t  VideoDataSchema,\n16\t  extractYouTubeId,\n17\t  type VideoData,\n18\t  type VideoTranscriptSegment,\n19\t} from './schema';\n20\t\n21\texport interface VideoWidgetProps {\n22\t  data: VideoData;\n23\t}\n24\t\n25\tconst wrapStyle: CSSProperties = {\n26\t  display: 'flex',\n27\t  flexDirection: 'column',\n28\t};\n29\t\n30\tconst playerWrapStyle: CSSProperties = {\n31\t  padding: 'var(--space-4) var(--space-5)',\n32\t  background: 'var(--bg-subtle)',\n33\t  display: 'flex',\n34\t  flexDirection: 'column',\n35\t  gap: 'var(--space-3)',\n36\t};\n37\t\n38\tconst aspectStyle: CSSProperties = {\n39\t  position: 'relative',\n40\t  width: '100%',\n41\t  aspectRatio: '16 / 9',\n42\t  background: '#000',\n43\t  borderRadius: 'var(--radius-md)',\n44\t  overflow: 'hidden',\n45\t  border: '1px solid var(--border)',\n46\t};\n47\t\n48\tconst playerElStyle: CSSProperties = {\n49\t  position: 'absolute',\n50\t  inset: 0,\n51\t  width: '100%',\n52\t  height: '100%',\n53\t  border: 'none',\n54\t  display: 'block',\n55\t};\n56\t\n57\tconst titleStyle: CSSProperties = {\n58\t  fontSize: 'var(--fs-sm)',\n59\t  color: 'var(--text-secondary)',\n60\t  textAlign: 'center',\n61\t  lineHeight: 1.5,\n62\t};\n63\t\n64\tconst transcriptWrapStyle: CSSProperties = {\n65\t  borderTop: '1px solid var(--border)',\n66\t  background: 'var(--bg-elevated)',\n67\t};\n68\t\n69\tconst toggleButtonStyle: CSSProperties = {\n70\t  display: 'inline-flex',\n71\t  alignItems: 'center',\n72\t  gap: 6,\n73\t  padding: '8px 14px',\n74\t  background: 'transparent',\n75\t  border: 'none',\n76\t  color: 'var(--text-secondary)',\n77\t  fontSize: 'var(--fs-sm)',\n78\t  fontWeight: 500,\n79\t  cursor: 'pointer',\n80\t  width: '100%',\n81\t  textAlign: 'left',\n82\t};\n83\t\n84\tconst transcriptListStyle: CSSProperties = {\n85\t  borderTop: '1px solid var(--border)',\n86\t  maxHeight: 320,\n87\t  overflow: 'auto',\n88\t  padding: 'var(--space-2) 0',\n89\t  display: 'flex',\n90\t  flexDirection: 'column',\n91\t};\n92\t\n93\tconst segmentBaseStyle: CSSProperties = {\n94\t  display: 'flex',\n95\t  alignItems: 'flex-start',\n96\t  gap: 'var(--space-3)',\n97\t  padding: '6px var(--space-5)',\n98\t  background: 'transparent',\n99\t  border: 'none',\n100\t  textAlign: 'left',\n101\t  cursor: 'pointer',\n102\t  color: 'var(--text)',\n103\t  fontSize: 'var(--fs-sm)',\n104\t  lineHeight: 1.5,\n105\t  width: '100%',\n106\t  fontFamily: 'inherit',\n107\t};\n108\t\n109\tconst segmentTimeStyle: CSSProperties = {\n110\t  flexShrink: 0,\n111\t  fontFamily: 'var(--font-mono)',\n112\t  fontSize: 'var(--fs-xs)',\n113\t  color: 'var(--text-tertiary)',\n114\t  width: 56,\n115\t  textAlign: 'right',\n116\t  paddingTop: 2,\n117\t  fontVariantNumeric: 'tabular-nums',\n118\t};\n119\t\n120\tconst segmentBodyStyle: CSSProperties = {\n121\t  flex: 1,\n122\t  minWidth: 0,\n123\t};\n124\t\n125\tconst speakerStyle: CSSProperties = {\n126\t  display: 'inline-block',\n127\t  marginRight: 6,\n128\t  fontSize: 'var(--fs-xs)',\n129\t  fontWeight: 600,\n130\t  letterSpacing: '0.06em',\n131\t  textTransform: 'uppercase',\n132\t  color: 'var(--text-tertiary)',\n133\t};\n134\t\n135\tfunction formatTimestamp(seconds: number): string {\n136\t  const total = Math.max(0, Math.floor(seconds));\n137\t  const h = Math.floor(total / 3600);\n138\t  const m = Math.floor((total % 3600) / 60);\n139\t  const s = total % 60;\n140\t  if (h > 0) {\n141\t    return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;\n142\t  }\n143\t  return `${m}:${String(s).padStart(2, '0')}`;\n144\t}\n145\t\n146\tfunction buildYouTubeEmbedUrl(videoId: string, opts: { autoplay: boolean; startAt?: number }): string {\n147\t  const url = new URL(`https://www.youtube-nocookie.com/embed/${videoId}`);\n148\t  url.searchParams.set('enablejsapi', '1');\n149\t  url.searchParams.set('rel', '0');\n150\t  url.searchParams.set('modestbranding', '1');\n151\t  if (opts.autoplay) url.searchParams.set('autoplay', '1');\n152\t  if (opts.startAt && opts.startAt > 0) {\n153\t    url.searchParams.set('start', String(Math.floor(opts.startAt)));\n154\t  }\n155\t  return url.toString();\n156\t}\n157\t\n158\tfunction findActiveSegmentIndex(transcript: VideoTranscriptSegment[], time: number): number {\n159\t  for (let i = transcript.length - 1; i >= 0; i--) {\n160\t    const seg = transcript[i];\n161\t    if (time + 0.001 >= seg.tStart) {\n162\t      if (seg.tEnd === undefined || time < seg.tEnd) return i;\n163\t      const next = transcript[i + 1];\n164\t      if (!next) return i;\n165\t      if (time < next.tStart) return i;\n166\t      return -1;\n167\t    }\n168\t  }\n169\t  return -1;\n170\t}\n171\t\n172\texport function VideoWidget({ data: rawData }: VideoWidgetProps) {\n173\t  const data = useMemo(() => VideoDataSchema.parse(rawData), [rawData]);\n174\t  const reactId = useId();\n175\t  const transcriptId = `video-transcript-${reactId}`;\n176\t  const [transcriptOpen, setTranscriptOpen] = useState(true);\n177\t  const [currentTime, setCurrentTime] = useState(data.startAt ?? 0);\n178\t\n179\t  const iframeRef = useRef<HTMLIFrameElement | null>(null);\n180\t  const videoRef = useRef<HTMLVideoElement | null>(null);\n181\t  const ytPollIntervalRef = useRef<number | null>(null);\n182\t  const pendingYtSeekRef = useRef<number | null>(null);\n183\t\n184\t  const youtubeId = data.kind === 'youtube' ? extractYouTubeId(data.src) : null;\n185\t  const youtubeEmbedUrl = useMemo(() => {\n186\t    if (data.kind !== 'youtube' || !youtubeId) return null;\n187\t    return buildYouTubeEmbedUrl(youtubeId, {\n188\t      autoplay: data.autoplay ?? false,\n189\t      startAt: data.startAt,\n190\t    });\n191\t  }, [data.kind, youtubeId, data.autoplay, data.startAt]);\n192\t\n193\t  const postYouTubeCommand = useCallback((command: string, args: unknown[] = []) => {\n194\t    const win = iframeRef.current?.contentWindow;\n195\t    if (!win) return;\n196\t    win.postMessage(\n197\t      JSON.stringify({ event: 'command', func: command, args }),\n198\t      '*',\n199\t    );\n200\t  }, []);\n201\t\n202\t  useEffect(() => {\n203\t    if (data.kind !== 'youtube') return;\n204\t    function onMessage(event: MessageEvent) {\n205\t      if (!iframeRef.current || event.source !== iframeRef.current.contentWindow) return;\n206\t      const raw = event.data;\n207\t      if (typeof raw !== 'string') return;\n208\t      let payload: unknown;\n209\t      try {\n210\t        payload = JSON.parse(raw);\n211\t      } catch {\n212\t        return;\n213\t      }\n214\t      const obj = payload as { event?: string; info?: unknown };\n215\t      if (obj.event === 'onReady') {\n216\t        postYouTubeCommand('addEventListener', ['onStateChange']);\n217\t        if (pendingYtSeekRef.current !== null) {\n218\t          postYouTubeCommand('seekTo', [pendingYtSeekRef.current, true]);\n219\t          pendingYtSeekRef.current = null;\n220\t        }\n221\t        if (ytPollIntervalRef.current === null) {\n222\t          ytPollIntervalRef.current = window.setInterval(() => {\n223\t            const w = iframeRef.current?.contentWindow;\n224\t            if (!w) return;\n225\t            w.postMessage(\n226\t              JSON.stringify({ event: 'listening', id: 'ai-lecturer-time' }),\n227\t              '*',\n228\t            );\n229\t            postYouTubeCommand('getCurrentTime');\n230\t          }, 250);\n231\t        }\n232\t      } else if (obj.event === 'infoDelivery') {\n233\t        const info = obj.info as { currentTime?: number } | undefined;\n234\t        if (info && typeof info.currentTime === 'number') {\n235\t          setCurrentTime(info.currentTime);\n236\t        }\n237\t      }\n238\t    }\n239\t    window.addEventListener('message', onMessage);\n240\t    return () => {\n241\t      window.removeEventListener('message', onMessage);\n242\t      if (ytPollIntervalRef.current !== null) {\n243\t        clearInterval(ytPollIntervalRef.current);\n244\t        ytPollIntervalRef.current = null;\n245\t      }\n246\t    };\n247\t  }, [data.kind, postYouTubeCommand]);\n248\t\n249\t  useEffect(() => {\n250\t    if (data.kind !== 'mp4') return;\n251\t    const el = videoRef.current;\n252\t    if (!el) return;\n253\t    if (data.startAt && data.startAt > 0) {\n254\t      try {\n255\t        el.currentTime = data.startAt;\n256\t      } catch {\n257\t        /* ignore */\n258\t      }\n259\t    }\n260\t  }, [data.kind, data.startAt]);\n261\t\n262\t  const handleMp4TimeUpdate = useCallback(() => {\n263\t    const el = videoRef.current;\n264\t    if (!el) return;\n265\t    setCurrentTime(el.currentTime);\n266\t  }, []);\n267\t\n268\t  const seekTo = useCallback(\n269\t    (seconds: number) => {\n270\t      if (data.kind === 'youtube') {\n271\t        const win = iframeRef.current?.contentWindow;\n272\t        if (!win) {\n273\t          pendingYtSeekRef.current = seconds;\n274\t          return;\n275\t        }\n276\t        postYouTubeCommand('seekTo', [seconds, true]);\n277\t        postYouTubeCommand('playVideo');\n278\t        setCurrentTime(seconds);\n279\t      } else {\n280\t        const el = videoRef.current;\n281\t        if (!el) return;\n282\t        try {\n283\t          el.currentTime = seconds;\n284\t        } catch {\n285\t          /* ignore */\n286\t        }\n287\t        setCurrentTime(seconds);\n288\t        if (el.paused) {\n289\t          void el.play().catch(() => {\n290\t            /* ignore */\n291\t          });\n292\t        }\n293\t      }\n294\t    },\n295\t    [data.kind, postYouTubeCommand],\n296\t  );\n297\t\n298\t  const transcript = data.transcript ?? [];\n299\t  const activeIndex = transcript.length\n300\t    ? findActiveSegmentIndex(transcript, currentTime)\n301\t    : -1;\n302\t\n303\t  return (\n304\t    <div data-video-widget data-video-kind={data.kind} style={wrapStyle}>\n305\t      <div style={playerWrapStyle}>\n306\t        <div style={aspectStyle} data-testid=\"video-player-frame\">\n307\t          {data.kind === 'youtube' ? (\n308\t            youtubeEmbedUrl ? (\n309\t              <iframe\n310\t                ref={iframeRef}\n311\t                title={data.title ?? 'YouTube video'}\n312\t                src={youtubeEmbedUrl}\n313\t                style={playerElStyle}\n314\t                allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n315\t                allowFullScreen\n316\t                data-testid=\"video-iframe\"\n317\t                data-yt-id={youtubeId ?? ''}\n318\t              />\n319\t            ) : (\n320\t              <div\n321\t                data-testid=\"video-error\"\n322\t                style={{\n323\t                  ...playerElStyle,\n324\t                  display: 'flex',\n325\t                  alignItems: 'center',\n326\t                  justifyContent: 'center',\n327\t                  color: 'var(--text-on-accent, #fff)',\n328\t                  fontSize: 'var(--fs-sm)',\n329\t                  padding: '0 var(--space-4)',\n330\t                  textAlign: 'center',\n331\t                }}\n332\t              >\n333\t                Could not parse YouTube ID from <code>{data.src}</code>\n334\t              </div>\n335\t            )\n336\t          ) : (\n337\t            <video\n338\t              ref={videoRef}\n339\t              src={data.src}\n340\t              controls\n341\t              autoPlay={data.autoplay}\n342\t              preload=\"metadata\"\n343\t              onTimeUpdate={handleMp4TimeUpdate}\n344\t              onLoadedMetadata={handleMp4TimeUpdate}\n345\t              style={playerElStyle}\n346\t              data-testid=\"video-mp4\"\n347\t            />\n348\t          )}\n349\t        </div>\n350\t        {data.title && (\n351\t          <div style={titleStyle} data-testid=\"video-title\">\n352\t            {data.title}\n353\t          </div>\n354\t        )}\n355\t      </div>\n356\t      {transcript.length > 0 && (\n357\t        <div style={transcriptWrapStyle}>\n358\t          <button\n359\t            type=\"button\"\n360\t            data-testid=\"video-transcript-toggle\"\n361\t            aria-expanded={transcriptOpen}\n362\t            aria-controls={transcriptId}\n363\t            onClick={() => setTranscriptOpen((v) => !v)}\n364\t            style={toggleButtonStyle}\n365\t          >\n366\t            {transcriptOpen ? (\n367\t              <ChevronDown size={14} aria-hidden />\n368\t            ) : (\n369\t              <ChevronRight size={14} aria-hidden />\n370\t            )}\n371\t            {transcriptOpen ? 'Hide transcript' : 'Show transcript'}\n372\t            <span\n373\t              style={{\n374\t                marginLeft: 'auto',\n375\t                fontSize: 'var(--fs-xs)',\n376\t                color: 'var(--text-tertiary)',\n377\t              }}\n378\t            >\n379\t              {transcript.length} segment{transcript.length === 1 ? '' : 's'}\n380\t            </span>\n381\t          </button>\n382\t          {transcriptOpen && (\n383\t            <div\n384\t              id={transcriptId}\n385\t              data-testid=\"video-transcript-list\"\n386\t              style={transcriptListStyle}\n387\t            >\n388\t              {transcript.map((seg, i) => {\n389\t                const active = i === activeIndex;\n390\t                const segStyle: CSSProperties = active\n391\t                  ? {\n392\t                      ...segmentBaseStyle,\n393\t                      background: 'var(--accent-subtle)',\n394\t                      color: 'var(--accent-text)',\n395\t                    }\n396\t                  : segmentBaseStyle;\n397\t                return (\n398\t                  <button\n399\t                    key={i}\n400\t                    type=\"button\"\n401\t                    onClick={() => seekTo(seg.tStart)}\n402\t                    style={segStyle}\n403\t                    data-testid={`video-transcript-seg-${i}`}\n404\t                    data-active={active ? 'true' : 'false'}\n405\t                    aria-label={`Jump to ${formatTimestamp(seg.tStart)}: ${seg.text}`}\n406\t                  >\n407\t                    <span style={segmentTimeStyle}>{formatTimestamp(seg.tStart)}</span>\n408\t                    <span style={segmentBodyStyle}>\n409\t                      {seg.speaker && <span style={speakerStyle}>{seg.speaker}</span>}\n410\t                      {seg.text}\n411\t                    </span>\n412\t                  </button>\n413\t                );\n414\t              })}\n415\t            </div>\n416\t          )}\n417\t        </div>\n418\t      )}\n419\t    </div>\n420\t  );\n421\t}\n422\t"}]},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"05508023-b6f6-41cf-8c53-1b5b24634656","timestamp":"2026-05-04T00:39:41.495Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/widgets/Video/VideoWidget.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useEffect,\n  useId,\n  useMemo,\n  useRef,\n  useState,\n  type CSSProperties,\n} from 'react';\nimport { ChevronDown, ChevronRight } from 'lucide-react';\n\nimport {\n  VideoDataSchema,\n  extractYouTubeId,\n  type VideoData,\n  type VideoTranscriptSegment,\n} from './schema';\n\nexport interface VideoWidgetProps {\n  data: VideoData;\n}\n\nconst wrapStyle: CSSProperties = {\n  display: 'flex',\n  flexDirection: 'column',\n};\n\nconst playerWrapStyle: CSSProperties = {\n  padding: 'var(--space-4) var(--space-5)',\n  background: 'var(--bg-subtle)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-3)',\n};\n\nconst aspectStyle: CSSProperties = {\n  position: 'relative',\n  width: '100%',\n  aspectRatio: '16 / 9',\n  background: '#000',\n  borderRadius: 'var(--radius-md)',\n  overflow: 'hidden',\n  border: '1px solid var(--border)',\n};\n\nconst playerElStyle: CSSProperties = {\n  position: 'absolute',\n  inset: 0,\n  width: '100%',\n  height: '100%',\n  border: 'none',\n  display: 'block',\n};\n\nconst titleStyle: CSSProperties = {\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text-secondary)',\n  textAlign: 'center',\n  lineHeight: 1.5,\n};\n\nconst transcriptWrapStyle: CSSProperties = {\n  borderTop: '1px solid var(--border)',\n  background: 'var(--bg-elevated)',\n};\n\nconst toggleButtonStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 6,\n  padding: '8px 14px',\n  background: 'transparent',\n  border: 'none',\n  color: 'var(--text-secondary)',\n  fontSize: 'var(--fs-sm)',\n  fontWeight: 500,\n  cursor: 'pointer',\n  width: '100%',\n  textAlign: 'left',\n};\n\nconst transcriptListStyle: CSSProperties = {\n  borderTop: '1px solid var(--border)',\n  maxHeight: 320,\n  overflow: 'auto',\n  padding: 'var(--space-2) 0',\n  display: 'flex',\n  flexDirection: 'column',\n};\n\nconst segmentBaseStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'flex-start',\n  gap: 'var(--space-3)',\n  padding: '6px var(--space-5)',\n  background: 'transparent',\n  border: 'none',\n  textAlign: 'left',\n  cursor: 'pointer',\n  color: 'var(--text)',\n  fontSize: 'var(--fs-sm)',\n  lineHeight: 1.5,\n  width: '100%',\n  fontFamily: 'inherit',\n};\n\nconst segmentTimeStyle: CSSProperties = {\n  flexShrink: 0,\n  fontFamily: 'var(--font-mono)',\n  fontSize: 'var(--fs-xs)',\n  color: 'var(--text-tertiary)',\n  width: 56,\n  textAlign: 'right',\n  paddingTop: 2,\n  fontVariantNumeric: 'tabular-nums',\n};\n\nconst segmentBodyStyle: CSSProperties = {\n  flex: 1,\n  minWidth: 0,\n};\n\nconst speakerStyle: CSSProperties = {\n  display: 'inline-block',\n  marginRight: 6,\n  fontSize: 'var(--fs-xs)',\n  fontWeight: 600,\n  letterSpacing: '0.06em',\n  textTransform: 'uppercase',\n  color: 'var(--text-tertiary)',\n};\n\nfunction formatTimestamp(seconds: number): string {\n  const total = Math.max(0, Math.floor(seconds));\n  const h = Math.floor(total / 3600);\n  const m = Math.floor((total % 3600) / 60);\n  const s = total % 60;\n  if (h > 0) {\n    return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;\n  }\n  return `${m}:${String(s).padStart(2, '0')}`;\n}\n\nfunction buildYouTubeEmbedUrl(videoId: string, opts: { autoplay: boolean; startAt?: number }): string {\n  const url = new URL(`https://www.youtube-nocookie.com/embed/${videoId}`);\n  url.searchParams.set('enablejsapi', '1');\n  url.searchParams.set('rel', '0');\n  url.searchParams.set('modestbranding', '1');\n  if (opts.autoplay) url.searchParams.set('autoplay', '1');\n  if (opts.startAt && opts.startAt > 0) {\n    url.searchParams.set('start', String(Math.floor(opts.startAt)));\n  }\n  return url.toString();\n}\n\nfunction findActiveSegmentIndex(transcript: VideoTranscriptSegment[], time: number): number {\n  for (let i = transcript.length - 1; i >= 0; i--) {\n    const seg = transcript[i];\n    if (time + 0.001 >= seg.tStart) {\n      if (seg.tEnd === undefined || time < seg.tEnd) return i;\n      const next = transcript[i + 1];\n      if (!next) return i;\n      if (time < next.tStart) return i;\n      return -1;\n    }\n  }\n  return -1;\n}\n\nexport function VideoWidget({ data: rawData }: VideoWidgetProps) {\n  const data = useMemo(() => VideoDataSchema.parse(rawData), [rawData]);\n  const reactId = useId();\n  const transcriptId = `video-transcript-${reactId}`;\n  const [transcriptOpen, setTranscriptOpen] = useState(true);\n  const [currentTime, setCurrentTime] = useState(data.startAt ?? 0);\n\n  const iframeRef = useRef<HTMLIFrameElement | null>(null);\n  const videoRef = useRef<HTMLVideoElement | null>(null);\n  const ytPollIntervalRef = useRef<number | null>(null);\n  const pendingYtSeekRef = useRef<number | null>(null);\n\n  const youtubeId = data.kind === 'youtube' ? extractYouTubeId(data.src) : null;\n  const youtubeEmbedUrl = useMemo(() => {\n    if (data.kind !== 'youtube' || !youtubeId) return null;\n    return buildYouTubeEmbedUrl(youtubeId, {\n      autoplay: data.autoplay ?? false,\n      startAt: data.startAt,\n    });\n  }, [data.kind, youtubeId, data.autoplay, data.startAt]);\n\n  const postYouTubeCommand = useCallback((command: string, args: unknown[] = []) => {\n    const win = iframeRef.current?.contentWindow;\n    if (!win) return;\n    win.postMessage(\n      JSON.stringify({ event: 'command', func: command, args }),\n      '*',\n    );\n  }, []);\n\n  useEffect(() => {\n    if (data.kind !== 'youtube') return;\n    function onMessage(event: MessageEvent) {\n      if (!iframeRef.current || event.source !== iframeRef.current.contentWindow) return;\n      const raw = event.data;\n      if (typeof raw !== 'string') return;\n      let payload: unknown;\n      try {\n        payload = JSON.parse(raw);\n      } catch {\n        return;\n      }\n      const obj = payload as { event?: string; info?: unknown };\n      if (obj.event === 'onReady') {\n        postYouTubeCommand('addEventListener', ['onStateChange']);\n        if (pendingYtSeekRef.current !== null) {\n          postYouTubeCommand('seekTo', [pendingYtSeekRef.current, true]);\n          pendingYtSeekRef.current = null;\n        }\n        if (ytPollIntervalRef.current === null) {\n          ytPollIntervalRef.current = window.setInterval(() => {\n            const w = iframeRef.current?.contentWindow;\n            if (!w) return;\n            w.postMessage(\n              JSON.stringify({ event: 'listening', id: 'ai-lecturer-time' }),\n              '*',\n            );\n            postYouTubeCommand('getCurrentTime');\n          }, 250);\n        }\n      } else if (obj.event === 'infoDelivery') {\n        const info = obj.info as { currentTime?: number } | undefined;\n        if (info && typeof info.currentTime === 'number') {\n          setCurrentTime(info.currentTime);\n        }\n      }\n    }\n    window.addEventListener('message', onMessage);\n    return () => {\n      window.removeEventListener('message', onMessage);\n      if (ytPollIntervalRef.current !== null) {\n        clearInterval(ytPollIntervalRef.current);\n        ytPollIntervalRef.current = null;\n      }\n    };\n  }, [data.kind, postYouTubeCommand]);\n\n  useEffect(() => {\n    if (data.kind !== 'mp4') return;\n    const el = videoRef.current;\n    if (!el) return;\n    if (data.startAt && data.startAt > 0) {\n      try {\n        el.currentTime = data.startAt;\n      } catch {\n        /* ignore */\n      }\n    }\n  }, [data.kind, data.startAt]);\n\n  const handleMp4TimeUpdate = useCallback(() => {\n    const el = videoRef.current;\n    if (!el) return;\n    setCurrentTime(el.currentTime);\n  }, []);\n\n  const seekTo = useCallback(\n    (seconds: number) => {\n      if (data.kind === 'youtube') {\n        const win = iframeRef.current?.contentWindow;\n        if (!win) {\n          pendingYtSeekRef.current = seconds;\n          return;\n        }\n        postYouTubeCommand('seekTo', [seconds, true]);\n        postYouTubeCommand('playVideo');\n        setCurrentTime(seconds);\n      } else {\n        const el = videoRef.current;\n        if (!el) return;\n        try {\n          el.currentTime = seconds;\n        } catch {\n          /* ignore */\n        }\n        setCurrentTime(seconds);\n        if (el.paused) {\n          void el.play().catch(() => {\n            /* ignore */\n          });\n        }\n      }\n    },\n    [data.kind, postYouTubeCommand],\n  );\n\n  const transcript = data.transcript ?? [];\n  const activeIndex = transcript.length\n    ? findActiveSegmentIndex(transcript, currentTime)\n    : -1;\n\n  return (\n    <div data-video-widget data-video-kind={data.kind} style={wrapStyle}>\n      <div style={playerWrapStyle}>\n        <div style={aspectStyle} data-testid=\"video-player-frame\">\n          {data.kind === 'youtube' ? (\n            youtubeEmbedUrl ? (\n              <iframe\n                ref={iframeRef}\n                title={data.title ?? 'YouTube video'}\n                src={youtubeEmbedUrl}\n                style={playerElStyle}\n                allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                allowFullScreen\n                data-testid=\"video-iframe\"\n                data-yt-id={youtubeId ?? ''}\n              />\n            ) : (\n              <div\n                data-testid=\"video-error\"\n                style={{\n                  ...playerElStyle,\n                  display: 'flex',\n                  alignItems: 'center',\n                  justifyContent: 'center',\n                  color: 'var(--text-on-accent, #fff)',\n                  fontSize: 'var(--fs-sm)',\n                  padding: '0 var(--space-4)',\n                  textAlign: 'center',\n                }}\n              >\n                Could not parse YouTube ID from <code>{data.src}</code>\n              </div>\n            )\n          ) : (\n            <video\n              ref={videoRef}\n              src={data.src}\n              controls\n              autoPlay={data.autoplay}\n              preload=\"metadata\"\n              onTimeUpdate={handleMp4TimeUpdate}\n              onLoadedMetadata={handleMp4TimeUpdate}\n              style={playerElStyle}\n              data-testid=\"video-mp4\"\n            />\n          )}\n        </div>\n        {data.title && (\n          <div style={titleStyle} data-testid=\"video-title\">\n            {data.title}\n          </div>\n        )}\n      </div>\n      {transcript.length > 0 && (\n        <div style={transcriptWrapStyle}>\n          <button\n            type=\"button\"\n            data-testid=\"video-transcript-toggle\"\n            aria-expanded={transcriptOpen}\n            aria-controls={transcriptId}\n            onClick={() => setTranscriptOpen((v) => !v)}\n            style={toggleButtonStyle}\n          >\n            {transcriptOpen ? (\n              <ChevronDown size={14} aria-hidden />\n            ) : (\n              <ChevronRight size={14} aria-hidden />\n            )}\n            {transcriptOpen ? 'Hide transcript' : 'Show transcript'}\n            <span\n              style={{\n                marginLeft: 'auto',\n                fontSize: 'var(--fs-xs)',\n                color: 'var(--text-tertiary)',\n              }}\n            >\n              {transcript.length} segment{transcript.length === 1 ? '' : 's'}\n            </span>\n          </button>\n          {transcriptOpen && (\n            <div\n              id={transcriptId}\n              data-testid=\"video-transcript-list\"\n              style={transcriptListStyle}\n            >\n              {transcript.map((seg, i) => {\n                const active = i === activeIndex;\n                const segStyle: CSSProperties = active\n                  ? {\n                      ...segmentBaseStyle,\n                      background: 'var(--accent-subtle)',\n                      color: 'var(--accent-text)',\n                    }\n                  : segmentBaseStyle;\n                return (\n                  <button\n                    key={i}\n                    type=\"button\"\n                    onClick={() => seekTo(seg.tStart)}\n                    style={segStyle}\n                    data-testid={`video-transcript-seg-${i}`}\n                    data-active={active ? 'true' : 'false'}\n                    aria-label={`Jump to ${formatTimestamp(seg.tStart)}: ${seg.text}`}\n                  >\n                    <span style={segmentTimeStyle}>{formatTimestamp(seg.tStart)}</span>\n                    <span style={segmentBodyStyle}>\n                      {seg.speaker && <span style={speakerStyle}>{seg.speaker}</span>}\n                      {seg.text}\n                    </span>\n                  </button>\n                );\n              })}\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":422,"startLine":1,"totalLines":422}}}
