ceof InvalidSlugError) {\n56\t      return NextResponse.json({ error: err.message }, { status: 400 });\n57\t    }\n58\t    throw err;\n59\t  }\n60\t\n61\t  const filePath = path.join(assetsDir, relPath);\n62\t  const resolved = path.resolve(filePath);\n63\t  const resolvedAssetsDir = path.resolve(assetsDir);\n64\t  if (!resolved.startsWith(resolvedAssetsDir + path.sep) && resolved !== resolvedAssetsDir) {\n65\t    return NextResponse.json({ error: 'Invalid asset path' }, { status: 400 });\n66\t  }\n67\t\n68\t  let buf: Buffer;\n69\t  try {\n70\t    buf = await fs.readFile(filePath);\n71\t  } catch (err) {\n72\t    if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n73\t      return NextResponse.json({ error: 'Asset not found' }, { status: 404 });\n74\t    }\n75\t    throw err;\n76\t  }\n77\t\n78\t  return new Response(new Uint8Array(buf), {\n79\t    status: 200,\n80\t    headers: {\n81\t      'Content-Type': contentTypeFor(relPath),\n82\t      'Content-Length': String(buf.length),\n83\t      'Cache-Control': 'no-cache',\n84\t    },\n85\t  });\n86\t}\n87\t\n88\texport async function PUT(req: Request, { params }: RouteCtx) {\n89\t  const { slug, path: relParts } = await params;\n90\t\n91\t  let assetsDir: string;\n92\t  let relPath: string;\n93\t  try {\n94\t    assertSafeSlug(slug);\n95\t    relPath = assertSafeAssetPath(relParts);\n96\t    assetsDir = path.join(courseDir(slug), 'assets');\n97\t  } catch (err) {\n98\t    if (err instanceof InvalidSlugError) {\n99\t      return NextResponse.json({ error: err.message }, { status: 400 });\n100\t    }\n101\t    throw err;\n102\t  }\n103\t\n104\t  const ext = path.extname(relPath).toLowerCase();\n105\t  if (!CONTENT_TYPES[ext]) {\n106\t    return NextResponse.json(\n107\t      { error: `Unsupported asset extension: ${ext || '(none)'}` },\n108\t      { status: 400 },\n109\t    );\n110\t  }\n111\t\n112\t  const filePath = path.join(assetsDir, relPath);\n113\t  const resolved = path.resolve(filePath);\n114\t  const resolvedAssetsDir = path.resolve(assetsDir);\n115\t  if (!resolved.startsWith(resolvedAssetsDir + path.sep) && resolved !== resolvedAssetsDir) {\n116\t    return NextResponse.json({ error: 'Invalid asset path' }, { status: 400 });\n117\t  }\n118\t\n119\t  const arrayBuf = await req.arrayBuffer();\n120\t  if (arrayBuf.byteLength === 0) {\n121\t    return NextResponse.json({ error: 'Empty body' }, { status: 400 });\n122\t  }\n123\t\n124\t  await fs.mkdir(path.dirname(filePath), { recursive: true });\n125\t  await fs.writeFile(filePath, Buffer.from(arrayBuf));\n126\t\n127\t  return NextResponse.json({\n128\t    src: `/api/courses/${encodeURIComponent(slug)}/assets/${relParts.map((p) => encodeURIComponent(p)).join('/')}`,\n129\t    bytes: arrayBuf.byteLength,\n130\t  });\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"aebae48c-3aa0-4f6d-8190-3e90eff4d396","timestamp":"2026-05-04T00:39:48.481Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/app/api/courses/[slug]/assets/[...path]/route.ts","content":"import { NextResponse } from 'next/server';\nimport { promises as fs } from 'node:fs';\nimport path from 'node:path';\n\nimport { InvalidSlugError, assertSafeSlug, courseDir } from '@/lib/server/paths';\n\nexport const dynamic = 'force-dynamic';\n\ntype RouteCtx = { params: Promise<{ slug: string; path: string[] }> };\n\nconst CONTENT_TYPES: Record<string, string> = {\n  '.png': 'image/png',\n  '.jpg': 'image/jpeg',\n  '.jpeg': 'image/jpeg',\n  '.svg': 'image/svg+xml',\n  '.webp': 'image/webp',\n  '.gif': 'image/gif',\n  '.mp4': 'video/mp4',\n  '.webm': 'video/webm',\n};\n\nfunction assertSafeAssetPath(parts: string[]): string {\n  if (!Array.isArray(parts) || parts.length === 0) {\n    throw new InvalidSlugError(String(parts));\n  }\n  for (const part of parts) {\n    if (typeof part !== 'string' || part.length === 0) {\n      throw new InvalidSlugError(String(part));\n    }\n    if (part.includes('/') || part.includes('\\\\') || part === '..' || part === '.') {\n      throw new InvalidSlugError(part);\n    }\n    if (part.includes('\\0')) {\n      throw new InvalidSlugError(part);\n    }\n  }\n  return parts.join('/');\n}\n\nfunction contentTypeFor(filename: string): string {\n  const ext = path.extname(filename).toLowerCase();\n  return CONTENT_TYPES[ext] ?? 'application/octet-stream';\n}\n\nexport async function GET(_req: Request, { params }: RouteCtx) {\n  const { slug, path: relParts } = await params;\n\n  let assetsDir: string;\n  let relPath: string;\n  try {\n    assertSafeSlug(slug);\n    relPath = assertSafeAssetPath(relParts);\n    assetsDir = path.join(courseDir(slug), 'assets');\n  } catch (err) {\n    if (err instanceof InvalidSlugError) {\n      return NextResponse.json({ error: err.message }, { status: 400 });\n    }\n    throw err;\n  }\n\n  const filePath = path.join(assetsDir, relPath);\n  const resolved = path.resolve(filePath);\n  const resolvedAssetsDir = path.resolve(assetsDir);\n  if (!resolved.startsWith(resolvedAssetsDir + path.sep) && resolved !== resolvedAssetsDir) {\n    return NextResponse.json({ error: 'Invalid asset path' }, { status: 400 });\n  }\n\n  let buf: Buffer;\n  try {\n    buf = await fs.readFile(filePath);\n  } catch (err) {\n    if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n      return NextResponse.json({ error: 'Asset not found' }, { status: 404 });\n    }\n    throw err;\n  }\n\n  return new Response(new Uint8Array(buf), {\n    status: 200,\n    headers: {\n      'Content-Type': contentTypeFor(relPath),\n      'Content-Length': String(buf.length),\n      'Cache-Control': 'no-cache',\n    },\n  });\n}\n\nexport async function PUT(req: Request, { params }: RouteCtx) {\n  const { slug, path: relParts } = await params;\n\n  let assetsDir: string;\n  let relPath: string;\n  try {\n    assertSafeSlug(slug);\n    relPath = assertSafeAssetPath(relParts);\n    assetsDir = path.join(courseDir(slug), 'assets');\n  } catch (err) {\n    if (err instanceof InvalidSlugError) {\n      return NextResponse.json({ error: err.message }, { status: 400 });\n    }\n    throw err;\n  }\n\n  const ext = path.extname(relPath).toLowerCase();\n  if (!CONTENT_TYPES[ext]) {\n    return NextResponse.json(\n      { error: `Unsupported asset extension: ${ext || '(none)'}` },\n      { status: 400 },\n    );\n  }\n\n  const filePath = path.join(assetsDir, relPath);\n  const resolved = path.resolve(filePath);\n  const resolvedAssetsDir = path.resolve(assetsDir);\n  if (!resolved.startsWith(resolvedAssetsDir + path.sep) && resolved !== resolvedAssetsDir) {\n    return NextResponse.json({ error: 'Invalid asset path' }, { status: 400 });\n  }\n\n  const arrayBuf = await req.arrayBuffer();\n  if (arrayBuf.byteLength === 0) {\n    return NextResponse.json({ error: 'Empty body' }, { status: 400 });\n  }\n\n  await fs.mkdir(path.dirname(filePath), { recursive: true });\n  await fs.writeFile(filePath, Buffer.from(arrayBuf));\n\n  return NextResponse.json({\n    src: `/api/courses/${encodeURIComponent(slug)}/assets/${relParts.map((p) => encodeURIComponent(p)).join('/')}`,\n    bytes: arrayBuf.byteLength,\n  });\n}\n","numLines":132,"startLine":1,"totalLines":132}}}
