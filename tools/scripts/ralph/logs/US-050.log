{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F3c3qTW5me8n8tMvu8fqpn","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport {\n4\t  useCallback,\n5\t  useMemo,\n6\t  useState,\n7\t  type CSSProperties,\n8\t} from 'react';\n9\timport { Plus, Trash2 } from 'lucide-react';\n10\timport type { z } from 'zod';\n11\t\n12\timport {\n13\t  EditorFormFooter,\n14\t  EditorFormSaveError,\n15\t  errorTextStyle,\n16\t  fieldStyle,\n17\t  formBodyStyle,\n18\t  inputStyle,\n19\t  labelStyle,\n20\t  textareaStyle,\n21\t  type FieldErrors,\n22\t} from '@/components/EditorForm';\n23\timport { SourcesField } from '@/components/Sources';\n24\timport type { Source } from '@/lib/schemas/lesson';\n25\t\n26\timport {\n27\t  VideoDataSchema,\n28\t  type VideoData,\n29\t  type VideoKind,\n30\t  type VideoTranscriptSegment,\n31\t} from './schema';\n32\t\n33\texport interface VideoEditorProps {\n34\t  initial: VideoData;\n35\t  initialSources?: Source[];\n36\t  onCancel: () => void;\n37\t  onSave: (next: VideoData, sources?: Source[]) => Promise<void>;\n38\t}\n39\t\n40\tinterface TranscriptRow extends VideoTranscriptSegment {\n41\t  rowId: string;\n42\t}\n43\t\n44\tfunction makeRowId(): string {\n45\t  return `t-${Math.random().toString(36).slice(2, 9)}`;\n46\t}\n47\t\n48\tfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n49\t  const out: FieldErrors = {};\n50\t  for (const issue of error.issues) {\n51\t    const path = issue.path.join('.') || '_root';\n52\t    if (!out[path]) out[path] = issue.message;\n53\t  }\n54\t  return out;\n55\t}\n56\t\n57\tconst segmentedRowStyle: CSSProperties = {\n58\t  display: 'inline-flex',\n59\t  border: '1px solid var(--border-strong)',\n60\t  borderRadius: 'var(--radius-md)',\n61\t  overflow: 'hidden',\n62\t};\n63\t\n64\tfunction segmentedButtonStyle(active: boolean): CSSProperties {\n65\t  return {\n66\t    padding: '6px 14px',\n67\t    fontSize: 'var(--fs-xs)',\n68\t    fontWeight: 500,\n69\t    background: active ? 'var(--accent-subtle)' : 'transparent',\n70\t    color: active ? 'var(--accent-text)' : 'var(--text-secondary)',\n71\t    border: 'none',\n72\t    cursor: 'pointer',\n73\t  };\n74\t}\n75\t\n76\tconst cardStyle: CSSProperties = {\n77\t  border: '1px solid var(--border)',\n78\t  borderRadius: 'var(--radius-md)',\n79\t  padding: 'var(--space-3)',\n80\t  display: 'flex',\n81\t  flexDirection: 'column',\n82\t  gap: 'var(--space-2)',\n83\t  background: 'var(--bg-elevated)',\n84\t  marginBottom: 6,\n85\t};\n86\t\n87\tconst cardHeaderStyle: CSSProperties = {\n88\t  display: 'flex',\n89\t  alignItems: 'center',\n90\t  gap: 'var(--space-2)',\n91\t};\n92\t\n93\tconst removeButtonStyle: CSSProperties = {\n94\t  width: 24,\n95\t  height: 24,\n96\t  display: 'inline-flex',\n97\t  alignItems: 'center',\n98\t  justifyContent: 'center',\n99\t  background: 'transparent',\n100\t  border: '1px solid transparent',\n101\t  borderRadius: 'var(--radius-sm)',\n102\t  color: 'var(--text-tertiary)',\n103\t  cursor: 'pointer',\n104\t  flexShrink: 0,\n105\t};\n106\t\n107\tconst addButtonStyle: CSSProperties = {\n108\t  display: 'inline-flex',\n109\t  alignItems: 'center',\n110\t  gap: 4,\n111\t  background: 'transparent',\n112\t  border: '1px dashed var(--border-strong)',\n113\t  borderRadius: 'var(--radius-md)',\n114\t  color: 'var(--text-secondary)',\n115\t  fontSize: 'var(--fs-xs)',\n116\t  fontWeight: 500,\n117\t  padding: '6px 10px',\n118\t  cursor: 'pointer',\n119\t  marginTop: 4,\n120\t};\n121\t\n122\tconst subLabelStyle: CSSProperties = {\n123\t  display: 'block',\n124\t  fontSize: '11px',\n125\t  color: 'var(--text-tertiary)',\n126\t  marginBottom: 4,\n127\t};\n128\t\n129\tconst inlineRowStyle: CSSProperties = {\n130\t  display: 'flex',\n131\t  flexWrap: 'wrap',\n132\t  gap: 'var(--space-3)',\n133\t  alignItems: 'flex-start',\n134\t};\n135\t\n136\tconst checkLabelStyle: CSSProperties = {\n137\t  display: 'inline-flex',\n138\t  alignItems: 'center',\n139\t  gap: 6,\n140\t  fontSize: 'var(--fs-sm)',\n141\t  color: 'var(--text-secondary)',\n142\t};\n143\t\n144\tfunction parseOptionalNumber(text: string): { ok: true; value: number | undefined } | { ok: false; error: string } {\n145\t  const trimmed = text.trim();\n146\t  if (!trimmed) return { ok: true, value: undefined };\n147\t  const n = Number(trimmed);\n148\t  if (!Number.isFinite(n) || n < 0) {\n149\t    return { ok: false, error: 'Must be a non-negative number' };\n150\t  }\n151\t  return { ok: true, value: n };\n152\t}\n153\t\n154\texport function VideoEditor({\n155\t  initial,\n156\t  initialSources,\n157\t  onCancel,\n158\t  onSave,\n159\t}: VideoEditorProps) {\n160\t  const [kind, setKind] = useState<VideoKind>(initial.kind);\n161\t  const [src, setSrc] = useState(initial.src);\n162\t  const [title, setTitle] = useState(initial.title ?? '');\n163\t  const [durationSecondsText, setDurationSecondsText] = useState(\n164\t    initial.durationSeconds !== undefined ? String(initial.durationSeconds) : '',\n165\t  );\n166\t  const [startAtText, setStartAtText] = useState(\n167\t    initial.startAt !== undefined ? String(initial.startAt) : '',\n168\t  );\n169\t  const [autoplay, setAutoplay] = useState(initial.autoplay ?? false);\n170\t  const [transcript, setTranscript] = useState<TranscriptRow[]>(() =>\n171\t    (initial.transcript ?? []).map((seg) => ({ ...seg, rowId: makeRowId() })),\n172\t  );\n173\t  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n174\t  const [errors, setErrors] = useState<FieldErrors>({});\n175\t  const [saving, setSaving] = useState(false);\n176\t  const [saveError, setSaveError] = useState<string | null>(null);\n177\t\n178\t  const durationParse = useMemo(() => parseOptionalNumber(durationSecondsText), [durationSecondsText]);\n179\t  const startAtParse = useMemo(() => parseOptionalNumber(startAtText), [startAtText]);\n180\t\n181\t  const current: VideoData | null = useMemo(() => {\n182\t    if (!durationParse.ok || !startAtParse.ok) return null;\n183\t    const out: VideoData = {\n184\t      kind,\n185\t      src,\n186\t      autoplay,\n187\t    };\n188\t    if (title.trim()) out.title = title.trim();\n189\t    if (durationParse.value !== undefined) out.durationSeconds = durationParse.value;\n190\t    if (startAtParse.value !== undefined) out.startAt = startAtParse.value;\n191\t    if (transcript.length > 0) {\n192\t      out.transcript = transcript.map((row) => {\n193\t        const seg: VideoTranscriptSegment = { tStart: row.tStart, text: row.text };\n194\t        if (row.tEnd !== undefined) seg.tEnd = row.tEnd;\n195\t        if (row.speaker && row.speaker.trim()) seg.speaker = row.speaker.trim();\n196\t        return seg;\n197\t      });\n198\t    }\n199\t    return out;\n200\t  }, [kind, src, title, autoplay, durationParse, startAtParse, transcript]);\n201\t\n202\t  const dirty = useMemo(() => {\n203\t    if (!current) return true;\n204\t    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n205\t    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n206\t  }, [current, initial, sources, initialSources]);\n207\t\n208\t  const handleSave = useCallback(async () => {\n209\t    if (saving) return;\n210\t    if (!durationParse.ok) {\n211\t      setErrors({ durationSeconds: durationParse.error });\n212\t      return;\n213\t    }\n214\t    if (!startAtParse.ok) {\n215\t      setErrors({ startAt: startAtParse.error });\n216\t      return;\n217\t    }\n218\t    if (!current) return;\n219\t    const result = VideoDataSchema.safeParse(current);\n220\t    if (!result.success) {\n221\t      setErrors(flattenIssues(result.error));\n222\t      return;\n223\t    }\n224\t    setErrors({});\n225\t    setSaveError(null);\n226\t    setSaving(true);\n227\t    try {\n228\t      await onSave(result.data, sources);\n229\t      setSaving(false);\n230\t    } catch (err) {\n231\t      setSaveError(err instanceof Error ? err.message : String(err));\n232\t      setSaving(false);\n233\t    }\n234\t  }, [current, durationParse, onSave, saving, sources, startAtParse]);\n235\t\n236\t  const addSegment = useCallback(() => {\n237\t    setTranscript((prev) => [\n238\t      ...prev,\n239\t      {\n240\t        rowId: makeRowId(),\n241\t        tStart: prev.length > 0 ? (prev[prev.length - 1].tEnd ?? prev[prev.length - 1].tStart + 5) : 0,\n242\t        text: '',\n243\t      },\n244\t    ]);\n245\t  }, []);\n246\t\n247\t  const updateSegment = useCallback((rowId: string, patch: Partial<TranscriptRow>) => {\n248\t    setTranscript((prev) =>\n249\t      prev.map((seg) => (seg.rowId === rowId ? { ...seg, ...patch } : seg)),\n250\t    );\n251\t  }, []);\n252\t\n253\t  const removeSegment = useCallback((rowId: string) => {\n254\t    setTranscript((prev) => prev.filter((seg) => seg.rowId !== rowId));\n255\t  }, []);\n256\t\n257\t  return (\n258\t    <div\n259\t      data-testid=\"video-editor\"\n260\t      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n261\t    >\n262\t      <div style={formBodyStyle}>\n263\t        <div style={fieldStyle}>\n264\t          <span style={labelStyle}>Source kind</span>\n265\t          <div style={segmentedRowStyle} role=\"tablist\" aria-label=\"Video kind\">\n266\t            <button\n267\t              type=\"button\"\n268\t              role=\"tab\"\n269\t              aria-selected={kind === 'youtube'}\n270\t              data-testid=\"video-edit-kind-youtube\"\n271\t              onClick={() => setKind('youtube')}\n272\t              style={segmentedButtonStyle(kind === 'youtube')}\n273\t            >\n274\t              YouTube\n275\t            </button>\n276\t            <button\n277\t              type=\"button\"\n278\t              role=\"tab\"\n279\t              aria-selected={kind === 'mp4'}\n280\t              data-testid=\"video-edit-kind-mp4\"\n281\t              onClick={() => setKind('mp4')}\n282\t              style={segmentedButtonStyle(kind === 'mp4')}\n283\t            >\n284\t              MP4\n285\t            </button>\n286\t          </div>\n287\t        </div>\n288\t\n289\t        <label style={fieldStyle}>\n290\t          <span style={labelStyle}>\n291\t            {kind === 'youtube' ? 'YouTube URL or video ID' : 'MP4 src (URL or asset path)'}\n292\t          </span>\n293\t          <input\n294\t            type=\"text\"\n295\t            data-testid=\"video-edit-src\"\n296\t            value={src}\n297\t            onChange={(e) => setSrc(e.target.value)}\n298\t            spellCheck={false}\n299\t            style={{\n300\t              ...inputStyle,\n301\t              fontFamily: 'var(--font-mono)',\n302\t              borderColor: errors.src ? 'var(--danger-border)' : undefined,\n303\t            }}\n304\t          />\n305\t          {errors.src && (\n306\t            <div data-testid=\"video-edit-src-error\" style={errorTextStyle}>\n307\t              {errors.src}\n308\t            </div>\n309\t          )}\n310\t        </label>\n311\t\n312\t        <label style={fieldStyle}>\n313\t          <span style={labelStyle}>Title (optional)</span>\n314\t          <input\n315\t            type=\"text\"\n316\t            data-testid=\"video-edit-title\"\n317\t            value={title}\n318\t            onChange={(e) => setTitle(e.target.value)}\n319\t            style={inputStyle}\n320\t          />\n321\t        </label>\n322\t\n323\t        <div style={{ ...inlineRowStyle, marginBottom: 'var(--space-4)' }}>\n324\t          <label style={{ ...fieldStyle, marginBottom: 0 }}>\n325\t            <span style={labelStyle}>Duration (s)</span>\n326\t            <input\n327\t              type=\"number\"\n328\t              min={0}\n329\t              data-testid=\"video-edit-duration\"\n330\t              value={durationSecondsText}\n331\t              onChange={(e) => setDurationSecondsText(e.target.value)}\n332\t              style={{ ...inputStyle, width: 120 }}\n333\t              placeholder=\"(none)\"\n334\t            />\n335\t            {!durationParse.ok && (\n336\t              <div style={errorTextStyle}>{durationParse.error}</div>\n337\t            )}\n338\t          </label>\n339\t          <label style={{ ...fieldStyle, marginBottom: 0 }}>\n340\t            <span style={labelStyle}>Start at (s)</span>\n341\t            <input\n342\t              type=\"number\"\n343\t              min={0}\n344\t              data-testid=\"video-edit-start-at\"\n345\t              value={startAtText}\n346\t              onChange={(e) => setStartAtText(e.target.value)}\n347\t              style={{ ...inputStyle, width: 120 }}\n348\t              placeholder=\"(none)\"\n349\t            />\n350\t            {!startAtParse.ok && (\n351\t              <div style={errorTextStyle}>{startAtParse.error}</div>\n352\t            )}\n353\t          </label>\n354\t          <label style={{ ...checkLabelStyle, marginTop: 24 }}>\n355\t            <input\n356\t              type=\"checkbox\"\n357\t              data-testid=\"video-edit-autoplay\"\n358\t              checked={autoplay}\n359\t              onChange={(e) => setAutoplay(e.target.checked)}\n360\t            />\n361\t            Autoplay\n362\t          </label>\n363\t        </div>\n364\t\n365\t        <div style={fieldStyle}>\n366\t          <span style={labelStyle}>Transcript (optional)</span>\n367\t          <div data-testid=\"video-edit-transcript\">\n368\t            {transcript.map((seg, i) => (\n369\t              <div key={seg.rowId} style={cardStyle} data-test-seg-index={i}>\n370\t                <div style={cardHeaderStyle}>\n371\t                  <label style={{ flex: '0 0 auto' }}>\n372\t                    <span style={subLabelStyle}>tStart (s)</span>\n373\t                    <input\n374\t                      type=\"number\"\n375\t                      min={0}\n376\t                      step={0.1}\n377\t                      data-testid={`video-edit-seg-tstart-${i}`}\n378\t                      value={seg.tStart}\n379\t                      onChange={(e) => {\n380\t                        const n = Number(e.target.value);\n381\t                        if (Number.isFinite(n) && n >= 0) {\n382\t                          updateSegment(seg.rowId, { tStart: n });\n383\t                        }\n384\t                      }}\n385\t                      style={{ ...inputStyle, width: 100 }}\n386\t                    />\n387\t                  </label>\n388\t                  <label style={{ flex: '0 0 auto' }}>\n389\t                    <span style={subLabelStyle}>tEnd (s)</span>\n390\t                    <input\n391\t                      type=\"number\"\n392\t                      min={0}\n393\t                      step={0.1}\n394\t                      data-testid={`video-edit-seg-tend-${i}`}\n395\t                      value={seg.tEnd ?? ''}\n396\t                      onChange={(e) => {\n397\t                        const v = e.target.value;\n398\t                        if (v === '') {\n399\t                          updateSegment(seg.rowId, { tEnd: undefined });\n400\t                          return;\n401\t                        }\n402\t                        const n = Number(v);\n403\t                        if (Number.isFinite(n) && n >= 0) {\n404\t                          updateSegment(seg.rowId, { tEnd: n });\n405\t                        }\n406\t                      }}\n407\t                      style={{ ...inputStyle, width: 100 }}\n408\t                      placeholder=\"(none)\"\n409\t                    />\n410\t                  </label>\n411\t                  <label style={{ flex: 1, minWidth: 120 }}>\n412\t                    <span style={subLabelStyle}>Speaker (optional)</span>\n413\t                    <input\n414\t                      type=\"text\"\n415\t                      data-testid={`video-edit-seg-speaker-${i}`}\n416\t                      value={seg.speaker ?? ''}\n417\t                      onChange={(e) =>\n418\t                        updateSegment(seg.rowId, { speaker: e.target.value })\n419\t                      }\n420\t                      style={inputStyle}\n421\t                    />\n422\t                  </label>\n423\t                  <button\n424\t                    type=\"button\"\n425\t                    data-testid={`video-edit-seg-remove-${i}`}\n426\t                    onClick={() => removeSegment(seg.rowId)}\n427\t                    aria-label={`Remove segment ${i + 1}`}\n428\t                    style={removeButtonStyle}\n429\t                  >\n430\t                    <Trash2 size={13} aria-hidden />\n431\t                  </button>\n432\t                </div>\n433\t                <label>\n434\t                  <span style={subLabelStyle}>Text</span>\n435\t                  <textarea\n436\t                    data-testid={`video-edit-seg-text-${i}`}\n437\t                    value={seg.text}\n438\t                    onChange={(e) =>\n439\t                      updateSegment(seg.rowId, { text: e.target.value })\n440\t                    }\n441\t                    style={{ ...textareaStyle, minHeight: 60 }}\n442\t                  />\n443\t                </label>\n444\t              </div>\n445\t            ))}\n446\t          </div>\n447\t          <button\n448\t            type=\"button\"\n449\t            data-testid=\"video-edit-add-segment\"\n450\t            onClick={addSegment}\n451\t            style={addButtonStyle}\n452\t          >\n453\t            <Plus size={12} aria-hidden /> Add segment\n454\t          </button>\n455\t        </div>\n456\t\n457\t        <SourcesField sources={sources} onChange={setSources} />\n458\t\n459\t        {errors._root && <div style={errorTextStyle}>{errors._root}</div>}\n460\t      </div>\n461\t\n462\t      <EditorFormSaveError message={saveError} />\n463\t      <EditorFormFooter\n464\t        saving={saving}\n465\t        saveDisabled={!dirty}\n466\t        onCancel={onCancel}\n467\t        onSave={() => void handleSave()}\n468\t        cancelTestId=\"video-edit-cancel\"\n469\t        saveTestId=\"video-edit-save\"\n470\t      />\n471\t    </div>\n472\t  );\n473\t}\n474\t"}]},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"7d1af474-ad47-4bb6-b145-5157b08ff01f","timestamp":"2026-05-04T00:39:44.715Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/widgets/Video/VideoEditor.tsx","content":"'use client';\n\nimport {\n  useCallback,\n  useMemo,\n  useState,\n  type CSSProperties,\n} from 'react';\nimport { Plus, Trash2 } from 'lucide-react';\nimport type { z } from 'zod';\n\nimport {\n  EditorFormFooter,\n  EditorFormSaveError,\n  errorTextStyle,\n  fieldStyle,\n  formBodyStyle,\n  inputStyle,\n  labelStyle,\n  textareaStyle,\n  type FieldErrors,\n} from '@/components/EditorForm';\nimport { SourcesField } from '@/components/Sources';\nimport type { Source } from '@/lib/schemas/lesson';\n\nimport {\n  VideoDataSchema,\n  type VideoData,\n  type VideoKind,\n  type VideoTranscriptSegment,\n} from './schema';\n\nexport interface VideoEditorProps {\n  initial: VideoData;\n  initialSources?: Source[];\n  onCancel: () => void;\n  onSave: (next: VideoData, sources?: Source[]) => Promise<void>;\n}\n\ninterface TranscriptRow extends VideoTranscriptSegment {\n  rowId: string;\n}\n\nfunction makeRowId(): string {\n  return `t-${Math.random().toString(36).slice(2, 9)}`;\n}\n\nfunction flattenIssues(error: z.ZodError<unknown>): FieldErrors {\n  const out: FieldErrors = {};\n  for (const issue of error.issues) {\n    const path = issue.path.join('.') || '_root';\n    if (!out[path]) out[path] = issue.message;\n  }\n  return out;\n}\n\nconst segmentedRowStyle: CSSProperties = {\n  display: 'inline-flex',\n  border: '1px solid var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  overflow: 'hidden',\n};\n\nfunction segmentedButtonStyle(active: boolean): CSSProperties {\n  return {\n    padding: '6px 14px',\n    fontSize: 'var(--fs-xs)',\n    fontWeight: 500,\n    background: active ? 'var(--accent-subtle)' : 'transparent',\n    color: active ? 'var(--accent-text)' : 'var(--text-secondary)',\n    border: 'none',\n    cursor: 'pointer',\n  };\n}\n\nconst cardStyle: CSSProperties = {\n  border: '1px solid var(--border)',\n  borderRadius: 'var(--radius-md)',\n  padding: 'var(--space-3)',\n  display: 'flex',\n  flexDirection: 'column',\n  gap: 'var(--space-2)',\n  background: 'var(--bg-elevated)',\n  marginBottom: 6,\n};\n\nconst cardHeaderStyle: CSSProperties = {\n  display: 'flex',\n  alignItems: 'center',\n  gap: 'var(--space-2)',\n};\n\nconst removeButtonStyle: CSSProperties = {\n  width: 24,\n  height: 24,\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  background: 'transparent',\n  border: '1px solid transparent',\n  borderRadius: 'var(--radius-sm)',\n  color: 'var(--text-tertiary)',\n  cursor: 'pointer',\n  flexShrink: 0,\n};\n\nconst addButtonStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 4,\n  background: 'transparent',\n  border: '1px dashed var(--border-strong)',\n  borderRadius: 'var(--radius-md)',\n  color: 'var(--text-secondary)',\n  fontSize: 'var(--fs-xs)',\n  fontWeight: 500,\n  padding: '6px 10px',\n  cursor: 'pointer',\n  marginTop: 4,\n};\n\nconst subLabelStyle: CSSProperties = {\n  display: 'block',\n  fontSize: '11px',\n  color: 'var(--text-tertiary)',\n  marginBottom: 4,\n};\n\nconst inlineRowStyle: CSSProperties = {\n  display: 'flex',\n  flexWrap: 'wrap',\n  gap: 'var(--space-3)',\n  alignItems: 'flex-start',\n};\n\nconst checkLabelStyle: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  gap: 6,\n  fontSize: 'var(--fs-sm)',\n  color: 'var(--text-secondary)',\n};\n\nfunction parseOptionalNumber(text: string): { ok: true; value: number | undefined } | { ok: false; error: string } {\n  const trimmed = text.trim();\n  if (!trimmed) return { ok: true, value: undefined };\n  const n = Number(trimmed);\n  if (!Number.isFinite(n) || n < 0) {\n    return { ok: false, error: 'Must be a non-negative number' };\n  }\n  return { ok: true, value: n };\n}\n\nexport function VideoEditor({\n  initial,\n  initialSources,\n  onCancel,\n  onSave,\n}: VideoEditorProps) {\n  const [kind, setKind] = useState<VideoKind>(initial.kind);\n  const [src, setSrc] = useState(initial.src);\n  const [title, setTitle] = useState(initial.title ?? '');\n  const [durationSecondsText, setDurationSecondsText] = useState(\n    initial.durationSeconds !== undefined ? String(initial.durationSeconds) : '',\n  );\n  const [startAtText, setStartAtText] = useState(\n    initial.startAt !== undefined ? String(initial.startAt) : '',\n  );\n  const [autoplay, setAutoplay] = useState(initial.autoplay ?? false);\n  const [transcript, setTranscript] = useState<TranscriptRow[]>(() =>\n    (initial.transcript ?? []).map((seg) => ({ ...seg, rowId: makeRowId() })),\n  );\n  const [sources, setSources] = useState<Source[] | undefined>(initialSources);\n  const [errors, setErrors] = useState<FieldErrors>({});\n  const [saving, setSaving] = useState(false);\n  const [saveError, setSaveError] = useState<string | null>(null);\n\n  const durationParse = useMemo(() => parseOptionalNumber(durationSecondsText), [durationSecondsText]);\n  const startAtParse = useMemo(() => parseOptionalNumber(startAtText), [startAtText]);\n\n  const current: VideoData | null = useMemo(() => {\n    if (!durationParse.ok || !startAtParse.ok) return null;\n    const out: VideoData = {\n      kind,\n      src,\n      autoplay,\n    };\n    if (title.trim()) out.title = title.trim();\n    if (durationParse.value !== undefined) out.durationSeconds = durationParse.value;\n    if (startAtParse.value !== undefined) out.startAt = startAtParse.value;\n    if (transcript.length > 0) {\n      out.transcript = transcript.map((row) => {\n        const seg: VideoTranscriptSegment = { tStart: row.tStart, text: row.text };\n        if (row.tEnd !== undefined) seg.tEnd = row.tEnd;\n        if (row.speaker && row.speaker.trim()) seg.speaker = row.speaker.trim();\n        return seg;\n      });\n    }\n    return out;\n  }, [kind, src, title, autoplay, durationParse, startAtParse, transcript]);\n\n  const dirty = useMemo(() => {\n    if (!current) return true;\n    if (JSON.stringify(current) !== JSON.stringify(initial)) return true;\n    return JSON.stringify(sources ?? null) !== JSON.stringify(initialSources ?? null);\n  }, [current, initial, sources, initialSources]);\n\n  const handleSave = useCallback(async () => {\n    if (saving) return;\n    if (!durationParse.ok) {\n      setErrors({ durationSeconds: durationParse.error });\n      return;\n    }\n    if (!startAtParse.ok) {\n      setErrors({ startAt: startAtParse.error });\n      return;\n    }\n    if (!current) return;\n    const result = VideoDataSchema.safeParse(current);\n    if (!result.success) {\n      setErrors(flattenIssues(result.error));\n      return;\n    }\n    setErrors({});\n    setSaveError(null);\n    setSaving(true);\n    try {\n      await onSave(result.data, sources);\n      setSaving(false);\n    } catch (err) {\n      setSaveError(err instanceof Error ? err.message : String(err));\n      setSaving(false);\n    }\n  }, [current, durationParse, onSave, saving, sources, startAtParse]);\n\n  const addSegment = useCallback(() => {\n    setTranscript((prev) => [\n      ...prev,\n      {\n        rowId: makeRowId(),\n        tStart: prev.length > 0 ? (prev[prev.length - 1].tEnd ?? prev[prev.length - 1].tStart + 5) : 0,\n        text: '',\n      },\n    ]);\n  }, []);\n\n  const updateSegment = useCallback((rowId: string, patch: Partial<TranscriptRow>) => {\n    setTranscript((prev) =>\n      prev.map((seg) => (seg.rowId === rowId ? { ...seg, ...patch } : seg)),\n    );\n  }, []);\n\n  const removeSegment = useCallback((rowId: string) => {\n    setTranscript((prev) => prev.filter((seg) => seg.rowId !== rowId));\n  }, []);\n\n  return (\n    <div\n      data-testid=\"video-editor\"\n      style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n    >\n      <div style={formBodyStyle}>\n        <div style={fieldStyle}>\n          <span style={labelStyle}>Source kind</span>\n          <div style={segmentedRowStyle} role=\"tablist\" aria-label=\"Video kind\">\n            <button\n              type=\"button\"\n              role=\"tab\"\n              aria-selected={kind === 'youtube'}\n              data-testid=\"video-edit-kind-youtube\"\n              onClick={() => setKind('youtube')}\n              style={segmentedButtonStyle(kind === 'youtube')}\n            >\n              YouTube\n            </button>\n            <button\n              type=\"button\"\n              role=\"tab\"\n              aria-selected={kind === 'mp4'}\n              data-testid=\"video-edit-kind-mp4\"\n              onClick={() => setKind('mp4')}\n              style={segmentedButtonStyle(kind === 'mp4')}\n            >\n              MP4\n            </button>\n          </div>\n        </div>\n\n        <label style={fieldStyle}>\n          <span style={labelStyle}>\n            {kind === 'youtube' ? 'YouTube URL or video ID' : 'MP4 src (URL or asset path)'}\n          </span>\n          <input\n            type=\"text\"\n            data-testid=\"video-edit-src\"\n            value={src}\n            onChange={(e) => setSrc(e.target.value)}\n            spellCheck={false}\n            style={{\n              ...inputStyle,\n              fontFamily: 'var(--font-mono)',\n              borderColor: errors.src ? 'var(--danger-border)' : undefined,\n            }}\n          />\n          {errors.src && (\n            <div data-testid=\"video-edit-src-error\" style={errorTextStyle}>\n              {errors.src}\n            </div>\n          )}\n        </label>\n\n        <label style={fieldStyle}>\n          <span style={labelStyle}>Title (optional)</span>\n          <input\n            type=\"text\"\n            data-testid=\"video-edit-title\"\n            value={title}\n            onChange={(e) => setTitle(e.target.value)}\n            style={inputStyle}\n          />\n        </label>\n\n        <div style={{ ...inlineRowStyle, marginBottom: 'var(--space-4)' }}>\n          <label style={{ ...fieldStyle, marginBottom: 0 }}>\n            <span style={labelStyle}>Duration (s)</span>\n            <input\n              type=\"number\"\n              min={0}\n              data-testid=\"video-edit-duration\"\n              value={durationSecondsText}\n              onChange={(e) => setDurationSecondsText(e.target.value)}\n              style={{ ...inputStyle, width: 120 }}\n              placeholder=\"(none)\"\n            />\n            {!durationParse.ok && (\n              <div style={errorTextStyle}>{durationParse.error}</div>\n            )}\n          </label>\n          <label style={{ ...fieldStyle, marginBottom: 0 }}>\n            <span style={labelStyle}>Start at (s)</span>\n            <input\n              type=\"number\"\n              min={0}\n              data-testid=\"video-edit-start-at\"\n              value={startAtText}\n              onChange={(e) => setStartAtText(e.target.value)}\n              style={{ ...inputStyle, width: 120 }}\n              placeholder=\"(none)\"\n            />\n            {!startAtParse.ok && (\n              <div style={errorTextStyle}>{startAtParse.error}</div>\n            )}\n          </label>\n          <label style={{ ...checkLabelStyle, marginTop: 24 }}>\n            <input\n              type=\"checkbox\"\n              data-testid=\"video-edit-autoplay\"\n              checked={autoplay}\n              onChange={(e) => setAutoplay(e.target.checked)}\n            />\n            Autoplay\n          </label>\n        </div>\n\n        <div style={fieldStyle}>\n          <span style={labelStyle}>Transcript (optional)</span>\n          <div data-testid=\"video-edit-transcript\">\n            {transcript.map((seg, i) => (\n              <div key={seg.rowId} style={cardStyle} data-test-seg-index={i}>\n                <div style={cardHeaderStyle}>\n                  <label style={{ flex: '0 0 auto' }}>\n                    <span style={subLabelStyle}>tStart (s)</span>\n                    <input\n                      type=\"number\"\n                      min={0}\n                      step={0.1}\n                      data-testid={`video-edit-seg-tstart-${i}`}\n                      value={seg.tStart}\n                      onChange={(e) => {\n                        const n = Number(e.target.value);\n                        if (Number.isFinite(n) && n >= 0) {\n                          updateSegment(seg.rowId, { tStart: n });\n                        }\n                      }}\n                      style={{ ...inputStyle, width: 100 }}\n                    />\n                  </label>\n                  <label style={{ flex: '0 0 auto' }}>\n                    <span style={subLabelStyle}>tEnd (s)</span>\n                    <input\n                      type=\"number\"\n                      min={0}\n                      step={0.1}\n                      data-testid={`video-edit-seg-tend-${i}`}\n                      value={seg.tEnd ?? ''}\n                      onChange={(e) => {\n                        const v = e.target.value;\n                        if (v === '') {\n                          updateSegment(seg.rowId, { tEnd: undefined });\n                          return;\n                        }\n                        const n = Number(v);\n                        if (Number.isFinite(n) && n >= 0) {\n                          updateSegment(seg.rowId, { tEnd: n });\n                        }\n                      }}\n                      style={{ ...inputStyle, width: 100 }}\n                      placeholder=\"(none)\"\n                    />\n                  </label>\n                  <label style={{ flex: 1, minWidth: 120 }}>\n                    <span style={subLabelStyle}>Speaker (optional)</span>\n                    <input\n                      type=\"text\"\n                      data-testid={`video-edit-seg-speaker-${i}`}\n                      value={seg.speaker ?? ''}\n                      onChange={(e) =>\n                        updateSegment(seg.rowId, { speaker: e.target.value })\n                      }\n                      style={inputStyle}\n                    />\n                  </label>\n                  <button\n                    type=\"button\"\n                    data-testid={`video-edit-seg-remove-${i}`}\n                    onClick={() => removeSegment(seg.rowId)}\n                    aria-label={`Remove segment ${i + 1}`}\n                    style={removeButtonStyle}\n                  >\n                    <Trash2 size={13} aria-hidden />\n                  </button>\n                </div>\n                <label>\n                  <span style={subLabelStyle}>Text</span>\n                  <textarea\n                    data-testid={`video-edit-seg-text-${i}`}\n                    value={seg.text}\n                    onChange={(e) =>\n                      updateSegment(seg.rowId, { text: e.target.value })\n                    }\n                    style={{ ...textareaStyle, minHeight: 60 }}\n                  />\n                </label>\n              </div>\n            ))}\n          </div>\n          <button\n            type=\"button\"\n            data-testid=\"video-edit-add-segment\"\n            onClick={addSegment}\n            style={addButtonStyle}\n          >\n            <Plus size={12} aria-hidden /> Add segment\n          </button>\n        </div>\n\n        <SourcesField sources={sources} onChange={setSources} />\n\n        {errors._root && <div style={errorTextStyle}>{errors._root}</div>}\n      </div>\n\n      <EditorFormSaveError message={saveError} />\n      <EditorFormFooter\n        saving={saving}\n        saveDisabled={!dirty}\n        onCancel={onCancel}\n        onSave={() => void handleSave()}\n        cancelTestId=\"video-edit-cancel\"\n        saveTestId=\"video-edit-save\"\n      />\n    </div>\n  );\n}\n","numLines":474,"startLine":1,"totalLines":474}}}
