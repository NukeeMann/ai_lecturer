  const handleSave = useCallback(async () => {\n936\t    if (!dirty || saving) return;\n937\t    setSaveError(null);\n938\t    setSaving(true);\n939\t    try {\n940\t      await onSave(draft);\n941\t      setSaving(false);\n942\t    } catch (err) {\n943\t      setSaveError(err instanceof Error ? err.message : String(err));\n944\t      setSaving(false);\n945\t    }\n946\t  }, [dirty, draft, onSave, saving]);\n947\t\n948\t  return (\n949\t    <SidePanel\n950\t      open={open}\n951\t      onClose={onClose}\n952\t      title=\"Lesson sources\"\n953\t      testId=\"lesson-sources-edit-panel\"\n954\t    >\n955\t      <div\n956\t        data-testid=\"lesson-sources-editor\"\n957\t        style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n958\t      >\n959\t        <div style={formBodyStyle}>"}]},"parent_tool_use_id":null,"session_id":"951b4940-59c9-45a3-ba97-d8bc93a78325","uuid":"b82b359c-03e3-450a-a620-6c01a3aa7de0","timestamp":"2026-05-04T00:40:12.017Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nukeemann/projects/ai_lecturer/.worktrees/US-050/src/app/courses/[slug]/lessons/[lessonSlug]/page.tsx","content":"      )}\n      {section?.type === 'dataTable' && (\n        <DataTableEditor\n          key={section.id}\n          initial={section.data}\n          initialSources={section.sources}\n          onCancel={onClose}\n          onSave={(next, sources) => onSave(section.id, next, sources)}\n        />\n      )}\n      {section?.type === 'video' && (\n        <VideoEditor\n          key={section.id}\n          initial={section.data}\n          initialSources={section.sources}\n          onCancel={onClose}\n          onSave={(next, sources) => onSave(section.id, next, sources)}\n        />\n      )}\n    </SidePanel>\n  );\n}\n\ninterface LessonSourcesEditPanelProps {\n  open: boolean;\n  sources: Source[] | undefined;\n  onClose: () => void;\n  onSave: (next: Source[] | undefined) => Promise<void>;\n}\n\nfunction LessonSourcesEditPanel({\n  open,\n  sources,\n  onClose,\n  onSave,\n}: LessonSourcesEditPanelProps) {\n  const initialKey = useMemo(\n    () => JSON.stringify(sources ?? null),\n    [sources],\n  );\n  const [draft, setDraft] = useState<Source[] | undefined>(sources);\n  const [saving, setSaving] = useState(false);\n  const [saveError, setSaveError] = useState<string | null>(null);\n\n  // Re-sync draft from server-saved sources when the panel opens or upstream changes.\n  const lastInitialKey = useRef(initialKey);\n  useEffect(() => {\n    if (lastInitialKey.current !== initialKey) {\n      lastInitialKey.current = initialKey;\n      setDraft(sources);\n    }\n  }, [initialKey, sources]);\n\n  const dirty = JSON.stringify(draft ?? null) !== initialKey;\n\n  const handleSave = useCallback(async () => {\n    if (!dirty || saving) return;\n    setSaveError(null);\n    setSaving(true);\n    try {\n      await onSave(draft);\n      setSaving(false);\n    } catch (err) {\n      setSaveError(err instanceof Error ? err.message : String(err));\n      setSaving(false);\n    }\n  }, [dirty, draft, onSave, saving]);\n\n  return (\n    <SidePanel\n      open={open}\n      onClose={onClose}\n      title=\"Lesson sources\"\n      testId=\"lesson-sources-edit-panel\"\n    >\n      <div\n        data-testid=\"lesson-sources-editor\"\n        style={{ display: 'flex', flexDirection: 'column', flex: 1, minHeight: 0 }}\n      >\n        <div style={formBodyStyle}>","numLines":80,"startLine":880,"totalLines":2425}}}
