{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Static Export: from library.config.json",
      "detail": "Eksportuje kolekcje z pola `collections` w tools/static-export/library.config.json → dist/library/",
      "type": "shell",
      "command": "npm run export -- --from-config",
      "options": { "cwd": "${workspaceFolder}/tools/static-export" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Static Export: custom collections (free-text)",
      "detail": "Wpisz kolekcje po przecinku, np. 'Matematyka,Biologia,Weterynaria'",
      "type": "shell",
      "command": "npm run export -- --collections \"${input:collectionsFree}\"",
      "options": { "cwd": "${workspaceFolder}/tools/static-export" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Static Export: all collections",
      "detail": "Wszystkie kolekcje z ~/.ai-lecturer/collections.json → dist/library/",
      "type": "shell",
      "command": "npm run export -- --all-collections",
      "options": { "cwd": "${workspaceFolder}/tools/static-export" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Static Export: single course",
      "detail": "Wyeksportuj jeden kurs do dist/<slug>/ (podajesz slug)",
      "type": "shell",
      "command": "npm run export -- ${input:courseSlug}",
      "options": { "cwd": "${workspaceFolder}/tools/static-export" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Static Export: preview dist/library locally",
      "detail": "Uruchamia npx serve na dist/library — otwórz http://localhost:3000",
      "type": "shell",
      "command": "npx serve dist/library",
      "options": { "cwd": "${workspaceFolder}/tools/static-export" },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "showReuseMessage": false
      }
    },
    {
      "label": "Static Export: open dist/library in Finder",
      "detail": "Otwiera folder dist/library w Finderze (drag-and-drop na FTP)",
      "type": "shell",
      "command": "open dist/library",
      "options": { "cwd": "${workspaceFolder}/tools/static-export" },
      "problemMatcher": []
    },

    {
      "label": "Gemini Polish: 1) PRZYGOTUJ batche (export → out/<slug>/)",
      "detail": "Jedna komenda przygotowuje out/<slug>/: NNN.prompt.md + NNN.map.json + MANIFEST.md. Podstawa pracy ręcznej (wklejanie do Gemini web) i automatycznej (task 2). Nie kasuje gotowych result.json.",
      "type": "shell",
      "command": "npm run export -- ${input:courseSlug}",
      "options": { "cwd": "${workspaceFolder}/tools/gemini-polish" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Gemini Polish: 2) RUN przez API (auto-resume + limity)",
      "detail": "Przerabia zaległe batche po kolei przez Gemini CLI i od razu aplikuje. Wznawia od ostatniego ukończonego; stop na quota/timeout/serii błędów; domyślnie tani flash-lite + twardy limit wywołań.",
      "type": "shell",
      "command": "npm run run -- ${input:courseSlug}",
      "options": { "cwd": "${workspaceFolder}/tools/gemini-polish" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Gemini Polish: 3) APPLY ręcznych wyników (dry-run)",
      "detail": "Podgląd dla pracy ręcznej: wczytuje wklejone NNN.result.json, weryfikuje tokeny + schemat, NIC nie zapisuje. Raporty w reports/<slug>/.",
      "type": "shell",
      "command": "npm run apply -- ${input:courseSlug} --dry",
      "options": { "cwd": "${workspaceFolder}/tools/gemini-polish" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Gemini Polish: 4) APPLY ręcznych wyników (zapis + .bak)",
      "detail": "⚠️ ZAPISUJE: aplikuje zweryfikowane poprawki do plików kursu (każda zmieniona lekcja → .json.bak; pola zmienione ręcznie po exporcie są pomijane jako 'stale').",
      "type": "shell",
      "command": "npm run apply -- ${input:courseSlug}",
      "options": { "cwd": "${workspaceFolder}/tools/gemini-polish" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ],
  "inputs": [
    {
      "id": "collectionsFree",
      "type": "promptString",
      "description": "Kolekcje po przecinku (np. Matematyka,Biologia,Weterynaria)",
      "default": "Matematyka,Biologia"
    },
    {
      "id": "courseSlug",
      "type": "promptString",
      "description": "Slug kursu (nazwa folderu w courses/ — to fragment URL-a po /courses/)",
      "default": "faza-i-intuicja-matematyczna-w-robotyce-i-inzynierii-symulacyjnej"
    }
  ]
}
